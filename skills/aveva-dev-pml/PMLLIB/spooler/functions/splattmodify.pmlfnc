--
--
-- Description:
-- Modify attribute from parent form list
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [FORM]    [Parent form with list from which attribute was picked]
--   [2] [R] [DBREF]   [Current element for modification]
--   [3] [R] [STRING]  [Attribute name]
--   [4] [R] [STRING]  [Current attribute value]
--   [5] [R] [STRING]  [Datatype of value to set attribute]
--   [6] [R] [BOOLEAN] [Validation required]
--
------------------------------------------------------------------------

-- Define function
define function !!splAttModify(!parentForm is FORM, !ce is DBREF, !attribute is STRING, !value is STRING, !dataType is STRING, !validate is BOOLEAN)

  -- Determine form based on datatype and initialise explicitly
  if (!dataType eq 'STRING' and !attribute.upcase() NE 'NAME' ) then
    kill !!splBooleanAtt
    kill !!splRealAtt
    kill !!splNameAtt
    show !!splStringAtt
    !!splStringAtt.init(!parentForm, !ce, !attribute, !value, !validate)
  elseif (!attribute.upcase() eq 'NAME') then
     kill !!splBooleanAtt
     kill !!splStringAtt
     kill !!splRealAtt
     show !!splNameAtt
     !!splNameAtt.init(!parentForm, !ce, !attribute, !value, !validate)

  elseif (!dataType eq 'REAL') then
    kill !!splBooleanAtt
    kill !!splStringAtt
    kill !!splNameAtt
    show !!splRealAtt
    !!splRealAtt.init(!parentForm, !ce, !attribute, !value.real(), !validate)

  elseif (!dataType eq 'BOOLEAN') then
    kill !!splStringAtt
    kill !!splRealAtt
    kill !!splNameAtt
    show !!splBooleanAtt
    !!splBooleanAtt.init(!parentForm, !ce, !attribute, !value.boolean(), !validate)

  endif

endfunction
-- End of function definition for !!splAttModify
