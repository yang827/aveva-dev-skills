--
--
-- Description:
-- Return AWELD ref data
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [AWELD]
-- Return:
--   [ARRAY] [description, dbref, weld number]
--
------------------------------------------------------------------------

define function !!splAwdOwner(!aweld is DBREF) is ARRAY

  !data = ARRAY()

  -- attribute contents is 3 reals, dbref[1], dbref[2], weld number
  !weldData = !aweld.awdOwner
  !ref = '=' & !weldData[1] & '/' & !weldData[2]
  !dbRef = !ref.dbRef()
  !weldNo = !weldData[3]
  !data.append(!dbRef.fullName & ' weld ' & !weldNo)
  !data.append(!dbRef)
  !data.append(!weldNo)

  return !data

endfunction
-- End of function definition for !!splAwdOwner
