--
--
-- Description:
-- Get list of pulled bends in splDrg
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [Spldrg]
-- Return:
--   [ARRAY] [Pull bends array of dbrefs]
--
------------------------------------------------------------------------

define function !!splBends(!splDrg is DBREF) is ARRAY

  !splBends = ARRAY()

  -- add all pulled bends in the splDrg to the element list
  if (!splDrg.type eq 'SPLDRG') then
    do !element values !!splMem(!splDrg)
      skip if (!element.type ne 'BEND')
      if (!element.detRef.skey.matchWild('PB?D')) then
        !splBends.append(!element)
      endif
    enddo
  endif

  return !splBends

endfunction
-- End of function definition for !!splBends
