--
--
-- Description:
-- function to create elements for spooler module
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!splCreate(!type is STRING)

  -- Create element
  NEW $!type
  handle any
    !!alert.error(!!error.text)
    return error 1 noalert
  elsehandle none
    --  Set Search Within constraint for Spool Drawing
    if (!type.eq('SPLDRG')) then
      SFLimit $!!<splGenOpt.constraint>
    endif
    if (!!namOpt.auto()) then
      !name = !!namOpt.nameString(!!ce, '', false, false)
      if (!name.unset()) then
        -- autoname not generated
        -- show element creation form
        show !!splCreate
      else
        -- Attempt to do even if a leading slash is missing
        if !name.substring(1,1) neq '/' then
          !name = '/' + !name
        endif

        NAME $!<name>

      endif

    else
      -- show element creation form
      show !!splCreate
    endif
  endhandle

endfunction
-- End of function definition for !!splCreate
