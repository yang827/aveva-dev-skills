-- File:            spldelete.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Wed Oct 8 08:56:33 BST 1997
--
--
-- Description:
-- Special delete function for spooler module, only allows elements
-- in ISOD databases to be deleted.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [Element to delete]
--   [2] [R]    [BOOLEAN]   [Flag to indicate deletion of element members only]
--   [3] [R]    [BOOLEAN]   [Flag to indicate confirmation of delete]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***

-- Define function
define function !!splDelete(!element is DBREF, !members is BOOLEAN, !confirm is BOOLEAN)

  -- Define all special cases
  if (!element.type eq 'WORL') then
    if (!members) then
      -- 'cannot delete members of the WORLD.'
      !!messageFile.error(41, 216)
    else
      -- 'cannot delete the WORLD.'
      !!messageFile.error(41, 80)
    endif

  elseif (!element.dbType ne 'ISOD' and !element.type ne 'WELD') then
    -- cannot delete elements in databases that are not of type ISOD
    -- 'Unable to delete #type #name'
    !!messageFile.error(154, 130, !element.fullType, !element.name)

  elseif (!members and !element.members.unset()) then
    -- '#type #name does not have any members.'
    !!messageFile.error(154, 131, !element.fullType, !element.name)

  else

    if (!confirm) then
      -- Highlight elements to be deleted
      if (!element.type ne 'SPLTMP') then
        !highlightCol = !!gphColOpt.highlight()
        ENHANCE $!element COLOUR $!<highlightCol.code>
      endif
      if (!members) then
        -- 'Ok to delete #type #name Members?'
        !prompt = !!messageFile.messageString(154, 132, !element.fullType, !element.name)
      else
        -- 'Ok to delete #type #name?'
        !prompt = !!messageFile.messageString(154, 133, !element.fullType, !element.name)
      endif
      !okToDelete = (!!alert.confirm(!prompt) eq 'YES')
      UNENHANCE $!element
    else
      !okToDelete = true
    endif

    if (!okToDelete) then

      -- SPOOL and FIELD elements have to be removed with the special
      -- command SPOOLING REMOVE, this may return an error indicating that
      -- the element can not be removed as the network would be broken.
      if (!element.type eq 'SPOOL' or !element.type eq 'FIELD') then
        SPOOLING REMOVE $!element
      elseif (!element.type eq 'SPLTMP') then
        SPOOLING REMOVESPLTMPS $!<element.owner>
      elseif (!members and !element.type eq 'SPLDRG') then
        -- Remove at Spldrg empties the members list but leaves the Spldrg
        SPOOLING REMOVE $!element MEMBERS
        Smaximum 0
        Wmaximum 0
        Jmaximum 0
        Pmaximum 0
        Bmaximum 0
      else
        -- Normal delete
        !!ce = !element
        if (!members.not()) then
          DELETE $!<element.type>
        else
          DELETE $!<element.type> MEMBERS
        endif
      endif

    endif
  endif

endfunction
-- End of function definition for !!splDelete
