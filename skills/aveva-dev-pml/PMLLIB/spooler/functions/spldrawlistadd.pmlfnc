--
--
-- Description:
-- separate function to add elements to the drawlist
-- will be replaced when drawlist functionality is made available through an object
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------

define function !!splDrawlistAdd(!elemType is STRING, !colourNum is REAL)

  if (!elemType eq 'CE') then
    !element = !!ce
  elseif(!elemType eq 'OWNER') then
    if (!!ce.type ne 'WORL') then
      !element = !!ce.owner
    else
      !element = !!ce
    endif
  endif

  -- Check were not at World Level
  if(!element.type eq |WORL|) then
    return error 1 |Cannot add the World|

  -- Check if at site
  elseif (!element.type eq |SITE|) then
    !answer = !!alert.confirm('Are you sure you want to add a site?')
    if(!answer eq 'NO') then
      return
    endif
  endif

  if (!colourNum eq 0) then

    REM $!<element>
    ADD $!<element> COLOUR GREY

  else

    !saveAuto = !!gphColOpt.autoColour()
    !!gphColOpt.autoColour(false)
    REM $!<element>
    ADD $!<element> COLOUR $!<colourNum>
    handle any
      ADD $!<element> COLOUR GREY
    endhandle
    !!gphColOpt.autoColour(!saveAuto)

  endif

  if (defined(!!splDrawlist)) then
    if (!!splDrawlist.shown()) then
      !!splDrawlist.display()
    endif
  endif

endfunction
-- End of function definition for !!splDrawlistAdd
