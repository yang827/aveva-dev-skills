--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Jun 22 08:48:53 BST 1998
--
--
-- Description:
-- get splDrg for current element
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Return:
--   [DBREF] [splDrg for current element]
--
------------------------------------------------------------------------

define function !!splDrg() is DBREF

  -- store original element
  !element = !!ce

  -- link the form to a SPLDRG
  if (!element.type eq 'SPLDRG') then
    return !element
  else
    -- try to climb to a SPLDRG element
    SPLDRG
    handle (2,111)
      -- unable to climb to a SPLDRG element
      -- is the element a pipe component with a valid sfref?
      !splDrg = object DBREF()
      if (!element.type ne 'WORL') then
        if (!element.owner.type eq 'BRAN') then
          if (!element.sfref.set()) then
            !splDrg = !element.sfref.owner
          endif
        endif
      endif
      if (!splDrg.set()) then
        return !splDrg
      else
        -- 'Unable to navigate to #type element from current database position'
        !!messageFile.error(154, 110, 'SPLDRG')
      endif
    elsehandle none
      return !!ce
    endhandle
  endif

endfunction
-- End of function definition for !!splDrg
