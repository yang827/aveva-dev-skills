--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Tue Jun 30 15:35:54 BST 1998
--
--
-- Description:
-- Return IJOINT ref data
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [IJOINT]
-- Return:
--   [ARRAY] [2 * (description, dbref, ppoint number)]
--
------------------------------------------------------------------------

define function !!splJntOwners(!ijoint is DBREF) is ARRAY

  !data = ARRAY()

  -- attribute contents is 2 x 4 reals, dbref[1], dbref[2], tube flag, ppoint
  !weldData = !ijoint.jntOwners
  do !i to 2
    -- nozzle ppoints are encoded negative
    !pPoint = !weldData[!i * 4].abs()
    !ref = '=' & !weldData[!i * 4 - 3] & '/' & !weldData[!i * 4 - 2]
    if (!weldData[!i * 4 - 1] eq 710633) then
      !dbRef = ILEAVE TUBE OF $!ref
    else
      !dbRef = !ref.dbRef()
    endif
    !data.append('P' & !pPoint & ' of ' & !dbRef.fullName)
    !data.append(!dbRef)
    !data.append(!pPoint)
  enddo

  return !data

endfunction
-- End of function definition for !!splJntOwners
