--
--
-- Description:
-- Get list of joints in splDrg
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [Spldrg]
-- Return:
--   [ARRAY] [Joints array of dbrefs]
--
------------------------------------------------------------------------

define function !!splJointS(!splDrg is DBREF) is ARRAY

  !splJointS = ARRAY()

  -- add all members of the joint group to the element list
  if (!splDrg.type eq 'SPLDRG') then
    do !member values !splDrg.members
      if (!member.type eq 'JNTGRP') then
        !splJointS.appendArray(!member.members)
        break
      endif
    enddo
  endif

  return !splJointS

endfunction
-- End of function definition for !!splJointS
