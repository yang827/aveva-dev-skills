--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Mar 4 16:19:44 GMT 1998
--
--
-- Description:
-- Control main bar menu during interactive update and other operations
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [STRING] [Action key]
--
------------------------------------------------------------------------

-- Define function
define function !!splMainBarCntrl(!action is STRING)

  if (!action.match('nodelete') gt 0) then
    -- suppress delete operations
    !!spooler.deleteMenu.setActive('CE', false)
    !!spooler.deleteMenu.setActive('Name...', false)
    !!spooler.deleteMenu.setActive('Members', false)
    !!spooler.deleteMenu.setActive('Spool Break', false)
    !!spooler.deleteMenu.setActive('Spool Break PA', false)
    !!spooler.deleteMenu.setActive('Spool Break PL', false)
    !!spooler.deleteMenu.setActive('Spool Break OFF', false)
  endif

  if (!action.match('nohierarchy') gt 0) then
    -- suppress modify hierarchy operations
    !!spooler.modifyMenu.setActive('Hierarchy', false)
  endif

endfunction
-- End of function definition for !!splMainBarCntrl
