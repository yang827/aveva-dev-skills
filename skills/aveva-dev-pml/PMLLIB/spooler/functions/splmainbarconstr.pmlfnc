--
--
-- Description:
-- Constructor for spooler main bar form !!spooler
-- (can be replaced by method when !!spooler moves into PMLLIB)
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
--
------------------------------------------------------------------------

-- Define function
define function !!splMainBarConstr()

  !bar = !!spooler.bar
  !bar.insertBefore('Window', 'Create', 'createMenu')
  !bar.insertAfter('CreateMenu', 'Modify', 'ModifyMenu')
  !bar.insertAfter('ModifyMenu', 'Delete', 'DeleteMenu')
  !bar.insertAfter('DeleteMenu', 'Number', 'NumberMenu')

  -- hook for user specific main bar menus

  !!spooler.newMenu('CreateMenu')
  !!spooler.newMenu('ModifyMenu')
  !!spooler.newMenu('DeleteMenu')
  !!spooler.newMenu('NumberMenu')
  !!spooler.newMenu('DelMembers')
  !!spooler.newMenu('ModHierarchy')

  !!spooler.deleteMenu.add('callback', 'CE', '!!splDelete(!!ce, false, true)')
  !!spooler.deleteMenu.add('callback', 'Name...', 'show !!splDeleteNam')
  !!spooler.deleteMenu.add('menu', 'Members', 'DelMembers')
  !!spooler.deleteMenu.add('separator')
  !!spooler.deleteMenu.add('callback', 'Spool Break', '!!splSfBreak(|remove|)')
  !!spooler.deleteMenu.add('callback', 'Spool Break PA', '!!splSfBreak(|removePA|)')
  !!spooler.deleteMenu.add('callback', 'Spool Break PL', '!!splSfBreak(|removePL|)')
  !!spooler.deleteMenu.add('callback', 'Spool Break OFF', '!!splSfBreak(|removePO|)')

  !!spooler.delMembers.add('callback', 'Selection...', 'show !!splDeleteSel')
  !!spooler.delMembers.add('callback', 'All', '!!splDelete(!!ce, true, true)')

  !!spooler.modifyMenu.add('callback', 'Name...', 'show !!rename')
  !!spooler.modifyMenu.add('callback', 'Attributes...', '!!splModify()')
  !!spooler.modifyMenu.add('callback', 'Lock...', 'show !!lock')
  !!spooler.modifyMenu.add('menu', 'Hierarchy', 'ModHierarchy')
  !!spooler.modifyMenu.add('separator')
  !!spooler.modifyMenu.add('callback', 'SPLDRG Order', '!!splReorder()')
  !!spooler.modifyMenu.add('callback', 'MTO Status...', 'show !!splMtoStatus')
  !!spooler.modifyMenu.add('callback', 'Shop/Field...', 'show !!splShopFlag')
  !!spooler.modifyMenu.add('callback', 'Detail Plotfile...', 'show !!splDetailPlt')
  !!spooler.modifyMenu.add('callback', 'Attached Welds...', 'show !!splNWelds')

  !!spooler.modHierarchy.add('callback', 'Include...', 'show !!splMemInclu')
  !!spooler.modHierarchy.add('callback', 'Reverse Order', '!!membersReverse()')
  !!spooler.modHierarchy.add('callback', 'Reorder...', 'show !!splMemReord')

  !!spooler.numberMenu.add('callback', 'Update...', '!!splUpdate()')
  !!spooler.numberMenu.add('callback', 'Renumber...', '!!splRenumber()')
  !!spooler.numberMenu.add('callback', 'Check...', '!!splCheck()')

  -- Create menu may be dynamically built in future in !!splMainBarTrack()
  !!spooler.createMenu.add('callback', 'Department...', |!!splCreate('ISODEP')|)
  !!spooler.createMenu.add('callback', 'Registry...', |!!splCreate('ISOREG')|)
  !!spooler.createMenu.add('callback', 'Spool Drawing...', |!!splCreate('SPLDRG')|)
  !!spooler.createMenu.add('separator')
  !!spooler.createMenu.add('callback', 'Weld...', 'show !!splCreatWeld')
  !!spooler.createMenu.add('callback', 'Spool Break', '!!splSfBreak(|add|)')
  !!spooler.createMenu.add('callback', 'Spool Break PA', '!!splSfBreak(|addPA|)')
  !!spooler.createMenu.add('callback', 'Spool Break PL', '!!splSfBreak(|addPL|)')
  !!spooler.createMenu.add('callback', 'Spool Break OFF', '!!splSfBreak(|addPO|)')

  !!spooler.isodBar = false
  !!spooler.desiBar = false

endfunction
-- End of function definition for !!splMainBarConstr
