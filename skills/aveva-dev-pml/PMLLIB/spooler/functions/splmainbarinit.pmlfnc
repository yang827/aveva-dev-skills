--
--
-- Description:
-- Initialisation for spooler main bar form !!spooler
-- (can be replaced by method when !!spooler moves into PMLLIB)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
-- Arguments:
--   [1] [R] [FORM]   [Form tracking]
--   [2] [R] [STRING] [DB CE type]
--
------------------------------------------------------------------------

-- Define function
define function !!splMainBarInit(!dummyForm is FORM, !dummyAction is STRING)

  if (defined(!!spooler)) then
    -- construct (can be removed when !!spooler moves into PMLLIB)
    if (!!spooler.shown.unset()) then
      !!splMainBarConstr()
      !!spooler.shown = true
    endif

    -- Build the active list option
    if (defined(!!spooler.list)) then
      !listForm = !!cdcList
      !!spooler.list.dText = !listForm.name.dText
      !!spooler.list.rText = !listForm.name.rText
      !!spooler.list.val = !listForm.name.val
      handle any
      endhandle
    endif

    -- initiate tracking
    if (!!ce.dbType eq 'ISOD') then
      !!spooler.functions.track(!!spooler, 'ISODCE')
      --!!splMainBarTrack(!!spooler, 'ISODCE')
    else
      !!spooler.functions.track(!!spooler, 'DESICE')
      -- !!splMainBarTrack(!!spooler, 'DESICE')
    endif
  endif

endfunction
-- End of function definition for !!splMainBarInit
