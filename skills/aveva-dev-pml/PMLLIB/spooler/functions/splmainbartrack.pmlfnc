--
--
-- Description:
-- CE tracking for spooler main bar form !!spooler
-- (can be replaced by method when !!spooler moves into PMLLIB)
--
------------------------------------------------------------------------
-- Author  Date        Ref                  Reason
-- ------  ----------  -------------------  ----------------------------
-- NJSB    05/09/2007  HPD0036076/DFN11541  Set Search Within constraint
-- NJSB    23/11/2007  HPD0036076/DFN11541  Code moved to splcreate.pmlfrm
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [FORM]   [Form tracking]
--   [2] [R] [STRING] [DB CE type]
--
------------------------------------------------------------------------

-- Define function
define function !!splMainBarTrack(!form is FORM, !dummyType is STRING)

  -- Setup of dynamic gadgets on form:
  -- Dynamic gadgets are changed depending on the database type and the element
  -- type, initially an object is returned from a function specific to the
  -- element type that is current on the form, the object is then modified
  -- for the current database type, and static items are added.  The object
  -- is then transferred to the form.

  !element = !!ce
  !mtoStatusTypes = 'SPLDRG SPOOL FIELD PIPE BRAN'
  !lowerSplTypes = 'SPOOL FIELD JNTGRP IJOINT WLDGRP IWELD RWELD AWELD AITEMS'

  -- Isodraft DB elements
  if (!element.dbType eq 'ISOD') then
    if (!form.isodBar.not()) then
      !form.bar.setFieldProperty('CreateMenu', 'VISIBLE', true)
      !form.bar.setFieldProperty('ModifyMenu', 'VISIBLE', true)
      !form.bar.setFieldProperty('DeleteMenu', 'VISIBLE', true)
      !form.bar.setFieldProperty('NumberMenu', 'VISIBLE', true)
    endif
    !form.isodBar = true
    !form.desiBar = false

    -- Determine active menus for Isodraft DB elements
    -- Hierarchy modify is set on type then checked below for member counts
    if (!element.type eq 'WORL') then

      !createIdept = true
      !createIregi = false
      !createSpldrg = false
      !modActive = false
      !includeActive = true
      !reverseActive = (!element.members.size() gt 1)
      !reorderActive = (!element.members.size() gt 1)
      !delActive = false
      !numActive = false

    elseif (!element.type eq 'ISODEP') then

      !createIdept = true
      !createIregi = true
      !createSpldrg = false
      !modActive = true
      !includeActive = true
      !reverseActive = (!element.members.size() gt 1)
      !reorderActive = (!element.members.size() gt 1)
      !delActive = true
      !numActive = false

    elseif (!element.type eq 'ISOREG') then

      !createIdept = true
      !createIregi = true
      !createSpldrg = true
      !modActive = true
      !includeActive = true
      !reverseActive = (!element.members.size() gt 1)
      !reorderActive = (!element.members.size() gt 1)
      !delActive = true
      !numActive = false

    elseif (!element.type eq 'SPLDRG') then

      !createIdept = true
      !createIregi = true
      !createSpldrg = true
      !modActive = true
      !includeActive = false
      !reverseActive = false
      !reorderActive = false
      !delActive = true
      !numActive = true

    elseif (!lowerSplTypes.occurs(!element.type) gt 0) then

      !createIdept = true
      !createIregi = true
      !createSpldrg = true
      !modActive = true
      !includeActive = false
      !reverseActive = false
      !reorderActive = false
      !delActive = false
      !numActive = true

    else

      !createIdept = false
      !createIregi = false
      !createSpldrg = false
      !modActive = false
      !includeActive = false
      !reverseActive = false
      !reorderActive = false
      !delActive = false
      !numActive = false

    endif

    -- Create menu future dynamic building
    -- !form.createMenu.clear()
    -- if (!createIdept) then
    --   !form.createMenu.add('callback', 'Department...', |!!splCreate('ISODEP')|)
    -- endif
    -- if (!createIregi) then
    --   !form.createMenu.add('callback', 'Registry...', |!!splCreate('ISOREG')|)
    -- endif
    -- if (!createSpldrg) then
    --   !form.createMenu.add('callback', 'Spool Drawing...', |!!splCreate('SPLDRG')|)
    -- endif
    -- if (!createWeld) then
    --   !form.createMenu.add('separator')
    --   !form.createMenu.add('form', 'Weld...', 'splCreatWeld')
    -- endif

    -- Create menu activation
    !form.createMenu.setActive('Department...', !createIdept)
    !form.createMenu.setActive('Registry...', !createIregi)
    !form.createMenu.setActive('Spool Drawing...', !createSpldrg)
    !form.createMenu.setActive('Weld...', true)
    !form.createMenu.setActive('Spool Break', true)
    !form.createMenu.setActive('Spool Break PA', false)
    !form.createMenu.setActive('Spool Break PL', false)
    !form.createMenu.setActive('Spool Break OFF', false)

    -- Modify menu activation
    !form.modifyMenu.setActive('Name...', !modActive)
    !form.modifyMenu.setActive('Attributes...', !modActive)
    !form.modifyMenu.setActive('Lock...', !modActive)
    !form.modifyMenu.setActive('SPLDRG Order', true)
    !form.modifyMenu.setActive('MTO Status...', (!mtoStatusTypes.match(!element.type) gt 0))
    !form.modifyMenu.setActive('Shop/Field...', false)
    !form.modifyMenu.setActive('Detail Plotfile...', false)
    !form.modifyMenu.setActive('Attached Welds...', false)

    -- Modify hierarchy activation
    !form.modHierarchy.setActive('Include...', !includeActive)
    !form.modHierarchy.setActive('Reverse Order', !reverseActive)
    !form.modHierarchy.setActive('Reorder...', !reorderActive)
    !form.modifyMenu.setActive('Hierarchy', (!includeActive or !reverseActive or !reorderActive))

    -- Delete menu activation
    !form.deleteMenu.setActive('CE', (!delActive or !element.type eq 'SPLTMP'))
    if (defined(!form.deleteCe)) then
      !form.deleteCe.active = (!delActive or !element.type eq 'SPLTMP')
    endif
    !form.deleteMenu.setActive('Name...', !delActive)
    !form.deleteMenu.setActive('Members', (!element.members.set() and !element.type ne 'SPLTMP'))
    !form.deleteMenu.setActive('Spool Break', true)
    !form.deleteMenu.setActive('Spool Break PA', false)
    !form.deleteMenu.setActive('Spool Break PL', false)
    !form.deleteMenu.setActive('Spool Break OFF', false)

    -- suppress delete members all at world
    !form.delMembers.setActive('All', !element.type ne 'WORL')

    -- suppress delete actions during interactive update
    if (defined(!!splInteractive)) then
      if (!!splInteractive.shown()) then
        !!splMainBarCntrl('nodelete')
      endif
    endif

    -- suppress delete and hierarchy actions during include and reorder
    if (defined(!!splMemInclu)) then
      if (!!splMemInclu.shown()) then
        !!splMainBarCntrl('nodelete nohierarchy')
      endif
    endif
    if (defined(!!splMemReord)) then
      if (!!splMemReord.shown()) then
        !!splMainBarCntrl('nodelete nohierarchy')
      endif
    endif

    -- Number menu activation
    !form.numberMenu.setActive('Renumber...', !numActive)
    !form.numberMenu.setActive('Update...', !numActive)
    !form.numberMenu.setActive('Check...', !numActive)

  -- Design db elements
  elseif (!element.dbType eq 'DESI') then
    if (!form.desiBar.not()) then
      !form.bar.setFieldProperty('CreateMenu', 'VISIBLE', true)
      !form.bar.setFieldProperty('ModifyMenu', 'VISIBLE', true)
      !form.bar.setFieldProperty('DeleteMenu', 'VISIBLE', true)
      !form.bar.setFieldProperty('NumberMenu', 'VISIBLE', false)
    endif
    !form.isodBar = false
    !form.desiBar = true

    -- Future dynamic building of create menu
    -- !form.createMenu.clear()
    -- !form.createMenu.add('form', 'Field Weld...', 'splFieldWeld')

    -- Create menu activation
    !form.createMenu.setActive('Department...', false)
    !form.createMenu.setActive('Registry...', false)
    !form.createMenu.setActive('Spool Drawing...', false)
    !form.createMenu.setActive('Weld...', true)
    !form.createMenu.setActive('Spool Break', true)
    !form.createMenu.setActive('Spool Break PA', true)
    !form.createMenu.setActive('Spool Break PL', true)
    !form.createMenu.setActive('Spool Break OFF', true)

    -- Modify menu activation (beware of owner check for world)
    !form.modifyMenu.setActive('Name...', ((!element.type eq 'WELD') or (!element.type eq 'ATTA')))
--PAB
    !form.modifyMenu.setActive('Attributes...', true)
    !form.modifyMenu.setActive('Lock...', true)
--PAB
--    !form.modifyMenu.setActive('Attributes...', ((!element.type eq 'WELD') or (!element.type eq 'ATTA')))
--    !form.modifyMenu.setActive('Lock...', ((!element.type eq 'WELD') or (!element.type eq 'ATTA')))
--PAB
    !form.modifyMenu.setActive('Hierarchy', false)
    !form.modifyMenu.setActive('SPLDRG Order', true)
    if (!element.type eq 'WORL') then
      !form.modifyMenu.setActive('MTO Status...', false)
      !form.modifyMenu.setActive('Shop/Field...', false)
      !form.modifyMenu.setActive('Detail Plotfile...', false)
      !form.modifyMenu.setActive('Attached Welds...', false)
    else
      !form.modifyMenu.setActive('MTO Status...', (!element.owner.type eq 'BRAN' or !mtoStatusTypes.match(!element.type) gt 0))
      !form.modifyMenu.setActive('Shop/Field...', (!element.owner.type eq 'BRAN'))
      !form.modifyMenu.setActive('Detail Plotfile...', (!element.owner.type eq 'BRAN'))
      !form.modifyMenu.setActive('Attached Welds...', (!element.owner.type eq 'BRAN'))
    endif

    -- Delete menu activation
    !form.deleteMenu.setActive('CE', (!element.type eq 'WELD'))
    if (defined(!form.deleteCe)) then
      !form.deleteCe.active = (!element.type eq 'WELD')
    endif
    !form.deleteMenu.setActive('Name...', false)
    !form.deleteMenu.setActive('Members', false)
    !form.deleteMenu.setActive('Spool Break', true)
    !form.deleteMenu.setActive('Spool Break PA', true)
    !form.deleteMenu.setActive('Spool Break PL', true)
    !form.deleteMenu.setActive('Spool Break OFF', true)

  -- All other dbs
  else
    if (!form.isodBar or !form.desiBar) then
      !form.bar.setFieldProperty('CreateMenu', 'VISIBLE', false)
      !form.bar.setFieldProperty('ModifyMenu', 'VISIBLE', false)
      !form.bar.setFieldProperty('DeleteMenu', 'VISIBLE', false)
      !form.bar.setFieldProperty('NumberMenu', 'VISIBLE', false)
      !form.isodBar = false
      !form.desiBar = false
    endif
  endif

endfunction
-- End of function definition for !!splMainBarTrack
