--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Tue Jun 16 12:41:28 BST 1998
--
--
-- Description:
-- Get list of components/tubes in splDrg
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [Spldrg]
-- Return:
--   [ARRAY] [Splmembers array of dbrefs]
--
------------------------------------------------------------------------

define function !!splMem(!splDrg is DBREF) is ARRAY

  !splMem = ARRAY()

  -- collect spool and field members
  if (!splDrg.type eq 'SPLDRG') then
    do !member values !splDrg.members
      if (!member.type eq 'SPOOL' or !member.type eq 'FIELD') then
        !splMem.appendArray(!member.splMem)
      endif
    enddo
  endif

  -- remove welds which can appear in splmem array but have no part number
  do !i indices !splMem
    if (!splMem[!i].type eq 'WELD') then
      !splMem[!i].delete()
    endif
  enddo
  !splMem.compress()

  return !splMem

endfunction
-- End of function definition for !!splMem
