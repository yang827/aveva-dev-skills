--
-- Description:
-- Modify spooler element attributes
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
--
------------------------------------------------------------------------

-- Define function
define function !!splModify()

  -- Show appropriate attributes form (force re-initialisation)
  if (!!ce.type eq 'ISODEP') then
    if (defined(!!splAttIsodep)) then
      !!splAttIsodep.hide()
    endif
    show !!splAttIsodep

  elseif (!!ce.type eq 'ISOREG') then
    if (defined(!!splAttIsoreg)) then
      !!splAttIsoreg.hide()
    endif
    show !!splAttIsoreg

  elseif (!!ce.type eq 'WELD') then
    if (defined(!!splAttWeld)) then
      !!splAttWeld.hide()
    endif
    show !!splAttWeld

  elseif (!!ce.type eq 'ATTA') then
    if (defined(!!splAttAtta)) then
      !!splAttAtta.hide()
    endif
    show !!splAttAtta

  elseif (!!ce.dbtype eq 'DESI') then
    if (defined(!!catModifyAttribs)) then
      !!catModifyAttribs.hide()
    endif
    show !!catModifyAttribs

  -- Form will try to navigate to a splDrg
  else
    if (defined(!!splModify)) then
      !!splModify.hide()
    endif
    show !!splModify

    -- display numbering data if form shown and we started at appropriate element
    if (!!splModify.specificObject.unset().not()) then
      !!splModify.modify(!!splModify.specificObject, !!splModify.objectModify)
    endif

  endif

endfunction
-- End of function definition for !!splModify
