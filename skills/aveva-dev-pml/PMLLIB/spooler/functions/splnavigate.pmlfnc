--
--
-- Description:
-- Function to navigate to picked element
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element picked]
--   [2] [R] [STRING] [Tubing indicator]
--
------------------------------------------------------------------------

-- Define function
define function !!splNavigate(!element is DBREF, !pickType is STRING)

  if (!pickType eq 'TUBING') then
    !!ce = ILEAVE TUBE OF $!element
  else
    !!ce = !element
  endif

endfunction
-- End of function definition for !!splNavigate
