--
-- Author:          M.Lewis
-- Created:         Fri Jul 3 11:15:31 BST 1998
--
--
-- Description:
-- Get connected component data
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [piping component]
--   [2] [R] [REAL]  [ppoint number]
-- Return:
--   [ARRAY] [connected component description, dbref, ppoint number]
--
------------------------------------------------------------------------

define function !!splPcref(!component is DBREF, !pPoint is REAL) is ARRAY

  !data = ARRAY()

  -- attribute contents is 4 reals, dbref[1], dbref[2], tube flag, ppoint
  !pcrefData = !component.pcref[!pPoint]
  -- nozzle ppoints are encoded negative
  !number = !pcrefData[4].abs()
  !ref = '=' & !pcrefData[1] & '/' & !pcrefData[2]
  if (!ref eq '=0/0') then
    !data.append('unset')
    !data.append(OBJECT DBREF())
    !data.append(0)
  else
    if (!pcrefData[3] eq 710633) then
      !dbRef = ILEAVE TUBE OF $!ref
    else
      !dbRef = !ref.dbRef()
    endif
    !data.append('P' & !number & ' of ' & !dbRef.fullName)
    !data.append(!dbRef)
    !data.append(!number)
  endif

  return !data

endfunction
-- End of function definition for !!splPcref
