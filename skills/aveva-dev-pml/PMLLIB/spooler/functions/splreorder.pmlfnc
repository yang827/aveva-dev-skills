--
-- Description:
-- Pick component to reorder splDrg from
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
--
------------------------------------------------------------------------

-- Define function
define function !!splReorder()

  -- splDrg reorder functionality is accessed from global object
  if (not defined(!!splReorder)) then
    !!comDefineGlobal(OBJECT SPLREORDER())
  endif

  -- activate EDG for splDrg reorder
  !!splReorder.start()

endfunction
-- End of function definition for !!splReorder
