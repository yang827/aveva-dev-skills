-- Created:         Tue Apr 28 07:44:31 BST 1998
--
--
-- Description:
-- Add/remove a spool break
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [STRING] [add/remove]
--
------------------------------------------------------------------------

-- Define function
define function !!splSfBreak(!mode is STRING)

  -- sfbreak functionality is accessed from global object
  if (not defined(!!splSfBreak)) then
    !!comDefineGlobal(OBJECT SPLSFBREAK())
  endif

  -- activate EDG for add/remove spool break
  if (!mode.upcase() eq 'ADD') then
    !!splSfBreak.add()
  elseif (!mode.upcase() eq 'ADDPA') then
    !!splSfBreak.addPA()
  elseif (!mode.upcase() eq 'ADDPL') then
    !!splSfBreak.addPL()
  elseif (!mode.upcase() eq 'ADDPO') then
    !!splSfBreak.addPO()
  elseif (!mode.upcase() eq 'REMOVE') then
   !!splSfBreak.remove()
  elseif (!mode.upcase() eq 'REMOVEPA') then
    !!splSfBreak.removePA()
  elseif (!mode.upcase() eq 'REMOVEPL') then
    !!splSfBreak.removePL()
  elseif (!mode.upcase() eq 'REMOVEPO') then
    !!splSfBreak.removePO()
  endif

endfunction
-- End of function definition for !!splSfBreak
