-- File:            splwelddata.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Fri Jul 3 10:55:36 BST 1998
--
--
-- Description:
-- Get weld data for IWELD/RWELD/AWELD
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF]         [IWELD/RWELD/AWELD]
--   [2] [R] [SplMtoOptions] [mto options]
-- Return:
--   [ARRAY] [Weld data: BORE     bore                                ]
--           [           STRING   ckey BW or SW                       ]
--           [           BOOLEAN  olet to header weld flag            ]
--           [           BOOLEAN  shop flag                           ]
--           [           STRING   spoolnumber                         ]
--           [           DBREF    design data ref                     ]
--           [           REAL     implied ppoint/attached weld number ]
--
------------------------------------------------------------------------

define function !!splWeldData(!weld is DBREF, !options is SPLMTOOPTIONS) is ARRAY

  -- default values
  !returnData  = ARRAY()
  !size        = object BORE()
  !cKey        = 'BW'
  !oletHdrWeld = false
  !shop        = false
  !spoolNumber = STRING()
  !ref         = object DBREF()
  !number      = REAL()

  if (!weld.type eq 'IWELD') then

    -- implied weld data
    !data = !!splIwdOwners(!weld)
    !ref = !data[2]
    !number = !data[3]
    if (!ref.type eq 'TUBI') then
      !ref = !data[5]
      !number = !data[6]
    endif
    !cKey = !weld.cKey

    -- shop and spoolnumber (check both sides in same spool)
    if (!data[2].sfref.set() and !data[5].sfref.set()) then
      if (!data[2].sfref eq !data[5].sfref) then
        if (!ref.sfref.type eq 'SPOOL') then
          !shop = true
          !spoolNumber = !ref.sfref.splPrefix & !ref.sfref.splNumber
        endif
      endif
    endif

    -- check for olet to header weld
    if (!ref.type eq 'OLET' or !ref.type eq 'TEE') then
      if (!options.oletSkeys.findFirst(!ref.detRef.skey.subString(1,2)).set()) then
        if (!number lt 3) then
          !oletHdrWeld = true
        endif
      endif
    endif

    -- weld size for olet is closer to P3 than P1
    if (!oletHdrWeld) then
      !size = !ref.ppBore[3]
    else
      !size = !ref.ppBore[1]
    endif

  elseif (!weld.type eq 'AWELD') then

    -- attached weld data
    !data = !!splAwdOwner(!weld)
    !ref = !data[2]
    !number = !data[3]
    !size = !ref.ppBore[1]
    !cKey = 'BW'

    -- shop and spoolnumber
    if (!ref.sfref.set()) then
      if (!ref.sfref.type eq 'SPOOL') then
        !shop = true
        !spoolNumber = !ref.sfref.splPrefix & !ref.sfref.splNumber
      endif
    endif

  elseif (!weld.type eq 'RWELD') then

    -- real weld data
    !ref = !weld.rwdowner
    !cKey = 'BW'

    -- spoolnumber
    if (!ref.sfref.set()) then
      if (!ref.sfref.type eq 'SPOOL') then
        !shop = true
        !spoolNumber = !ref.sfref.splPrefix & !ref.sfref.splNumber
      endif
    endif

    do !pPoint to 2

      -- connected item data returned is description, dbref, ppoint
      !connData = !!splPcref(!ref, !pPoint)

      -- check for socket weld
      if (!connData[2].type ne 'TUBI' and !connData[2].owner.type eq 'BRAN') then
        !dbPos = !!ce
        !!ce = !connData[2]
        var !skeyData COMPSKEYS $!connData[3]
        !!ce = !dbPos
        -- pskey in word 3 overrides skey connection type in word 2
        !connSkey = !skeyData.part(3)
        if (!connSkey eq 'NULL') then
          !connSkey = !skeyData.part(2)
        endif
        if (!connSkey eq 'SW') then
          !cKey = 'SW'
        endif
      endif

      -- check for olet to header weld
      if (!connData[2].type eq 'OLET' or !connData[2].type eq 'TEE') then
        if (!options.oletSkeys.findFirst(!connData[2].detRef.skey.subString(1,2)).set()) then
          if (!connData[3] lt 3) then
            !olet = !connData[2]
            !oletHdrWeld = true
          endif
        endif
      endif

    enddo

    -- weld size for olet is closer to P3 than P1
    if (!oletHdrWeld) then
      !size = !olet.ppBore[3]
    else
      !size = !ref.ppBore[1]
    endif

  endif

  -- return values
  !returnData.append(!size)
  !returnData.append(!cKey)
  !returnData.append(!oletHdrWeld)
  !returnData.append(!shop)
  !returnData.append(!spoolNumber)
  !returnData.append(!ref)
  !returnData.append(!number)
  return !returnData

endfunction
-- End of function definition for !!splWeldData
