--
--
-- Description:
-- Get list of welds in splDrg
--
--  ** NOTE ** this function is called by user appware
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [DBREF] [Spldrg]
-- Return:
--   [ARRAY] [Welds array of dbrefs]
--
------------------------------------------------------------------------

define function !!splWelds(!splDrg is DBREF) is ARRAY

  !splWelds = ARRAY()

  -- add all members of the weld group to the element list
  if (!splDrg.type eq 'SPLDRG') then
    do !member values !splDrg.members
      if (!member.type eq 'WLDGRP') then
        !splWelds.appendArray(!member.members)
        break
      endif
    enddo
  endif

  return !splWelds

endfunction
-- End of function definition for !!splWelds
