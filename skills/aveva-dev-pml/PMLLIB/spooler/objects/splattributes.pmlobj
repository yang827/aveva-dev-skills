--
-- Author:          C.Brown
-- Created:         Thu Oct 30 08:05:46 GMT 1997
--
--
-- Description:
-- object to hold attribute data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAttList(DBREF,STRING,STRING)  -                   Get attribute list from an element
--  getAttributes(DBREF)             SPLATTRIBUTES       Get designated attributes from an element
--  getAttributes(DBREF,STRING,STRING) SPLATTRIBUTES       Get designated attributes from an element
--
------------------------------------------------------------------------

-- Define object
define object SPLATTRIBUTES

  -- type of element for which attribute list has been built
  member .type is STRING

  -- list of attributes required (all strings)
  member .attributes is ARRAY

  -- values for attributes (mixed data types)
  member .values is ARRAY

endobject
-- End of object definition for SPLATTRIBUTES

------------------------------------------------------------------------
--
-- Method:      !getAttList()
--
-- Description: Get attribute list from an element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to retrieve attributes from]
--   [2] [R] [STRING] [name of numbering attribute to be first in list]
--   [3] [R] [STRING] [name of list/ref attribute to be last in list]
--
------------------------------------------------------------------------

-- Define method
define method .getAttList(!element is DBREF, !firstInList is STRING, !lastInList is STRING)

  -- check if we have already built attribute list for this type
  if (!this.type.set()) then
    if (!element.type eq !this.type) then
      return
    endif
  endif

  -- initialise attribute info
  !this.type = !element.type
  !this.attributes = ARRAY()

  -- check for unset first and last specifiers
  if (!firstInList.unset()) then
    !firstAtt = ''
  else
    !firstAtt = !firstInList
  endif
  if (!lastInList.unset()) then
    !lastAtt = ''
  else
    !lastAtt = !lastInList
  endif

  -- set spl/wld/jntnumber attribute at top of list
  if (!firstAtt ne '') then
    !testAtt = !element.attribute(!firstAtt)
    -- ignore if not available
    handle any
    elsehandle none
      !this.attributes.append(!firstAtt)
      !testAtt.delete()
    endhandle
  endif

  -- loop through all the attributes of the element and select
  -- attributes that can be copied between elements.
  do !attribute values !element.attributes()

    -- special case attributes handled outside loop
    skip if (!attribute.upcase() eq !firstAtt.upcase() or !attribute.upcase() eq !lastAtt.upcase())

    -- workaround for missing query text
    skip if (!attribute.trim() eq '')

    if (!attribute.subString(1, 1) eq ':') then

      -- case for UDA's, all attributes except array attributes are copied
      !attCheck = !element.attribute(!attribute)
      if (!attCheck.objectType() ne 'ARRAY') then
        !this.attributes.append(!attribute)
      endif
      !attCheck.delete()

    else

      -- case for standard attributes, all attributes except DBREF and array
      -- attributes are copied
      !attCheck = !element.attribute(!attribute)
      if (!attCheck.objectType() ne 'DBREF' and !attCheck.objectType() ne 'ARRAY') then

        -- an additional case for standard attributes, is not to copy
        -- TYPE or LOCK attributes, LOCK may be copied in a future release
        -- also SPLCHG is not modifiable by the user
        if (!attribute.upcase() ne 'TYPE' and !attribute.upcase() ne 'LOCK' and $
            !attribute.upcase() ne 'SPLCHG') then
          !this.attributes.append(!attribute)
        endif

      endif

      -- !attCheck may contain different data types so delete it here
      !attCheck.delete()

    endif

  enddo

  -- set list/ref attribute at end of list
  if (!lastAtt ne '') then
    !testAtt = !element.attribute(!lastAtt)
    -- ignore if not available
    handle any
    elsehandle none
      !this.attributes.append(!lastAtt)
    endhandle
  endif

endmethod
-- End of method definition for .getAttList(DBREF, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !getAttributes()
--
-- Description: Get designated attributes from an element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to retrieve attributes from]
-- Return:
--   [SPLATTRIBUTES] [Arrays of attributes and names]
--
------------------------------------------------------------------------

-- Define method
define method .getAttributes(!element is DBREF) is SPLATTRIBUTES

  -- build attribute list if necessary
  !this.getAttList(!element, STRING(), STRING())

  -- build corresponding values list
  !this.values = ARRAY()
  do !attribute values !this.attributes
    -- avoid references (still need 'Name' not 'Fullname' in attribute list)
    if (!attribute.upcase() ne 'NAME') then
      !this.values.append(!element.attribute(!attribute))
    else
       if (substring(!element.namn,1,1) EQ '=') then
          !this.values.append('unset')
       else
          !this.values.append(!element.namn)
       endif
    endif
  enddo

  return !this

endmethod
-- End of method definition for .getAttributes(DBREF) SPLATTRIBUTES

------------------------------------------------------------------------
--
-- Method:      !getAttributes()
--
-- Description: Get designated attributes from an element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to retrieve attributes from]
--   [2] [R] [STRING] [name of numbering attribute to be first in list]
--   [3] [R] [STRING] [name of list/ref attribute to be last in list]
-- Return:
--   [SPLATTRIBUTES] [Arrays of attributes and names]
--
------------------------------------------------------------------------

-- Define method
define method .getAttributes(!element is DBREF, !firstInList is STRING, !lastInList is STRING) is SPLATTRIBUTES

  -- build attribute list if necessary
  !this.getAttList(!element, !firstInList, !lastInList)

  -- build corresponding values list
  !this.values = ARRAY()
  do !attribute values !this.attributes
    -- omit actual value of list/ref attribute
    if (!attribute ne !lastInList) then
      -- avoid references (still need 'Name' not 'Fullname' in attribute list)
      if (!attribute.upcase() ne 'NAME') then
        !this.values.append(!element.attribute(!attribute))
      else
         if (substring(!element.namn,1,1) EQ '=') then
            !this.values.append('unset')
         else
            !this.values.append(!element.namn)
      endif
      endif
    else
      !this.values.append('List...')
    endif
  enddo

  return !this

endmethod
-- End of method definition for .getAttributes(DBREF, STRING, STRING) SPLATTRIBUTES
