-- Method:      !validate()
--
-- Description: validate string attribute from user input
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to set attribute on]
--   [2] [R] [STRING] [Attribute]
--   [3] [R] [STRING] [Value]
-- Return value:
--   [BOOLEAN]  [True if validated]
--
------------------------------------------------------------------------

-- Define method
define method .validate(!element is DBREF, !attribute is STRING, !value is STRING) is BOOLEAN

  return !this.common.validate(!element, !attribute, !value)

endmethod
-- End of method definition for .validate(DBREF, STRING, STRING) BOOLEAN

