--
--
-- Description:
-- Bend numbering functionality
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignTidy()                      -                   remove spltmp after align
--  ce(DBREF)                        -                   sets the !this.common.ce object member
--  check()                          ARRAY               check bend numbers
--  erase()                          -                   erases bend numbers from part elements
--  getAttributes(DBREF)             SPLATTRIBUTES       Gets designated attributes from an element for asbuilt
--  highlight(DBREF)                 -                   Highlight the selected element
--  listMembers()                    ARRAY               Returns a list of elements to be updated, used in asbuilt mode only
--  renumber()                       -                   renumbers bend elements
--  setAttribute(DBREF,STRING,BOOLEAN) -                   boolean attribute setting from user input
--  setAttribute(DBREF,STRING,REAL)  -                   real attribute setting from user input
--  setAttribute(DBREF,STRING,STRING) -                   string attribute setting from user input
--  splBendN()                       -                   Constructor
--  start()                          -                   Initialise the object for update
--  trackSelect()                    DBREF               Get list member derived from CE for modify
--  unhighlight()                    -                   unhighlight the selected element
--  update()                         -                   update bend numbering
--  updateReqd()                     BOOLEAN             Check if update of numbering is required
--  updatingText()                   STRING              Return prompt text for updating
--  validate(DBREF,STRING,BOOLEAN)   BOOLEAN             validate boolean attribute from user input
--  validate(DBREF,STRING,REAL)      BOOLEAN             validate real attribute from user input
--  validate(DBREF,STRING,STRING)    BOOLEAN             validate string attribute from user input
--
------------------------------------------------------------------------

-- Define object
define object SPLBENDN

  -- common numbering functionality
  member .common is SPLCOMMONN

  -- stores element marked
  member .markedElement is DBREF

  -- interactive form title text
  member .formTitleText is STRING

  -- element list title text
  member .elementListText is STRING

endobject
-- End of object definition for SPLBENDN

------------------------------------------------------------------------
--
-- Method:      !splBendN()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splBendN()

  -- numbering attributes: cross ref, number, max, prefix
  !this.common.setAtts(STRING(), 'PBendNumber', 'Bmaximum', STRING())

  -- initialise strings for the !!splInteractive form
  !this.formTitleText   = 'Bend Numbers'
  !this.elementListText = 'Pulled Bend numbers'

endmethod
-- End of method definition for .splBendN()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: sets the !this.common.ce object member
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to link object to]
--
------------------------------------------------------------------------

-- Define method
define method .ce(!element is DBREF)

  !this.common.ce(!element)

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      !erase()
--
-- Description: erases bend numbers from part elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .erase()

  -- collect element list and perform erase
  !this.start()
  !this.common.erase()

endmethod
-- End of method definition for .erase()

------------------------------------------------------------------------
--
-- Method:      !check()
--
-- Description: check bend numbers
--
-- Method Type: Function
-- Return:
--   [ARRAY] [Array of messages resulting from check]
--
------------------------------------------------------------------------

-- Define method
define method .check() is ARRAY

  -- initialise return data
  !returnData = ARRAY()
  !maxBendNum = 0

  -- start the update process
  !this.start()

  -- collect bendNumber data
  !getBendNum = object BLOCK('!this.common.elementList[!evalIndex].pBendNumber')
  !bendNumbers = !this.common.elementList.evaluate(!getBendNum)

  -- pBendNumbers are derived attributes and return unset instead of zero
  do !i indices !bendNumbers
    if (!bendNumbers[!i].unset()) then
      !bendNumbers[!i] = 0
    endif
  enddo

  -- check bend numbers
  do !i indices !this.common.elementList

    -- store max bendNum found
    !maxBendNum = MAX(!maxBendNum, !bendNumbers[!i])

    if (!bendNumbers[!i] eq 0) then
      -- 'Bend number required at #name'
      !returnData.append(!!messageFile.messageString(154, 80, !this.common.elementList[!i].fullName))
    elseif (!bendNumbers[!i] lt 0) then
      -- 'Illegal value for bend number at #name'
      !returnData.append(!!messageFile.messageString(154, 81, !this.common.elementList[!i].fullName))
    elseif (!bendNumbers[!i] ne 0) then
      !duplicates = !bendNumbers.find(!bendNumbers[!i])
      if (!duplicates.size() gt 1) then
        -- duplicate bend number reported on second and subsequent occurrences
        if (!i gt !duplicates[1]) then
          -- 'Duplicate bend numbers at #name and #name'
          !returnData.append(!!messageFile.messageString(154, 82, !this.common.elementList[!duplicates[1]].fullName, !this.common.elementList[!i].fullName))
        endif
      endif
    endif
  enddo

  -- check bmax of splDrg
  if (!maxBendNum gt !this.common.ce.bmaximum) then
    -- 'Bmaximum should be #real at #name'
    !returnData.append(!!messageFile.messageString(154, 83, !maxBendNum, !this.common.ce.fullName))
  endif

  -- append ok message if no errors found
  if (!returnData.size() eq 0) then
    -- 'No errors in bend numbering'
    !returnData.append(!!messageFile.messageString(154, 84))
  endif

  return !returnData

endmethod
-- End of method definition for .check() ARRAY

------------------------------------------------------------------------
--
-- Method:      !renumber()
--
-- Description: renumbers bend elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .renumber()

  -- erase the existing numbers
  !this.erase()

  -- assign new bendNumbers
  !this.update()

endmethod
-- End of method definition for .renumber()

------------------------------------------------------------------------
--
-- Method:      !update()
--
-- Description: update bend numbering
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- start the update process
  !this.start()

  -- get bmax of splDrg
  !bmax = !this.common.ce.bmaximum

  -- update all bend numbers
  do !i indices !this.common.elementList
    !bendNumber = !this.common.elementList[!i].pBendNumber
    if (!bendNumber.unset()) then
      !bendNumber = 0
    endif
    if (!bendNumber eq 0) then
      !!ce = !this.common.elementList[!i]
      !bmax = !bmax + 1
      PBENDNUMBER $!bmax
    endif
  enddo

  -- set bmax of splDrg
  !!ce = !this.common.ce
  BMAXIMUM $!bmax

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      !updateReqd()
--
-- Description: Check if update of numbering is required
--
-- Method Type: Function
-- Return value:
--  [BOOLEAN]  [True if update is required]
--
------------------------------------------------------------------------

-- Define method
define method .updateReqd() is BOOLEAN

  -- check if bendNumbers need updating
  !results = !this.check()
  if (!results.size() eq 1) then
    -- compare to error message for no errors
    if (!results[1] eq !!messageFile.messageString(154, 84)) then
      return false
    endif
  endif

  -- errors found in check
  return true

endmethod
-- End of method definition for .updateReqd() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !updatingText()
--
-- Description: Return prompt text for updating
--
-- Method Type: Function
-- Return value:
--  [STRING]  [Prompt text]
--
------------------------------------------------------------------------

-- Define method
define method .updatingText() is STRING

  -- 'Updating bend numbers for #name'
  return !!messageFile.messageString(154, 149, !this.common.ce.fullName)

endmethod
-- End of method definition for .updatingText() STRING

------------------------------------------------------------------------
--
-- Method:      !alignTidy()
--
-- Description: remove spltmp after align
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .alignTidy()

  !this.common.alignTidy()

endmethod
-- End of method definition for .alignTidy()

------------------------------------------------------------------------
--
-- Method:      !start()
--
-- Description: Initialise the object for update
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .start()

  -- common numbering initialisation
  !this.common.start()

  -- add pulled bends to element list
  !this.common.elementList = !!splBends(!this.common.ce)

endmethod
-- End of method definition for .start()

------------------------------------------------------------------------
--
-- Method:      !getAttributes()
--
-- Description: Gets designated attributes from an element for asbuilt
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to retrieve attributes from]
-- Return:
--   [ARRAY] [Array of attribute names]
--
------------------------------------------------------------------------

-- Define method
define method .getAttributes(!element is DBREF) is SPLATTRIBUTES

  -- special version for bendNumbers, there is only pBendNumber
  !returnData = object SPLATTRIBUTES()
  !returnData.attributes.append('PBendNumber')
  !returnData.values.append(!element.pBendNumber)
  return !returnData

endmethod
-- End of method definition for .getAttributes(DBREF) SPLATTRIBUTES

------------------------------------------------------------------------
--
-- Method:      !listMembers()
--
-- Description: Returns a list of elements to be updated, used in asbuilt mode only
--
-- Method Type: Function
-- Return:
--   [ARRAY] [2 dimensional array holding Dtext & Rtext values]
--
------------------------------------------------------------------------

-- Define method
define method .listMembers() is ARRAY

  return !this.common.listMembers()

endmethod
-- End of method definition for .listMembers() ARRAY

------------------------------------------------------------------------
--
-- Method:      !highlight()
--
-- Description: Highlight the selected element
--
-- Method Type: Procedure
-- Arguments:
-- [1]  [R]  [DBREF]    [Element selected for highlighting]
--
------------------------------------------------------------------------

-- Define method
define method .highlight(!element is DBREF)

  -- reset display
  !this.unhighlight()

  -- highlight the selected element
  !highlightCol = !!gphColOpt.highlight()
  ENHANCE $!element COLOUR $!<highlightCol.code>

  -- mark the selected element
  !this.markedElement = !element
  MARK $!<this.markedElement>

endmethod
-- End of method definition for .highlight(DBREF)

------------------------------------------------------------------------
--
-- Method:      !unhighlight()
--
-- Description: unhighlight the selected element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .unhighlight()

  -- reset display
  UNENHANCE $!<this.common.ce>
  -- REPRESENTATION UPDATE

  -- unmark the previously marked element
  if (!this.markedElement.set()) then
    if (!this.markedElement.badRef().not()) then
      UNMARK $!<this.markedElement>
    endif
    !this.markedElement = object DBREF()
  endif

endmethod
-- End of method definition for .unhighlight()

------------------------------------------------------------------------
--
-- Method:      !trackSelect()
--
-- Description: Get list member derived from CE for modify
--
-- Method Type: Function
-- Return:
--   [DBREF] [List member to select]
--
------------------------------------------------------------------------

-- Define method
define method .trackSelect() is DBREF

  !returnData = object DBREF()

  -- Select CE if present in element list
  if (!this.common.elementList.findFirst(!!ce).set()) then
    !returnData = !!ce
  endif

  return !returnData

endmethod
-- End of method definition for .trackSelect() DBREF

------------------------------------------------------------------------
