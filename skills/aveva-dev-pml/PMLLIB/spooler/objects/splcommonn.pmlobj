-- Created:         Thu Mar 12 07:42:32 GMT 1998
--
--
-- Description:
-- Spooler common numbering functionality pseudo virtual base class
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignTidy()                      -                   remove spltmp after align
--  assignData(DBREF,DBREF)          -                   Pairs an element with a set of attribute data
--  assignData(DBREF,STRING)         -                   Pairs an element with a set of attribute data
--  assignToElement(DBREF,DBREF,SPLATTRIBUTES,REAL) -                   assigns a data set to an element
--  assigned(DBREF)                  BOOLEAN             check if element has already been assigned data
--  autoAssign()                     BOOLEAN             interactive update elements where no user selection required
--  ce(DBREF)                        -                   sets the !this.ce object member
--  checkData(DBREF)                 BOOLEAN             checks if a data element can be used
--  chooseData(DBREF,ARRAY,BOOLEAN)  DBREF               choose the data for an element
--  erase()                          -                   erases numbers from elements
--  getAttributes(DBREF)             SPLATTRIBUTES       Gets designated attributes from an element for update
--  getAttributes(DBREF,STRING,STRING) SPLATTRIBUTES       Gets designated attributes from an element
--  getData(DBREF)                   ARRAY               Get data that could be assigned to current element
--  listData(DBREF)                  ARRAY               Returns a list of data, used in interactive mode only
--  listElements()                   ARRAY               Returns a list of elements to be updated, used in interactive mode only
--  listMembers()                    ARRAY               Returns a list of elements to be updated, used in asbuilt mode only
--  merge()                          -                   Merge data from !this.newData to data in !this.newElements
--  nextNumber(BOOLEAN)              REAL                Returns the next spool/weld/joint number
--  renumber()                       -                   renumbers elements
--  setAttribute(DBREF,STRING,BOOLEAN) -                   boolean attribute setting from user input
--  setAttribute(DBREF,STRING,REAL)  -                   real attribute setting from user input
--  setAttribute(DBREF,STRING,STRING) -                   string attribute setting from user input
--  setAtts(STRING,STRING,STRING,STRING) -                   sets owning object specific attribute names
--  start()                          -                   Initialise the object for update
--  undo()                           -                   Undo operation for interactive update mode
--  update(BOOLEAN)                  -                   update element data and numbering
--  validate(DBREF,STRING,BOOLEAN)   BOOLEAN             validate boolean attribute from user input
--  validate(DBREF,STRING,REAL)      BOOLEAN             validate real attribute from user input
--  validate(DBREF,STRING,STRING)    BOOLEAN             validate string attribute from user input
--
------------------------------------------------------------------------

define object SPLCOMMONN

  -- stores the SPLDRG element that the object is linked to
  member .ce is DBREF

  -- cross reference attribute
  member .xrefAtt is STRING

  -- prefix attribute
  member .prefAtt is STRING

  -- number attribute
  member .numAtt is STRING

  -- maximum attribute
  member .maxAtt is STRING

  -- stores a list of spool/weld/joint elements
  member .elementList is ARRAY

  -- stores new element dbrefs that have been paired with old elements
  member .newElements is ARRAY

  -- stores old element dbrefs that have been paired with new elements
  member .oldElements is ARRAY

  -- stores SPLATTRIBUTES data for the new elements in .newElements
  member .newData is ARRAY

  -- stores the spool/weld/joint numbers that are paired with new elements
  member .numbers is ARRAY

  -- attribute lists (SPLATTRIBUTES) one per type
  member .attLists is ARRAY

endobject
-- End of object definition for SPLCOMMONN

------------------------------------------------------------------------
--
-- Method:      !setAtts()
--
-- Description: sets owning object specific attribute names
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [cross reference attribute]
--   [2] [R] [STRING] [number attribute]
--   [3] [R] [STRING] [maximum attribute]
--   [4] [R] [STRING] [prefix attribute]
--
------------------------------------------------------------------------

-- Define method
define method .setAtts(!xrefAtt is STRING, !numAtt is STRING, !maxAtt is STRING, !prefAtt is STRING)

  -- numbering attributes
  !this.xrefAtt = !xrefAtt
  !this.numAtt  = !numAtt
  !this.maxAtt  = !maxAtt
  !this.prefAtt = !prefAtt

endmethod
-- End of method definition for .setAtts(STRING, STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: sets the !this.ce object member
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to link object to]
--
------------------------------------------------------------------------

-- Define method
define method .ce(!value is DBREF)

  !this.ce = !value

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      !alignTidy()
--
-- Description: remove spltmp after align
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .alignTidy()

  SPOOLING REMOVESPLTMPS $!<this.ce>
  handle any
  endhandle

endmethod
-- End of method definition for .alignTidy()

------------------------------------------------------------------------
--
-- Method:      !start()
--
-- Description: Initialise the object for update
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
-- Author  Date        Ref                  Reason
-- ------  ----------  -------------------  ----------------------------
-- NJSB    10/07/2013  98353                Initialise global variables
------------------------------------------------------------------------

-- Define method
define method .start()

  -- clear object members must be cleared prior to collecting list
  !this.elementList.clear()
  !this.oldElements.clear()
  !this.newElements.clear()
  !this.newData.clear()
  !this.numbers.clear()

  !!snew = false
  !!smin = 0

endmethod
-- End of method definition for .start()

------------------------------------------------------------------------
--
-- Method:      !update()
--
-- Description: update element data and numbering
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [BOOLEAN] [always generate new data where choice is ambiguous]
--
------------------------------------------------------------------------
-- Author  Date        Ref                  Reason
-- ------  ----------  -------------------  ----------------------------
-- NJSB    22/01/2013  86780/S-43004        Re-use deleted Spool Numbers
------------------------------------------------------------------------

-- Define method
define method .update(!newData is BOOLEAN)

  -- set spool numbering options
  !!smin = 0
  !!snew = !newData
  -- choose from data available and assign it to new elements

  do !element values !this.elementList

    !dataElement = !this.chooseData(!element, !this.getData(!element), !newData)

    if (!dataElement.unset()) then
      !this.assignData(!element, 'NEW')
    else
      !this.assignData(!element, !dataElement)
    endif

  enddo

  -- apply new data to new elements
  !this.merge()

endmethod
-- End of method definition for .update(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !autoAssign()
--
-- Description: interactive update elements where no user selection required
--
-- Method Type: Function
-- Returns:
--   [BOOLEAN] [true if all elements assigned data]
--
------------------------------------------------------------------------

-- Define method
define method .autoAssign() is BOOLEAN

  -- choose from data available and assign it to new elements
  do !element values !this.elementList

    -- skip elements already assigned data
    -- this allows multiple calls to autoAssign as user selections are made
    skip if (!this.assigned(!element))

    -- get old elements from which data could be taken
    !dataElements = !this.getData(!element)

    if (!dataElements.empty()) then
      -- interactive update automatic with new data
      !this.assignData(!element, 'NEW')

    elseif (!dataElements.size() eq 1 and !dataElements[1].attribute(!this.xrefAtt).size() eq 1) then
      -- interactive update automatic with 1 for 1
      !this.assignData(!element, !dataElements[1])

    else
      -- interactive update requiring user selection
      skip

    endif

  enddo

  -- if no more assignments required apply new data to new elements
  if (!this.newElements.size() eq !this.elementList.size()) then
    !this.merge()
    return true
  else
    return false
  endif

endmethod
-- End of method definition for .autoAssign() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !renumber()
--
-- Description: renumbers elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
-- Author  Date        Ref                  Reason
-- ------  ----------  -------------------  ----------------------------
-- NJSB    22/01/2013  86780/S-43004        Re-use deleted Spool Numbers
------------------------------------------------------------------------

-- Define method
define method .renumber()

  -- erase the existing numbers
  !this.erase()

  -- set spool numbering options
  !!smin = 0
  !!snew = true

  -- assign new numbers (retain other data)
  do !element values !this.elementList
    !this.assignData(!element, 'NEW')
  enddo

  -- apply new data to new elements
  !this.merge()

endmethod
-- End of method definition for .renumber()

------------------------------------------------------------------------
--
-- Method:      !erase()
--
-- Description: erases numbers from elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .erase()

  -- check if splDrg has been issued
  if (!this.ce.issued) then
    -- 'Spool drawing has been issued - renumbering is not allowed'
    !!messageFile.error(154, 63)
  endif

  -- set s/w/jmax to 0
  !!ce = !this.ce
  $!<this.maxAtt> 0

  -- unset all spool/weld/joint/bend numbers
  do !element values !this.elementList
    !!ce = !element
    $!<this.numAtt> 0
    if ((!this.prefAtt.set()) and (!element.type.upcase() NE 'SPLDRG')) then
       $!<this.prefAtt> UNSET
    endif
  enddo

  -- restore db position to splDrg
  !!ce = !this.ce

endmethod
-- End of method definition for .erase()

------------------------------------------------------------------------
--
-- Method:      !getData()
--
-- Description: Get data that could be assigned to current element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [element to get data for]
-- Return:
--   [ARRAY] [Array of elements or SPLATTRIBUTES containing data for element]
--
------------------------------------------------------------------------

-- Define method
define method .getData(!element is DBREF) is ARRAY

  !dataList = ARRAY()

  !index = !this.newElements.findFirst(!element)
  if (!index.set()) then

    -- the element is in !this.newElements, so data has already been assigned
    -- to it, in this case the data is taken from the new element's SPLATTRIBUTES
    !dataList[1] = !this.newData[!index]

  else

    -- the element is not in !this.newElements so display all available data
    -- checking first that the data has not been assigned to another element,
    -- in this case the data is taken from one or many DBREFS
    !xrefArray = !element.attribute(!this.xrefAtt)
    do !oldSpl values !xrefArray

      -- Ref attribute may be invalid if something has prevented oldspl tidy up
      skip if (!oldSpl.badRef())

      if (!this.oldElements.findFirst(!oldSpl).unset()) then
        !dataList.append(!oldSpl)
      endif
    enddo

  endif

  return !dataList

endmethod
-- End of method definition for .getData(DBREF) ARRAY

------------------------------------------------------------------------
--
-- Method:      !nextNumber()
--
-- Description: Returns the next spool/weld/joint number
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [BOOLEAN] [set max value if true]
-- Return:
--   [REAL] [spool/weld/joint number]
--
------------------------------------------------------------------------

-- Define method
define method .nextNumber(!set is BOOLEAN) is REAL

  !nextVal = !this.ce.attribute(!this.maxAtt) + 1

  if (!set) then
    !!ce = !this.ce
    $!<this.maxAtt> $!nextVal
  endif

  return !nextVal

endmethod
-- End of method definition for .nextNumber(BOOLEAN) REAL

------------------------------------------------------------------------
--
-- Method:      !chooseData()
--
-- Description: choose the data for an element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]   [element to choose data for]
--   [2] [R] [ARRAY]   [data elements to choose from]
--   [3] [R] [BOOLEAN] [always generate new data where choice is ambiguous]
-- Return:
--   [DBREF] [chosen data element]
--
------------------------------------------------------------------------

-- Define method
define method .chooseData(!element is DBREF, !dataElements is ARRAY, !newData is BOOLEAN) is DBREF

  -- there are 5 distinct cases that need to be considered
  --   the first 2 are unambiguous and are used if possible
  --     (1) No data elements
  --     (2) One data element that references one new element
  --   the next 3 are skipped if new data is to be generated at ambiguities
  --     (3) One data element that references many new elements
  --     (4) Many data elements that reference one new element
  --     (5) Many data elements that reference many new elements

  if (!dataElements.empty()) then
    -- *** CASE 1 ***
    -- The only action here, is to take out new values. This could be done
    -- by a user defined pml function, this functionality will be implemented
    -- in a later release if required. In the mean time we just skip this
    !returnData = object DBREF()


  elseif (!dataElements.size() eq 1 and !dataElements[1].attribute(!this.xrefAtt).size() eq 1) then
    -- *** CASE 2 ***
    -- one to one relation, the values in the old element can be used
    -- in the new element
    !returnData = !dataElements[1]


  elseif (!newData) then
    -- always generate new data where choice is ambiguous so skip other cases
    !returnData = object DBREF()


  elseif (!dataElements.size() eq 1 and !dataElements[1].attribute(!this.xrefAtt).size() gt 1) then
    -- *** CASE 3 ***
    -- many to one relationship, many new elements map to one old element.
    -- The default method is to assign the old element data to the
    -- current new element, then this  data will not be available for
    -- subsequent elements, a better method could be defined.
    -- Prior to assigning the data we must check that the data has not
    -- already been used for another new element.
    if (!this.checkData(!dataElements[1])) then
      if (!element.type eq 'IWELD') then
        --P-16498 (Maintain Weld Number for a part with a new connection)
        --Get non-tube part of weld
        if (!element.iwdowners[3] eq 710633) then
          !ref = '=' & !element.iwdowners[5] & '/' & !element.iwdowners[6]
        else
          !ref = '=' & !element.iwdowners[1] & '/' & !element.iwdowners[2]
        endif
        $!ref
        --if part numbered on previous spool drawing then maintain its weld number, otherwise create new weld number
        var !partn partn
        if (!partn.real() eq 0) then
          !returnData = object DBREF()
        else
          !returnData = !dataElements[1]
        endif
      else
        !returnData = !dataElements[1]
      endif
    else
      !returnData = object DBREF()
    endif


  elseif (!dataElements.size() gt 1) then

    !oneToMany = true
    do !j indices !dataElements
      if (!dataElements[!j].attribute(!this.xrefAtt).size() gt 1) then
        !oneToMany = false
        break
      endif
    enddo

    if (!oneToMany) then
      -- *** CASE 4 ***
      -- one to many relationship, one new element maps to many old elements.
      -- The values in the first element in the list of old elements
      -- is used for the new element.
      !returnData = !dataElements[1]

    else
      -- *** CASE 5 ***
      -- many to many relationship, many new elements map to many old
      -- elements.
      -- The number of return references for each old element is checked,
      -- and the values for the old element with the least number of
      -- return references is used for the new element. As long as the
      -- old element has not already been used for another new element.

      -- first put the data elements in order of priority
      !noOfRefs = object BLOCK('!dataElements[!evalIndex].attribute(!this.xrefAtt).size()')
      !dataReturnRefs = !dataElements.evaluate(!noOfRefs)
      !priorities = !dataReturnRefs.sortedIndices()
      !prioritisedData = ARRAY()
      do !priority values !priorities
        !prioritisedData.append(!dataElements[!priority])
      enddo

      -- now find a data element that has not already been used
      !defined = false
      do !data values !prioritisedData
        if (!this.checkData(!data)) then
          if (!data.type eq 'IWELD') then
            -- must use a different weld number because one of the connections will be different (otherwise wouldn't be CASE 5)
            var !flnn flnn of $!element
            !flnnarr = !flnn.split()
            !iweldn = !flnnarr[2]
            var !flnn flnn of $!data
            !flnnarr = !flnn.split()
            !iweldnx = !flnnarr[2]
            if (!iweldnx ne !iweldn) then
              !returnData = !data
              !defined = true
              break
            endif
          else
            !returnData = !data
            !defined = true
            break
          endif
        endif
      enddo
      if (!defined.not()) then
        !returnData = object DBREF()
      endif
    endif

  endif

  return !returnData

endmethod
-- End of method definition for .chooseData(DBREF, ARRAY, BOOLEAN) DBREF

------------------------------------------------------------------------
--
-- Method:      !checkData()
--
-- Description: checks if a data element can be used
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [data element to check]
-- Return:
--   [BOOLEAN] [flag to indicate if data element is valid]
--
------------------------------------------------------------------------

-- Define method
define method .checkData(!dataElement is DBREF) is BOOLEAN

  -- if element is numbered, check for number in use
  if (!this.numAtt.set()) then
    !numberFree = !this.numbers.findFirst(!dataElement.attribute(!this.numAtt)).unset()
  else
    !numberFree = true
  endif

  -- check if data element has already been assigned
  if (!this.oldElements.findFirst(!dataElement).unset() and !numberFree) then
    !flag = true
  else
    !flag = false
  endif

  return !flag

endmethod
-- End of method definition for .checkData(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !merge()
--
-- Description: Merge data from !this.newData to data in !this.newElements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .merge()

  -- loop through elements contained in !this.newElements and apply
  -- attribute values stored in !this.newData and !this.numbers
  do !i indices !this.newElements

    -- navigate to element
    !!ce = !this.newElements[!i]

    -- set the spl/wld/jntnumber number
    if (!this.numAtt.set()) then
      !value = !this.numbers[!i]
      $!<this.numAtt> $!value
      !value.delete()

      -- attribute name is checked below
      !numAttUpcased = !this.numAtt.upcase()
    else
      !numAttUpcased = ''
    endif

    if (!this.newData[!i].unset()) then

      -- build attribute list if necessary
      !attList = !this.getAttributes(!this.newElements[!i])

      -- creating new values so see if any can be cascaded from splDrg
      -- unwanted attributes have already been excluded from !this.spoolAtts
      do !attribute values !attList.attributes
        if (!attribute.upcase() ne 'NAME') then
          -- don't overwrite set attributes, e.g. during renumbering
          -- note that string attributes are set if null string
          -- this test is ok because array attributes have been excluded
          if (!this.newElements[!i].attribute(!attribute).unset() or $
              !this.newElements[!i].attribute(!attribute).string() eq '') then
            -- is attribute valid at splDrg?
            !value = !this.ce.attribute(!attribute)
            handle any
            elsehandle none
              if (!value.string().trim() ne '') then
                if (!value.objectType() eq 'STRING') then
                  $!attribute |$!value|
                else
                  $!attribute $!value
                endif
              endif
              -- variable is used to hold attribute values which may be
              -- different data types, therefore it must be deleted here.
              !value.delete()
            endhandle
          endif
        endif
      enddo

    else

      -- for each attribute named in !this.newData copy the value
      -- from !this.newData, except the splNumber attribute
      -- as it is set separately, to remove control from the user
      do !j indices !this.newData[!i].attributes

        !attribute = !this.newData[!i].attributes[!j]
        !value = !this.newData[!i].values[!j]

        -- if numbered, number attribute is already set
        if (!attribute.upcase() ne !numAttUpcased) then
          if (!value.string().trim() ne '') then
            if (!value.objectType() eq 'STRING') then
              -- Name attribute must be set unquoted
              -- Don't set if unnamed (i.e. ref no)
              -- If named, need to unname the old element
              if (!attribute.upcase() eq 'NAME') then
                if (!value.subString(1, 1) eq '/') then
                  !!ce = !this.oldElements[!i]
                  UNNAME
                  !!ce = !this.newElements[!i]
                  $!attribute $!value
                endif
              else
                $!attribute |$!value|
                -- may be a word attribute
                handle (47,15) (2,10)
                  $!attribute $!value
                endhandle
              endif
            else
              $!attribute $!value
            endif
          endif
        endif
        -- variable is used to hold attribute values which may be different
        -- data types, therefore it must be deleted here.
        !value.delete()
      enddo

    endif

  enddo

  -- navigate back to spool drawing
  !!ce = !this.ce

endmethod
-- End of method definition for .merge()

------------------------------------------------------------------------
--
-- Method:      !assignData(DBREF, STRING)
--
-- Description: Pairs an element with a set of attribute data
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to add to !newElements array]
--   [2] [R] [STRING] [Data to add to !newData array]
--
------------------------------------------------------------------------
-- Author  Date        Ref                  Reason
-- ------  ----------  -------------------  ----------------------------
-- NJSB    22/01/2013  86780/S-43004        Re-use deleted Spool Numbers
------------------------------------------------------------------------

-- Define method
define method .assignData(!element is DBREF, !data is STRING)

  -- this method is called from the interactive update form
  -- Check for type of update
  !newValues = false
  if (!data.trim() eq 'NOACTION') then
    return
  elseif (!data.trim() eq 'NEW') then
    !newValues = true
  endif

  -- new values selected
  if (!newValues) then

    -- set the spl/wld/jntnumber number if element is numbered
    if (!this.numAtt.set()) then
      if (!this.numbers.findFirst(!element.attribute(!this.numAtt)).unset() and $
          !element.attribute(!this.numAtt) ne 0) then
        !number = !element.attribute(!this.numAtt)
      else
      	-- re-use deleted spool numbers for Use first available data option
        if (!element.type eq 'SPOOL') then
        	if (!!snew) then
              !number = !this.nextNumber(true)
        	else
        	  -- only re-use spool numbers if spooling update command has not been used
            if (!!salign) then
              !number = !this.nextNumber(true)
            else
          	  !smax = !!ce.smax
        	    !number = 0
          	  do !i from !!smin + 1 to !smax
                var !spool collect all SPLDRG mem with (type eq 'SPOOL' and SPLNU eq $!i) for ce
                if (!spool.size() eq 0) then
            	    !number = !i
                  break
                endif
              enddo
              if (!number eq 0) then
                !number = !this.nextNumber(true)
              endif
              !!smin = !number
            endif
          endif
        else
          !number = !this.nextNumber(true)
        endif
      endif
    else
      !number = REAL()
    endif

--     if (defined(!!splOpt.useSpoolNFunc)) then
--       -- execute user function, there may be errors, so catch them
--       -- more specific handles should be added here when the error numbers
--       -- are established,
--       !dataValues = !!splUserAttData(!element)
--       handle any
--         !!alert.error('Error in User defined pml function !!splUserAttData')
--         return
--       endhandle
--
--       -- check that the user function has returned the correct data type
--       if (!dataValues.objectType() ne 'SPLATTRIBUTES') then
--         !!alert.error('User defined pml function !!splUserAttData returns ' & !dataValues.objectType() & 'Data type. It should return a SPLATTRIBUTES object.')
--         return
--       elseif (!dataValues.attributes.size() ne !dataValues.values.size()) then
--         !!alert.error('User defined pml function !!splUserAttData returns different numbers of attribute names and values. There must be one value for each attribute name.')
--         return
--       endif
--       -- user defined new data
--       !this.assignToElement(!element, !element, !dataValues, !number)
--
--     else

      -- new data
      !this.assignToElement(!element, !element, object SPLATTRIBUTES(), !number)

--     endif

  else

    -- attribute data is being taken from an old spool element
    !dataElement = !data.dbRef()

    -- set the spl/wld/jntnumber number if element is numbered
    if (!this.numAtt.set()) then
      if (!this.numbers.findFirst(!dataElement.attribute(!this.numAtt)).unset() and $
          !dataElement.attribute(!this.numAtt) ne 0) then
        !number = !dataElement.attribute(!this.numAtt)
      else
        !number = !this.nextNumber(true)
      endif
    else
      !number = REAL()
    endif

    !this.assignToElement(!element, !dataElement, !this.getAttributes(!dataElement), !number)

  endif

endmethod
-- End of method definition for .assignData(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !assignData(DBREF, DBREF)
--
-- Description: Pairs an element with a set of attribute data
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to add to !newElements array]
--   [2] [R] [DBREF]  [Data to add to !newData array]
--
------------------------------------------------------------------------

-- Define method
define method .assignData(!element is DBREF, !data is DBREF)

  -- this method is called from the interactive update form

  -- attribute data is being taken from an old spool element
  -- set the spl/wld/jntnumber number if element is numbered
  if (!this.numAtt.set()) then
    if (!this.numbers.findFirst(!data.attribute(!this.numAtt)).unset() and $
        !data.attribute(!this.numAtt) ne 0) then
      !number = !data.attribute(!this.numAtt)
    else
      !number = !this.nextNumber(true)
    endif
  else
    !number = REAL()
  endif

  !this.assignToElement(!element, !data, !this.getAttributes(!data), !number)

endmethod
-- End of method definition for .assignData(DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:      !assignToElement()
--
-- Description: assigns a data set to an element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]         [element to add data to]
--   [2] [R] [DBREF]         [element to add data from]
--   [3] [R] [SPLATTRIBUTES] [data to add]
--   [4] [R] [REAL]          [spl/wld/jntnumber of new element]
--
------------------------------------------------------------------------

-- Define method
define method .assignToElement(!element is DBREF, !dataElement is DBREF, !data is SPLATTRIBUTES, !number is REAL)

  !this.newElements.append(!element)
  !this.oldElements.append(!dataElement)
  !this.newData.append(!data)
  !this.numbers.append(!number)

endmethod
-- End of method definition for .assignToElement(DBREF, DBREF, SPLATTRIBUTES, REAL)

------------------------------------------------------------------------
--
-- Method:      !getAttributes()
--
-- Description: Gets designated attributes from an element for update
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to retrieve attributes from]
-- Return:
--   [SPLATTRIBUTES] [Arrays of attributes and names]
--
------------------------------------------------------------------------

-- Define method
define method .getAttributes(!element is DBREF) is SPLATTRIBUTES

  -- in update mode no list/ref attribute required
  return !this.getAttributes(!element, !this.numAtt, STRING())

endmethod
-- End of method definition for .getAttributes(DBREF) SPLATTRIBUTES

------------------------------------------------------------------------
--
-- Method:      !getAttributes()
--
-- Description: Gets designated attributes from an element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to retrieve attributes from]
--   [2] [R] [STRING] [spl/wld/jntnumber attribute]
--   [3] [R] [STRING] [list/ref attribute attribute]
-- Return:
--   [SPLATTRIBUTES] [Arrays of attributes and names]
--
------------------------------------------------------------------------

-- Define method
define method .getAttributes(!element is DBREF, !numAtt is STRING, !listAtt is STRING) is SPLATTRIBUTES

  -- check if we have already built the attribute list for this type
  do !attList values !this.attLists
    if (!attList.type eq !element.type) then
      return !attList.getAttributes(!element, !numAtt, !listAtt)
    endif
  enddo

  -- add a new attlist if not previously defined for this type
  !this.attLists.append(object SPLATTRIBUTES())
  return !this.attLists[!this.attLists.size()].getAttributes(!element, !numAtt, !listAtt)

endmethod
-- End of method definition for .getAttributes(DBREF, STRING, STRING) SPLATTRIBUTES

------------------------------------------------------------------------
--
-- Method:      !listData()
--
-- Description: Returns a list of data, used in interactive mode only
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [element to get data for]
-- Return:
--   [ARRAY] [2 dimensional array holding Dtext & Rtext values]
--
------------------------------------------------------------------------

-- Define method
define method .listData(!element is DBREF) is ARRAY

  !values[1] = ARRAY()
  !values[2] = ARRAY()

  -- data is in SPLATTRIBUTES if already assigned to new element
  -- or data is in one or many DBREFs if not yet assigned
  do !data values !this.getData(!element)

    if (!data.objectType() eq 'DBREF') then

      -- get list of attributes to display to the user
      !dataValues = !this.getAttributes(!data)

      -- loop through the list of attributes and copy values to return array
      do !j indices !dataValues.attributes

        !attribute = !dataValues.attributes[!j]
        !value = !dataValues.values[!j].string()

        -- don't show fullnames involving SPLTMP
        if (!attribute.upcase() eq 'NAME') then
          if (!value.match(' of SPLTMP ') gt 0) then
            !value = 'unset'
          endif
        endif

        -- format for attributes shown in list is
        -- <attribute name>: <attribute value>
        !values[1].append(!attribute & ': ' & !value)
        !values[2].append(!data.string())

      enddo

      -- add an empty line between attribute lists
      !values[1].append('')
      !values[2].append('NOACTION')

    elseif (!data.objectType() eq 'SPLATTRIBUTES') then

      -- loop through the list of attributes and copy values to return array
      do !j indices !data.attributes

        !attribute = !dataValues.attributes[!j]
        !value = !dataValues.values[!j].string()

        -- format for attributes shown in list is
        -- <attribute name>: <attribute value>
        !values[1].append(!attribute + ': ' + !value)

      enddo

    endif

  enddo

  return !values

endmethod
-- End of method definition for .listData(DBREF) ARRAY

------------------------------------------------------------------------
--
-- Method:      !listElements()
--
-- Description: Returns a list of elements to be updated, used in interactive mode only
--
-- Method Type: Function
-- Return:
--   [ARRAY] [2 dimensional array holding Dtext & Rtext values]
--
------------------------------------------------------------------------

-- Define method
define method .listElements() is ARRAY

  !values[1] = ARRAY()
  !values[2] = ARRAY()

  -- list elements not yet assigned data for
  -- values[1] is names in dtext array, values[2] is dbrefs in rtext array
  do !element values !this.elementList
    if (!this.assigned(!element).not()) then
      !values[1].append(!element.fullName)
      !values[2].append(!element.string())
    endif
  enddo

  return !values

endmethod
-- End of method definition for .listElements() ARRAY

------------------------------------------------------------------------
--
-- Method:      !listMembers()
--
-- Description: Returns a list of elements to be updated, used in asbuilt mode only
--
-- Method Type: Function
-- Return:
--   [ARRAY] [2 dimensional array holding Dtext & Rtext values]
--
------------------------------------------------------------------------

-- Define method
define method .listMembers() is ARRAY

  -- initialise local arrays for return values
  !values[1] = ARRAY()
  !values[2] = ARRAY()
  !numbers = ARRAY()
  !prefix = ''

  if (!this.numAtt.set()) then

    -- loop through all elements and extract prefix+number data
    do !element values !this.elementList
      !number = !element.attribute(!this.numAtt)
      if (!number gt 0) then
        if (!this.prefAtt.set()) then
          !prefix = !element.attribute(!this.prefAtt)
        endif
        !numbers.append(!prefix & !number)
      else
        !numbers.append('unset')
      endif
    enddo

    -- pad number data and combine with names
    !width = !numbers.width() + 3
    do !i indices !numbers
      !paddedNumber = !numbers[!i] & '                                '
      !values[1].append(!paddedNumber.subString(1, !width) & !this.elementList[!i].fullName)
    enddo

  else

    -- elements without numbering data just get names
    do !i indices !this.elementList
      !values[1].append(!this.elementList[!i].fullName)
    enddo

  endif

  -- return dbrefs as rtext
  do !i indices !this.elementList
    !values[2].append(!this.elementList[!i].string())
  enddo

  return !values

endmethod
-- End of method definition for .listMembers() ARRAY

------------------------------------------------------------------------
--
-- Method:      !assigned()
--
-- Description: check if element has already been assigned data
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to be checked]
-- Return:
--   [BOOLEAN] [true if element has been assigned data]
--
------------------------------------------------------------------------

-- Define method
define method .assigned(!element is DBREF) is BOOLEAN

  return !this.newElements.findFirst(!element).set()

endmethod
-- End of method definition for .assigned(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !undo()
--
-- Description: Undo operation for interactive update mode
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .undo()

  -- undo the last assignment of new data to new elements
  if (!this.newElements.size() gt 0) then
    !this.oldElements.removeLast()
    !this.newElements.removeLast()
    !this.newData.removeLast()
    !this.numbers.removeLast()
  endif

endmethod
-- End of method definition for .undo()

------------------------------------------------------------------------
--
-- Method:      !validate()
--
-- Description: validate string attribute from user input
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to set attribute on]
--   [2] [R] [STRING] [Attribute]
--   [3] [R] [STRING] [Value]
-- Return value:
--   [BOOLEAN]  [True if validated]
--
------------------------------------------------------------------------

-- Define method
define method .validate(!element is DBREF, !attribute is STRING, !value is STRING) is BOOLEAN

  -- 'Attribute not recognised for validation'
  !!alert.error(!!messageFile.messageString(154, 92))
  return false

endmethod
-- End of method definition for .validate(DBREF, STRING, STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !validate()
--
-- Description: validate real attribute from user input
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to set attribute on]
--   [2] [R] [STRING] [Attribute]
--   [3] [R] [REAL]   [Value]
-- Return value:
--   [BOOLEAN]  [True if validated]
--
------------------------------------------------------------------------

-- Define method
define method .validate(!element is DBREF, !attribute is STRING, !value is REAL) is BOOLEAN

  -- Spool/weld/joint number as built setting
  if (!attribute.upcase() eq !this.numAtt.upcase()) then

    -- Collect number data
    !numbers = !this.elementList.evaluate(OBJECT BLOCK('!this.elementList[!evalIndex].attribute(!this.numAtt)'))

    -- check if new value is illegal
    if (!value.unset() or !value le 0) then
      -- 'Illegal value for #attribute'
      !!alert.error(!!messageFile.messageString(154, 94, !attribute))
      return false
    elseif (!numbers.findFirst(!value).set()) then
      -- '#attribute #value has already been used'
      !!alert.error(!!messageFile.messageString(154, 95, !attribute, !value))
      return false
    else
      return true
    endif

  else

    -- 'Attribute not recognised for validation'
    !!alert.error(!!messageFile.messageString(154, 92))
    return false

  endif

endmethod
-- End of method definition for .validate(DBREF, STRING, REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !validate()
--
-- Description: validate boolean attribute from user input
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]   [Element to set attribute on]
--   [2] [R] [STRING]  [Attribute]
--   [3] [R] [BOOLEAN] [Value]
-- Return value:
--   [BOOLEAN]  [True if validated]
--
------------------------------------------------------------------------

-- Define method
define method .validate(!element is DBREF, !attribute is STRING, !value is BOOLEAN) is BOOLEAN

  -- 'Attribute not recognised for validation'
  !!alert.error(!!messageFile.messageString(154, 92))
  return false

endmethod
-- End of method definition for .validate(DBREF, STRING, BOOLEAN) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !setAttribute()
--
-- Description: string attribute setting from user input
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to set attribute on]
--   [2] [R] [STRING] [Attribute]
--   [3] [R] [STRING] [Value]
--
------------------------------------------------------------------------

-- Define method
define method .setAttribute(!element is DBREF, !attribute is STRING, !value is STRING)

  -- 'Attribute not recognised for setting'
  !!messageFile.error(154, 93)

endmethod
-- End of method definition for .setAttribute(DBREF, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !setAttribute()
--
-- Description: real attribute setting from user input
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to set attribute on]
--   [2] [R] [STRING] [Attribute]
--   [3] [R] [REAL]   [Value]
--
------------------------------------------------------------------------

-- Define method
define method .setAttribute(!element is DBREF, !attribute is STRING, !value is REAL)

  -- Spool/weld/joint number as built setting
  if (!attribute.upcase() eq !this.numAtt.upcase()) then

    -- New value exceeds max for splDrg
    if (!value gt !this.ce.attribute(!this.maxAtt)) then
      !!ce = !this.ce
      $!<this.maxAtt> $!value
    endif

    -- Set number
    !!ce = !element
    $!<this.numAtt> $!value

  else

    -- 'Attribute not recognised for setting'
    !!messageFile.error(154, 93)

  endif

endmethod
-- End of method definition for .setAttribute(DBREF, STRING, REAL)

------------------------------------------------------------------------
--
-- Method:      !setAttribute()
--
-- Description: boolean attribute setting from user input
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]   [Element to set attribute on]
--   [2] [R] [STRING]  [Attribute]
--   [3] [R] [BOOLEAN] [Value]
--
------------------------------------------------------------------------

-- Define method
define method .setAttribute(!element is DBREF, !attribute is STRING, !value is BOOLEAN)

  -- 'Attribute not recognised for setting'
  !!messageFile.error(154, 93)

endmethod
-- End of method definition for .setAttribute(DBREF, STRING, BOOLEAN)
