------------------------------------------------------------------------
--
-- Method:      !iweldGadgetSet()
--
-- Description: Method to set form gadgets for an A/I/RWELD or IJOINT element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to initialise gadgets to]
--
------------------------------------------------------------------------

-- Define method
define method .iweldGadgetSet(!element is DBREF)

  if (!element.type eq 'RWELD') then
    if (!this.updateMembers) then
      !this.members.navigateMenu.add('callback', 'WELD', '!!ce = !!ce.rwdowner')
    endif
  endif

  !dText[1] = 'Department'
  !rText[1] = 'ISODEP'
  !dText[2] = 'Registry'
  !rText[2] = 'ISOREG'
  !dText[3] = 'Spool Drawing'
  !rText[3] = 'SPLDRG'
  !this.mainForm.createType.dText = !dText
  !this.mainForm.createType.rText = !rText
  !this.mainForm.createType.active = true
  !this.mainForm.createType.val = 3
  !this.mainForm.create.active = true
  !this.splDrg = !element.owner.owner

endmethod
-- End of method definition for .iweldGadgetSet(DBREF)

------------------------------------------------------------------------
--
-- Method:      !pcompsGadgetSet()
--
-- Description: Method to set form gadgets for all Piping Components
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to initialise gadgets to]
--
------------------------------------------------------------------------

-- Define method
define method .pcompsGadgetSet(!element is DBREF)

  if (!element.sfref.set()) then
    if (!this.updateMembers) then
      !this.members.navigateMenu.add('callback', !element.sfref.type, '!!ce = !!ce.sfref')
    endif
    !this.splDrg = !element.sfref.owner
    !this.mainForm.activeSpldrg.val = !this.splDrg.name
  endif

  if (!element.type eq 'WELD') then
    if (!element.wldref[1].set()) then
      if (!this.updateMembers) then
        !this.members.navigateMenu.add('callback', 'RWELD', '!!ce = !!ce.wldref[1]')
      endif
    endif
  endif

  !this.mainForm.create.active = false
  !this.mainForm.createType.active = false

endmethod
-- End of method definition for .pcompsGadgetSet(DBREF)

------------------------------------------------------------------------
