------------------------------------------------------------------------

-- Define method
define method .otherGadgetSet(!element is DBREF)

  !this.mainForm.create.active = false
  !this.mainForm.createType.active = false

endmethod
-- End of method definition for .otherGadgetSet(DBREF)

------------------------------------------------------------------------
--
-- Method:      !splDrgAdd()
--
-- Description: add elements to splDrg
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to add to Spldrg]
--   [2] [R] [STRING] [ELEMENT or TUBING]
--
------------------------------------------------------------------------

-- Define method
define method .splDrgAdd(!element is DBREF, !pickType is STRING)

  if (!pickType eq 'TUBING') then
    !tempElem = ILEAVE TUBE OF $!element
  else
    !tempElem = !element
  endif

  !!ce = !this.splDrg
  SPOOLING ADD $!<this.splDrg> $!tempElem

  -- handle error so EDG does not complain
  handle any
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method definition for .splDrgAdd(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !splDrgRemove()
--
-- Description: remove elements from a splDrg
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to be removed from splDrg]
--   [2] [R] [STRING] [ELEMENT or TUBING]
--
------------------------------------------------------------------------

-- Define method
define method .splDrgRemove(!element is DBREF, !pickType is STRING)

  if (!pickType eq 'TUBING') then
    !tempElem = ILEAVE TUBE OF $!element
  else
    !tempElem = !element
  endif

  !splDrgMem = !tempElem.sfref

  -- ce must not be element about to be removed
  !!ce = !this.splDrg
  SPOOLING REMOVE $!splDrgMem

  -- handle error so EDG does not complain
  handle any
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method definition for .splDrgRemove(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !rollbackEdg()
--
-- Description: update form following EDG rollback on graphics form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .rollbackEdg()

  -- display navigate as pick mode
  !this.pickMode = 'NAVIGATE'
  !this.mainForm.includeFields.active = false

  -- unset edg packet
  !this.edgPacket = object EDGPACKET()

endmethod
-- End of method definition for .rollbackEdg()

------------------------------------------------------------------------
--
-- Method:      !removeEdg()
--
-- Description: remove EDG packet
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeEdg()

  -- remove edg packet (which will cause !this.rollbackEdg to be called)
  if (!this.edgPacket.type.set()) then
    !!edgCntrl.remove(!this.edgPacket)
  endif

endmethod
-- End of method definition for .removeEdg()

------------------------------------------------------------------------
--
-- Method:      !extractClaims()
--
-- Description: Switch on/off extract claim marker callback method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [MENU] [menu gadget]
--   [2] [R] [STRING] [select state]
--
------------------------------------------------------------------------

-- Define method
define method .extractClaims(!menu is MENU, !dummyState is STRING)

  !!showMemExtracts = !menu.selected(|Show Extract Claims|)
  -- set command text to be used when form reloaded (horrible but necessary!)
  if( !!showMemExtracts ) then
    !!splExtractFlag = | EXCLTO '*' ' ' ' '|
  else
    !!splExtractFlag = ||
  endif

  -- Must tidy up any splmembers EDG modes
  !!splMembers.close()
  kill !!splMembers
  show !!splMembers free at xr 0 yr 0.1

endmethod
-- End of method definition for .extractClaims(MENU, STRING)
