-- Created:         Mon Aug 18 14:12:58 BST 1997
--
--
-- Description:
-- Object to store spooler options
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  constraint()                     STRING              get the constraint option
--  constraint(STRING)               -                   set the constraint option
--  copyToGlobal()                   -                   copy the object to the global instance
--  coreSettings()                   -                   Align all core settings with the member values
--  default(BOOLEAN)                 -                   Default options settings
--  edit()                           -                   edit the options via the GUI
--  globalInstance()                 -                   create a global instance of the object
--  load()                           -                   Load options from system and user files
--  localCopy()                      SPLGENOPT           return a local copy of the object
--  multiway()                       BOOLEAN             get the multiway option
--  multiway(BOOLEAN)                -                   set the multiway option
--  numberingOrder()                 STRING              get the numbering order option
--  numberingOrder(STRING)           -                   set the numbering order option
--  priority()                       STRING              get the priority option
--  priority(STRING)                 -                   set the priority option
--  save()                           -                   Save options settings to %PDMSUSER%
--  splGenOpt()                      -                   Constructor
--  splGenOpt(BOOLEAN)               -                   Constructor
--
------------------------------------------------------------------------

-- Define object
define object SPLGENOPT

  -- member to hold the status of the current user
  -- true indicates administrator status, otherwise false.
  member .adminStatus is BOOLEAN

  -- current options file name for this object
  member .filename is STRING

  -- global object flag, if set then global core options are also set
  member .global is BOOLEAN

  -- members to store network searching settings
  member .constraint is STRING
  member .priority is STRING
  member .multiway is BOOLEAN
  -- member .includeFields is BOOLEAN
  member .numberingOrder is STRING

endobject
-- End of object definition for SPLGENOPT

------------------------------------------------------------------------
--
-- Method:      !splGenOpt()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splGenOpt()

  -- set file name
  !this.filename = 'spl-gen.pmldat'

  -- initialise the global flag
  !this.global = false

  -- set the default values
  !this.default(false)

  -- Check team for Spooler General Admin
  !validTeam[1] = 'MASTER'
  !validTeam[2] = 'SPLADMIN'
  !this.adminStatus = !!comTeamCheck(!validTeam)

endmethod
-- End of method definition for .splGenOpt()

------------------------------------------------------------------------
--
-- Method:      !splGenOpt(BOOLEAN)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------

-- Define method
define method .splGenOpt(!globalValue is BOOLEAN)

  -- set file name
  !this.filename = 'spl-gen.pmldat'

  -- initialise the global flag
  !this.global = !globalValue

  -- set the default values
  !this.default(!globalValue)

  -- Check team for Spooler General Admin
  !validTeam[1] = 'MASTER'
  !validTeam[2] = 'SPLADMIN'
  !this.adminStatus = !!comTeamCheck(!validTeam)

endmethod
-- End of method definition for .splGenOpt(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !default(BOOLEAN)
--
-- Description: Default options settings
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------

-- Define method
define method .default(!setCore is BOOLEAN)

  -- define default settings here
  !this.constraint('PIPE')
  !this.priority('PA')
  !this.multiway(TRUE)
  -- !this.includeFields(FALSE)
  !this.numberingOrder('BRANCH')

  if (!setCore) then
    !this.coreSettings()
  endif

endmethod
-- End of method definition for .default(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- create the global instance of this object
  !!splGenOpt = !this
  !!splGenOpt.global = true

  -- load the options settings
  !!splGenOpt.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [SPLGENOPT] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is SPLGENOPT

  -- copy this object to a local variable and unset the global flag
  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() SPLGENOPT

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  !!splGenOpt = !this
  !!splGenOpt.global = true
  !!splGenOpt.coreSettings()

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method: !coreSettings()
--
-- Description: Align all core settings with the member values
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .coreSettings()

  SPOOLING OPTIONS CONSTRAINT $!<this.constraint>
  SPOOLING OPTIONS PRIORITY $!<this.priority>
  SPOOLING OPTIONS MULTIWAY $!<this.multiway>
  -- SPOOLING OPTIONS INCLUDEFIELDS $!<this.includeFields>
  SPOOLING OPTIONS NUMBERING ORDER $!<this.numberingOrder>

endmethod
-- End of method definition for .coreSettings()

------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
-- Arguments:
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------

-- Define method
define method .load()

  -- get the locations of system options file and user options file
  !optionFiles = !!comGetOptFiles(!this.filename)

  -- create a temporary global variable to store the data
  if (defined(!!tmpSplGenOpt)) then
    !!tmpSplGenOpt.delete()
  endif
  !!tmpSplGenOpt = !this

  -- if a system options file has been found, load the data
  if (defined(!optionFiles[1])) then

    !storeAdminStatus = !this.adminStatus
    !this.adminStatus = true

    -- load options file
    !localName = !optionFiles[1].fullName()
    $m "$!<localName>"
    handle any
      -- 'System Options File #filename is corrupt, setting default options'
      !!messageFile.warning(146, 31, !optionFiles[1].fullName())
      !this.default(false)
    endhandle

    !this.adminStatus = !storeAdminStatus

  endif

  -- if a user options file has been found, load the options
  if (defined(!optionFiles[2])) then

    -- load options file
    !localName = !optionFiles[2].fullName()
    $m "$!<localName>"
    handle any
      -- 'User Options File #filename is corrupt'
      !!messageFile.warning(146, 32, !optionFiles[2].fullName())
      !this.default(false)
    endhandle

  endif

  !this = !!tmpSplGenOpt

  !this.coreSettings()

  !!tmpSplGenOpt.delete()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method: !save()
--
-- Description: Save options settings to %PDMSUSER%
--
-- Method Type: Function
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

  -- write header information
  !saveContents.append('-- Data file for spooling general options')
  !saveContents.append('')

  -- options are not saved if they are the same as the default values
  -- currently the default values are put in here directly, this is
  -- for performance reasons, it would be better to have a method for
  -- each existing member, that held its default value.

  ----------------------------------------------------------------------
  -- user options are  saved for all users
  ----------------------------------------------------------------------
  if (!this.constraint ne 'WORL') then
    !saveContents.append('!!tmpSplGenOpt.constraint = |' & !this.constraint() & '|')
  endif
  if (!this.priority ne 'PA') then
    !saveContents.append('!!tmpSplGenOpt.priority = |' & !this.priority() & '|')
  endif
  if (!this.multiway.not()) then
    !saveContents.append('!!tmpSplGenOpt.multiway = ' & !this.multiway())
  endif
  -- if (!this.includeFields) then
  --   !saveContents.append('!!tmpSplGenOpt.includeFields = ' & !this.includeFields())
  -- endif
  if (!this.numberingOrder ne 'BRANCH') then
    !saveContents.append('!!tmpSplGenOpt.numberingOrder = |' & !this.numberingOrder() & '|')
  endif

   -- end of user options

  ----------------------------------------------------------------------
  -- system options are only saved if the user has administrator status
  ----------------------------------------------------------------------
  if (!this.adminStatus) then

  endif
  -- end of system options

  !!writeFile('%PDMSUSER%/' + !this.filename, 'OVERWRITE', !saveContents)

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !edit()
--
-- Description: edit the options via the GUI
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .edit()

  show !!splGenEdit

endmethod
-- End of method definition for .edit()

