-- Method:      !start()
--
-- Description: Initialise the object for update
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .start()

  -- common numbering initialisation
  !this.common.start()

  -- add all members of the joint group to the element list
  !this.common.elementList = !!splJoints(!this.common.ce)

endmethod
-- End of method definition for .start()

