-- File:            splmto.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Apr 6 15:05:50 BST 1998
--
--
-- Description:
-- Piping MTO data and calculation
-- This object works in non graphics mode and so generates no alerts
-- (the only exception is in use of the file object for tracing)
-- Note that the members array may be sparse after calculation completes
-- as tube items are removed to the cutpieces array
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAllow()                       -                   add fitting allowances
--  boltedHead(DBREF)                BOOLEAN             check if bolts will be allocated to branch head
--  boltedNotTail(DBREF)             BOOLEAN             check if bolts will not be allocated downstream
--  buildMto()                       -                   calculate mto for selected item
--  buildPtrs()                      -                   build prev/next pointers for members array
--  buildSingleMto()                 -                   calculate mto for individual splDrg or pipe
--  collectComps()                   ARRAY               collect list of components/tubes for spool, field or pipe
--  collectGroups()                  ARRAY               collect groupings of splDrg or pipe
--  getBolts()                       -                   get bolts (new method only)
--  getBolts(FILE)                   -                   get bolts from material control file
--  getMtorefs()                     -                   get mtoref data
--  listBom()                        ARRAY               list material in BOM order (default column widths)
--  listBom(REAL,REAL,REAL,REAL,REAL) ARRAY               list material in BOM order
--  listMembers()                    -                   list members to screen
--  nextOf(REAL)                     REAL                get member that follows member !this.member[!i]
--  nextRef(DBREF)                   DBREF               get reference of next member
--  orderForBom(ARRAY)               ARRAY               return arrays sorted for Bill of Materials
--  orderFrom(REAL)                  -                   list members in order to screen
--  prevOf(REAL)                     REAL                get member that precedes member !this.member[!i]
--  prevRef(DBREF)                   DBREF               get reference of previous member
--  print()                          -                   print mto data to screen
--  print(STRING)                    -                   print mto data to file
--  resolveTubes()                   -                   resolve tube pieces from members array
--  setGlobalFormats()               -                   set bore, distance and bolt length/diameter format objects
--  splMto(DBREF)                    -                   constructor
--  splMto(DBREF,SPLMTOOPTIONS)      -                   constructor
--  splMto(STRING)                   -                   constructor
--  splMto(STRING,SPLMTOOPTIONS)     -                   constructor
--  totalWeights(REAL)               -                   calculate wet weights, total weights and CofGs
--  updatePtrs()                     -                   update member pointers into tube array
--
------------------------------------------------------------------------

define object SPLMTO

  -- pipe or splDrg
  member .ce is DBREF

  -- groupings by spool, field
  member .groups is ARRAY

  -- all components/tubes
  member .members is ARRAY

  -- bolts
  member .bolts is ARRAY

  -- mtorefs (additional MTO items)
  member .mtorefs is ARRAY

  -- cut tube pieces
  member .cutPieces is ARRAY

  -- options
  member .mtoOptions is SPLMTOOPTIONS

  -- specific gravity for wet weights
  member .specGravity is REAL

  -- total dry weight
  member .dryWeight is REAL

  -- total wet weight
  member .wetWeight is REAL

  -- total dry centre of gravity
  member .dryCofG is POSITION

  -- total wet centre of gravity
  member .wetCofG is POSITION

endobject
-- End of object definition for SPLMTO

------------------------------------------------------------------------
--
-- Method:      !splMto(DBREF,SplMtoOptions)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]         [Pipe or Spldrg for MTO]
--   [2] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .splMto(!element is DBREF, !options is SPLMTOOPTIONS)

  -- store ce
  !this.ce = !element

  -- set options
  !this.mtoOptions = !options

  -- calculate mto
  !this.buildMto()

endmethod
-- End of method definition for .splMto(DBREF, SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !splMto(DBREF)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Pipe or Spldrg for MTO]
--
------------------------------------------------------------------------

define method .splMto(!element is DBREF)

  -- store ce
  !this.ce = !element

  -- calculate mto using default options
  !this.buildMto()

endmethod
-- End of method definition for .splMto(DBREF)

------------------------------------------------------------------------
--
-- Method:      !splMto(STRING,SplMtoOptions)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of Pipe or Spldrg for MTO]
--   [2] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .splMto(!name is STRING, !options is SPLMTOOPTIONS)

  -- check element via normal error handling
  !element = !name.dbRef()

  -- store ce
  !this.ce = !element

  -- set options
  !this.mtoOptions = !options

  -- calculate mto using default options
  !this.buildMto()

endmethod
-- End of method definition for .splMto(STRING, SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !splMto(STRING)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of Pipe or Spldrg for MTO]
--
------------------------------------------------------------------------

define method .splMto(!name is STRING)

  -- check element via normal error handling
  !element = !name.dbRef()

  -- store ce
  !this.ce = !element

  -- calculate mto using default options
  !this.buildMto()

endmethod
-- End of method definition for .splMto(STRING)

-------------------------------------------------------------------------
--
-- Method:      !buildMto()
--
-- Description: calculate mto for selected item
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .buildMto()

  -- initialisation
  !this.groups.clear()
  !this.members.clear()
  !this.bolts.clear()
  !this.mtorefs.clear()
  !this.cutPieces.clear()

  -- settings required
  TRACE OFF
  FORWARDS
  PRECISION VARIABLE 6DP

  -- set bore and distance format objects
  !this.setGlobalFormats()

  -- allowable types
  !groupTypes = 'ISODEP ISOREG ZONE'
  !mtoTypes = 'SPLDRG PIPE DRAWI'

  if (!groupTypes.match(!this.ce.type) gt 0) then

    -- build mto for offspring
    do !group values !this.collectGroups()
      !this.groups.append(OBJECT splMto(!group, !this.mtoOptions))
    enddo

  elseif (!mtoTypes.match(!this.ce.type) gt 0) then

    -- build mto for this
    !this.buildSingleMto()

  else
    -- 'Invalid type for piping MTO'
    !!messageFile.error(154, 160)
  endif

endmethod
-- End of method definition for .buildMto()

-------------------------------------------------------------------------
--
-- Method:      !setGlobalFormats()
--
-- Description: set bore, distance and bolt length/diameter format objects
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setGlobalFormats()

  -- set global objects according to current units settings
  -- these vary slightly from the standard !!boreFmt and !!distanceFmt
  !metricBore     = !!isImperialLength('BORE').not()
  !metricDistance = !!isImperialLength('DIST').not()

  !!splMtoBoreFmt = object FORMAT()
  !!splMtoBoreFmt.dimension = 'L'

  if (!metricBore) then
    !!splMtoBoreFmt.units = 'MM'
    !!splMtoBoreFmt.dp = 0
    !!splMtoBoreFmt.label = 'mm'
  else
    !!splMtoBoreFmt.units = 'INCH'
    !!splMtoBoreFmt.fraction = true
    !!splMtoBoreFmt.denominator = 8
    !!splMtoBoreFmt.inchSeparator = |.|
    !!splMtoBoreFmt.label = '"'
    !!splMtoBoreFmt.zeros = false
  endif

  !!splMtoDistFmt = object FORMAT()
  !!splMtoDistFmt.dimension = 'L'

  if (!metricDistance) then
    !!splMtoDistFmt.units = 'MM'
    !!splMtoDistFmt.dp = 0
    !!splMtoDistFmt.label = 'mm'
  else
    !!splMtoDistFmt.units = 'FINCH'
    !!splMtoDistFmt.fraction = true
    !!splMtoDistFmt.denominator = 16
    !!splMtoDistFmt.ftLabel = |'|
    !!splMtoDistFmt.inchSeparator = |.|
    !!splMtoDistFmt.label = '"'
    !!splMtoDistFmt.zeros = false
  endif

  !!splMtoBDiaFmt = object FORMAT()
  !!splMtoBDiaFmt.dimension = 'L'

  if (!metricBore) then
    !!splMtoBDiaFmt.units = 'MM'
    !!splMtoBDiaFmt.dp = 0
    !!splMtoBDiaFmt.label = 'mm'
  else
    !!splMtoBDiaFmt.units = 'INCH'
    !!splMtoBDiaFmt.fraction = true
    !!splMtoBDiaFmt.denominator = 16
    !!splMtoBDiaFmt.inchSeparator = |.|
    !!splMtoBDiaFmt.zeros = false
    !!splMtoBDiaFmt.label = '"'
  endif

  !!splMtoBLenFmt = object FORMAT()
  !!splMtoBLenFmt.dimension = 'L'

  if (!metricDistance) then
    !!splMtoBLenFmt.units = 'MM'
    !!splMtoBLenFmt.dp = 0
    !!splMtoBLenFmt.label = 'mm'
  else
    !!splMtoBLenFmt.units = 'INCH'
    !!splMtoBLenFmt.fraction = true
    !!splMtoBLenFmt.denominator = 16
    !!splMtoBLenFmt.inchSeparator = |.|
    !!splMtoBLenFmt.zeros = false
    !!splMtoBLenFmt.label = '"'
  endif

endmethod
-- End of method definition for .setGlobalFormats()

-------------------------------------------------------------------------
--
-- Method:      !buildSingleMto()
--
-- Description: calculate mto for individual splDrg or pipe
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .buildSingleMto()

  -- save db position
  !dbPos = !!ce

  -- collect branch members
  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Building component list'
  endif
  !compList = !this.collectComps()

  -- if origin for positions is unset, set it on world of first component
  if (!this.mtoOptions.origin.unset()) then
    if (!compList.empty().not()) then
      !!ce = !compList.first()
      !this.mtoOptions.origin('/*')
    endif
  endif

  -- build component list
  do !member values !compList
    !this.members.append(OBJECT SplMtoComp(!member, !this.mtoOptions))
  enddo
  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

  -- build prev/next pointers
  !this.buildPtrs()

  -- get bolts
  !this.getBolts()

  -- get mtorefs
  !this.getMtorefs()

  -- combine tubes into cutpieces
  !this.resolveTubes()

  -- calculate tube quantities and add bend allowances
  do !piece values !this.cutPieces
    !piece.quantify()
    !piece.bendAllows(!this.mtoOptions)
  enddo

  -- compress arrays and update pointers
  !this.updatePtrs()

  -- add fitting allowances
  !this.addAllow()

  -- restore db position
  !!ce = !dbPos

endmethod
-- End of method definition for .buildSingleMto()

-----------------------------------------------------------------------
--
-- Method:      !collectGroups()
--
-- Description: collect groupings of splDrg or pipe
--
-- Method Type: Function
-- Return:
--   [ARRAY] [List of offspring]
--
------------------------------------------------------------------------

define method .collectGroups() is ARRAY

  !returnData = ARRAY()

  if (!this.ce.type eq 'ZONE') then

    -- collect pipes
    do !member values !this.ce.members
      if (!member.type eq 'PIPE') then
        !returnData.append(!member)
      endif
    enddo

  elseif (!this.ce.type eq 'ISODEP' or !this.ce.type eq 'ISOREG') then

    -- collect groups of splDrgs
    !returnData.appendArray(!this.ce.members)

  endif

  return !returnData

endmethod
-- End of method definition for .collectGroups() ARRAY

-----------------------------------------------------------------------
--
-- Method:      !collectComps()
--
-- Description: collect list of components/tubes for spool, field or pipe
--
-- Method Type: Function
-- Return:
--   [ARRAY] [List of DBREFS of components/tubes]
--
------------------------------------------------------------------------

define method .collectComps() is ARRAY

  !returnData = ARRAY()

  if (!this.ce.type eq 'PIPE') then

    -- collect branch members
    var !pipeMembers COLLECT ALL BRAN MEMBERS FOR $!<this.ce>
    do !member values !pipeMembers
      !returnData.append(!member.dbRef())
    enddo

  elseif (!this.ce.type eq 'SPLDRG') then

    -- collect spool and field members
    do !member values !this.ce.members
      if (!member.type eq 'SPOOL' or !member.type eq 'FIELD') then
        !returnData.appendArray(!member.splMem)
      endif
    enddo

  elseif (!this.ce.type eq 'DRAWI') then

    -- deprecated Spooling drawing but useful for testing
    do !element values !this.ce.members
      if (!element.type eq 'TEXT') then
        var !drawiMembers APPEND COLLECT ALL BRAN MEMBERS FOR $!<element.sText>
      endif
    enddo
    do !member values !drawiMembers
      !returnData.append(!member.dbRef())
    enddo

  endif

  return !returnData

endmethod
-- End of method definition for .collectComps() ARRAY

------------------------------------------------------------------------
--
-- Method:      !resolveTubes()
--
-- Description: resolve tube pieces from members array
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .resolveTubes()

  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Resolving tubes'
  endif
  -- olet to header weld does not break tube
  do !member values !this.members
    if (!member.isOlet) then
      if (!member.prev.set()) then
        if (!this.members[!member.prev].ce.type eq 'WELD') then
          !this.members[!member.prev].offline = true
        endif
      endif
      if (!member.next.set()) then
        if (!this.members[!member.next].ce.type eq 'WELD') then
          !this.members[!member.next].offline = true
        endif
      endif
    endif
  enddo

  -- loop through members searching for a tube not yet included
  do

    -- find a tube not yet included
    do !i indices !this.members
      !scanFrom = !i
      golabel /SCAN if (!this.members[!i].isTube and !this.members[!i].tubePieceNo.unset())
    enddo
    break

    -- scan to start of cut piece
    label /SCAN
    -- WRITE 'Scan from $!scanFrom'
    !current = !scanFrom
    !tubeStart = !scanFrom
    do
      !prev = !this.members[!current].prev
      -- end of drwg limits
      golabel /START if (!prev.unset())
      if (!this.members[!prev].isTube) then
        -- previous is tube so store for start
        !tubeStart = !prev
      else
        -- previous is component so check if it breaks tube
        golabel /START if (!this.members[!prev].offline.not())
      endif
      !current = !prev
    enddo

    -- start of cut piece
    label /START
    -- WRITE 'Start at $!tubeStart'
    !current = !tubeStart
    -- add tube to cutpiece array and mark as added
    !this.cutPieces.append(OBJECT SplMtoTube(!this.members[!current]))
    !this.members[!current].tubePieceNo = !this.cutPieces.size()

    -- continue cut piece
    do
      !next = !this.members[!current].next
      -- end of drwg limits
      break if (!next.unset())
      if (!this.members[!next].isTube) then
        -- next is tube so add to cutpiece array and mark as added
        -- WRITE 'Add $!next'
        !this.cutPieces[!this.cutPieces.size()].append(!this.members[!next])
        !this.members[!next].tubePieceNo = !this.cutPieces.size()
      else
        -- next is component so check if it breaks tube
        break if (!this.members[!next].offline.not())
      endif
      !current = !next
    enddo

  enddo

  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

endmethod
-- End of method definition for .resolveTubes()

------------------------------------------------------------------------
--
-- Method:      !getBolts()
--
-- Description: get bolts (new method only)
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .getBolts()

  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Get bolts'
  endif

  -- determine if new bolting method from first member's spec
  if (!this.members.empty().not()) then
    !firstSpec = '/' & !this.members.first().spec
    if (!firstSpec.dbRef().bltm eq 'NEW') then

      -- check for bolts defined by new method
      do !member values !this.members
        skip if (!member.ce.type eq 'TUBI')

        -- check if bolts will be allocated to branch head
        if (!this.boltedHead(!member.ce)) then

          var !boltTotal PA BOLT TOTAL OF $!<member.ce>

          -- ignore if no bolts
          handle any
          elsehandle none
            do !number to !boltTotal.real()
              !this.bolts.append(OBJECT SplMtoBolt(!member, !member.ce.arrive, !number, !this.mtoOptions, true))
            enddo
          endhandle
        endif

        -- check if bolts will be allocated downstream
        if (!this.boltedNotTail(!member.ce)) then

          var !boltTotal PL BOLT TOTAL OF $!<member.ce>

          -- ignore if no bolts
          handle any
          elsehandle none
            do !number to !boltTotal.real()
              !this.bolts.append(OBJECT SplMtoBolt(!member, !member.ce.leave, !number, !this.mtoOptions, false))
            enddo
          endhandle
        endif

      enddo

    endif
  endif

  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

endmethod
-- End of method definition for .getBolts()

------------------------------------------------------------------------
--
-- Method:      !getBolts()
--
-- Description: get bolts from material control file
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FILE] [Isodraft material control file]
--
------------------------------------------------------------------------

define method .getBolts(!matcFile is FILE)

  -- this method is not called automatically
  -- the user must call it if required, hence reinitialise bolts array
  !this.bolts.clear()

  -- read matc data
  if (!matcFile.set()) then
    if (!matcFile.exists()) then
      !records = !matcFile.readFile()
    endif
  endif

  -- return quietly if file not available
  if (undefined(!records)) then
    return
  endif

  -- determine appropriate bolt partnumber attribute
  if (!this.mtoOptions.oldPtnos) then
    !boltNumAtt = 'ptnb'
  else
    !boltNumAtt = 'boltPartnumbers'
  endif

  -- collect dbrefs with bolt partnumbers
  !boltPtnos = ARRAY()
  !boltedComps = ARRAY()
  do !member values !this.members
    if (!member.ce.attribute(!boltNumAtt).set()) then
      do !i to !member.ce.attribute(!boltNumAtt).size()
        !boltedComps.append(!member)
      enddo
      !boltPtnos.appendArray(!member.ce.attribute(!boltNumAtt))
    endif
    -- catch bolt partnumbers at branch level and associate with first member
    if (!member.ce.type ne 'TUBI') then
      if (!member.ce.sequence eq 1) then
        if (!member.ce.owner.attribute(!boltNumAtt).set()) then
          do !i to !member.ce.owner.attribute(!boltNumAtt).size()
            !boltedComps.append(!member)
          enddo
          !boltPtnos.appendArray(!member.ce.owner.attribute(!boltNumAtt))
        endif
      endif
    endif
  enddo

  -- process matc data
  !pos = 0
  do

    -- find significant records
    !pos = !pos + 1
    break if (!pos gt !records.size())
    !recordId = !records[!pos].part(1).real()
    skip if (!recordId ne 60 and !recordId ne 500)

    -- process units info
    if (!recordId eq 60) then
      !impeBoltDiams = (!records[!pos].part(2).real() lt 20)
      skip
    endif

    -- process a bolts record
    if (!recordId eq 500) then

      -- bolt diameter in matc file is in mm or 1/16th of inch, store in mm
      !diameter = !records[!pos].part(2).real()
      if (!impeBoltDiams) then
        !diameter = !diameter / 16 * 25.4
      endif

      -- bolt length in matc file is in mm, store in mm
      !length = !records[!pos].part(7).real()

      -- get other bolt data
      !quantity = !records[!pos].part(5).real()
      !shop = (!records[!pos].part(6).real() eq 1)
      !partNumber = !records[!pos].part(8).real()

      -- get itemCode record including continuation records (id -1)
      break if ((!pos + 1) gt !records.size())
      skip if (!records[!pos + 1].part(1).real() ne -20)
      !pos = !pos + 1
      !itemCode = !records[!pos].subString(9)
      do
        break if ((!pos + 1) gt !records.size())
        break if (!records[!pos + 1].part(1).real() ne -1)
        !pos = !pos + 1
        !itemCode = !itemCode & !records[!pos].subString(9)
      enddo

      -- get optional description including continuation records (id -1)
      break if ((!pos + 1) gt !records.size())
      !description = STRING()
      if (!records[!pos + 1].part(1).real() eq -21) then
        !pos = !pos + 1
        !description = !records[!pos].subString(9)
        do
          break if ((!pos + 1) gt !records.size())
          break if (!records[!pos + 1].part(1).real() ne -1)
          !pos = !pos + 1
          !description = !description & !records[!pos].subString(9)
        enddo
      endif

      -- parent component can be identified if bolts are partnumbered
      if (!partNumber gt 0) then
        !index = !boltPtnos.findFirst(!partNumber)
        if (!index.set()) then
          !this.bolts.append(OBJECT SplMtoBolt(!boltedComps[!index], !diameter, !quantity, !length, !shop, !partNumber, !itemCode, !description))
        else
          -- 'Bolt data in material control file is out of date'
          !!messageFile.error(154, 161)
        endif
      else
        !this.bolts.append(OBJECT SplMtoBolt(OBJECT SplMtoComp(), !diameter, !quantity, !length, !shop, REAL(), !itemCode, !description))
      endif

    endif

  enddo

endmethod
-- End of method definition for .getBolts(FILE)

------------------------------------------------------------------------
--
-- Method:      !boltedHead()
--
-- Description: check if bolts will be allocated to branch head
--
-- Method Type: Function
--
-- Arguments:
--  [1] [R] [DBREF] [element at joint end]
-- Returns:
--  [BOOLEAN] [true if bolted across head]
--
------------------------------------------------------------------------

define method .boltedHead(!element is DBREF) is BOOLEAN

  -- check this is a bolted joint end
  var !joint PA BOLT JOINT OF $!element
  if (!joint ne 'End') then
    return false
  endif

  -- track back along branch checking for bolted joint start
  do !listPos from (!element.order - 1) to 1 by -1
    !previous = !element.owner.members[!listPos]
    var !joint PL BOLT JOINT OF $!previous
    if (!joint eq 'Start') then
      return false
    endif
  enddo

  -- no joint start found so must be bolted across head
  -- bolts will be allocated to head if connected item is not in same pipe
  -- (unless gasket is last member in other pipe - bolts go with gasket)
  -- or if in same pipe but connected other than by pleave
  !connItem = !!splPcref(!element.owner.members.first(), !element.owner.members.first().arrive)
  if (!connItem[2].unset()) then
    return false
  else
    return ((!connItem[2].owner.owner ne !element.owner.owner and $
            !connItem[2].type ne 'GASK') or !connItem[3] ne !connItem[2].leave)
  endif

endmethod
-- End of method definition for .boltedHead(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !boltedNotTail()
--
-- Description: check if bolts will not be allocated downstream
--
-- Method Type: Function
--
-- Arguments:
--  [1] [R] [DBREF] [element at joint start]
-- Returns:
--  [BOOLEAN] [true if bolted across tail]
--
------------------------------------------------------------------------

define method .boltedNotTail(!element is DBREF) is BOOLEAN

  -- check this is a bolted joint start
  var !joint PL BOLT JOINT OF $!element
  if (!joint ne 'Start') then
    return false
  endif

  -- track forward along branch checking for bolted joint end
  do !listPos from (!element.order + 1) to !element.owner.members.size()
    !next = !element.owner.members[!listPos]
    var !joint PA BOLT JOINT OF $!next
    if (!joint eq 'End') then
      return true
    endif
  enddo

  -- no joint end found so must be bolted across tail
  -- bolts will be allocated downstream if connected item is not in same pipe
  -- (unless gasket is last member in this pipe - bolts go with gasket)
  !connItem = !!splPcref(!element.owner.members.last(), !element.owner.members.last().leave)
  if (!connItem[2].unset()) then
    return false
  else
    return (!connItem[2].owner.owner eq !element.owner.owner or $
            !element.owner.members.last().type eq 'GASK')
  endif

endmethod
-- End of method definition for .boltedNotTail(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !getMtorefs()
--
-- Description: get mtoref data
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .getMtorefs()

  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Get mtorefs'
  endif

  -- collect Mtoref items
  do !member values !this.members
    do !i indices !member.ce.mtoref
      !this.mtorefs.append(OBJECT SplMtoMtor(!member, !i, !this.mtoOptions))
    enddo
  enddo

  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

endmethod
-- End of method definition for .getMtorefs()

------------------------------------------------------------------------
--
-- Method:      !addAllow()
--
-- Description: add fitting allowances
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .addAllow()

  -- this method must be called after resolveTubes() and updatePtrs()
  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Add allowances'
  endif

  -- loop through members checking for items with allowances
  do !i indices !this.members

    -- flare backing flange or loose flange allowance
    if (!this.members[!i].ce.type eq 'FLAN') then
      !flare = !this.mtoOptions.flareSkeys.findFirst(!this.members[!i].ce.detRef.skey).set()
      !loose = !this.members[!i].ce.loose
      if (!flare or !loose) then

        -- check for adjacent tube on P2 side, allowing for weld
        !tubeIndex = !this.members[!i].connTubeIndex(2)
        if (!tubeIndex.unset()) then
          !compIndex = !this.members[!i].connCompIndex(2)
          if (!compIndex.set()) then
            if (!this.members[!compIndex].ce.type eq 'WELD') then
              if (!compIndex eq !this.members[!i].prev) then
                !tubeIndex = !this.members[!compIndex].prevTube
              else
                !tubeIndex = !this.members[!compIndex].nextTube
              endif
            endif
          endif
        endif

        -- add overlength if tube found
        if (!tubeIndex.set()) then
          if (!flare) then
            if (!this.mtoOptions.trace) then
              !message = 'Add flare flange allowance at ' & !this.members[!i].ce.fullName
              WRITE '$!message'
            endif
            -- flare allowance from P0 to P3 distance
            !tubeLine = object LINE()
            !tubeLine.startPosition = !this.members[!i].ce.position
            !tubeLine.endPosition = !this.members[!i].ce.pPos[3]
            handle any
              !allowance = 0
            elsehandle none
              if (!tubeLine.startPosition eq !tubeLine.endPosition) then
                !allowance = 0
              else
                !allowance = !tubeLine.length()
              endif
            endhandle
            -- flag flare operation on tube piece with pointer to flange
            !this.cutPieces[!tubeIndex].flarePtr.append(!i)
          elseif (!loose) then
            if (!this.mtoOptions.trace) then
              !message = 'Add loose flange allowance at ' & !this.members[!i].ce.fullName
              WRITE '$!message'
            endif
            -- loose allowance from attribute if set, otherwise from option
            !allowance = !this.members[!i].ce.allowance
            if (!allowance eq 0) then
              !allowance = !this.mtoOptions.fittAllow
            endif
          endif
          -- flag overlength, list allowance, add to length
          !this.cutPieces[!tubeIndex].overLength = true
          !this.cutPieces[!tubeIndex].allowances.append(!allowance)
          !this.cutPieces[!tubeIndex].tubeLength = !this.cutPieces[!tubeIndex].tubeLength + !allowance
        endif

      endif

    -- field fitted weld allowance
    elseif (!this.members[!i].ce.type eq 'WELD') then
      if (!this.members[!i].ce.detRef.skey eq 'WF') then

        -- add allowance to P1 side if tube, otherwise to P2 side if tube
        !tubeIndex = !this.members[!i].connTubeIndex(1)
        if (!tubeIndex.unset()) then
          !tubeIndex = !this.members[!i].connTubeIndex(2)
        endif

        -- add overlength if tube found, use allowance attribute if set
        if (!tubeIndex.set()) then
          if (!this.mtoOptions.trace) then
            !message = 'Add field fitted weld allowance at ' & !this.members[!i].ce.fullName
            WRITE '$!message'
          endif
          !allowance = !this.members[!i].ce.allowance
          if (!allowance eq 0) then
            !allowance = !this.mtoOptions.fittAllow
          endif
          -- flag overlength, list allowance, add to length
          !this.cutPieces[!tubeIndex].overLength = true
          !this.cutPieces[!tubeIndex].allowances.append(!allowance)
          !this.cutPieces[!tubeIndex].tubeLength = !this.cutPieces[!tubeIndex].tubeLength + !allowance
        endif
      endif

    endif
  enddo

  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

endmethod
-- End of method definition for .addAllow()

------------------------------------------------------------------------
--
-- Method:      !buildPtrs()
--
-- Description: build prev/next pointers for members array
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .buildPtrs()

  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Build pointers'
  endif

  -- set next/prev pointers (set two way for efficiency)
  do !i indices !this.members

    if (!this.members[!i].prev.unset()) then
      !prev = !this.prevOf(!i)
      if (!prev.set()) then
        !this.members[!i].prev = !prev
        -- pointer from atta is ok but don't set pointer to atta
        if (!this.members[!i].ce.type ne 'ATTA') then
          !this.members[!prev].next = !i
        endif
      endif
    endif

    if (!this.members[!i].next.unset()) then
      !next = !this.nextOf(!i)
      if (!next.set()) then
        !this.members[!i].next = !next
        -- pointer from atta is ok but don't set pointer to atta
        if (!this.members[!i].ce.type ne 'ATTA') then
          !this.members[!next].prev = !i
        endif
      endif
    endif

  enddo

  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

endmethod
-- End of method definition for .buildPtrs()

------------------------------------------------------------------------
--
-- Method:      !prevRef()
--
-- Description: get reference of previous member
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .prevRef(!element is DBREF) is DBREF

  -- get the previous component
  if (!element.type eq 'TUBI') then
    !prevData = !element.pcref[1]
    handle any
      !prevData = ARRAY()
    endhandle

  else
    !prevData = !element.pcref[!element.arrive]
    handle any
      !prevData = ARRAY()
    endhandle
  endif

  if (!prevData.set()) then
    if (!prevData[3] eq 710633) then
      !prevRefString = 'ileave tube of =' & !prevData[1] & '/' & !prevData[2]
    else
      !prevRefString = '=' & !prevData[1] & '/' & !prevData[2]
    endif
    !prevRef = !prevRefString.dbRef()

    -- check for valid reference
    if(!prevRef.badRef() ) then
       !prevRef = object DBREF()
    else
    -- filter out offline connections into multi way components
       if (!prevRef.type ne 'TUBI') then
         if (!prevRef.type eq 'NOZZ') then
           !prevRef = object DBREF()
         elseif (!prevData[4] ne !prevRef.arrive and !prevData[4] ne !prevRef.leave) then
           !prevRef = object DBREF()
         endif
       endif
    endif

  else
    !prevRef = object DBREF()
  endif

  return !prevRef

endmethod
-- End of method definition for .prevRef(DBREF) DBREF

------------------------------------------------------------------------
--
-- Method:      !nextRef()
--
-- Description: get reference of next member
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .nextRef(!element is DBREF) is DBREF

  -- get the next component
  if (!element.type eq 'TUBI') then
    !nextData = !element.pcref[2]
    handle any
      !prevData = ARRAY()
    endhandle

  else
    !nextData = !element.pcref[!element.leave]
    handle any
      !prevData = ARRAY()
    endhandle
  endif

  if (!nextData.set()) then
    if (!nextData[3] eq 710633) then
      !nextRefString = 'ileave tube of =' & !nextData[1] & '/' & !nextData[2]
    else
      !nextRefString = '=' & !nextData[1] & '/' & !nextData[2]
    endif
    !nextRef = !nextRefString.dbRef()

    -- check for valid reference
    if(!nextRef.badRef() ) then
       !nextRef = object DBREF()
    else
    -- filter out offline connections into multi way components
       if (!nextRef.type ne 'TUBI') then
         if (!nextRef.type eq 'NOZZ') then
           !nextRef = object DBREF()
         elseif (!nextData[4] ne !nextRef.arrive and !nextData[4] ne !nextRef.leave) then
           !nextRef = object DBREF()
         endif
       endif
    endif

  else
    !nextRef = object DBREF()
  endif

  return !nextRef

endmethod
-- End of method definition for .nextRef(DBREF) DBREF

------------------------------------------------------------------------
--
-- Method:      !prevOf()
--
-- Description: get member that precedes member !this.member[!i]
--
-- Method Type: Function
-- Arguments:
--  [1] [R] [REAL] [position in array of current element]
-- Returns:
--  [REAL] [position in array of element that precedes current element]
--
------------------------------------------------------------------------

define method .prevOf(!current is REAL) is REAL

  -- get the previous component
  !prevRef = !this.prevRef(!this.members[!current].ce)
  do
    if (!prevRef.unset()) then
      return REAL()
    elseif (!prevRef.type ne 'ATTA') then
      break
    endif
    !prevRef = !this.prevRef(!prevRef)
  enddo

  -- check for (usual) position alignment on previous in array
  !prev = !current - 1
  if (!prev gt 0) then
    -- check back past one atta before looping through array
    if (!this.members[!prev].ce.type eq 'ATTA') then
      !prev = !prev - 1
    endif
    if (!prev gt 0) then
      if (!this.members[!prev].ce.type ne 'ATTA') then
        if (!prevRef eq !this.members[!prev].ce) then
          return !prev
        endif
      endif
    endif
  endif

  -- check for another element with a coincident ppoint position
  do !i indices !this.members
    skip if (!i eq !current or !this.members[!i].ce.type eq 'ATTA')
    if (!prevRef eq !this.members[!i].ce) then
      return !i
    endif
  enddo

  -- no matching position
  return REAL()

endmethod
-- End of method definition for .prevOf(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      !nextOf()
--
-- Description: get member that follows member !this.member[!i]
--
-- Method Type: Function
-- Arguments:
--  [1] [R] [REAL] [position in array of current element]
-- Returns:
--  [REAL] [position in array of element that follows current element]
--
------------------------------------------------------------------------

define method .nextOf(!current is REAL) is REAL

  -- get the next component
  !nextRef = !this.nextRef(!this.members[!current].ce)
  do
    if (!nextRef.unset()) then
      return REAL()
    elseif (!nextRef.type ne 'ATTA') then
      break
    endif
    !nextRef = !this.nextRef(!nextRef)
  enddo

  -- check for (usual) position alignment on next in array
  !next = !current + 1
  if (!next le !this.members.size()) then
    -- check forward past one atta before looping through array
    if (!this.members[!next].ce.type eq 'ATTA') then
      !next = !next + 1
    endif
    if (!next le !this.members.size()) then
      if (!this.members[!next].ce.type ne 'ATTA') then
        if (!nextRef eq !this.members[!next].ce) then
          return !next
        endif
      endif
    endif
  endif

  -- check for another element with a coincident ppoint position
  do !i indices !this.members
    skip if (!i eq !current or !this.members[!i].ce.type eq 'ATTA')
    if (!nextRef eq !this.members[!i].ce) then
      return !i
    endif
  enddo

  -- no matching position
  return REAL()

endmethod
-- End of method definition for .nextOf(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      !updatePtrs()
--
-- Description: update member pointers into tube array
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .updatePtrs()

  if (!this.mtoOptions.trace) then
    CLOCK INIT
    WRITE 'Update pointers'
  endif

  -- update pointers from members to tube array elements
  -- there may be multiple pointers to a tube piece if attas are present
  do !member values !this.members
    if (!member.prev.set()) then
      if (!this.members[!member.prev].tubePieceNo.set()) then
        !member.prevTube = !this.members[!member.prev].tubePieceNo
        !member.prev = REAL()
      endif
    endif
    if (!member.next.set()) then
      if (!this.members[!member.next].tubePieceNo.set()) then
        !member.nextTube = !this.members[!member.next].tubePieceNo
        !member.next = REAL()
      endif
    endif
  enddo

  -- delete member array elements added to cut pieces
  -- build an index lookup for use after array is compressed
  !count = 0
  do !i indices !this.members
    if (!this.members[!i].tubePieceNo.set()) then
      !this.members[!i].delete()
    else
      !count = !count + 1
      !newMemberIndex[!i] = !count
    endif
  enddo

  -- update pointers from tube array elements to members
  do !piece values !this.cutPieces
    if (!piece.prev.set()) then
      !piece.prev = !newMemberIndex[!piece.prev]
    endif
    if (!piece.next.set()) then
      !piece.next = !newMemberIndex[!piece.next]
    endif
  enddo

  -- then compress member array and update pointers
  !this.members.compress()
  do !member values !this.members
    if (!member.prev.set()) then
      !member.prev = !newMemberIndex[!member.prev]
    endif
    if (!member.next.set()) then
      !member.next = !newMemberIndex[!member.next]
    endif
  enddo

  if (!this.mtoOptions.trace) then
    CLOCK READ ELAPSED
  endif

endmethod
-- End of method definition for .updatePtrs()

------------------------------------------------------------------------
--
-- Method:      !orderForBom(ARRAY)
--
-- Description: return arrays sorted for Bill of Materials
--
-- Method Type: Function
-- Arguments:
--   [1] [RW] [ARRAY] [indices of start of spools/fabrication/erection
--                     in returned array]
-- Returns:
--   [ARRAY] [ordered array of SplMtoComp, SplMtoTube, SplMtoMtor, SplMtoBolt]
--
------------------------------------------------------------------------

define method .orderForBom(!spoolStarts is ARRAY) is ARRAY

  -- combine arrays to sort by spool and partnumber
  !material = !this.members
  !material.appendArray(!this.cutPieces)
  !material.appendArray(!this.bolts)
  !material.appendArray(!this.mtorefs)

  -- remove excluded material
  do !i indices !material
    if (!material[!i].included.not()) then
      !material[!i].delete()
    endif
  enddo
  !material.compress()

  -- string arrays needed for correct action of sort command
  !shopFlags = ARRAY()
  !spoolNumbers = ARRAY()
  !partNumbers = ARRAY()
  do !member values !material
    !shopFlags.append(!member.shop.string())
    !partNumbers.append(!member.partNumber.string())
    !spoolNumbers.append(!member.spoolNumber)
  enddo

  -- sort by spool and part number or sort by fabrication and erection material
  !sortBySpool = !this.mtoOptions.sortBySpool
  if (!sortBySpool and !this.ce.type ne 'SPLDRG') then
    if (!this.ce.smax eq 0) then
      !sortBySpool = false
    endif
  endif

  -- use sort command to do two criteria sort then get real indices
  !spoolStarts = ARRAY()
  if (!sortBySpool) then
    var !newIndex SORT !spoolNumbers FIRST !groupStarts !partNumbers NUMERIC
  else
    var !newIndex SORT !shopFlags DESCENDING FIRST !groupStarts !partNumbers NUMERIC
  endif
  do !i indices !newIndex
    !sortedIndices[!i] = !newIndex[!i].real()
  enddo
  do !i indices !groupStarts
    !spoolStarts[!i] = !groupStarts[!i].real()
  enddo

  -- return sorted material array
  !material.reIndex(!sortedIndices)
  return !material

endmethod
-- End of method definition for .orderForBom(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method:      !listBom()
--
-- Description: list material in BOM order
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [REAL]    [part number column width]
--   [2] [R] [REAL]    [nominal size column width]
--   [3] [R] [REAL]    [description column width]
--   [4] [R] [REAL]    [itemCode column width]
--   [5] [R] [REAL]    [quantity column width]
-- Returns:
--   [ARRAY] [formatted ordered array of STRINGs]
--
------------------------------------------------------------------------

define method .listBom(!ptnoWidth is REAL, !sizeWidth is REAL, !descWidth is REAL, !itemWidth is REAL, !qtyWidth is REAL) is ARRAY

  !data = ARRAY()

  if (!this.groups.size() gt 0) then

    -- recursive format of hierarchy
    do !group values !this.groups
      !data.appendArray(!group.listBom(!ptnoWidth, !sizeWidth, !descWidth, !itemWidth, !qtyWidth))
    enddo

  else

    -- header data
    !session = CURRENT SESSION
    !datetime = object DATETIME()
    !data.append('MTO for ' & !this.ce.fullName & ' ' & !session.name  & ' ' &  !datetime)

    -- get a sorted material list
    !spoolStarts = ARRAY()
    !material = !this.orderForBom(!spoolStarts)

    -- compose titles (fixed but caller can replace them if required)
    var !composed COMPOSE |PT| WIDTH $!ptnoWidth SPACE 2 $
                          |N.S.| WIDTH $!sizeWidth SPACE 1 $
                          |DESCRIPTION| WIDTH $!descWidth SPACE 1 $
                          |ITEMCODE| WIDTH $!itemWidth SPACE 1 $
                          |QTY|  WIDTH $!qtyWidth RIGHT
    !data.appendArray(!composed)

    -- format material data into array
    do !i indices !material

      -- grouping may be by spool number or fabrication/erection
      if (defined(!spoolStarts[!i])) then
        if (!this.mtoOptions.sortBySpool and !material[!i].spoolNumber.set()) then
          !data.append('    --- Spool ' & !material[!i].spoolNumber & ' Material ---')
        elseif (!material[!i].shop) then
          !data.append('    --- Fabrication Material ---')
        else
          !data.append('    --- Erection Material ---')
        endif
      endif

      -- extract data
      !ptno = !material[!i].partNumber.string()
      !size = !material[!i].nominalSize()
      !desc = !material[!i].description
      !item = !material[!i].itemCode
      !qty  = !material[!i].quantity()

      -- compose data
      var !composed COMPOSE |$!ptno| WIDTH $!ptnoWidth RIGHT SPACE 2 $
                            |$!size| WIDTH $!sizeWidth SPACE 1 $
                            |$!desc| WIDTH $!descWidth SPACE 1 $
                            |$!item| WIDTH $!itemWidth SPACE 1 $
                            |$!qty|  WIDTH $!qtyWidth  RIGHT
      !data.appendArray(!composed)

    enddo

  endif

  return !data

endmethod
-- End of method definition for .listBom(REAL, REAL, REAL, REAL, REAL) ARRAY

------------------------------------------------------------------------
--
-- Method:      !listBom()
--
-- Description: list material in BOM order (default column widths)
--
-- Method Type: Function
-- Returns:
--   [ARRAY] [formatted ordered array of STRINGs]
--
------------------------------------------------------------------------

define method .listBom() is ARRAY

  -- default column widths for ptno, size, desc, itemCode, qty
  return !this.listBom(3, 12, 36, 12, 12)

endmethod
-- End of method definition for .listBom() ARRAY

------------------------------------------------------------------------
--
-- Method:      !totalWeights()
--
-- Description: calculate wet weights, total weights and CofGs
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [specific gravity]
--
------------------------------------------------------------------------

define method .totalWeights(!specGravity is REAL)

  -- calculate wet weights
  !this.specGravity = !specGravity
  do !member values !this.members
    !member.wetWeight = !member.dryWeight + !member.volume * !specGravity * 1000
  enddo
  do !piece values !this.cutPieces
    !piece.wetWeight = !piece.dryWeight + !piece.volume * !specGravity * 1000
  enddo
  do !mtoref values !this.mtorefs
    !mtoref.wetWeight = !mtoref.dryWeight
  enddo

  -- calculate total weights and centres of gravity
  !this.dryWeight = 0
  !this.wetWeight = 0
  !sumDryEast = 0
  !sumDryNorth = 0
  !sumDryUp = 0
  !sumWetEast = 0
  !sumWetNorth = 0
  !sumWetUp = 0

  -- component weights
  do !member values !this.members
    !this.dryWeight = !this.dryWeight + !member.dryWeight
    !this.wetWeight = !this.wetWeight + !member.wetWeight
    !sumDryEast  = !sumDryEast  + !member.centOfGrav.east  * !member.dryWeight
    !sumDryNorth = !sumDryNorth + !member.centOfGrav.north * !member.dryWeight
    !sumDryEast  = !sumDryEast  + !member.centOfGrav.up    * !member.dryWeight
    !sumWetEast  = !sumWetEast  + !member.centOfGrav.east  * !member.wetWeight
    !sumWetNorth = !sumWetNorth + !member.centOfGrav.north * !member.wetWeight
    !sumWetEast  = !sumWetEast  + !member.centOfGrav.up    * !member.wetWeight
  enddo

  -- tube weights
  do !piece values !this.cutPieces
    !this.dryWeight = !this.dryWeight + !piece.dryWeight
    !this.wetWeight = !this.wetWeight + !piece.wetWeight
    !sumDryEast  = !sumDryEast  + !piece.centOfGrav.east  * !piece.dryWeight
    !sumDryNorth = !sumDryNorth + !piece.centOfGrav.north * !piece.dryWeight
    !sumDryEast  = !sumDryEast  + !piece.centOfGrav.up    * !piece.dryWeight
    !sumWetEast  = !sumWetEast  + !piece.centOfGrav.east  * !piece.wetWeight
    !sumWetNorth = !sumWetNorth + !piece.centOfGrav.north * !piece.wetWeight
    !sumWetEast  = !sumWetEast  + !piece.centOfGrav.up    * !piece.wetWeight
  enddo

  -- mtoref weights - dry weights only
  do !mtoref values !this.mtorefs
    !this.dryWeight = !this.dryWeight + !mtoref.dryWeight
    !this.wetWeight = !this.wetWeight + !mtoref.dryWeight
    !sumDryEast  = !sumDryEast  + !mtoref.centOfGrav.east  * !mtoref.dryWeight
    !sumDryNorth = !sumDryNorth + !mtoref.centOfGrav.north * !mtoref.dryWeight
    !sumDryEast  = !sumDryEast  + !mtoref.centOfGrav.up    * !mtoref.dryWeight
    !sumWetEast  = !sumWetEast  + !mtoref.centOfGrav.east  * !mtoref.dryWeight
    !sumWetNorth = !sumWetNorth + !mtoref.centOfGrav.north * !mtoref.dryWeight
    !sumWetEast  = !sumWetEast  + !mtoref.centOfGrav.up    * !mtoref.dryWeight
  enddo

  -- get dry centre of gravity
  if (!this.dryWeight gt 0) then
    !this.dryCofG.origin = !this.mtoOptions.origin
    !this.dryCofG.east   = !sumDryEast  / !this.dryWeight
    !this.dryCofG.north  = !sumDryNorth / !this.dryWeight
    !this.dryCofG.up     = !sumDryUp    / !this.dryWeight
  elseif (!this.members.empty().not()) then
    !this.dryCofG = !this.members[1].centOfGrav
  elseif (!this.cutPieces.empty().not()) then
    !this.dryCofG = !this.cutPieces[1].centOfGrav
  endif

  -- get wet centre of gravity
  if (!this.wetWeight gt 0) then
    !this.wetCofG.origin = !this.mtoOptions.origin
    !this.wetCofG.east   = !sumWetEast  / !this.wetWeight
    !this.wetCofG.north  = !sumWetNorth / !this.wetWeight
    !this.wetCofG.up     = !sumWetUp    / !this.wetWeight
  elseif (!this.members.empty().not()) then
    !this.wetCofG = !this.members[1].centOfGrav
  elseif (!this.cutPieces.empty().not()) then
    !this.wetCofG = !this.cutPieces[1].centOfGrav
  endif

endmethod
-- End of method definition for .totalWeights(REAL)

------------------------------------------------------------------------
--
-- Method:      !listMembers()
--
-- Description: list members to screen
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .listMembers()

  do !i indices !this.cutPieces
    WRITE 'Tube Piece $!i'
    !this.cutPieces[!i].listMembers()
  enddo
  do !i indices !this.members
    !name = !this.members[!i].ce.fullName.replace(|'|, |''|)
    WRITE '$!i  $!name'
  enddo

endmethod
-- End of method definition for .listMembers()

------------------------------------------------------------------------
--
-- Method:      !orderFrom()
--
-- Description: list members in order to screen
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [REAL] [start member for sequence]
--
------------------------------------------------------------------------

define method .orderFrom(!startMember is REAL)

  if (defined(!this.members[!startMember])) then

    -- cycle through until break in sequence
    !i = !startMember
    !inTube = false

    do

      -- output current item and get next pointer
      if (!inTube) then

        WRITE 'Tube Piece $!i'
        !this.cutPieces[!i].listMembers()
        !next = !this.cutPieces[!i].next
        !inTube = false

      else

        !name = !this.members[!i].ce.fullName.replace(|'|, |''|)
        WRITE '$!i  $!name'

        -- next item may be component or tube piece
        !next = !this.members[!i].next
        !inTube = false
        if (!next.unset()) then
          !next = !this.members[!i].nextTube
          !inTube = true
        endif

      endif

      -- check for end of sequence
      break if (!next.unset())
      !i = !next

    enddo

  endif

endmethod
-- End of method definition for .orderFrom(REAL)

------------------------------------------------------------------------
--
-- Method:      !print()
--
-- Description: print mto data to screen
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .print()

  -- copy data to screen
  do !line values !this.listBom()
    !text = !line.replace(|'|, |''|)
    WRITE '$!text'
  enddo

endmethod
-- End of method definition for .print()

------------------------------------------------------------------------
--
-- Method:      !print(STRING)
--
-- Description: print mto data to file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .print(!filename is STRING)

  -- append data to file
  !file = object FILE(!filename)
  !file.writeFile('APPEND', !this.listBom())

endmethod
-- End of method definition for .print(STRING)
