-- Created:         Wed Apr 8 13:14:47 BST 1998
--
--
-- Description:
-- Bolt MTO data for piping
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  nominalSize()                    STRING              return nominal size string
--  quantity()                       STRING              return quantity string
--  splMtoBolt(SPLMTOCOMP,REAL,REAL,REAL,BOOLEAN,REAL,STRING,STRING) -                   constructor (material control file data)
--  splMtoBolt(SPLMTOCOMP,REAL,REAL,SPLMTOOPTIONS,BOOLEAN) -                   constructor (new bolting method)
--
------------------------------------------------------------------------

define object SPLMTOBOLT

  -- piping component
  member .ce is DBREF

  -- ppoint number
  member .pPoint is REAL

  -- bolt number for this ppoint
  member .boltNo is REAL

  -- included in MTO
  member .included is BOOLEAN

  -- fabrication/erection
  member .shop is BOOLEAN

  -- part number
  member .partNumber is REAL

  -- spool number
  member .spoolNumber is STRING

  -- bolt spref
  member .spref is DBREF

  -- description
  member .description is STRING

  -- pipe spec
  member .spec is STRING

  -- itemCode
  member .itemCode is STRING

  -- bolt diameter
  member .boltDiameter is REAL

  -- bolt length
  member .boltLength is REAL

  -- number off
  member .numbOff is REAL

endobject
-- End of object definition for SPLMTOBOLT

------------------------------------------------------------------------
--
-- Method:      !splMtoBolt()
--
-- Description: constructor (new bolting method)
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoComp]    [bolted component]
--   [2] [R] [REAL]          [ppoint number]
--   [3] [R] [REAL]          [bolt number for ppoint]
--   [4] [R] [SplMtoOptions] [mto options]
--   [5] [R] [BOOLEAN]       [use partno from branch if true]
--
------------------------------------------------------------------------

define method .splMtoBolt(!element is SPLMTOCOMP, !pPoint is REAL, !boltNo is REAL, !options is SPLMTOOPTIONS, !branPtno is BOOLEAN)

  -- bolt reference data
  !this.ce = !element.ce
  !this.pPoint = !pPoint
  !this.boltNo = !boltNo
  !this.included = !element.included

  -- part number
  if (!branPtno) then
    !ownerOfPtno = !this.ce.owner
  else
    !ownerOfPtno = !this.ce
  endif
  if (!options.oldPtnos) then
    if (!ownerOfPtno.ptnb.set()) then
      if (!ownerOfPtno.ptnb.size() ge !boltNo) then
        !this.partNumber = !ownerOfPtno.ptnb[!boltNo]
      endif
    endif
  else
    if (!ownerOfPtno.boltPartNumber.set()) then
      if (!ownerOfPtno.boltPartNumber.size() ge !boltNo) then
        !this.partNumber = !ownerOfPtno.boltPartNumber[!boltNo]
      endif
    endif
  endif

  -- get bolt data for bolt of ppoint of element
  var !boltLength PPOINT $!pPoint BOLT $!boltNo BLENGTH OF $!<this.ce>
  !this.boltLength = !boltLength.real()

  var !boltDiameter PPOINT $!pPoint BOLT $!boltNo BDIAMETER OF $!<this.ce>
  !this.boltDiameter = !boltDiameter.real()

  var !numbOff PPOINT $!pPoint BOLT $!boltNo NOFF OF $!<this.ce>
  !this.numbOff = !numbOff.real()

  -- get spref and hence description and itemCode
  var !sprefName PPOINT $!pPoint BOLT $!boltNo SPREF OF $!<this.ce>
  !this.spref = !sprefName.dbRef()

  -- description (mtext may be unset)
  if (!options.mtext eq '') then
    !mtext = ''
  else
    !mtext = !this.spref.attribute(!options.mtext)
    handle any
      !mtext = ''
    endhandle
  endif
  if (!mtext ne '') then
    !this.description = !this.spref.attribute(!options.dText) & ' ' & !mtext
  else
    !this.description = !this.spref.attribute(!options.dText)
  endif

  -- prepend bolt length without units label to description
  if (!this.boltLength gt 0) then
    !this.description = !this.boltLength.string(!!splMtoBLenFmt).replace(!!splMtoBLenFmt.label, '') & ' ' & !this.description
  endif

  -- spec and itemCode (with bolt length appended if from spref)
  !this.spec = !this.spref.name.part(2, '/')
  if (!options.clientCodeUda ne '') then
    !this.itemCode = !this.spref.attribute(!options.clientCodeUda)
  else
    if (!options.itemDelimiter eq '') then
      !this.itemCode = !this.spref.name.part(3, '/')
    else
      !this.itemCode = !this.spref.name.part(3, '/').before(!options.itemDelimiter)
    endif
    if (!this.boltLength gt 0) then
      !this.itemCode = !this.itemCode & !this.boltLength.string(!!splMtoBLenFmt).replace(!!splMtoBLenFmt.label, '')
    endif
  endif

  -- extract shop answer from selectors, default shop false
  !this.shop = false
  !specElement = !this.spref
  do
    if (!specElement.owner.question eq 'SHOP') then
      !this.shop = !specElement.tAnswer.boolean()
      handle any
      endhandle
    endif
    !specElement = !specElement.owner
    break if (!specElement.type eq 'SPEC')
  enddo

  -- for shop true bolts take spoolnumber of parent component
  if (!this.shop) then
    !this.spoolNumber = !element.spoolNumber
  endif

endmethod
-- End of method definition for .splMtoBolt(SPLMTOCOMP, REAL, REAL, SPLMTOOPTIONS, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !splMtoBolt()
--
-- Description: constructor (material control file data)
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoComp]    [bolted component]
--   [2] [R] [REAL]          [diameter]
--   [3] [R] [REAL]          [quantity]
--   [4] [R] [REAL]          [length]
--   [5] [R] [BOOLEAN]       [shop]
--   [6] [R] [REAL]          [partnumber]
--   [7] [R] [STRING]        [itemCode]
--   [8] [R] [STRING]        [description]
--
------------------------------------------------------------------------

define method .splMtoBolt(!element is SPLMTOCOMP, !diameter is REAL, !quantity is REAL, !length is REAL, !shop is BOOLEAN, !partNumber is REAL, !itemCode is STRING, !description is STRING)

  -- must be in MTO if in matc file
  !this.included = true

  -- bolt data
  !this.partNumber = !partNumber
  !this.boltLength = !length
  !this.boltDiameter = !diameter
  !this.numbOff = !quantity
  !this.description = !description
  !this.itemCode = !itemCode
  !this.shop = !shop

  -- bolt reference data (only available if partnumbered in matc file)
  if (!element.set()) then
    !this.ce = !element.ce
    !this.spec = !element.spec
    -- for shop true bolts take spoolnumber of parent component
    if (!this.shop) then
      !this.spoolNumber = !element.spoolNumber
    endif
  endif

endmethod
-- End of method definition for .splMtoBolt(SPLMTOCOMP, REAL, REAL, REAL, BOOLEAN, REAL, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      !quantity()
--
-- Description: return quantity string
--
-- Method Type: Function
-- Returns:
--   [STRING] [quantity]
--
------------------------------------------------------------------------

define method .quantity() is STRING

  return !this.numbOff.string('D0')

endmethod
-- End of method definition for .quantity() STRING

------------------------------------------------------------------------
--
-- Method:      !nominalSize()
--
-- Description: return nominal size string
--
-- Method Type: Function
-- Returns:
--   [STRING] [nominal size]
--
------------------------------------------------------------------------

define method .nominalSize() is STRING

  return !this.boltDiameter.string(!!splMtoBDiaFmt)

endmethod
-- End of method definition for .nominalSize() STRING
