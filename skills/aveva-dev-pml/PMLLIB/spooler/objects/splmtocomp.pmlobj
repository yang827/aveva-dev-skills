-- Created:         Mon Apr 6 15:06:22 BST 1998
--
--
-- Description:
-- MTO data for a single piping component
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  attaData(SPLMTOOPTIONS)          -                   specific checks for attas
--  bendData(SPLMTOOPTIONS)          -                   specific checks for bends and elbows
--  compData(SPLMTOOPTIONS)          -                   data for all non tube components
--  connCompIndex(REAL)              REAL                return index of component connected to ppoint
--  connTubeIndex(REAL)              REAL                return index of tube connected to ppoint
--  nominalSize()                    STRING              return nominal size string
--  offsetCofG(REAL,REAL,REAL)       -                   user method to offset centre of gravity data
--  quantity()                       STRING              return quantity string
--  splMtoComp(DBREF,SPLMTOOPTIONS)  -                   constructor
--  teeData(SPLMTOOPTIONS)           -                   specific checks for fabricated tees/crosses and olets
--  tubeData(SPLMTOOPTIONS)          -                   data for implied tubes
--  weldData(SPLMTOOPTIONS)          -                   specific checks for welds
--
------------------------------------------------------------------------

define object SPLMTOCOMP

  -- piping component
  member .ce is DBREF

  -- included in MTO
  member .included is BOOLEAN

  -- component is tube or pulled bend
  member .isTube is BOOLEAN
  member .isBend is BOOLEAN

  -- component is olet
  member .isOlet is BOOLEAN

  -- fabrication/erection
  member .shop is BOOLEAN

  -- tube length for tube or pulled bend
  member .tubeLength is REAL

  -- position in array of SplTubeMto objects that component has been added to
  member .tubePieceNo is REAL

  -- component breaks tube
  member .offline is BOOLEAN

  -- part number
  member .partNumber is REAL

  -- spool number
  member .spoolNumber is STRING

  -- description
  member .description is STRING

  -- pipe spec
  member .spec is STRING

  -- itemCode
  member .itemCode is STRING

  -- nominal sizes
  member .nominalSize1 is BORE
  member .nominalSize2 is BORE
  member .nominalSize3 is BORE
  member .nominalSize4 is BORE

  -- centre of gravity
  member .centOfGrav is POSITION

  -- weights
  member .dryWeight is REAL
  member .wetWeight is REAL

  -- internal volume
  member .volume is REAL

  -- reverse flow
  member .back is BOOLEAN

  -- arrive and leave positions resolved for flow direction
  member .aPos is POSITION
  member .lpos is POSITION

  -- tube overlength flag
  member .overLength is BOOLEAN

  -- indexes into member array of previous and next members
  member .prev is REAL
  member .next is REAL

  -- indexes into tube array
  member .nextTube is REAL
  member .prevTube is REAL

endobject
-- End of object definition for SPLMTOCOMP

------------------------------------------------------------------------
--
-- Method:      !splMtoComp(DBREF,SplMtoOptions)
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]         [Element for MTO]
--   [2] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .splMtoComp(!element is DBREF, !options is SPLMTOOPTIONS)

  -- store ce and initialise data
  !this.ce = !element
  !this.included = true
  !this.offline = false
  !this.isOlet = false
  !this.overLength = false

  -- check for unset spref to fail MTO
  if (!this.ce.spref.badRef()) then
    -- 'Invalid spref at #name'
    !!messageFile.error(154, 162, !this.ce.fullName)
  endif

  -- flow and arrive/leave positions required for resolving tubes
  !this.back = (!this.ce.owner.flow eq 'BACK')
  if (!this.back) then
    !this.aPos = !this.ce.lpos.wrt(!options.origin)
    !this.lpos = !this.ce.aPos.wrt(!options.origin)
  else
    !this.aPos = !this.ce.aPos.wrt(!options.origin)
    !this.lpos = !this.ce.lpos.wrt(!options.origin)
  endif

  -- description (mtext may be unset)
  if (!options.mtext eq '') then
    !mtext = ''
  else
    !mtext = !this.ce.attribute(!options.mtext)
    handle any
      !mtext = ''
    endhandle
  endif
  if (!mtext ne '') then
    !this.description = !this.ce.attribute(!options.dText)
  else
    !this.description = !this.ce.attribute(!options.dText) & ' ' & !mtext
  endif

  -- spec and itemCode
  !this.spec = !this.ce.spref.name.part(2, '/')
  if (!options.clientCodeUda ne '') then
    !this.itemCode = !this.ce.spref.attribute(!options.clientCodeUda)
  else
    if (!options.itemDelimiter eq '') then
      !this.itemCode = !this.ce.spref.name.part(3, '/')
    else
      !this.itemCode = !this.ce.spref.name.part(3, '/').before(!options.itemDelimiter)
    endif
  endif

  -- general type requirements
  if (!this.ce.type eq 'TUBI') then
    !this.tubeData(!options)
  else
    !this.compData(!options)
  endif

  -- specific type requirements
  if (!this.ce.type eq 'BEND' or !this.ce.type eq 'ELBO') then
    !this.bendData(!options)
  elseif (!this.ce.type eq 'TEE' or !this.ce.type eq 'OLET' or !this.ce.type eq 'CROSS') then
    !this.teeData(!options)
  elseif (!this.ce.type eq 'ATTA') then
    !this.attaData(!options)
  elseif (!this.ce.type eq 'WELD') then
    !this.weldData(!options)
  endif

endmethod
-- End of method definition for .splMtoComp(DBREF, SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !compData(SplMtoOptions)
--
-- Description: data for all non tube components
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .compData(!options is SPLMTOOPTIONS)

  -- mark as non tube
  !this.isTube = false
  !this.isBend = false

  -- part number (note old ptno cannot return unset so check for zero)
  if (!options.oldPtnos) then
    if (!this.ce.ptno gt 0) then
      !this.partNumber = !this.ce.ptno
    endif
  else
    !this.partNumber = !this.ce.partNumber
  endif

  -- spool number (note old spln cannot return unset so check for blank)
  if (!options.oldSplns) then
    if (!this.ce.spln.trim() ne '') then
      !this.spoolNumber = !this.ce.spln
    endif
  else
    if (!this.ce.sfref.badRef().not()) then
      if (!this.ce.sfref.type eq 'SPOOL') then
        if(!this.ce.sfref.splPrefix.unset()) then
           !this.spoolNumber = '' & !this.ce.sfref.splNumber
        else
           !this.spoolNumber = !this.ce.sfref.splPrefix & !this.ce.sfref.splNumber
        endif
      endif
    endif
  endif

  -- mto suppressed (unset is equivalent to ON)
  !this.included = (!this.ce.mtoc eq 'ON' or !this.ce.mtoc eq '')

  -- shop flag
  !this.shop = !this.ce.shop

  -- nominal sizes
  !mainSize = 1
  if (!this.ce.ppBore[1].set() and !this.ce.ppBore[2].set()) then
    if (!this.ce.ppBore[2] gt !this.ce.ppBore[1]) then
      !mainSize = 2
    endif
  endif
  if (!mainSize eq 1) then
    !this.nominalSize1 = !this.ce.ppBore[1]
    !this.nominalSize2 = !this.ce.ppBore[2]
  else
    !this.nominalSize1 = !this.ce.ppBore[2]
    !this.nominalSize2 = !this.ce.ppBore[1]
  endif

  if (!this.ce.pplst.size() gt 2) then
   !this.nominalSize3 = !this.ce.ppBore[3]
   Handle any
     !this.nominalSize3 = object bore()
   endhandle
   !this.nominalSize4 = !this.ce.ppBore[4]
   Handle any
     !this.nominalSize4 = object bore()
   endhandle
  endif

  -- weights and CofG
  !this.dryWeight = !this.ce.spref.cmpref.cwei
  handle any
    !this.dryWeight = 0
  endhandle
  if (!this.dryWeight.unset()) then
    !this.dryWeight = 0
  endif
  !this.centOfGrav = !this.ce.position.wrt(!options.origin)

  -- calculate internal volume using actual bore if available into m3
  !bore = !this.ce.spref.cmpref.acbo.real()
  handle any
    !bore = 0
  endhandle
  if (!bore.unset()) then
    !bore = 0
  endif
  if (!bore eq 0) then
    !bore = !this.nominalSize1.real()
  endif
  !layLine = object LINE()
  !layLine.startPosition = !this.aPos
  !layLine.endPosition = !this.lpos
  if (!layLine.startPosition eq !layLine.endPosition) then
    !layLength = 0
  else
    !layLength = !layLine.length()
  endif
  -- !this.volume = 3.14159 * !bore * !bore * !layLength / 4000000000
  !rad = !bore / 2
  !mmVolume = 3.14159 * !rad.power(2) * !layLength
  -- convert volume from mm3 to m3
  !this.volume = !mmVolume / 1000000000

endmethod
-- End of method definition for .compData(SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !tubeData(SplMtoOptions)
--
-- Description: data for implied tubes
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .tubeData(!options is SPLMTOOPTIONS)

  -- mark as tube
  !this.isTube = true
  !this.isBend = false

  -- part number
  if (!options.oldPtnos.not()) then
    !this.partNumber = !this.ce.partNumber
  endif

  -- spool number
  if (!options.oldSplns.not()) then
    if (!this.ce.sfref.badRef().not()) then
      if (!this.ce.sfref.type eq 'SPOOL') then
        if(!this.ce.sfref.splPrefix.unset()) then
           !this.spoolNumber = '' & !this.ce.sfref.splNumber
        else
           !this.spoolNumber = !this.ce.sfref.splPrefix & !this.ce.sfref.splNumber
        endif
      endif
    endif
  endif

  -- shop flag (awaiting a pseudo attribute for shop on tube)
  -- !this.shop = !this.ce.shop
  -- also mto status and old ptno and spln attributes
  !!ce = !this.ce
  PREVIOUS
  -- List exhausted means head tube
  handle (2,113)
    END
  endhandle
  if (!!ce.type eq 'BRAN') then
    -- Head tube
    var !tubeShop HEADTUBE SHOP
    !mtoStatus = !!ce.mtoh
    if (!options.oldPtnos) then
      if (!!ce.ptnh gt 0) then
        !this.partNumber = !!ce.ptnh
      endif
    endif
    if (!options.oldSplns) then
      if (!!ce.splh.trim() ne '') then
        !this.spoolNumber = !!ce.splh
      endif
    endif
  else
    -- Leave tube
    var !tubeShop LEAVETUBE SHOP
    !mtoStatus = !!ce.mtot
    if (!options.oldPtnos) then
      if (!!ce.ptnt gt 0) then
        !this.partNumber = !!ce.ptnt
      endif
    endif
    if (!options.oldSplns) then
      if (!!ce.splt.trim() ne '') then
        !this.spoolNumber = !!ce.splt
      endif
    endif
  endif
  !this.shop = !tubeShop.boolean()

  -- mto suppressed (unset is equivalent to ON)
  !this.included = (!mtoStatus eq 'ON' or !mtoStatus eq '')

  -- nominal sizes
  !this.tubeLength = !this.ce.itLength
  !this.nominalSize1 = !this.ce.ppBore[1]

  -- weights and CofG
  !this.dryWeight = !this.ce.spref.cmpref.uwei
  handle any
    !this.dryWeight = 0
  endhandle
  if (!this.dryWeight.unset()) then
    !this.dryWeight = 0
  endif
  !this.centOfGrav = !this.ce.itPosition.wrt(!options.origin)

endmethod
-- End of method definition for .tubeData(SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !bendData(SplMtoOptions)
--
-- Description: specific checks for bends and elbows
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .bendData(!options is SPLMTOOPTIONS)

  -- zero length bend is not part of MTO
  if (!this.ce.aPos eq !this.ce.lpos) then
    !this.included = false

  -- pulled bend is part of tube
  elseif (!this.ce.detRef.skey.matchWild('PB?D') or !this.ce.detRef.skey.matchWild('BU?D')) then
    !this.included = true
    !this.offline = true
    !this.isTube = true
    !this.isBend = true
    !this.tubeLength = 3.14159 * !this.ce.radius * !this.ce.angle / 180

    -- partnumber for pulled bend is taken from leave tube setting
    if (!options.oldPtnos.not()) then
      !!ce = ILEAVE TUBE of $!<this.ce>
      !this.partNumber = !!ce.partNumber
    else
      !this.partNumber = !this.ce.ptnt
    endif


  elseif (!options.mitresAsTube) then

    -- plain ended mitred components included in tube length
    if (!this.ce.detRef.skey.matchWild('L?PL') or !this.ce.detRef.skey eq 'MIPL') then
      !this.included = true
      !this.offline = true
      !this.isTube = true
      !this.isBend = false

      -- set length as twice leg length (parrive to p0)
      !tubeLine = object LINE()
      !tubeLine.startPosition = !this.aPos
      !tubeLine.endPosition = !this.ce.position
      if (!tubeLine.startPosition eq !tubeLine.endPosition) then
        !this.tubeLength = 0
      else
        !this.tubeLength = 2 * !tubeLine.length()
      endif
    endif

  endif

endmethod
-- End of method definition for .bendData(SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !teeData(SplMtoOptions)
--
-- Description: specific checks for fabricated tees/crosses and olets
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .teeData(!options is SPLMTOOPTIONS)

  -- fabricated tees are not part of MTO and do not break tube
  if (!options.fabTeeSkeys.findFirst(!this.ce.detRef.skey).set()) then
    !this.included = false
    !this.offline = true

    -- SplMto cannot at present calculate tubes when not straight through offline tees
    if (!this.ce.arrive gt 2 or !this.ce.leave gt 2) then
      -- 'SplMto cannot calculate tube pieces - main branch not inline through #name'
      !!messageFile.error(154, 164, !this.ce.fullName)
    endif

  -- olets do not break tube
  elseif (!options.oletSkeys.findFirst(!this.ce.detRef.skey.subString(1,2)).set()) then
    !this.offline = true
    !this.isOlet = true

    -- SplMto cannot at present calculate tubes when not straight through offline tees
    if (!this.ce.arrive gt 2 or !this.ce.leave gt 2) then
      -- 'SplMto cannot calculate tube pieces - main branch not inline through #name'
      !!messageFile.error(154, 164, !this.ce.fullName)
    endif

  endif

endmethod
-- End of method definition for .teeData(SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !attaData(SplMtoOptions)
--
-- Description: specific checks for attas
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .attaData(!options is SPLMTOOPTIONS)

  -- attas do not break tube
  !this.offline = true

  -- non support attas are not part of MTO
  if (!options.nonMtoAttaSkeys.findFirst(!this.ce.atty).set()) then
    !this.included = false
  endif

endmethod
-- End of method definition for .attaData(SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !weldData(SplMtoOptions)
--
-- Description: specific checks for welds
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .weldData(!options is SPLMTOOPTIONS)

  -- welds are not part of MTO
  !this.included = false

endmethod
-- End of method definition for .weldData(SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !connCompIndex(REAL)
--
-- Description: return index of component connected to ppoint
--
-- Method Type: Function
-- Returns:
--  [REAL] [index in member array of element connected to ppoint]
--
------------------------------------------------------------------------

define method .connCompIndex(!pPoint is REAL) is REAL

  !returnData = REAL()

  -- get arrive or leave and resolve on flow
  if (!this.ce.arrive eq !pPoint) then
    if (!this.back) then
      !returnData = !this.next
    else
      !returnData = !this.prev
    endif
  elseif (!this.ce.leave eq !pPoint) then
    if (!this.back) then
      !returnData = !this.prev
    else
      !returnData = !this.next
    endif
  endif

  return !returnData

endmethod
-- End of method definition for .connCompIndex(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      !connTubeIndex(REAL)
--
-- Description: return index of tube connected to ppoint
--
-- Method Type: Function
-- Returns:
--  [REAL] [index in tube array of element connected to ppoint]
--
------------------------------------------------------------------------

define method .connTubeIndex(!pPoint is REAL) is REAL

  !returnData = REAL()

  -- get arrive or leave and resolve on flow
  if (!this.ce.arrive eq !pPoint) then
    if (!this.back) then
      !returnData = !this.nextTube
    else
      !returnData = !this.prevTube
    endif
  elseif (!this.ce.leave eq !pPoint) then
    if (!this.back) then
      !returnData = !this.prevTube
    else
      !returnData = !this.nextTube
    endif
  endif

  return !returnData

endmethod
-- End of method definition for .connTubeIndex(REAL) REAL

------------------------------------------------------------------------
--
-- Method:      !offsetCofG(REAL,REAL,REAL)
--
-- Description: user method to offset centre of gravity data
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [offset East]
--   [2] [R] [REAL] [offset North]
--   [3] [R] [REAL] [offset Up]
--
------------------------------------------------------------------------

define method .offsetCofG(!east is REAL, !north is REAL, !up is REAL)

  -- reposition c of g where offset provided
  if (!east.set()) then
    !this.centOfGrav.east = !this.centOfGrav.east + !east
  endif
  if (!north.set()) then
    !this.centOfGrav.north = !this.centOfGrav.north + !north
  endif
  if (!up.set()) then
    !this.centOfGrav.up = !this.centOfGrav.up + !up
  endif

endmethod
-- End of method definition for .offsetCofG(REAL, REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      !quantity()
--
-- Description: return quantity string
--
-- Method Type: Function
-- Returns:
--   [STRING] [quantity]
--
------------------------------------------------------------------------

define method .quantity() is STRING

  return '1'

endmethod
-- End of method definition for .quantity() STRING

------------------------------------------------------------------------
--
-- Method:      !nominalSize()
--
-- Description: return nominal size string
--
-- Method Type: Function
-- Returns:
--   [STRING] [nominal size]
--
------------------------------------------------------------------------

define method .nominalSize() is STRING

  -- combine nominal sizes
  !sizes = ARRAY()
  !size = !this.nominalSize1.string(!!splMtoBoreFmt)
  if (!this.nominalSize1.set()) then
    !sizes.append(!this.nominalSize1)
  endif
  if (!this.nominalSize2.set()) then
    if (!sizes.findFirst(!this.nominalSize2).unset()) then
      !size = !size & 'x' & !this.nominalSize2.string(!!splMtoBoreFmt)
    endif
    !sizes.append(!this.nominalSize2)
  endif
  if (!this.nominalSize3.set()) then
    if (!sizes.findFirst(!this.nominalSize3).unset()) then
      !size = !size & 'x' & !this.nominalSize3.string(!!splMtoBoreFmt)
    endif
    !sizes.append(!this.nominalSize3)
  endif
  if (!this.nominalSize4.set()) then
    if (!sizes.findFirst(!this.nominalSize4).unset()) then
      !size = !size & 'x' & !this.nominalSize4.string(!!splMtoBoreFmt)
    endif
    !sizes.append(!this.nominalSize4)
  endif

  -- strip off all except last units text
  return !size.replace(!!splMtoBoreFmt.label, '') & !!splMtoBoreFmt.label

endmethod
-- End of method definition for .nominalSize() STRING
