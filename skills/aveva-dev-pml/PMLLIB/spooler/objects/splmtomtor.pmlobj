-- File:            splmtomtor.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Apr 9 10:30:40 BST 1998
--
--
-- Description:
-- Piping MTO for additional MTO items
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  nominalSize()                    STRING              return nominal size string
--  quantity()                       STRING              return quantity string
--  splMtoMtor(SPLMTOCOMP,REAL,SPLMTOOPTIONS) -                   constructor
--
------------------------------------------------------------------------

define object SPLMTOMTOR

  -- piping component
  member .ce is DBREF

  -- mtoref number
  member .mtorNumb is REAL

  -- type
  member .type is STRING

  -- included in MTO
  member .included is BOOLEAN

  -- fabrication/erection
  member .shop is BOOLEAN

  -- part number
  member .partNumber is REAL

  -- spool number
  member .spoolNumber is STRING

  -- mtoref spref
  member .spref is DBREF

  -- description
  member .description is STRING

  -- pipe spec
  member .spec is STRING

  -- itemCode
  member .itemCode is STRING

  -- length or quantity (only one is set)
  member .length is REAL
  member .quantity is REAL

  -- nominal size
  member .nominalSize is BORE

  -- centre of gravity
  member .centOfGrav is POSITION

  -- weights
  member .dryWeight is REAL
  member .wetWeight is REAL

endobject
-- End of object definition for SPLMTOMTOR

------------------------------------------------------------------------
--
-- Method:      !splMtoMtor()
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [SplMtoComp]    [parent component]
--   [2] [R] [REAL]          [mtoref number]
--   [3] [R] [SplMtoOptions] [mto options]
--
------------------------------------------------------------------------

define method .splMtoMtor(!element is SPLMTOCOMP, !mtorNumb is REAL, !options is SPLMTOOPTIONS)

  -- reference data
  !this.ce = !element.ce
  !this.mtorNumb = !mtorNumb
  !this.included = !element.included
  !this.centOfGrav = !element.centOfGrav

  -- part number
  if (!options.oldPtnos) then
    if (!this.ce.mtox.set()) then
      if (!this.ce.mtox.size() ge !mtorNumb) then
        !this.partNumber = !this.ce.mtox[!mtorNumb]
      endif
    endif
  else
    if (!this.ce.mtoPartNumbers.set()) then
      if (!this.ce.mtoPartNumber.size() ge !mtorNumb) then
        !this.partNumber = !this.ce.mtoPartNumber[!mtorNumb]
      endif
    endif
  endif

  -- get spref and hence description and itemCode
  !this.spref = !this.ce.mtoref[!mtorNumb]

  -- description (mtext may be unset)
  if (!options.mtext eq '') then
    !mtext = ''
  else
    !mtext = !this.spref.attribute(!options.mtext)
    handle any
      !mtext = ''
    endhandle
  endif
  if (!mtext ne '') then
    !this.description = !this.spref.attribute(!options.dText)
  else
    !this.description = !this.spref.attribute(!options.dText) & ' ' & !mtext
  endif

  -- spec and itemCode
  !this.spec = !this.spref.name.part(2, '/')
  if (!options.clientCodeUda ne '') then
    !this.itemCode = !this.spref.attribute(!options.clientCodeUda)
  else
    if (!options.itemDelimiter eq '') then
      !this.itemCode = !this.spref.name.part(3, '/')
    else
      !this.itemCode = !this.spref.name.part(3, '/').before(!options.itemDelimiter)
    endif
  endif

  -- length or quantity (length takes precedence) and weight
  !this.length = !this.spref.detRef.mtol
  if (!this.length.unset()) then
    !this.length = 0
  endif
  if (!this.length gt 0) then
    !this.dryWeight = !this.spref.cmpref.uwei * !this.length / 1000
    handle any
      !this.dryWeight = 0
    endhandle
  else
    !this.quantity = !this.spref.detRef.mtoq
    !this.dryWeight = !this.spref.cmpref.cwei * !this.quantity
    handle any
      !this.dryWeight = 0
    endhandle
  endif
  if (!this.quantity.unset()) then
    !this.quantity = 0
  endif

  -- defaults for type and pbor from parent component, default shop false
  !this.type = 'MTOR'
  !this.nominalSize = !element.nominalSize1
  !this.shop = false

  -- extract type, pbor and shop answers from selectors
  !specElement = !this.spref
  do
    if (!specElement.owner.question eq 'TYPE') then
      !this.type = !specElement.tAnswer
    elseif (!specElement.owner.question eq 'PBOR') then
      !this.nominalSize = !specElement.answer
      handle any
      endhandle
    elseif (!specElement.owner.question eq 'SHOP') then
      !this.shop = !specElement.tAnswer.boolean()
      handle any
      endhandle
    endif
    !specElement = !specElement.owner
    break if (!specElement.type eq 'SPEC')
  enddo

  -- for shop true items take spoolnumber of parent component
  if (!this.shop) then
    !this.spoolNumber = !element.spoolNumber
  endif

endmethod
-- End of method definition for .splMtoMtor(SPLMTOCOMP, REAL, SPLMTOOPTIONS)

------------------------------------------------------------------------
--
-- Method:      !quantity()
--
-- Description: return quantity string
--
-- Method Type: Function
-- Returns:
--   [STRING] [quantity]
--
------------------------------------------------------------------------

define method .quantity() is STRING

  -- length takes precedence
  if (!this.length.gt(0)) then
    return !this.length.string(!!splMtoDistFmt)
  else
    return !this.quantity.string('D0')
  endif

endmethod
-- End of method definition for .quantity() STRING

------------------------------------------------------------------------
--
-- Method:      !nominalSize()
--
-- Description: return nominal size string
--
-- Method Type: Function
-- Returns:
--   [STRING] [nominal size]
--
------------------------------------------------------------------------

define method .nominalSize() is STRING

  return !this.nominalSize.string(!!splMtoBoreFmt)

endmethod
-- End of method definition for .nominalSize() STRING
