------------------------------------------------------------------------
--
-- Method:      !longItemcodes()
--
-- Description: set long itemCodes (include spec name) flag
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [long itemCodes flag]
--
------------------------------------------------------------------------

define method .longItemcodes(!long is BOOLEAN)

  !this.longItemcodes = !long

endmethod
-- End of method definition for .longItemcodes(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !itemDelimiter()
--
-- Description: set itemCode delimiter
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [delimiter string]
--
------------------------------------------------------------------------

define method .itemDelimiter(!delimiter is STRING)

  !this.itemDelimiter = !delimiter

endmethod
-- End of method definition for .itemDelimiter(STRING)

------------------------------------------------------------------------
--
-- Method:      !clientCodeUda()
--
-- Description: set client itemCode uda
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [client itemCode uda name]
--
------------------------------------------------------------------------

define method .clientCodeUda(!udaName is STRING)

  -- allow for null string but add colon if uda name omits it
  if (!udaName eq '' or !udaName.subString(1,1) eq ':') then
    !this.clientCodeUda = !udaName
  else
    !this.clientCodeUda = ':' & !udaName
  endif

endmethod
-- End of method definition for .clientCodeUda(STRING)

------------------------------------------------------------------------
--
-- Method:      !fittAllow()
--
-- Description: set fitting allowance
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [fitting allowance]
--
------------------------------------------------------------------------

define method .fittAllow(!allowance is REAL)

  !this.fittAllow = !allowance

endmethod
-- End of method definition for .fittAllow(REAL)

------------------------------------------------------------------------
--
-- Method:      !oldPtnos()
--
-- Description: set old design ptnos flag
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [old ptnos flag]
--
------------------------------------------------------------------------

define method .oldPtnos(!ptnos is BOOLEAN)

  !this.oldPtnos = !ptnos

endmethod
-- End of method definition for .oldPtnos(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !oldSplns()
--
-- Description: set old design splns flag
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [old splns flag]
--
------------------------------------------------------------------------

define method .oldSplns(!splns is BOOLEAN)

  !this.oldSplns = !splns

