-- End of method definition for .oldSplns(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !mitresAsTube()
--
-- Description: set mitres in tube length flag
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [mitres in tube length flag]
--
------------------------------------------------------------------------

define method .mitresAsTube(!mitres is BOOLEAN)

  !this.mitresAsTube = !mitres

endmethod
-- End of method definition for .mitresAsTube(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !addOletSkey()
--
-- Description: add a user defined olet skey
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [olet skey]
--
------------------------------------------------------------------------

define method .addOletSkey(!skey is STRING)

  !this.oletSkeys.append(!skey)

endmethod
-- End of method definition for .addOletSkey(STRING)

------------------------------------------------------------------------
--
-- Method:      !removeOletSkey()
--
-- Description: remove a user defined olet skey
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [olet skey]
--
------------------------------------------------------------------------

define method .removeOletSkey(!skey is STRING)

  !index = !this.oletSkeys.findFirst(!skey)
  if (!index.set()) then
    !this.oletSkeys.remove(!index)
  endif

endmethod
-- End of method definition for .removeOletSkey(STRING)

------------------------------------------------------------------------
--
-- Method:      !addFlareSkey()
--
-- Description: add a user defined flare flange skey
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [olet skey]
--
------------------------------------------------------------------------

define method .addFlareSkey(!skey is STRING)

  !this.flareSkeys.append(!skey)

endmethod
-- End of method definition for .addFlareSkey(STRING)

------------------------------------------------------------------------
--
-- Method:      !removeFlareSkey()
--
-- Description: remove a user defined flare flange skey
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [olet skey]
--
------------------------------------------------------------------------

define method .removeFlareSkey(!skey is STRING)

  !index = !this.flareSkeys.findFirst(!skey)
  if (!index.set()) then
    !this.flareSkeys.remove(!index)
  endif

endmethod
-- End of method definition for .removeFlareSkey(STRING)

------------------------------------------------------------------------
--
-- Method:      !addBendGripRule()
--
-- Description: add a bend grip length and rule
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL]   [grip length]
--   [2] [R] [STRING] [bend rule]
--
------------------------------------------------------------------------

define method .addBendGripRule(!length is REAL, !rule is STRING)

  !this.bendGripLengths.append(!length)
  !this.bendGripRules.append(!rule)

endmethod
-- End of method definition for .addBendGripRule(REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      !origin(DBREF)
--
-- Description: set origin for positions
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [element to be used as origin for positions]
--
------------------------------------------------------------------------

define method .origin(!element is DBREF)

  !this.origin = !element

endmethod
-- End of method definition for .origin(DBREF)

------------------------------------------------------------------------
--
-- Method:      !origin(STRING)
--
-- Description: set origin for positions
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [STRING] [name of element to be used as origin for positions]
--
------------------------------------------------------------------------

define method .origin(!element is STRING)

  !this.origin = !element.dbRef()

endmethod
-- End of method definition for .origin(STRING)

------------------------------------------------------------------------
