--
-- Author:          M.Lewis
-- Created:         Wed Apr 8 07:29:04 BST 1998
--
--
-- Description:
-- Options for piping MTO object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addBendGripRule(REAL,STRING)     -                   add a bend grip length and rule
--  addFlareSkey(STRING)             -                   add a user defined flare flange skey
--  addOletSkey(STRING)              -                   add a user defined olet skey
--  clientCodeUda(STRING)            -                   set client itemCode uda
--  dTextR()                         -                   set dtext to use rtext
--  dTextT()                         -                   set dtext to use ttext
--  dTexts()                         -                   set dtext to use stext
--  fittAllow(REAL)                  -                   set fitting allowance
--  itemDelimiter(STRING)            -                   set itemCode delimiter
--  longItemcodes(BOOLEAN)           -                   set long itemCodes (include spec name) flag
--  mTextOff()                       -                   ignore mText
--  mTextX()                         -                   set mText to use xtext
--  mTextY()                         -                   set mText to use ytext
--  mTextZ()                         -                   set mText to use ztext
--  mitresAsTube(BOOLEAN)            -                   set mitres in tube length flag
--  oldPtnos(BOOLEAN)                -                   set old design ptnos flag
--  oldSplns(BOOLEAN)                -                   set old design splns flag
--  origin(DBREF)                    -                   set origin for positions
--  origin(STRING)                   -                   set origin for positions
--  removeFlareSkey(STRING)          -                   remove a user defined flare flange skey
--  removeOletSkey(STRING)           -                   remove a user defined olet skey
--  sortBySpool(BOOLEAN)             -                   set sort by spool flag
--  splMtoOptions()                  -                   constructor
--  trace(BOOLEAN)                   -                   set splMto trace flag
--
---------------------------
-- rule must use temporary array !bends[!evalIndex] and evaluate to boolean, e.g.
-- '(!bends[!evalIndex].ppBore[1].gt(15) and !bends[!evalIndex].ppBore[1].leq(100))'
--
------------------------------------------------------------------------

define object SPLMTOOPTIONS

  -- detail text attribute option, dtxR, dtxS or dtxT
  member .dText is STRING

  -- material text attribute option, mtxX, mtxY, mtxZ or null (off)
  member .mText is STRING

  -- itemCodes to include spec name
  member .longItemcodes is BOOLEAN

  -- itemCode delimiter
  member .itemDelimiter is STRING

  -- uda for client itemCodes
  member .clientCodeUda is STRING

  -- tube fitting allowance for loose flanges and field fitted welds
  member .fittAllow is REAL

  -- use old design ptnos instead of spooler partnumbers
  member .oldPtnos is BOOLEAN

  -- use old design splns instead of spooler splnumbers
  member .oldSplns is BOOLEAN

  -- include mitred elbows/bends in tube length
  member .mitresAsTube is BOOLEAN

  -- skeys for fabricated tees and crosses
  member .fabTeeSkeys is ARRAY

  -- skeys for olets
  member .oletSkeys is ARRAY

  -- skeys for flare flange
  member .flareSkeys is ARRAY

  -- skeys for non-MTO attas
  member .nonMtoAttaSkeys is ARRAY

  -- bend grip lengths and rules
  member .bendGripLengths is ARRAY
  member .bendGripRules is ARRAY

  -- positions relative to dbref (will use world if unset)
  member .origin is DBREF

  -- sort by spool option for BOM order
  member .sortBySpool is BOOLEAN

  -- splMto tracing
  member .trace is BOOLEAN

endobject
-- End of object definition for SPLMTOOPTIONS

------------------------------------------------------------------------
--
-- Method:      !splMtoOptions()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splMtoOptions()

  -- default options for MTO correspond to default Isodraft options
  !this.dText = 'dtxRtext'
  !this.mText = 'mtxXtext'
  !this.longItemcodes = false
  !this.itemDelimiter = ':'
  !this.clientCodeUda = ''
  !this.fittAllow = 150mm
  !this.oldPtnos = false
  !this.oldSplns = false
  !this.mitresAsTube = false
  !this.sortBySpool = true
  !this.trace = false

  -- default fabricated tees and crosses
  !this.fabTeeSkeys.append('TESO')
  !this.fabTeeSkeys.append('TPUL')
  !this.fabTeeSkeys.append('TERF')
  !this.fabTeeSkeys.append('CRSO')
  !this.fabTeeSkeys.append('CRRF')

  -- default olet skeys, first two characters only, others are connection type
  !this.oletSkeys.append('HC')
  !this.oletSkeys.append('LA')
  !this.oletSkeys.append('NI')
  !this.oletSkeys.append('SK')
  !this.oletSkeys.append('SW')
  !this.oletSkeys.append('TH')
  !this.oletSkeys.append('WT')

  -- default flare flange skey
  !this.flareSkeys.append('FLFL')

  -- default non MTO attas
  !this.nonMtoAttaSkeys.append('CCCC')
  !this.nonMtoAttaSkeys.append('CCNN')
  !this.nonMtoAttaSkeys.append('FLOW')
  !this.nonMtoAttaSkeys.append('XXXX')
  !this.nonMtoAttaSkeys.append('SSSS')
  !this.nonMtoAttaSkeys.append('INPP')

  -- default bend grip lengths and rules (for testing)
  -- !this.addBendGripRule(200, '(!bends[!evalIndex].ppBore[1].gt(15) and !bends[!evalIndex].ppBore[1].leq(100))')
  -- !this.addBendGripRule(400, '(!bends[!evalIndex].ppBore[1].gt(100) and !bends[!evalIndex].ppBore[1].leq(200))')

  -- note that no origin default is set here because we may not be in a design
  -- db when this object is constructed, but splMto will use the world of the
  -- first component, and set that dbref here if it is initially unset

endmethod
-- End of method definition for .splMtoOptions()

------------------------------------------------------------------------
--
-- Method:      !dTextR()
--
-- Description: set dtext to use rtext
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dTextR()

  !this.dText = 'dtxRtext'

endmethod
-- End of method definition for .dTextR()

------------------------------------------------------------------------
