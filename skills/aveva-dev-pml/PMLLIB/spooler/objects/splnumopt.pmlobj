--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        spooler
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Aug 18 14:12:58 BST 1997
--
--
-- Description:
-- Object to store spooler options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  bends()                          BOOLEAN             get the bends option
--  bends(BOOLEAN)                   -                   set the bends option
--  copyToGlobal()                   -                   copy the object to the global instance
--  coreSettings()                   -                   Align all core settings with the member values
--  default(BOOLEAN)                 -                   Default options settings
--  edit()                           -                   edit the options via the GUI
--  fields()                         BOOLEAN             get the fields option
--  fields(BOOLEAN)                  -                   set the fields option
--  globalInstance()                 -                   create a global instance of the object
--  interactive()                    STRING              get the interactive option
--  interactive(STRING)              -                   set the interactive option
--  joints()                         BOOLEAN             get the joints option
--  joints(BOOLEAN)                  -                   set the joints option
--  load()                           -                   Load options from system and user files
--  localCopy()                      SPLNUMOPT           return a local copy of the object
--  parts()                          BOOLEAN             get the parts option
--  parts(BOOLEAN)                   -                   set the parts option
--  perSpool()                       STRING              get the perSpool option
--  perSpool(STRING)                 -                   set the perSpool option
--  pulledBends()                    BOOLEAN             get the pulled bends option
--  pulledBends(BOOLEAN)             -                   set the pulled bends option
--  save()                           -                   Save options settings to %PDMSUSER%
--  splNumOpt()                      -                   Constructor
--  splNumOpt(BOOLEAN)               -                   Constructor
--  splPrefix()                      STRING              get the splPrefix option
--  splPrefix(STRING)                -                   set/get the splPrefix option
--  spools()                         BOOLEAN             get the spools option
--  spools(BOOLEAN)                  -                   set the spools option
--  welds()                          BOOLEAN             get the welds option
--  welds(BOOLEAN)                   -                   set the welds option
--
------------------------------------------------------------------------

-- Define object
define object SPLNUMOPT

  -- member to hold the status of the current user
  -- true indicates administrator status, otherwise false.
  member .adminStatus is BOOLEAN

  -- current options file name for this object
  member .filename is STRING

  -- global object flag, if set then global core options are also set
  member .global is BOOLEAN

  -- members to store numbering options
  member .spools is BOOLEAN
  member .fields is BOOLEAN
  member .welds is BOOLEAN
  member .joints is BOOLEAN
  member .parts is BOOLEAN
  member .bends is BOOLEAN
  member .splPrefix is STRING
  member .perSpool is STRING
  member .interactive is STRING
  member .pulledBends is BOOLEAN

endobject
-- End of object definition for SPLNUMOPT

------------------------------------------------------------------------
--
-- Method:      !splNumOpt()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splNumOpt()

  -- set file name
  !this.filename = 'spl-num.pmldat'

  -- initialise the global flag
  !this.global = false

  -- set the default values
  !this.default(false)

  -- Check team for Spooler General Admin
  !validTeam[1] = 'MASTER'
  !validTeam[2] = 'SPLADMIN'
  !this.adminStatus = !!comTeamCheck(!validTeam)

endmethod
-- End of method definition for .splNumOpt()

------------------------------------------------------------------------
--
-- Method:      !splNumOpt(BOOLEAN)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------

-- Define method
define method .splNumOpt(!globalValue is BOOLEAN)

  -- set file name
  !this.filename = 'spl-num.pmldat'

  -- initialise the global flag
  !this.global = !globalValue

  -- set the default values
  !this.default(!globalValue)

  -- Check team for Spooler General Admin
  !validTeam[1] = 'MASTER'
  !validTeam[2] = 'SPLADMIN'
  !this.adminStatus = !!comTeamCheck(!validTeam)

endmethod
-- End of method definition for .splNumOpt(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !default(BOOLEAN)
--
-- Description: Default options settings
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [flag to indicate global instance of object]
--
------------------------------------------------------------------------

-- Define method
define method .default(!setCore is BOOLEAN)

  -- define default settings here
  !this.spools(true)
  !this.fields(true)
  !this.welds(true)
  !this.joints(true)
  !this.parts(true)
  !this.bends(true)
  !this.pulledBends(false)
  !this.splPrefix('SPL')
  !this.perSpool('per SPLDRG')
  !this.interactive('FIRST')

  if (!setCore) then
    !this.coreSettings()
  endif

endmethod
-- End of method definition for .default(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- create the global variable
  !!splNumOpt = !this
  !!splNumOpt.global = true

  -- load the options settings
  !!splNumOpt.load()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !localCopy()
--
-- Description: return a local copy of the object
--
-- Method Type: Function
-- Return:
--   [SPLGENOPT] [local copy of object]
--
------------------------------------------------------------------------
define method .localCopy() is SPLNUMOPT

  -- copy this object to a local variable and unset the global flag
  !tempObject = !this
  !tempObject.global = false

  return !tempObject

endmethod
-- End of method definition for .localCopy() SPLNUMOPT

------------------------------------------------------------------------
--
-- Method:      !copyToGlobal()
--
-- Description: copy the object to the global instance
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copyToGlobal()

  !!splNumOpt = !this
  !!splNumOpt.global = true
  !!splNumOpt.coreSettings()

endmethod
-- End of method definition for .copyToGlobal()

------------------------------------------------------------------------
--
-- Method: !coreSettings()
--
-- Description: Align all core settings with the member values
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .coreSettings()

  -- no core settings for numbering options at present
  !unused = true

endmethod
-- End of method definition for .coreSettings()

------------------------------------------------------------------------
--
-- Method: !load()
--
-- Description: Load options from system and user files
--
-- Method Type: Procedure
-- Arguments:
--
-- *** OLD STYLE PML ***
--
------------------------------------------------------------------------

-- Define method
define method .load()

  -- get the locations of system options file and user options file
  !optionFiles = !!comGetOptFiles(!this.filename)

  -- create a temporary global variable to store the data
  if (defined(!!tmpSplNumOpt)) then
    !!tmpSplNumOpt.delete()
  endif
  !!tmpSplNumOpt = !this

  -- if a system options file has been found, load the data
  if (defined(!optionFiles[1])) then

    !storeAdminStatus = !this.adminStatus
    !this.adminStatus = true

    -- load options file
    !localName = !optionFiles[1].fullName()
    $m "$!<localName>"
    handle any
      -- 'System Options File #filename is corrupt, setting default options'
      !!messageFile.warning(146, 31, !optionFiles[1].fullName())
      !this.default(false)
    endhandle

    !this.adminStatus = !storeAdminStatus

  endif

  -- if a user options file has been found, load the options
  if (defined(!optionFiles[2])) then

    -- load options file
    !localName = !optionFiles[2].fullName()
    $m "$!<localName>"
    handle any
      -- 'User Options File #filename is corrupt'
      !!messageFile.warning(146, 32, !optionFiles[2].fullName())
      !this.default(false)
    endhandle

  endif

  !this = !!tmpSplNumOpt

  !this.coreSettings()

  !!tmpSplNumOpt.delete()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method: !save()
--
-- Description: Save options settings to %PDMSUSER%
--
-- Method Type: Function
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .save()

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

  -- write header information
  !saveContents.append('-- Data file for spooling numbering options')
  !saveContents.append('')

  -- options are not saved if they are the same as the default values
  -- currently the default values are put in here directly, this is
  -- for performance reasons, it would be better to have a method for
  -- each existing member, that held its default value.

  ----------------------------------------------------------------------
  -- user options are  saved for all users
  ----------------------------------------------------------------------
  if (!this.spools.not()) then
    !saveContents.append('!!tmpSplNumOpt.spools = ' & !this.spools())
  endif
  if (!this.fields.not()) then
    !saveContents.append('!!tmpSplNumOpt.fields = ' & !this.fields())
  endif
  if (!this.welds.not()) then
    !saveContents.append('!!tmpSplNumOpt.welds = ' & !this.welds())
  endif
  if (!this.joints.not()) then
    !saveContents.append('!!tmpSplNumOpt.joints = ' & !this.joints())
  endif
  if (!this.parts.not()) then
    !saveContents.append('!!tmpSplNumOpt.parts = ' & !this.parts())
  endif
  if (!this.bends.not()) then
    !saveContents.append('!!tmpSplNumOpt.bends = ' & !this.bends())
  endif
  if (!this.pulledBends) then
    !saveContents.append('!!tmpSplNumOpt.pulledBends = ' & !this.pulledBends())
  endif
  if (!this.splPrefix ne 'SPL') then
    !saveContents.append('!!tmpSplNumOpt.splPrefix = |' & !this.splPrefix() & '|')
  endif
  if (!this.perSpool ne 'per SPLDRG') then
    !saveContents.append('!!tmpSplNumOpt.perSpool = |' & !this.perSpool() & '|')
  endif
  if (!this.interactive ne 'FIRST') then
    !saveContents.append('!!tmpSplNumOpt.interactive = |' & !this.interactive() & '|')
  endif

  -- end of user options

  ----------------------------------------------------------------------
  -- system options are only saved if the user has administrator status
  ----------------------------------------------------------------------
  if (!this.adminStatus) then

  endif
  -- end of system options

  !!writeFile('%PDMSUSER%/' + !this.filename, 'OVERWRITE', !saveContents)

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
