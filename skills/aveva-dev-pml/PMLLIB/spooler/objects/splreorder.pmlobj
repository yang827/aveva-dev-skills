-- File:            splreorder.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Apr 29 12:48:37 BST 1998
--
--
-- Description:
-- Pick component to reOrder splDrg from
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  globalInstance()                 -                   create a global instance of the object
--  reOrder(DBREF,STRING)            -                   reorder on picked component
--  removeEdg()                      -                   remove EDG packet
--  rollbackEdg()                    -                   update object following EDG rollback on graphics form
--  start()                          -                   start EDG for reOrder
--
------------------------------------------------------------------------

define object SPLREORDER

  -- EDG packet
  member .edgPacket is EDGPACKET

endobject
-- End of object definition for SPLREORDER

------------------------------------------------------------------------
--
-- Method:      !globalInstance()
--
-- Description: create a global instance of the object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- if the global instance already exists then delete it
  if (defined(!!splReorder)) then
    !!splReorder.delete()
  endif

  -- create the global instance of this object
  !!splReorder = object SPLREORDER()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      !start()
--
-- Description: start EDG for reOrder
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .start()

  -- remove EDG packet if not completed
  !this.removeEdg()

  -- define an edg packet for the pick
  !packet = object EDGPACKET()
  !packet.key         = 'splreorder'
  !packet.description = 'Reorder SPLDRG'
  !packet.type        = 'Spooler'
  !packet.priority    = 0
  !packet.action      = '!!splReorder.reOrder(!this.return[1].item, !this.return[1].type)'
  !packet.remove      = false
  !packet.close       = '!!splReorder.rollbackEdg()'
  !packet.pickPacket.stdElement('Pick element to reorder SPLDRG from')
  !packet.pickPacket.picks[1].pick.input[3]   = '((type of owner) eq |BRAN| and not(unset(sfref)))'
  -- no type criterion on tube check so works for head and leave tubes
  !packet.pickPacket.picks[1].pick.input[5]   = '(not(unset(sfref)))'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- store and activate the packet
  !this.edgPacket = !packet
  if (!!edgCntrl.add(!packet).not()) then
    !this.rollbackEdg()
  endif

endmethod
-- End of method definition for .start()

------------------------------------------------------------------------
--
-- Method:      !reOrder()
--
-- Description: reorder on picked component
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF]  [picked element]
--  [2] [R] [STRING] [element or tubing indicator]
--
------------------------------------------------------------------------

define method .reOrder(!element is DBREF, !pickType is STRING)

  if (!pickType eq 'TUBING') then
    !splDrgMem = ILEAVE TUBE OF $!element
  else
    !splDrgMem = !element
  endif

  -- make splDrg active
  !!ce = !splDrgMem.sfref.owner
  SPOOLING REORDER $!splDrgMem

  -- handle error so EDG does not complain
  handle any
    !!alert.error(!!error.text)
  endhandle

  -- remove edg packet
  !this.removeEdg()

endmethod
-- End of method definition for .reOrder(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !rollbackEdg()
--
-- Description: update object following EDG rollback on graphics form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .rollbackEdg()

  -- unset edg packet
  !this.edgPacket = object EDGPACKET()

endmethod
-- End of method definition for .rollbackEdg()

------------------------------------------------------------------------
--
-- Method:      !removeEdg()
--
-- Description: remove EDG packet
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeEdg()

  -- remove edg packet (which will cause !this.rollbackEdg to be called)
  if (!this.edgPacket.type.set()) then
    !!edgCntrl.remove(!this.edgPacket)
  endif

endmethod
-- End of method definition for .removeEdg()
