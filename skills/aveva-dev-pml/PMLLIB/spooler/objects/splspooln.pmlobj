--
-- Description:
-- object to handle all spool numbering functionality
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  align()                          -                   align splDrg contents with model
--  alignReqd()                      BOOLEAN             Check if alignment of contents is required
--  alignTidy()                      -                   remove spltmp after align
--  aligningText()                   STRING              Return prompt text for aligning
--  assignData(DBREF,DBREF)          -                   Pairs an element with a set of attribute data
--  assignData(DBREF,STRING)         -                   Pairs an element with a set of attribute data
--  autoAssign()                     BOOLEAN             interactive update elements where no user selection required
--  ce(DBREF)                        -                   sets the !this.common.ce object member
--  check()                          ARRAY               check spool numbers
--  erase()                          -                   erases spool numbers from spool elements
--  getAttributes(DBREF)             SPLATTRIBUTES       Gets designated attributes from an element for asbuilt
--  highlight(DBREF)                 -                   Highlight the selected element
--  listData(DBREF)                  ARRAY               Returns a list of data, used in interactive mode only
--  listElements()                   ARRAY               Returns a list of elements to be updated, used in interactive mode only
--  listMembers()                    ARRAY               Returns a list of elements to be updated, used in asbuilt mode only
--  renumber()                       -                   renumbers spool elements
--  setAttribute(DBREF,STRING,BOOLEAN) -                   boolean attribute setting from user input
--  setAttribute(DBREF,STRING,REAL)  -                   real attribute setting from user input
--  setAttribute(DBREF,STRING,STRING) -                   string attribute setting from user input
--  splSpoolN()                      -                   Constructor
--  start()                          -                   Initialise the object for update
--  trackSelect()                    DBREF               Get list member derived from CE for modify
--  undo()                           -                   Undo operation for interactive update mode
--  unhighlight()                    -                   unhighlight the selected element
--  update(BOOLEAN)                  -                   update spool data and numbering
--  updateReqd()                     BOOLEAN             Check if update of numbering is required
--  updatingText()                   STRING              Return prompt text for updating
--  validate(DBREF,STRING,BOOLEAN)   BOOLEAN             validate boolean attribute from user input
--  validate(DBREF,STRING,REAL)      BOOLEAN             validate real attribute from user input
--  validate(DBREF,STRING,STRING)    BOOLEAN             validate string attribute from user input
--
------------------------------------------------------------------------

-- Define object
define object SPLSPOOLN

  -- common numbering functionality
  member .common is SPLCOMMONN

  -- interactive form title text
  member .formTitleText is STRING

  -- element list title text
  member .elementListText is STRING

endobject
-- End of object definition for SPLSPOOLN

------------------------------------------------------------------------
--
-- Method:      !splSpoolN()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splSpoolN()

  -- numbering attributes: cross ref, number, max, prefix
  !this.common.setAtts('oldSpl', 'SplNumber', 'Smaximum', 'SplPrefix')

  -- initialise strings for the !!splInteractive form
  !this.formTitleText   = 'Spool Elements'
  !this.elementListText = 'Spool numbers'

endmethod
-- End of method definition for .splSpoolN()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: sets the !this.common.ce object member
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to link object to]
--
------------------------------------------------------------------------

-- Define method
define method .ce(!element is DBREF)

  !this.common.ce(!element)

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      !erase()
--
-- Description: erases spool numbers from spool elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .erase()

  -- collect element list and perform erase
  !this.start()
  !this.common.erase()

endmethod
-- End of method definition for .erase()

------------------------------------------------------------------------
--
-- Method:      !check()
--
-- Description: check spool numbers
--
-- Method Type: Function
-- Return:
--   [ARRAY] [Array of messages resulting from check]
--
------------------------------------------------------------------------

-- Define method
define method .check() is ARRAY

  -- initialise return data
  !returnData = ARRAY()
  !maxSplnum = 0

  -- start the update process
  !this.start()

  -- collect splnumber data
  !getSplnum = object BLOCK('!this.common.elementList[!evalIndex].splNumber')
  !splNumbers = !this.common.elementList.evaluate(!getSplnum)

  -- check spool numbers
  do !i indices !this.common.elementList

    -- store max splnum found
    !maxSplnum = MAX(!maxSplnum, !splNumbers[!i])

    if (!splNumbers[!i] eq 0) then
      -- 'Spool number required at #name'
      !returnData.append(!!messageFile.messageString(154, 64, !this.common.elementList[!i].fullName))
    elseif (!splNumbers[!i] lt 0) then
      -- 'Illegal value for spool number at #name'
      !returnData.append(!!messageFile.messageString(154, 65, !this.common.elementList[!i].fullName))
    elseif (!splNumbers[!i] ne 0) then
      !duplicates = !splNumbers.find(!splNumbers[!i])
      if (!duplicates.size() gt 1) then
        -- duplicate spool number reported on second and subsequent occurrences
        if (!i gt !duplicates[1]) then
          -- 'Duplicate spool numbers at #name and #name'
          !returnData.append(!!messageFile.messageString(154, 66, !this.common.elementList[!duplicates[1]].fullName, !this.common.elementList[!i].fullName))
        endif
      endif
    endif
  enddo

  -- check smax of splDrg
  if (!maxSplnum gt !this.common.ce.smaximum) then
    -- 'Smaximum should be #real at #name'
    !returnData.append(!!messageFile.messageString(154, 67, !maxSplnum, !this.common.ce.fullName))
  endif

  -- append ok message if no errors found
  if (!returnData.size() eq 0) then
    -- 'No errors in spool numbering'
    !returnData.append(!!messageFile.messageString(154, 68))
  endif

  return !returnData

endmethod
-- End of method definition for .check() ARRAY

------------------------------------------------------------------------
--
-- Method:      !renumber()
--
-- Description: renumbers spool elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .renumber()

  -- collect element list and perform renumber
  !this.start()
  !this.common.renumber()

endmethod
-- End of method definition for .renumber()

------------------------------------------------------------------------
--
-- Method:      !align()
--
-- Description: align splDrg contents with model
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .align()

  -- align spools and fields
  SPOOLING UPDATE $!<this.common.ce>

  -- Dependent drawings (spool now goes into other splDrg)
  handle (83,14)
    if (!!splupdate.force.val) then
      SPOOLING UPDATE FORCED $!<this.common.ce>
      handle any
        !!alert.error(!!error.text)
        !this.alignTidy()
        return error 1 noalert
      endhandle
    else
      SPOOLING UPDATE NOFORCE $!<this.common.ce>
      handle any
        !!alert.error(!!error.text)
        !this.alignTidy()
        return error 1 noalert
      endhandle
    endif
    !this.alignTidy()

  -- Tidy up any SPLTMP element if the align fails for any other reason
  elsehandle any
    !!alert.error(!!error.text & ' (on update spldrg)')
    !this.alignTidy()
    return error 1 noalert
  endhandle

endmethod
-- End of method definition for .align()

------------------------------------------------------------------------
--
-- Method:      !update()
--
-- Description: update spool data and numbering
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [BOOLEAN] [always generate new data where choice is ambiguous]
--
------------------------------------------------------------------------

-- Define method
define method .update(!newData is BOOLEAN)

  -- collect element list and perform update
  !this.start()
  !this.common.update(!newData)

endmethod
-- End of method definition for .update(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !autoAssign()
--
-- Description: interactive update elements where no user selection required
--
-- Method Type: Function
-- Returns:
--   [BOOLEAN] [true if all elements assigned data]
--
------------------------------------------------------------------------

-- Define method
define method .autoAssign() is BOOLEAN

  return !this.common.autoAssign()

endmethod
-- End of method definition for .autoAssign() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !alignReqd()
--
-- Description: Check if alignment of contents is required
--
-- Method Type: Function
-- Return value:
--  [BOOLEAN]  [True if align is required]
--
------------------------------------------------------------------------

-- Define method
define method .alignReqd() is BOOLEAN

  -- check if SPLDRG needs aligning
  SPOOLING CHECK $!<this.common.ce>

  -- Spooling check failed - <splDrg> needs to be updated
  handle (83,6)
    return true
  elsehandle any
    !!alert.error(!!error.text & ' (on check spldrg)')
    return true
  elsehandle none
    return false
  endhandle

endmethod
-- End of method definition for .alignReqd() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !updateReqd()
--
-- Description: Check if update of numbering is required
--
-- Method Type: Function
-- Return value:
--  [BOOLEAN]  [True if update is required]
--
------------------------------------------------------------------------

-- Define method
define method .updateReqd() is BOOLEAN

  -- check if SPLDRG needs updating
  !results = !this.check()
  if (!results.size() eq 1) then
    -- compare to error message for no errors
    if (!results[1] eq !!messageFile.messageString(154, 68)) then
      return false
    endif
  endif

  -- errors found in check
  return true

endmethod
-- End of method definition for .updateReqd() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !aligningText()
--
-- Description: Return prompt text for aligning
--
-- Method Type: Function
-- Return value:
--  [STRING]  [Prompt text]
--
------------------------------------------------------------------------

-- Define method
define method .aligningText() is STRING

  -- 'Aligning contents for #name'
  return !!messageFile.messageString(154, 140, !this.common.ce.fullName)

endmethod
-- End of method definition for .aligningText() STRING

------------------------------------------------------------------------
--
-- Method:      !updatingText()
--
-- Description: Return prompt text for updating
--
-- Method Type: Function
-- Return value:
--  [STRING]  [Prompt text]
--
------------------------------------------------------------------------

-- Define method
define method .updatingText() is STRING

  -- 'Updating spool data for #name'
  return !!messageFile.messageString(154, 141, !this.common.ce.fullName)

endmethod
-- End of method definition for .updatingText() STRING

------------------------------------------------------------------------
--
-- Method:      !alignTidy()
--
-- Description: remove spltmp after align
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .alignTidy()

  !this.common.alignTidy()

endmethod
-- End of method definition for .alignTidy()

------------------------------------------------------------------------
--
-- Method:      !start()
--
-- Description: Initialise the object for update
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .start()

  -- common numbering initialisation
  !this.common.start()

  -- add all spools of !this.common.ce to the element list
  do !element values !this.common.ce.members
    if (!element.type eq 'SPOOL') then
      !this.common.elementList.append(!element)
    endif
  enddo

endmethod
-- End of method definition for .start()

