------------------------------------------------------------------------
--
-- Method:      !highlight()
--
-- Description: Highlight the selected element
--
-- Method Type: Procedure
-- Arguments:
-- [1]  [R]  [DBREF]    [Element selected for highlighting]
--
------------------------------------------------------------------------

-- Define method
define method .highlight(!element is DBREF)

  -- reset display
  !this.unhighlight()

  -- highlight the selected element
  !highlightCol = !!gphColOpt.highlight()
  ENHANCE $!element COLOUR $!<highlightCol.code>

endmethod
-- End of method definition for .highlight(DBREF)

------------------------------------------------------------------------
--
-- Method:      !unhighlight()
--
-- Description: unhighlight the selected element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .unhighlight()

  -- reset display
  UNENHANCE $!<this.common.ce>
  -- REPRESENTATION UPDATE

endmethod
-- End of method definition for .unhighlight()

------------------------------------------------------------------------
--
-- Method:      !trackSelect()
--
-- Description: Get list member derived from CE for modify
--
-- Method Type: Function
-- Return:
--   [DBREF] [List member to select]
--
------------------------------------------------------------------------

-- Define method
define method .trackSelect() is DBREF

  !returnData = object DBREF()

  -- Select CE if present in element list
  if (!this.common.elementList.findFirst(!!ce).set()) then
    !returnData = !!ce

  -- Select CE's spool/field if present in element list
  elseif (!!ce.type ne 'WORL') then
    if (!!ce.owner.type eq 'BRAN') then
      if (!!ce.sfref.set()) then
        if (!this.common.elementList.findFirst(!!ce.sfref).set()) then
          !returnData = !!ce.sfref
        endif
      endif
    endif
  endif

  return !returnData

endmethod
-- End of method definition for .trackSelect() DBREF

