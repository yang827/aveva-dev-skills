------------------------------------------------------------------------
--
-- Method:      !highlight()
--
-- Description: Highlight the selected element
--
-- Method Type: Procedure
-- Arguments:
-- [1]  [R]  [DBREF]    [Element selected for highlighting]
--
------------------------------------------------------------------------

-- Define method
define method .highlight(!element is DBREF)

  -- reset display
  !this.unhighlight()

  if (!element.type eq 'IWELD') then

    -- get position of implied weld
    !position = !element.wjPosition

  elseif (!element.type eq 'AWELD') then

    -- get position of component for attached weld
    !weldData = !element.awdOwner
    !dbRef = '=' & !weldData[1] & '/' & !weldData[2]
    !position = !dbRef.dbRef().position

  elseif (!element.type eq 'RWELD') then

    -- get position of real weld
    !position = !element.rwdowner.position

  endif

  -- adjust for SITE position (P-9271)
  var !siteEast  east  of site of splparent of spldrg
  var !siteNorth north of site of splparent of spldrg
  var !siteUp    up    of site of splparent of spldrg

  if (!siteEast.eq('unset')) then
    !siteEast = '0'
  endif
  if (!siteNorth.eq('unset')) then
    !siteNorth = '0'
  endif
  if (!siteUp.eq('unset')) then
    !siteUp = '0'
  endif

  !position.east  = !position.east  + !siteEast.real()
  !position.north = !position.north + !siteNorth.real()
  !position.up    = !position.up    + !siteUp.real()

  -- mark the selected element
  !this.markedElement = !element
  AID TEXT NUMBER $!<this.aidNumber> '__$!<element.wldNumber>' AT $!position

endmethod
-- End of method definition for .highlight(DBREF)

------------------------------------------------------------------------
--
-- Method:      !unhighlight()
--
-- Description: unhighlight the selected element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .unhighlight()

  -- unmark the previously marked element
  if (!this.markedElement.set()) then
    if (!this.markedElement.badRef().not()) then
      AID CLEAR TEXT $!<this.aidNumber>
      -- ignore error if no aid text for this number
      handle any
      endhandle
    endif
    !this.markedElement = object DBREF()
  endif

endmethod
-- End of method definition for .unhighlight()

------------------------------------------------------------------------
--
-- Method:      !trackSelect()
--
-- Description: Get list member derived from CE for modify
--
-- Method Type: Function
-- Return:
--   [DBREF] [List member to select]
--
------------------------------------------------------------------------

-- Define method
define method .trackSelect() is DBREF

  !returnData = object DBREF()

  -- Select CE if present in element list
  if (!this.common.elementList.findFirst(!!ce).set()) then
    !returnData = !!ce

  -- Select CE's weldref if present in element list
  elseif (!!ce.type ne 'WORL') then
    if (!!ce.owner.type eq 'BRAN') then
      -- navigate off leave tube
      if (!!ce.type eq 'TUBI') then
        PREVIOUS
        handle any
        endhandle
      endif
      if (!!ce.type eq 'WELD') then
        -- real weld
        if (!this.common.elementList.findFirst(!!ce.wldref[1]).set()) then
          !returnData = !!ce.wldref[1]
        endif
      else
        -- check up to 3 ppoints for piping component
        if (!this.common.elementList.findFirst(!!ce.wldref[1]).set()) then
          !returnData = !!ce.wldref[1]
        elseif (!this.common.elementList.findFirst(!!ce.wldref[2]).set()) then
          !returnData = !!ce.wldref[2]
        elseif (!this.common.elementList.findFirst(!!ce.wldref[3]).set()) then
          !returnData = !!ce.wldref[3]
        endif
      endif
    endif
  endif

  return !returnData

endmethod
-- End of method definition for .trackSelect() DBREF

