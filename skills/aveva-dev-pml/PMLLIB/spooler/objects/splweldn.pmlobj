--
-- Description:
-- object to handle all weld numbering functionality
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  align()                          -                   align welds with model
--  alignBoth()                      -                   align welds and joints with model
--  alignBothReqd()                  BOOLEAN             Check if alignment of welds and joints is required
--  alignBothText()                  STRING              Return prompt text for aligning welds and joints
--  alignReqd()                      BOOLEAN             Check if alignment of welds is required
--  alignTidy()                      -                   remove spltmp after align
--  aligningText()                   STRING              Return prompt text for aligning welds
--  assignData(DBREF,DBREF)          -                   Pairs an element with a set of attribute data
--  assignData(DBREF,STRING)         -                   Pairs an element with a set of attribute data
--  autoAssign()                     BOOLEAN             interactive update elements where no user selection required
--  ce(DBREF)                        -                   sets the !this.common.ce object member
--  check()                          ARRAY               check weld numbers
--  erase()                          -                   erases weld numbers from weld elements
--  getAttributes(DBREF)             SPLATTRIBUTES       Gets designated attributes from an element for asbuilt
--  highlight(DBREF)                 -                   Highlight the selected element
--  listData(DBREF)                  ARRAY               Returns a list of data, used in interactive mode only
--  listElements()                   ARRAY               Returns a list of elements to be updated, used in interactive mode only
--  listMembers()                    ARRAY               Returns a list of elements to be updated, used in asbuilt mode only
--  renumber()                       -                   renumbers weld elements
--  setAttribute(DBREF,STRING,BOOLEAN) -                   boolean attribute setting from user input
--  setAttribute(DBREF,STRING,REAL)  -                   real attribute setting from user input
--  setAttribute(DBREF,STRING,STRING) -                   string attribute setting from user input
--  splWeldN()                       -                   Constructor
--  start()                          -                   Initialise the object for update
--  trackSelect()                    DBREF               Get list member derived from CE for modify
--  undo()                           -                   Undo operation for interactive update mode
--  unhighlight()                    -                   unhighlight the selected element
--  update(BOOLEAN)                  -                   update weld data and numbering
--  updateReqd()                     BOOLEAN             Check if update of numbering is required
--  updatingText()                   STRING              Return prompt text for updating
--  validate(DBREF,STRING,BOOLEAN)   BOOLEAN             validate boolean attribute from user input
--  validate(DBREF,STRING,REAL)      BOOLEAN             validate real attribute from user input
--  validate(DBREF,STRING,STRING)    BOOLEAN             validate string attribute from user input
--
------------------------------------------------------------------------

-- Define object
define object SPLWELDN

  -- common numbering functionality
  member .common is SPLCOMMONN

  -- stores element marked
  member .markedElement is DBREF

  -- aid text allocated number
  member .aidNumber is REAL

  -- interactive form title text
  member .formTitleText is STRING

  -- element list title text
  member .elementListText is STRING

endobject
-- End of object definition for SPLWELDN

------------------------------------------------------------------------
--
-- Method:      !splWeldN()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splWeldN()

  -- numbering attributes: cross ref, number, max, prefix
  !this.common.setAtts('wldXrf', 'WldNumber', 'Wmaximum', 'WldPrefix')

  -- initialise strings for the !!splInteractive form
  !this.formTitleText   = 'Weld Elements'
  !this.elementListText = 'Weld numbers'

  -- allocate an aid text number
  !this.aidNumber = !!aidNumbers.add(STRING())

endmethod
-- End of method definition for .splWeldN()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: sets the !this.common.ce object member
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to link object to]
--
------------------------------------------------------------------------

-- Define method
define method .ce(!element is DBREF)

  !this.common.ce(!element)
  !this.markedElement = object DBREF()

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      !erase()
--
-- Description: erases weld numbers from weld elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .erase()

  -- collect element list and perform erase
  !this.start()
  !this.common.erase()

endmethod
-- End of method definition for .erase()

------------------------------------------------------------------------
--
-- Method:      !check()
--
-- Description: check weld numbers
--
-- Method Type: Function
-- Return:
--   [ARRAY] [Array of messages resulting from check]
--
------------------------------------------------------------------------

-- Define method
define method .check() is ARRAY

  -- initialise return data
  !returnData = ARRAY()
  !maxWldnum = 0

  -- start the update process
  !this.start()

  -- collect wldnumber data
  !getWldnum = object BLOCK('!this.common.elementList[!evalIndex].wldNumber')
  !wldNumbers = !this.common.elementList.evaluate(!getWldnum)

  -- check weld numbers
  do !i indices !this.common.elementList

    -- store max wldnum found
    !maxWldnum = MAX(!maxWldnum, !wldNumbers[!i])

    if (!wldNumbers[!i] eq 0) then
      -- 'Weld number required at #name'
      !returnData.append(!!messageFile.messageString(154, 74, !this.common.elementList[!i].fullName))
    elseif (!wldNumbers[!i] lt 0) then
      -- 'Illegal value for weld number at #name'
      !returnData.append(!!messageFile.messageString(154, 75, !this.common.elementList[!i].fullName))
    elseif (!wldNumbers[!i] ne 0) then
      !duplicates = !wldNumbers.find(!wldNumbers[!i])
      if (!duplicates.size() gt 1) then
        -- duplicate weld number reported on second and subsequent occurrences
        if (!i gt !duplicates[1]) then
          -- 'Duplicate weld numbers at #name and #name'
          !returnData.append(!!messageFile.messageString(154, 76, !this.common.elementList[!duplicates[1]].fullName, !this.common.elementList[!i].fullName))
        endif
      endif
    endif
  enddo

  -- check wmax of splDrg
  if (!maxWldnum gt !this.common.ce.wmaximum) then
    -- 'Wmaximum should be #real at #name'
    !returnData.append(!!messageFile.messageString(154, 77, !maxWldnum, !this.common.ce.fullName))
  endif

  -- append ok message if no errors found
  if (!returnData.size() eq 0) then
    -- 'No errors in weld numbering'
    !returnData.append(!!messageFile.messageString(154, 78))
  endif

  return !returnData

endmethod
-- End of method definition for .check() ARRAY

------------------------------------------------------------------------
--
-- Method:      !renumber()
--
-- Description: renumbers weld elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .renumber()

  -- collect element list and perform renumber
  !this.start()
  !this.common.renumber()

endmethod
-- End of method definition for .renumber()

------------------------------------------------------------------------
--
-- Method:      !align()
--
-- Description: align welds with model
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .align()

  -- align welds
  SPOOLING CREATE WELDS $!<this.common.ce>

  -- Tidy up any SPLTMP element if the align fails for any reason
  handle any
    !!alert.error(!!error.text & ' (on create welds)')
    !this.alignTidy()
    return error 1 noalert
  endhandle

endmethod
-- End of method definition for .align()

------------------------------------------------------------------------
--
-- Method:      !alignBoth()
--
-- Description: align welds and joints with model
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .alignBoth()

  -- align welds and joints
  -- if both are to be aligned it is more efficient to align them together
  SPOOLING CREATE WELDS JOINTS $!<this.common.ce>

  -- Tidy up any SPLTMP element if the align fails for any reason
  handle any
    !!alert.error(!!error.text & ' (on create welds and joints)')
    !this.alignTidy()
    return error 1 noalert
  endhandle

endmethod
-- End of method definition for .alignBoth()

------------------------------------------------------------------------
--
-- Method:      !update()
--
-- Description: update weld data and numbering
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [BOOLEAN] [always generate new data where choice is ambiguous]
--
------------------------------------------------------------------------

-- Define method
define method .update(!newData is BOOLEAN)

  -- collect element list and perform update
  !this.start()
  !this.common.update(!newData)

endmethod
-- End of method definition for .update(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !autoAssign()
--
-- Description: interactive update elements where no user selection required
--
-- Method Type: Function
-- Returns:
--   [BOOLEAN] [true if all elements assigned data]
--
------------------------------------------------------------------------

-- Define method
define method .autoAssign() is BOOLEAN

  return !this.common.autoAssign()

endmethod
-- End of method definition for .autoAssign() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !alignReqd()
--
-- Description: Check if alignment of welds is required
--
-- Method Type: Function
-- Return value:
--  [BOOLEAN]  [True if align is required]
--
------------------------------------------------------------------------

-- Define method
define method .alignReqd() is BOOLEAN

  -- check if welds need aligning
  SPOOLING CHECK WELDS $!<this.common.ce>

  -- Spooling weld/joint check failed - <splDrg> needs welds/joints updated
  handle (83,15)
    return true
  elsehandle any
    -- !!alert.error(!!error.text & ' (on check welds)')
    return true
  elsehandle none
    return false
  endhandle

endmethod
-- End of method definition for .alignReqd() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !alignBothReqd()
--
-- Description: Check if alignment of welds and joints is required
--
-- Method Type: Function
-- Return value:
--  [BOOLEAN]  [True if align is required]
--
------------------------------------------------------------------------

-- Define method
define method .alignBothReqd() is BOOLEAN

  -- check if welds and joints need aligning
  -- if both are to be checked it is more efficient to check them together
  SPOOLING CHECK WELDS JOINTS $!<this.common.ce>

  -- Spooling weld/joint check failed - <splDrg> needs welds/joints updated
  handle (83,15)
    return true
  elsehandle any
    !!alert.error(!!error.text & ' (on check welds and joints)')
    return true
  elsehandle none
    return false
  endhandle

endmethod
-- End of method definition for .alignBothReqd() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !updateReqd()
--
-- Description: Check if update of numbering is required
--
-- Method Type: Function
-- Return value:
--  [BOOLEAN]  [True if update is required]
--
------------------------------------------------------------------------

-- Define method
define method .updateReqd() is BOOLEAN

  -- check if SPLDRG needs updating
  !results = !this.check()
  if (!results.size() eq 1) then
    -- compare to error message for no errors
    if (!results[1] eq !!messageFile.messageString(154, 78)) then
      return false
    endif
  endif

  -- errors found in check
  return true

endmethod
-- End of method definition for .updateReqd() BOOLEAN

------------------------------------------------------------------------
