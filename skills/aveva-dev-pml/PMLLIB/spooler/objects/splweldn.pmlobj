------------------------------------------------------------------------
--
-- Method:      !start()
--
-- Description: Initialise the object for update
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .start()

  -- common numbering initialisation
  !this.common.start()

  -- add all members of the weld group to the element list
  !this.common.elementList = !!splWelds(!this.common.ce)

endmethod
-- End of method definition for .start()

------------------------------------------------------------------------
--
-- Method:      !getAttributes()
--
-- Description: Gets designated attributes from an element for asbuilt
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF]  [Element to retrieve attributes from]
-- Return:
--   [SPLATTRIBUTES] [Arrays of attributes and names]
--
------------------------------------------------------------------------

-- Define method
define method .getAttributes(!element is DBREF) is SPLATTRIBUTES

  if (!element.type eq 'IWELD') then
    return !this.common.getAttributes(!element, !this.common.numAtt, 'IwdOwners')
  elseif (!element.type eq 'RWELD') then
    return !this.common.getAttributes(!element, !this.common.numAtt, 'RwdOwner')
  elseif (!element.type eq 'AWELD') then
    return !this.common.getAttributes(!element, !this.common.numAtt, 'AwdOwner')
  endif

endmethod
-- End of method definition for .getAttributes(DBREF) SPLATTRIBUTES

