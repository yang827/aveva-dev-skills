--
-- Description:
-- Storage object for tags compound units override functionality
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  globalInstance()                 -                   Create global instance of object
--
------------------------------------------------------------------------

define object TAGSCOMPOUNDUNITSOVERRIDE

  member .acceleration         is REAL
  member .area                 is REAL
  member .density              is REAL
  member .massConcentration    is REAL
  member .massFlowrate         is REAL
  member .power                is REAL
  member .pressure             is REAL
  member .pressureDropLength   is REAL
  member .specificEnthalpy     is REAL
  member .surfaceTension       is REAL
  member .temperatureRate      is REAL
  member .thermalConductivity  is REAL
  --member .timeTime             is REAL
  member .velocityAngular      is REAL
  member .velocityLinear       is REAL
  member .viscosityDynamic     is REAL
  member .volume               is REAL
  member .volumetricFlowrate   is REAL
  member .gaugePressure        is REAL
  member .absPressure          is REAL
  member .kinematicViscosity   is REAL
  member .specHeatCapacity     is REAL

endobject


------------------------------------------------------------------------
-- Method:      globalInstance
--
-- Description:
--   Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create global variable
  if (not defined(!!tagsCompoundUnitsOverride)) then
    !!tagsCompoundUnitsOverride = !this
  endif

  -- Recover the enumerations for each of the compound dimensions
  -- that we're interested in making a special-case

  !accVar = 1m/s2
  !areaVar = 1m2
  !densityVar = 1kg/m3
  !massFlowVar = 1tonne/d
  !powerVar = 1kW
  !pressVar = 1bar
  !pressDropLenVar = 1bar/m
  !specEnthVar = 1kiloJ/kg
  !surfTenVar = 1N/m
  !tempRateVar = 1degC/s
  !thermCondVar = 1kW/m.degC
  --!timeTimeVar = 1d/yr
  !veloAngVar = 1rpm
  !veloLinVar = 1m/s
  !viscDynVar = 1poise
  !volVar = 1m3
  !volFlowVar = 1l/s
  !gaugePressureVar = 1barg
  !absPressureVar = 1bara
  !kinViscVar = 1m2/s
  !specHeatCapVar = 1J/kg/K

  !!tagsCompoundUnitsOverride.acceleration = !accVar.dimension().enum()
  !!tagsCompoundUnitsOverride.area = !areaVar.dimension().enum()
  !!tagsCompoundUnitsOverride.density = !densityVar.dimension().enum()
  !!tagsCompoundUnitsOverride.massFlowrate = !massFlowVar.dimension().enum()
  !!tagsCompoundUnitsOverride.power = !powerVar.dimension().enum()
  !!tagsCompoundUnitsOverride.pressure = !pressVar.dimension().enum()
  !!tagsCompoundUnitsOverride.pressureDropLength = !pressDropLenVar.dimension().enum()
  !!tagsCompoundUnitsOverride.specificEnthalpy = !specEnthVar.dimension().enum()
  !!tagsCompoundUnitsOverride.surfaceTension = !surfTenVar.dimension().enum()
  !!tagsCompoundUnitsOverride.temperatureRate = !tempRateVar.dimension().enum()
  !!tagsCompoundUnitsOverride.thermalConductivity = !thermCondVar.dimension().enum()
  --!!tagsCompoundUnitsOverride.timeTime = !timeTimeVar.dimension().enum()
  !!tagsCompoundUnitsOverride.velocityAngular = !veloAngVar.dimension().enum()
  !!tagsCompoundUnitsOverride.velocityLinear = !veloLinVar.dimension().enum()
  !!tagsCompoundUnitsOverride.viscosityDynamic = !viscDynVar.dimension().enum()
  !!tagsCompoundUnitsOverride.volume = !volVar.dimension().enum()
  !!tagsCompoundUnitsOverride.volumetricFlowrate = !volFlowVar.dimension().enum()
  !!tagsCompoundUnitsOverride.gaugePressure = !gaugePressureVar.dimension().enum()
  !!tagsCompoundUnitsOverride.absPressure = !absPressureVar.dimension().enum()
  !!tagsCompoundUnitsOverride.kinematicViscosity = !kinViscVar.dimension().enum()
  !!tagsCompoundUnitsOverride.specHeatCapacity = !specHeatCapVar.dimension().enum()
endmethod
