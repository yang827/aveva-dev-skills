import 'Aveva.Pdms.Viewer3D.Addin'
------------------------------------------------------------------------------------------
-- Form definition                                                                      --
------------------------------------------------------------------------------------------
setup form !!viewer3d dialog docking r

  -- Set the form title
  !this.formTitle = |3D View|

  -- Set the callbacks on the form
  !this.firstShownCall  = |!this.firstShown()|
  !this.killingCall     = |!this.close()|

  -- Define the volume view element
  frame .volumeFrame panel anchor all width 50 height 10
    view .volumeView  volume
      -- Set the size and the initial viewing direction
      width 60 height 12
      limits auto
      isometric 3
    exit
  exit

  para .clip   at x1 ymax-0.1 anchor b+l text |Clipbox|
  -- Define the slider
  !sliderInfo = |horizontal range -100 100 step 1 val 10|
  slider .slider at xmax ymin+0.2 anchor b+l $!sliderInfo width 18

  para .clip2   at xmax ymin.clip anchor b+l text |Translucency|
  !sliderInfo2 = |horizontal range 1 99 step 1 val 10|
  slider .slider2 at xmax ymin.slider anchor b+l $!sliderInfo2 width 18

  -- A form member

  -- Drawing list
  member .drawlist is REAL

  -- Auxiliary drawing list
  member .auxiliaryDrawList is REAL

  -- Box
  member .box      is GMFBOX

  -- Temporary box used by slide functions
  member .modBox   is GMFBOX

  -- ISO
  member .iso is STRING

  -- Plan
  member .plan is STRING

  -- Look
  member .look is STRING

  -- Translucency
  member .translucency is REAL

exit
------------------------------------------------------------------------------------------
-- Constructor Method - Setup the form when it is loaded                                --
------------------------------------------------------------------------------------------
define method .viewer3d()

  -- Setup the slider
  !this.slider.tickStyle = 0
  !this.slider.active    = TRUE
  !this.slider.callback  = |!this.slide(|

  -- Set common translucency
  !this.translucency = 50

  -- Setup the slider
  !this.slider2.tickStyle = 0
  !this.slider2.active    = TRUE
  !this.slider2.val = !this.translucency
  !this.slider2.callback  = |!this.slide2(|

  -- If not already defined, setup the global objects required for a VIEW
  -- Graphic View Control
  if undefined(!!gphViews) then
    call !!comDefineGlobal(object GPHVIEWS())
  endif

  -- Drawlists
  if undefined(!!gphdrawlists) then
    !!comDefineGlobal(object gphDrawlists())
  endif

  -- Create local drawlist within the global object
  !this.drawlist = !!gphDrawlists.createDrawList()

  !!gphDrawlists.drawlists[!this.drawlist].holes(TRUE)
  !!gphDrawlists.drawlists[!this.drawlist].arcTol(0.1)

  -- Create auxiliary drawlist within the global object
  !this.auxiliaryDrawList = !!gphDrawlists.createDrawList()

  -- Setup the VIEW as required
  !this.setupView()

  -- Setup the clipbox + associated objects
  !this.initialiseClipBox()
  -- !this.volumeView.clipping = TRUE

  -- View empty pop-up menu
  !this.volumeview.popup = !!viewer3d.newMenu('viewer3demptypopupmenu')

endmethod

------------------------------------------------------------------------------------------
-- First Shown Method - Register the view gadget and attach the drawlist                --
------------------------------------------------------------------------------------------
define method .firstShown()
  -- Add 3D view to view system
  !!gphViews.add(!this.volumeView)
  -- Add local drawlist add to 3D view
  !!gphDrawlists.attachView(!this.drawlist, !this.volumeView)
  -- Ensure the holes are displayed in the drawlist, with a presentation arc tolerance
  !!gphDrawlists.drawlists[!this.drawlist].holes(TRUE)
  !!gphDrawlists.drawlists[!this.drawlist].arcTol(0.1)
endmethod

------------------------------------------------------------------------------------------
-- Killing Call Method - Detach the drawlist and then delete it                         --
------------------------------------------------------------------------------------------
define method .close()
  !!gphDrawlists.detachView(!this.volumeView)
  !!gphDrawlists.deleteDrawlist(!this.drawlist)
endmethod

------------------------------------------------------------------------------------------
-- Method .slide(GADGET, STRING) - Open callback for when the slider is used            --
------------------------------------------------------------------------------------------
define method .slide(!gadget is GADGET, !string is STRING)

  if !string.eq(|STOP|) then
    !this.stopSliding()
  elseif !string.eq(|START|) then
    !this.volumeView.clipping = TRUE
    !this.modBox = !this.box
  else
    !this.slide()
  endif

endmethod

------------------------------------------------------------------------------------------
-- Method .slide2(GADGET, STRING) - Open callback for when the slider is used            --
------------------------------------------------------------------------------------------
define method .slide2(!gadget is GADGET, !string is STRING)

  using namespace 'Aveva.Pdms.Viewer3D.Addin'

  -- Remember translucency
  !this.translucency = !this.slider2.val

  -- Apply transluency for drawlist
  !myassembly = object PmlViewerThreeDAddin()
  !myassembly.Translucency(!this.translucency)

  -- Refresh the view
  !this.volumeView.refresh()

endmethod

------------------------------------------------------------------------------------------
-- Method .stopSliding() - Reset the slider and update the drawlist                     --
------------------------------------------------------------------------------------------
define method .stopSliding()

  using namespace 'Aveva.Pdms.Viewer3D.Addin'

  -- Reset the slider
  !this.slider.val = 0

  -- Store the modified box as the one to use
  !this.box = !this.modBox

  -- Update the drawlist
  !myassembly = object PmlViewerThreeDAddin()
  !myassembly.StopClipping()

endmethod
------------------------------------------------------------------------------------------
-- Method .slide() - As the slider moves, dynamically update the clipbox                --
------------------------------------------------------------------------------------------
define method .slide()

  !value = !this.slider.val * !this.slider.val.abs()

  !xlen = !this.box.xlength + !value
  if !xlen.gt(5mm) then
    !this.modbox.xlength = !xlen
  else
    !this.modbox.xlength = 5mm
  endif

  !ylen = !this.box.ylength + !value
  if !ylen.gt(5mm) then
    !this.modbox.ylength = !ylen
  else
    !this.modbox.ylength = 5mm
  endif

  !zlen = !this.box.zlength + !value
  if !zlen.gt(5mm) then
    !this.modbox.zlength = !zlen
  else
    !this.modbox.zlength = 5mm
  endif

  !this.volumeView.clipBoxXlen = !this.modbox.xlength
  !this.volumeView.clipBoxYlen = !this.modbox.ylength
  !this.volumeView.clipBoxZlen = !this.modbox.zlength

  -- Refresh the view
  !this.volumeView.refresh()

endmethod

define method .setupView()

  -- Apply some default settings to the view element
  !this.volumeView.borders = FALSE
  !this.volumeView.background = |white|
  !this.volumeView.shaded = TRUE
  !this.volumeView.projection = |perspective|
  !this.volumeView.radius = 100
  !this.volumeView.range = 500.0
  !this.volumeView.eyemode = FALSE
  !this.volumeView.step = 25
  !this.volumeView.showAxes = TRUE

endmethod

define method .initialiseClipBox()

  !this.box.position = object POSITION(|E 0 N 0 U 0 WRT /* |)
  !this.box.orientation = object ORIENTATION('Y is N')
  !this.box.xLength = 1mm
  !this.box.yLength = 1mm
  !this.box.zLength = 1mm
  !this.modbox = !this.box

endmethod

-------------------------------------------------------------------------------------------
-- Method .slidePlane(!direction is STRING, !value is REAL, !action is STRING) - Called when the slider is used --
-- direction: DOWN UP SOUTH NORTH WEST EAST
-- action: START SLIDE STOP
-------------------------------------------------------------------------------------------
define method .slidePlane(!direction is STRING, !value is REAL, !action is STRING)

  if !action.eq(|STOP|) then
    !this.stopSlidingPlane()
  elseif !action.eq(|START|) then
    !this.volumeView.clipping = TRUE
    !this.modBox = !this.box
  else
    !this.slidePlane(!direction,!value)
  endif

endmethod

-------------------------------------------------------------------------------------------
-- Method .slidePlane(!direction is STRING, !value is REAL) - As the slider moves, dynamically update the clipbox --
-- direction: DOWN UP SOUTH NORTH WEST EAST
-------------------------------------------------------------------------------------------
define method .slidePlane(!direction is STRING, !value is REAL)

  !tmpValue = 0

  if !direction.eq(|EAST|) then
     !this.modbox.xlength = !this.box.xlength + !value
     !this.modbox.position.east = !this.box.position.east + (!value / 2)
  endif

  if !direction.eq(|NORTH|) then
     !this.modbox.ylength = !this.box.ylength + !value
     !this.modbox.position.north = !this.box.position.north + (!value / 2)
  endif

  if !direction.eq(|UP|) then
     !this.modbox.zlength = !this.box.zlength + !value
     !this.modbox.position.up = !this.box.position.up + (!value / 2)
  endif

  if !direction.eq(|WEST|) then
     !this.modbox.position.east = !this.box.position.east + ( !value / 2)
     !this.modbox.xlength = !this.box.xlength - !value
  endif

  if !direction.eq(|SOUTH|) then
     !this.modbox.position.north = !this.box.position.north + ( !value / 2)
     !this.modbox.ylength = !this.box.ylength - !value
  endif

  if !direction.eq(|DOWN|) then
     !this.modbox.position.up = !this.box.position.up + ( !value / 2)
     !this.modbox.zlength = !this.box.zlength - !value
  endif

  !clipboxposition[1] = !this.modbox.position.east
  !clipboxposition[2] = !this.modbox.position.north
  !clipboxposition[3] = !this.modbox.position.up

  !this.volumeView.clipboxposition = !clipboxposition
  !this.volumeView.clipBoxXlen = !this.modbox.xlength
  !this.volumeView.clipBoxYlen = !this.modbox.ylength
  !this.volumeView.clipBoxZlen = !this.modbox.zlength

endmethod

-------------------------------------------------------------------------------------------
-- Method .stopSliding() - Reset the slider and update the drawlist --
-- direction: DOWN UP SOUTH NORTH WEST EAST
-------------------------------------------------------------------------------------------
define method .stopSlidingPlane()

  using namespace 'Aveva.Pdms.Viewer3D.Addin'

  -- Store the modified box as the one to use
  !this.box = !this.modBox

  -- Update the drawlist
  !myassembly = object PmlViewerThreeDAddin()
  !myassembly.StopClipping()

endmethod

------------------------------------------------------------------------------------------
-- Method .setShowAxes( !showaxes is BOOLEAN) - Sets new value of showaxes member and updates view. --
------------------------------------------------------------------------------------------
define method .setShowAxes( !showaxes is BOOLEAN)

    !this.volumeView.showaxes = !showaxes

endmethod

------------------------------------------------------------------------------------------
-- Method .getShowAxes() is REAL - Returns current value of showaxes member. --
------------------------------------------------------------------------------------------
define method .getShowAxes() is REAL

	if !this.volumeView.showaxes then
		return 1
	endif

	return 0

endmethod

------------------------------------------------------------------------------------------
-- Method .setVisible( !visible is BOOLEAN) - Sets a value that indicates whether a window should be visible or not. --
------------------------------------------------------------------------------------------
define method .setVisible( !visible is BOOLEAN)

    if !visible then
        show !this
     else
        hide !this
     endif

endmethod

------------------------------------------------------------------------------------------
-- Method .getVisible() is REAL - Gets a value that indicates whether a window is visible or not. --
------------------------------------------------------------------------------------------
define method .getVisible() is REAL

	if !this.shown() then
		return 1
	endif

	return 0

endmethod

------------------------------------------------------------------------------------------
