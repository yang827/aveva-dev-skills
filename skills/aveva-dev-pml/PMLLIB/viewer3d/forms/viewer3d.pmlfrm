endmethod

------------------------------------------------------------------------------------------
-- Method .setIso( !iso is STRING) - Sets new value of iso member and updates view. --
-- Valid input: ISO1 ISO2 ISO3 ISO4
------------------------------------------------------------------------------------------
define method .setIso( !iso is STRING)

  if !iso.eq(|ISO1|) then
    -- Remember iso
    !this.iso = !iso
    -- Reset plan
    !this.plan = ''
    -- Reset look
    !this.look = ''
    -- Set direction
    !dir[1] = -0.577350273783069
    !dir[2] = -0.577350273783069
    !dir[3] = -0.57735026000274
    !this.volumeView.direction = !dir
  elseif !iso.eq(|ISO2|) then
    -- Remember iso
    !this.iso = !iso
    -- Reset plan
    !this.plan = ''
    -- Reset look
    !this.look = ''
    -- Set direction
    !dir[1] = -0.577350273783069
    !dir[2] = 0.577350273783069
    !dir[3] = -0.57735026000274
    !this.volumeView.direction = !dir
  elseif !iso.eq(|ISO3|) then
    -- Remember iso
    !this.iso = !iso
    -- Reset plan
    !this.plan = ''
    -- Reset look
    !this.look = ''
    -- Set direction
    !dir[1] = 0.577350273783069
    !dir[2] = 0.577350273783069
    !dir[3] = -0.57735026000274
    !this.volumeView.direction = !dir
  elseif !iso.eq(|ISO4|) then
    -- Remember iso
    !this.iso = !iso
    -- Reset plan
    !this.plan = ''
    -- Reset look
    !this.look = ''
    -- Set direction
    !dir[1] = 0.577350273783069
    !dir[2] = -0.577350273783069
    !dir[3] = -0.57735026000274
    !this.volumeView.direction = !dir
  endif

endmethod

------------------------------------------------------------------------------------------
-- Method .getIso() is STRING - Returns current value of iso member. --
------------------------------------------------------------------------------------------
define method .getIso() is STRING

	return !this.iso

endmethod

------------------------------------------------------------------------------------------
-- Method .setPlan( !plan is STRING) - Sets new value of plan member and updates view. --
-- Valid input: PLANN PLANS PLANE PLANW
------------------------------------------------------------------------------------------
define method .setPlan( !plan is STRING)

  -- Update view
  if !plan.subString(1,4).eq(|PLAN|) then

    -- Remember plan
    !this.plan = !plan

    -- Reset iso
    !this.iso = ''

    -- Reset look
    !this.look = ''

    !direction = object DIRECTION(!plan.after(|PLAN|))
    !pVector = object POINTVECTOR(object POSITION(|E 0 N 0 U 0 WRT /* |), !direction)
    !line = !pVector.line(1)

    !dir[1] = !line.endPosition.east.value()
    !dir[2] = !line.endPosition.north.value()
    !dir[3] = !line.endPosition.up.value()

    !this.volumeView.direction = !dir

  endif

endmethod

------------------------------------------------------------------------------------------
-- Method .getPlan() is STRING - Returns current value of plan member. --
------------------------------------------------------------------------------------------
define method .getPlan() is STRING

	return !this.plan

endmethod

------------------------------------------------------------------------------------------
-- Method .setLook( !look is STRING) - Sets new value of look member and updates view. --
-- Valid input: LOOKN LOOKS LOOKE LOOKW LOOKU LOOKD
------------------------------------------------------------------------------------------
define method .setLook( !look is STRING)

  if !look.subString(1,4).eq(|LOOK|) then

    if !look.eq(|LOOKU|).or(!look.eq(|LOOKD|)) then

      !dir[1] = 0
      !dir[2] = -1
      !dir[3] = 0

      !this.volumeView.direction = !dir

    endif

    -- Remember look
    !this.look = !look

    -- Reset plan
    !this.plan = ''

    -- Reset iso
    !this.iso = ''

    !direction = object DIRECTION(!look.after(|LOOK|))
    !pVector = object POINTVECTOR(object POSITION(|E 0 N 0 U 0 WRT /* |), !direction)
    !line = !pVector.line(1)

    !dir[1] = !line.endPosition.east.value()
    !dir[2] = !line.endPosition.north.value()
    !dir[3] = !line.endPosition.up.value()

    !this.volumeView.direction = !dir

  endif

endmethod

------------------------------------------------------------------------------------------
-- Method .getLook() is STRING - Returns current value of look member. --
------------------------------------------------------------------------------------------
define method .getLook() is STRING

	return !this.look

endmethod

------------------------------------------------------------------------------------------
