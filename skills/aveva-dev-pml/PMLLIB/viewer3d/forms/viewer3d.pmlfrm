------------------------------------------------------------------------------------------
-- Method .setBox() - Sets new value of this.box member. --
-- Note:                                                         --
--  x,  y,  z                                                    --
-- [0],[1],[2] - From                                            --
-- [3],[4],[5] - To                                              --
------------------------------------------------------------------------------------------
define method .setBox(!box1 is STRING, !box2 is STRING, !box3 is STRING, !box4 is STRING, !box5 is STRING, !box6 is STRING)

   !tmpbox1 = object real(!box1)
   !tmpbox2 = object real(!box2)
   !tmpbox3 = object real(!box3)
   !tmpbox4 = object real(!box4)
   !tmpbox5 = object real(!box5)
   !tmpbox6 = object real(!box6)

   !this.box.xlength = !tmpbox4 - !tmpbox1
   !this.box.ylength = !tmpbox5 - !tmpbox2
   !this.box.zlength = !tmpbox6 - !tmpbox3

   !this.box.position.east = !tmpbox1 + (!this.box.xlength / 2)
   !this.box.position.north = !tmpbox2 + (!this.box.ylength / 2)
   !this.box.position.up = !tmpbox3 + (!this.box.zlength / 2)

endmethod

--------------------------------------------------------------------------------------------
-- Method .getBox() is ARRAY - Returns current value of this.box member. --
-- Note:                                                                           --
--  x,  y,  z                                                                      --
-- [0],[1],[2] - From                                                              --
-- [3],[4],[5] - To                                                                --
--------------------------------------------------------------------------------------------
define method .getBox() is ARRAY

  -- Box
  !box = object array()

  !tmpbox1 = (!this.box.position.east - !this.box.xlength / 2)
  !tmpbox2 = (!this.box.position.north - !this.box.ylength / 2)
  !tmpbox3 = (!this.box.position.up - !this.box.zlength / 2)
  !tmpbox4 = (!this.box.position.east + !this.box.xlength / 2)
  !tmpbox5 = (!this.box.position.north + !this.box.ylength / 2)
  !tmpbox6 = (!this.box.position.up + !this.box.zlength / 2)

  !box[1] = !tmpbox1.string()
  !box[2] = !tmpbox2.string()
  !box[3] = !tmpbox3.string()
  !box[4] = !tmpbox4.string()
  !box[5] = !tmpbox5.string()
  !box[6] = !tmpbox6.string()

  return !box

endmethod

------------------------------------------------------------------------------------------
-- Method .setLimits() - Sets new value of this.volumeView.limits member.              --
-- Note:                                                                                --
--       E,     N,    U                                                                 --
-- From  1,     3,    5                                                                 --
-- To    2,     4,    6                                                                 --
------------------------------------------------------------------------------------------
define method .setLimits(!limit1 is STRING, !limit2 is STRING, !limit3 is STRING, !limit4 is STRING, !limit5 is STRING, !limit6 is STRING)

    -- Limits
    !limits = object array()

    !limits[1] = object real(!limit1)
    !limits[2] = object real(!limit2)
    !limits[3] = object real(!limit3)
    !limits[4] = object real(!limit4)
    !limits[5] = object real(!limit5)
    !limits[6] = object real(!limit6)

    !this.volumeView.limits = !limits

endmethod

---------------------------------------------------------------------------------------------
-- Method .getLimits() is ARRAY - Returns current value of this.volumeView.limits member. --
-- Note:                                                                                   --
--       E,     N,    U                                                                    --
-- From  1,     3,    5                                                                    --
-- To    2,     4,    6                                                                    --
---------------------------------------------------------------------------------------------
define method .getLimits() is ARRAY

    -- Limits
    !limits = object array()
    !tmpLimits = !this.volumeView.limits

    !limits[1] = !tmpLimits[1].string()
    !limits[2] = !tmpLimits[2].string()
    !limits[3] = !tmpLimits[3].string()
    !limits[4] = !tmpLimits[4].string()
    !limits[5] = !tmpLimits[5].string()
    !limits[6] = !tmpLimits[6].string()

    return !limits

endmethod

------------------------------------------------------------------------------------------
-- Method .setClipBox - Sets new value of the !this.volumeView.clip... members.        --
-- Note:                                                                                --
-- pos1, pos2, pis3 - Center of box.                                                    --
-- xLen, yLen, zLen - Box's dimensions along x, y and z axis.                           --
------------------------------------------------------------------------------------------
define method .setClipBox(!pos1 is STRING, !pos2 is STRING, !pos3 is STRING, !xLen is STRING, !yLen is STRING, !zLen is STRING)

  !clipboxposition = object array()

  -- Set clipbox
  !clipboxposition[1] = object real(!pos1)
  !clipboxposition[2] = object real(!pos2)
  !clipboxposition[3] = object real(!pos3)

  !this.volumeView.clipping = TRUE

  !this.volumeView.clipboxposition = !clipboxposition
  !this.volumeView.clipBoxXlen = object real(!xLen)
  !this.volumeView.clipBoxYlen = object real(!yLen)
  !this.volumeView.clipBoxZlen = object real(!zLen)

endmethod

------------------------------------------------------------------------------------------
-- Method .getClipBox() - Gets current value of the !this.volumeView.clip... members.  --
-- Note:                                                                                --
-- 1, 2, 3 - Center of box.                                                             --
-- 4 - Box's length in x direction.                                                     --
-- 5 - Box's length in y direction.                                                     --
-- 6 - Box's length in z direction.                                                     --
------------------------------------------------------------------------------------------
define method .getClipBox() is ARRAY

  -- clipBox
  !clipBox = object array()

  !clipboxposition = !this.volumeView.clipboxposition

  !clipBox[1] = !clipboxposition[1].string()
  !clipBox[2] = !clipboxposition[2].string()
  !clipBox[3] = !clipboxposition[3].string()
  !clipBox[4] = !this.volumeView.clipBoxXlen.string()
  !clipBox[5] = !this.volumeView.clipBoxYlen.string()
  !clipBox[6] = !this.volumeView.clipBoxZlen.string()

  return !clipBox

endmethod

