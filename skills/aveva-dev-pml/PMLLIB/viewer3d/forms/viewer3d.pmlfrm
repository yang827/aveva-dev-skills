------------------------------------------------------------------------------------------
--                                                                                      --
------------------------------------------------------------------------------------------

define method .setThrough(!pos1 is STRING, !pos2 is STRING, !pos3 is STRING)

  !through = object array()

  -- Set clipbox
  !through[1] = object real(!pos1)
  !through[2] = object real(!pos2)
  !through[3] = object real(!pos3)

  !this.volumeView.through = !through

endmethod

------------------------------------------------------------------------------------------
--                                                                                      --
------------------------------------------------------------------------------------------

define method .getDirection() is ARRAY

  !direction = object array()

  !tmpdirection = !this.volumeView.direction

  !direction[1] = !tmpdirection[1].string()
  !direction[2] = !tmpdirection[2].string()
  !direction[3] = !tmpdirection[3].string()

  return !direction

endmethod

------------------------------------------------------------------------------------------
--                                                                                      --
------------------------------------------------------------------------------------------

define method .setDirection(!pos1 is STRING, !pos2 is STRING, !pos3 is STRING)

  !direction = object array()

  -- Set clipbox
  !direction[1] = object real(!pos1)
  !direction[2] = object real(!pos2)
  !direction[3] = object real(!pos3)

  !this.volumeView.direction = !direction

endmethod

------------------------------------------------------------------------------------------
-- Method .getAuxiliaryDrawListSglId() is REAL - Gets SGL id of auxiliary draw list.    --
-- Note. In case of error returns -1.0 .
------------------------------------------------------------------------------------------
define method .getAuxiliaryDrawListSglId() is REAL

   -- Set default value which means error.
   !sglid = -1.0

   -- Get the drawlist associated with the view.
   !drawlist = !!gphDrawlists.drawlist(!this.auxiliaryDrawList)

   if !drawlist.unset().not() then
      !sglid = !drawlist.sglid()
   endif

   return !sglid

endmethod

------------------------------------------------------------------------------------------
-- Method .getDrawListSglId() is REAL - Gets SGL id of draw list. --
-- Note. In case of error returns -1.0 .
------------------------------------------------------------------------------------------
define method .getDrawListSglId() is REAL

   -- Set default value which means error.
   !sglid = -1.0

   -- Get the drawlist associated with the view.
   !drawlist = !!gphDrawlists.drawlist(!this.drawlist)

   if !drawlist.unset().not() then
      !sglid = !drawlist.sglid()
   endif

   return !sglid

endmethod

