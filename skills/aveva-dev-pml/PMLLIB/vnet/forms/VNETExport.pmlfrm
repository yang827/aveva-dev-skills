-- Kill existing form definition
Kill !!VNETExport

!name = '9XMvbxuchzkp/mC4GaGT3cy/ZLTguovipJZcvsorjJXynSV1'
!check = !name.substring(48,' 2')

-- Define Form
Setup Form  !!VNETExport at xr0 yr0 dialog

  !this.formtitle    = 'AVEVA NET Export - Main'
  !this.icontitle    = ''
  !this.Callback     = '!this.initialise()'
  !this.formrevision = ' $Revision 1.0$ '

  path down

  -- Body of Form
    bar
    -- Define Bar Menu
      !bar = !this.bar
      !bar.add('Control',  'ControlMenu')
      !bar.add('Setup',    'SetupMenu')
      !bar.add('About',    'AboutMenu')

      -- Control Menu
      !menu = !this.newMenu('ControlMenu')
        !menu.add('CALLBACK', 'Save Settings...', 'call !!VNETfilebrowser(''%PDMSUSER%'', ''VNET*.dat'', ''Save Export Definition'', false, ''!!VNETsetupfile(true)'', ''SAVE'')')
        !menu.add('CALLBACK', 'Load Settings...', 'call !!VNETfilebrowser(''%PDMSUSER%'', ''VNET*.dat'', ''Load Export Definition'', true, ''!!VNETsetupfile(false)'',''OPEN'')')
        !menu.add('separator')
        !menu.add('CALLBACK', 'Close',   '!this.hide()')

      -- Setup Menu
      !menu = !this.newMenu('SetupMenu')
        !menu.add('CALLBACK','Settings...','show !!VNETxsettings')

      -- About Menu
      !menu = !this.newMenu('AboutMenu')
      var !bannerName BANNER
      !resultVar = !bannerName.string()
      if (!resultVar.occurs('PDMS') eq 1) then
      !menu.add('CALLBACK','AVEVA NET PDMS Gateway 4.7.1.1','')
      else
      !menu.add('CALLBACK','AVEVA NET Marine Gateway 4.7.1.1','')
      endif

    -- Output Folder
    frame .FOutput |Character Encoding| width 43
      para .charenc width 48 lines 1
    exit

    -- Check for Marine and add relevent gadgets
    var !marine evar  'marine'
    var !pdmsmarine evar  'pdms_marine'

    if(!marine.upcase().eq('YES')) or (!pdmsmarine.upcase().eq('YES')) then
       frame .designtype |Select Hierarchy To Export| at x0 ymax+0.2 width.FOutput
          rtoggle .desitem1 'Design Items' States '' 'Sites'
          path right
          valign centre
          rtoggle .desitem2 'Assemblies' States '' 'Assemblies'
          rtoggle .desitem3 'Manufacturing' States '' 'Manufacturing'
       exit
       !this.designtype.val = 1
       !this.designtype.callback = '!this.resetModuleHier()'
    endif

    -- Create Datum
    frame .Fhier |Select MDB and Items| at x0 ymax+0.2 width.FOutput
      option .MDB | MDB | at ymax+.25 call |!this.swapmdb()| width 39
      button .List |Change Selection...| at xmin_MDB ymax+.25 tooltip 'Select MDB items to export' Call |show !!VNETxlist|
      para   .PList at xmax+0.75 ymin width 26 lines 1
    exit

    -- Set Classification
    frame .FClassify |Class Mapping| at x0 ymax+0.2 width.FOutput
      path right
      para .UClass at xmin_charenc ymax width 47 lines 1
    exit

    -- Progress visualiser
    frame .FProgress |Progress| at x0 ymax+0.2 width.FOutput
      para .Progress at ymax text '                                            '
      para .NumberOfItems at xmin_Progress ymax text '                                            '
      para .Progtxt at xmin_Progress ymax text |                | width 11
      para .Prog0  at xmax+1 ymin text |   |
      para .Prog1  at xmax_Prog0-1 ymin text |   |
      para .Prog2  at xmax_Prog1-1 ymin text |   |
      para .Prog3  at xmax_Prog2-1 ymin text |   |
      para .Prog4  at xmax_Prog3-1 ymin text |   |
      para .Prog5  at xmax_Prog4-1 ymin text |   |
      para .Prog6  at xmax_Prog5-1 ymin text |   |
      para .Prog7  at xmax_Prog6-1 ymin text |   |
      para .Prog8  at xmax_Prog7-1 ymin text |   |
      para .Prog9  at xmax_Prog8-1 ymin text |   |
      para .Prog10 at xmax_Prog9-1 ymin text |   |
      para .Prog11 at xmax_Prog10-1 ymin text |   |
      para .Prog12 at xmax_Prog11-1 ymin text |   |
      para .Prog13 at xmax_Prog12-1 ymin text |   |
      para .Prog100 at xmax_Prog13 ymin text |    |

  exit

  -- Bottom Line
    button .Cancel | Dismiss | at xmax form-size ymax+0.2 cancel
    button .Setting | Settings... | at xcen form-8 ymin call |show !!VNETxsettings|
    button .Ok     | Apply | at x0 ymin call |!this.ExercuteExport()|

  -- Form Members

    -- Definition File
    member .SetupFile is STRING

  -- Current MDB members
    member .SiteMembers is ARRAY

    -- Hierarchy Selection
    member .HierList is ARRAY

    -- Classification list
    member .Classes  is ARRAY

    -- MDB store (to enable roll-back if change is CANCELled.)
    member .oldMDB is STRING

  -- User Class Temporary Storage area
    member .UserClassStore1 is array
    member .UserClassStore2 is array
    member .UserClassStore3 is array
    member .UserClassStore4 is array
    member .UserClassStore5 is array
    member .UserClassStore6 is array
    member .UserClassStore7 is array
    member .UserClassStore8 is array
    member .UserClassStore9 is array
    member .UserClassStore10 is array

  -- Allows the PDMS name to be modified as per the required output names
  -- OrigName Setting File exists
    member .OrigName is BOOLEAN

  -- Other Names allows the output to have extra lines that adds
  -- an association of is identified by to allow mapping to other systems items names
  -- OtherNames Setting File exists
    member .OtherNames is BOOLEAN

  -- Allows classification of items be item type
  -- UserClass Setting File exists
    member .UserClass is BOOLEAN
    member .UserClassFileName is STRING

  -- Current PDMS Module
    member .PDMSModule is STRING
    member .hierprefix is STRING

  -- Marine Settings
    member .marine is BOOLEAN
    !this.marine = false
    if(!marine.upcase().eq('YES')) or (!pdmsmarine.upcase().eq('YES')) then
       !this.marine = true
    endif

  -- Valid Modules
    member .ValidDes is STRING
    member .ValidSpl is STRING
    member .ValidDra is STRING

    !this.ValidDes = 'DESIGN OUTFITTING HULLDESIGN'
    !this.ValidSpl = 'SPOOLER'
    !this.ValidDra = 'DRAFT'

 -- Running data for logfile
    member .user is STRING
    member .logtime is STRING

  -- Valid Marine Design Items
    member .MarineTypes is STRING
    !this.MarineTypes = 'BLOCK SSOWLD HCMWLD COMWLD RSOWLD'

  -- Valid Marine Manufacturing Items
    member .ManuTypes is STRING
    !this.ManuTypes = 'MBLOCK MANPKG'

  -- Logfiles
    member .NormalLog is file
    member .FullLog is file
    member .LogfileMes is array

exit


-- End form definition for !!VNETExport()

---------------------------------------------------------------------------
-- Method:           .initialise
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Initialise AVEVA NET Export routines
----------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables

   !this.mdb.active  = true
   !this.list.active = true

   !this.FProgress.active = false
   !this.prog1.visible = false
   !this.prog2.visible = false
   !this.prog3.visible = false
   !this.prog4.visible = false
   !this.prog5.visible = false
   !this.prog6.visible = false
   !this.prog7.visible = false
   !this.prog8.visible = false
   !this.prog9.visible = false
   !this.prog10.visible = false
   !this.prog11.visible = false
   !this.prog12.visible = false
   !this.prog13.visible = false

  -- Selection
   !this.plist.val = 'Unset (Output all MDB)'

  -- Check project is set (Pre 11.5)
   if undefined(!!currentproject) then
      var !!currentproject project code
   endif

  -- Check Current Module
   !this.ModuleCheck()

  -- Set default file pathname by calling in the respective form
  -- ONLY if it hasn't been called before (Dont want to reset user input!)
   if undefined (!!VNETXsettings) then
      pml load form !!VNETXsettings
   endif
   if undefined (!!VNETXlist) then
      pml load form !!VNETxlist
   endif

   if undefined (!!VNETCharEncObj) then
      pml load object VNETEncodingStore
      !!VNETCharEncObj = object VNETEncodingStore()
   endif

  -- Check for a Class settings File for the current project
   !this.ClassFileExists()
   !this.ClassRead()

  -- Show file names on main
   !this.OutputFldr()

  -- Check for a OriginalName settings file for the current project
   !this.OriginalNameExists()

  -- Check for a OtherName settings file for the current project
   !this.OtherNameExists()

  -- Include unset values
   !!VNETxsettings.IncludeUnsetValue.val = false

  -- Include nulref values
   !!VNETxsettings.IncludeNulrefValue.val = false
   !!VNETxlist.formtitle = 'AVEVA NET Export - Item Selection (Unnamed items Excluded)'

  -- Include UnNamed Sites
   !!VNETxsettings.IncludeUnNamedSite.val = false

  -- Include (0) values
   !!VNETxsettings.IncludeZeroValue.val = false

 -- Include (E 0 N 0 U 0) Positions
   !!VNETxsettings.IncludeZeroPosValue.val = false

 -- Export referenced Hierachies when exporting SPLDRG and ASMBLY
   !!VNETxsettings.IncludeSITES.val = true

  -- Set error messages to the default settings
   !!VNETxsettings.AttrErr.val = true
   !!VNETxsettings.ConErr.val = true

  -- Read in Include Design files
   !!VNETDefaultsExist(!!VNETxsettings.incitemname, 'DES-VNET-ITEMS')
   !!VNETDefaultsExist(!!VNETxsettings.incattrsname, 'DES-VNET-INCLUDE')

  -- Read in Include Spooler files
   !!VNETDefaultsExist(!!VNETxsettings.incitemspl, 'SPL-VNET-ITEMS')
   !!VNETDefaultsExist(!!VNETxsettings.incattrsspl, 'SPL-VNET-INCLUDE')
   !!VNETDefaultsExist(!!VNETxsettings.inctolerspl, 'SPL-VNET-TOLERANCE')

  -- Read in Character Encoding file
   !!VNETDefaultsExist(!!VNETxsettings.charencname, 'VNET-CHAR-ENCODE')

  -- Get Encoding
   !!VNETLoadXMLEncode()

  -- Character Encoding
   !this.CharEnc.val = 'Character Encoding : ' & !!VNETCharEncode()

  -- Set VM gadgets
   if !this.marine then

      if !this.ValidDes.match(!this.PDMSModule) gt 0 then
         !this.designtype.active = true
      else
         !this.designtype.active = false
      endif

      if undefined (!!VNETAssmObj) then
         pml load object VNETAssemblyStore
         !!VNETAssmObj = object VNETAssemblyStore()
      endif
   endif

  -- Set current module hierprefix
   !this.SetModuleHier()

  -- Set the HierList on the xlist form
   !this.SetHierList()

  -- Modify Menu Settings
   !gadget = !this.MDB
   var !mdb coll all mdb
   var !mdbn eval name for all from !mdb
   !gadget.dtext = !mdbn
   !gadget.rtext = !mdbn

  -- Select current MDB in gadget list
   var !a mdb
   !this.MDB.select('DTEXT', !a)

  -- Clear list of elements to dump and set to current world /*
   !this.HierList.Clear()
   !this.HierList[1] = '/*'
   !this.oldMDB      = !this.MDB.selection()

 -- Set User
   var !user user
   !this.user = !user

  -- Read in RVM Template file
   !!VNETDefaultsExist(!!VNETxsettings.rvmtempname, 'DES-VNET-RVMTEMPLATE.xr')
   !!VNETxsettings.checkrvmtemp()

endmethod

-- End of method definition for .initialise()

---------------------------------------------------------------------------
-- Method:           .swapmdb
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Check MBDs are available
----------------------------------------------------------------------------

define method .swapmdb()

 -- Initialise Variables

  !xlistshown = !!VNETxlist.shown()
  if !xlistshown then
     !!VNETxlist.hide()
  endif

  !Save = !!Alert.question('Do you wish to SAVEWORK before changing MDB''s?')
  if (!Save eq 'YES') then
    !Upd = 'MDB NOUPDATE'
  elseif (!Save eq 'NO') then
    !Upd = 'MDB UPDATE'
  else
    !this.MDB.select('DTEXT', !this.oldMDB)
    return
  endif

  !origMDB = !this.oldMDB

 -- Execute the MDB change
  !ExitMDBmode = 'exit'
  !this.oldMDB = !this.mdb.selection()
  $!upd
  $!this.MDB
  handle any
     !!Alert.warning('Error changing MDBs : $!!ERROR.TEXT')
     $!origMDB
     !this.oldMDB = !origMDB
     !this.mdb.select('RTEXT',!this.oldMDB)
  endhandle
  $!ExitMDBmode
  handle any
     !!Alert.warning('Error changing MDBs : $!!ERROR.TEXT')
     $!origMDB
     !this.oldMDB = !origMDB
     !this.mdb.select('RTEXT',!this.oldMDB)
     $!ExitMDBmode
     handle any
     endhandle
  endhandle

 -- Set the hierarch list to the world again, until the user says different...
  !this.HierList.Clear()
  !this.Hierlist[1] = '/*'

  if !xlistshown then
     !!VNETxlist.show()
  endif

endmethod

-- End of method definition for .swapmdb()

---------------------------------------------------------------------------
-- Method:           .ClassFileExists
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Check if a project Class pmlobj file exists
----------------------------------------------------------------------------

define method .ClassFileExists()

  -- Try and load a UserClass file that defined for the project
  -- this would be in the format of VNETUserClass-<Project 3 characters>.pmlobj

   !Uclass = object file()

   !filename = 'VNETUserClass' & !!currentproject & '.pmlobj'
   !filenamelc = !filename.lowcase()
   !macro = !!pml.getPathName(!filenamelc)
   handle none
      !!VNETxsettings.uclass.val = !macro
   elsehandle any
      !!VNETxsettings.uclass.val = 'Unset'
   endhandle

  -- If the Uclass field is unset then we only use the standard AVEVA supplied mapping file.
  -- If it IS set then we use the std. one first, then call the users one second.
   !file1 = !Uclass.file(!!VNETxsettings.uclass.val).entry()
   if (!file1 eq 'Unset') then
     !file1 = !uclass.file(!!VNETxsettings.class.val).entry()
   endif

   !this.Uclass.val = !file1

   if (!this.uclass.val eq 'Unset') then
      !this.UserClass = false
   else
      !UserFunction = !!file(!this.uclass.val).entry()
      !filename = !UserFunction.lowcase()
      !macro = !!pml.getPathName(!filename)
      handle any
         !this.UserClass = false
      elsehandle none
         !this.UserClass = true
         !this.UserClassFileName = !this.Uclass.string().before('.pmlobj')
      endhandle
   endif

endmethod

-- End of method definition for .ClassFileExists()

---------------------------------------------------------------------------
-- Method:           .OriginalNameExists
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Check if a project Original Names pmlobj file exists
----------------------------------------------------------------------------

define method .OriginalNameExists()

-- Determine if OriginalName file exists
   !filename = 'VNETxmlOrigName' & !!currentproject & '.pmlobj'
   !filenamelc = !filename.lowcase()
   !macro = !!pml.getPathName(!filenamelc)
   handle any
      !this.OrigName = false
      !!VNETxsettings.OrigName.val = 'Unset'
      !!VNETxsettings.OrigName.settooltip('Unset')
   elsehandle none
      !this.OrigName = true
      !!VNETxsettings.OrigName.val = !macro
      !!VNETxsettings.OrigName.settooltip(!macro.string())
   endhandle

endmethod

-- End of method definition for .OriginalNameExists()

