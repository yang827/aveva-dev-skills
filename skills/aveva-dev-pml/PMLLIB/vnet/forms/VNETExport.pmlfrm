---------------------------------------------------------------------------
-- Method:           .ClassRead
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Read in the Class Library file
----------------------------------------------------------------------------

define method .ClassRead()

  !ClassArray = object ARRAY()

  -- Open Class Definition file and read in all contents...
  !InFile = !!VNETxsettings.Class.val
  !InputFile = object FILE(!InFile)
  if (!InputFile.exists()) then
    !Lines     = !InputFile.ReadFile()
  else
    !!Alert.Error('Error finding Class Definition file. $!InFile Does Not Exist')
    return
  endif

  -- Find the "--Begin" indicator
  !StartIndx = !Lines.FindFirst('--Begin')
  If (!StartIndx eq 0) then
    !!Alert.Error('Cannot find any entries in Class definition file. $!InFile')
    return
  endif

  -- Remove the unwanted lines from the array
  !Rem = !Lines.DeleteTo(!StartIndx)
  !cmp = !Lines.Compress()

  Do !line values !Lines
    !ClassArray.append(!line)
  Enddo

  -- Finally set them to the main store .Classes
  !this.Classes = !ClassArray

endmethod

-- End of method definition for .ClassRead()

---------------------------------------------------------------------------
-- Method:           .ModuleCheck
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Check current Module
----------------------------------------------------------------------------

define method .ModuleCheck()

   !session = current session
   !this.PDMSModule = !session.module()

endmethod

-- End of method definition for .ModuleCheck()

---------------------------------------------------------------------------
-- Method:           .SetModuleHier
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Determine the PDMS Module and set the form text accordingly
----------------------------------------------------------------------------

define method .SetModuleHier()

   !this.hierprefix = 'SITE'

   if !this.ValidDes.match(!this.PDMSModule) gt 0 then
      if !this.marine then
         if !this.designtype.val eq 1 then
            !this.hierprefix = 'SITE'
            !!VNETxlist.MEMBERSADD.tag = 'Add Parent of CE'
            !!VNETxlist.REM.tag = 'Remove Parent of CE'
         elseif !this.designtype.val eq 2 then
            !this.hierprefix = 'ASMBLY'
            !!VNETxlist.MEMBERSADD.tag = 'Add Assembly of CE'
            !!VNETxlist.REM.tag = 'Remove Assembly of CE'
         else
            !this.hierprefix = 'MANU'
            !!VNETxlist.MEMBERSADD.tag = 'Add Parent of CE'
            !!VNETxlist.REM.tag = 'Remove Parent of CE'
         endif
      endif
   elseif !this.ValidSpl.match(!this.PDMSModule) gt 0 then
      !this.hierprefix = 'ISODEP'
      !!VNETxlist.MEMBERSADD.tag = 'Add Isodep of CE'
   else
      !this.hierprefix = !this.PDMSModule
   endif

endmethod

-- End of method definition for .SetModuleHier()

---------------------------------------------------------------------------
-- Method:           .resetModuleHier
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Reset the List of included items if you change MDB
----------------------------------------------------------------------------

define method .resetModuleHier()

   !!vnetxlist.IDLIMEM.clear()
   if !!vnetxlist.shown() then
      hide !!vnetxlist
   endif

   !this.SetHierList()
   !this.SetModuleHier()

endmethod

-- End of method definition for .resetModuleHier()

---------------------------------------------------------------------------
-- Method:           .ExercuteExport
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Exercute the relevent Export
----------------------------------------------------------------------------

define method .ExercuteExport()

   -- "pml index" will update bufferd files (like VNETUserClassXXX.pmlobj objects)
   pml index

  -- Reset Errors
   !!error.text = ''

   if (undefined(!!VNETdirbrowser)) then
     pml load form !!VNETdirbrowser
   endif

   !!VNETxsettings.checkdir('logfile')

   !this.ModuleCheck()

   !!fmsys.UIACTIVATE(false)
   if (!this.ValidDes.match(!this.PDMSModule) gt 0) then
      if !this.marine then
         if !this.designtype.val eq 1 or !this.designtype.val eq 3 then
            !a = object VNETWriteXML()
         elseif !this.designtype.val eq 2 then
            !a = object VNETWriteASMXML()
         endif
      else
         !a = object VNETWriteXML()
      endif
   elseif !this.ValidSpl.match(!this.PDMSModule) gt 0 then
      !a = object VNETWriteSPLXML()
   elseif !this.ValidDra.match(!this.PDMSModule) gt 0 then
      !a = object VNETWriteXML()
   else
      !!alert.warning('You must be in ' + !this.ValidDes + ' ' + !this.ValidSpl + ' modules to run the AVEVA NET Export')
      return
   endif

   !errormessage = ''
   if !!error.text.before('-') eq 'VNETError' then
      !errormessage = !!error.text.after('-')
   endif

  -- Check If Errors Occured
   if !!VNETError.ExErrors or !!VNETError.OrigNameError or !errormessage neq '' then
      if undefined(!!VNETBatchMode) then
         REPR UPDATE
         !!Alert.Warning(!errormessage + ' Export Complete. Warnings/Errors occured. Check Log file(s)')
      else
         $p Export Complete. Check Log file(s)
      endif
   endif

  -- Reset Errors
   !!VNETError.Reset()
   !!error.text = ''

endmethod

-- End of method definition for .ExercuteExport()

---------------------------------------------------------------------------
-- Method:           .SetHierList
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Set the selected hieracy
----------------------------------------------------------------------------

define method .SetHierList()

  !!VNETExport.HierList.Clear()
  if (!!VNETxlist.idlimem.rtext.size() eq 0) or (!!VNETxlist.members.rtext.size() eq 0) then
    !this.plist.val = 'Unset (Output all MDB)'
    !this.HierList[1] = '/*'
  else
    !this.plist.val = 'Selected ' & !!VNETxlist.idlimem.rtext.size() & ' Item(s)'

   -- Set Main Store for Hierarch list.....
    !this.HierList = !!VNETxlist.idlimem.rtext
  endif

endmethod

-- End of method definition for .SetHierList()

---------------------------------------------------------------------------
-- Method:           .OutputFldr
-- Arthor:           I.Stanbrook
-- Created:          Fri September 25
--
--
-- Description:
-- Function to set output folder on main form
----------------------------------------------------------------------------

define method .OutputFldr()

   !file = !!file(!!VNETxsettings.output.val)

   !check = !file.fullname()
   handle any
      !!VNETxsettings.output.val = '%PDMSUSER%'
   endhandle

endmethod

-- End of method definition for .OutputFldr()

