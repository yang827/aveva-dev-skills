--
--
-- Description:
-- Form definition for File Browser form.
--
------------------------------------------------------------------------

-- Define form
setup form !!VNETdirBrowser at xr 0 yr 0 blocking

  !!VNETdirBrowser.formTitle     = 'AVEVA NET Export - Directory Browser'
  !!VNETdirBrowser.iconTitle     = 'DIRS'
  !!VNETdirBrowser.callback      = ''
  !!VNETdirBrowser.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Frame for directory subdirectories
  para .mode at x0 y0 width 45 line 1

  frame .directoryFrame at x 0.1 ymax+0.2 |Directory|

    text .path   at xmin+1 ymin+1   |Path |           callback |call !!VNETdirBrowserDir(_path.val)|                  width 34 string
    list .subDir at xmin   ymax+0.2 |Sub-directories| callback |call !!VNETdirBrowserDir(_subDir.selection('RTEXT'))| width 45 length 8

  exit

  -- Buttons
  button .ok     |  OK  | at x 0            ymax+0.5 ok
  button .cancel |Cancel| at xmax form-size ymin     cancel

  -- Members
    -- Directory for which contents are displayed
    member .directory is STRING
    member .file      is FILE
    member .existFlag is BOOLEAN

exit
-- End of form definition for !!VNETdirBrowser
