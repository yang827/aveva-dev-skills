--   Module:            Design
--   Replaces:
--
-- Arthor:           C. Pearson
-- Created:          Fri March 20
--
--
-- Description:
-- Set the list of main elements to be dumped out
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addele()                         -
--  addeleall()                      -
--  deleleall()                      -
--  delentry()                       -
--  getassembnames(DBREF)            ARRAY
--  idlimemSort()                    -
--  idlimemState()                   -
--  initialise()                     -
--  membersState()                   -
--  membersadd()                     -
--  membersfilter()                  -
--  remele()                         -
--  resetpos(GADGET,ARRAY)           -
--  selectinv (STRING)               -
--  setheadings()                    -
--  updatemembers()                  -
--

-- Kill existing form definition
kill !!VNETxlist

-- Define form
setup form !!VNETxlist

  !!VNETxlist.formtitle = 'AVEVA NET Export - Item Selection'
  !!VNETxlist.icontitle = ||
  !!VNETxlist.Callback  = '!this.initialise()'
  !!VNETxlist.formrevision = |$Revision 1.0$ |

  frame .FRMMEMBERS |Items in MDB|
     text   .MEMBERSFLTR |Select by Filter | call |!this.membersfilter()| width 25 string
     list   .MEMBERS || call |!this.membersState()| at xmin_MEMBERSFLTR ymax_MEMBERSFLTR+.1 multi width 40 length 12
     button .MEMBERSADD |Add Parent of CE| at xmin_MEMBERSFLTR ymax_MEMBERS+.1 call |!this.membersadd()|
  exit

  button .ADD at xmax_FRMMEMBERS+1 ymin_FRMMEMBERS+4 pixmap height 16 width 16 call |!this.addele()| tooltip 'Add selected to Export list'
  button .ADDALL at xmin_ADD ymax pixmap height 16 width 16 call |!this.addeleall()| tooltip 'Add all to Export list'
  button .DELENT at xmin_ADD ymax pixmap height 16 width 16 call |!this.delentry()| tooltip 'Remove selected from Export list'
  button .DELALL at xmin_ADD ymax pixmap height 16 width 16 call |!this.deleleall()| tooltip 'Remove all from Export list'

  frame .FRMIDLIMEM |Items to Export| at xmax_ADD+1 ymin_FRMMEMBERS
     list   .IDLIMEM || at ymin_MEMBERS multi width 40 length 12
     button .REM  | Remove CE Parent | at xmin_IDLIMEM ymin_MEMBERSADD call |!this.remele()|
     para .NUMSEL at xmax_IDLIMEM-13 ymin_REM width 12 lines 1
  exit

  button .OK     | OK | at x0 ymax_FRMMEMBERS+0.5  call |!!VNETExport.SetHierList()| OK
  button .CANCEL | Cancel | at xmax form-size ymin CANCEL

  -- Add form members....

  -- Pop up menus
  menu .idlidelPop
    !this.idlidelPop.add('callback', 'Remove Selection', '!this.delentry() ')
    !this.idlidelPop.add('callback', 'Remove CE Parent', '!this.remele() ')
    !this.idlidelPop.add('callback', 'Remove All', '!this.deleleall() ')
    !this.idlidelPop.add('separator')
    !this.idlidelPop.add('callback', 'Clear Selection', '!this.idlimem.clearselection()
                                                         !this.idlimemState() ')
    !this.idlidelPop.add('callback', 'Invert Selection', '!this.selectinv(|vnetxlist.idlimem|) ')
    !this.idlimem.setPopup(!this.idlidelPop)

  menu .memPop
      !this.memPop.add('callback', 'Add Selection', '!this.addele()')
      !this.memPop.add('callback', 'Add All', '!this.addeleall()')
      !this.memPop.add('separator')
      !this.memPop.add('TOGGLE', 'Sort Alphabetically A-Z', '!this.updatemembers()')
      !this.memPop.add('separator')
      !this.memPop.add('callback', 'Clear Selection', '!this.members.clearselection()
                                                       !this.membersState() ')
      !this.memPop.add('callback', 'Invert Selection', '!this.selectinv(|vnetxlist.members|) ')
      !this.mempop.select('Sort Alphabetically A-Z', false)
      !this.members.setPopup(!this.memPop)

  !this.IDLIMEM.callback = |!this.DELENT.active = (not !this.IDLIMEM.val.unset())
                            !this.idlidelPop.setactive('Remove Selection', (not !this.IDLIMEM.val.unset()))|

  -- Pixmaps
  !this.ADD.addPixmap(!!PML.getPathName('rightarrow16.png'))
  !this.ADDALL.addPixmap(!!PML.getPathName('rightrightarrow16.png'))
  !this.DELENT.addPixmap(!!PML.getPathName('leftarrow16.png'))
  !this.DELALL.addPixmap(!!PML.getPathName('leftleftarrow16.png'))

exit

-- End of form definition

---------------------------------------------------------------------------
-- Method:           .initialise
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Load all sites in MDB into Form list for user to choose from
----------------------------------------------------------------------------

define method .initialise()

  if !!VNETExport.ValidDes.match(!!VNETExport.PDMSModule) gt 0 then
     if !!VNETExport.hierprefix eq 'SITE' then
     var !siteref collect all SITE
     var !siten eval name for all from !siteref
     var !sitefn eval fullname for all from !siteref
       -- Get Blocks as well
        if (!!VNETExport.marine) then

           !splittyp = !!VNETExport.MarineTypes.split()
           do !martypes values !splittyp

              var !allitmref collect all $!martypes
              var !allitmn eval name for all from !allitmref
              var !allitmfn eval fullname for all from !allitmref

              !siten.appendarray(!allitmn)
              !sitefn.appendarray(!allitmfn)
           enddo

        endif

     elseif !!VNETExport.hierprefix eq 'MANU' then
        !splitManuTyps = !!VNETExport.ManuTypes.split()
		!manuRefs = object array()
        do !manutype values !splitManuTyps
			var !manuTypeRefs collect all $!manutype
			handle any
				!manuTypeRefs = object array()
			endhandle
			!manuRefs.appendArray(!manuTypeRefs)
		enddo
        var !manuFns eval fullname for all from !manuRefs
		!sites = !manuFns
     else

        !!VNETAssmObj.Update()

        !sites = !!VNETAssmObj.memfullname


     endif
  elseif !!VNETExport.ValidSpl.match(!!VNETExport.PDMSModule) gt 0 then
     var !siteref collect all ISODEP
     var !siten eval name for all from !siteref
     var !sitefn eval fullname for all from !siteref
  elseif !!VNETExport.ValidDra.match(!!VNETExport.PDMSModule) gt 0 then
     var !siteref collect all SITE
     var !siten eval name for all from !siteref
     var !sitefn eval fullname for all from !siteref
  else
     !!alert.warning('You must be in one of the following modules to run AVEVA NET Export: ' + !!VNETExport.ValidDes + ' ' + !!VNETExport.ValidSpl)
     return error 1 noalert
  endif

  if !!VNETExport.hierprefix neq 'ASMBLY' and !!VNETExport.hierprefix neq 'MANU' then
  if !!VNETxsettings.IncludeUnNamedSite.val.not() then
     !sites = !siten.intersect(!sitefn)
  else
     !sites = !sitefn
     endif
  endif

  -- Update Current MDB members list
  !!VNETExport.SiteMembers = !sites

  !this.members.clear()
  !this.idlimem.clear()

  if (!!VNETExport.Hierlist[1] eq '/*') then
     !this.idlimem.dtext = !!VNETExport.SiteMembers
  else

    -- Get current list of items and see if they exist in the current list of items
     !dtext = ARRAY()
     do !loop indices !!VNETExport.Hierlist
        !pos = !sites.findfirst(!!VNETExport.Hierlist[!loop])
        if !pos.unset().not() then
           !dtext.append(!sites[!pos])
        endif
     enddo

    -- Check result
     !dtext.unique()

    -- Add items that are still there to list
     !this.idlimem.dtext = !dtext

    -- If there are differences then update the main form
     if !!VNETExport.Hierlist.DIFFERENCE(!dtext).empty().not() then
        !!VNETExport.Hierlist = !dtext
        !!VNETExport.SetHierList()
     endif

  endif

  !this.updatemembers()
  !this.idlimemSort()
  !this.idlimemState()

endmethod

---------------------------------------------------------------------------
-- Method:           .addele
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Add single item to list
----------------------------------------------------------------------------

define method .addele()

  -- Initialise Variables
  -- Add picked elements into Export list....

   !currentpos = !this.members.val

  -- Get current list of items
   !dtext = !this.idlimem.dtext

  -- Get the current selection
   !selected = !this.members.selection()
   do !loop indices !selected
      !dtext.append(!selected[!loop])
   enddo

  -- Assemblies need to get selected items and find owned assemblies to add these from the selected list
   if (!!VNETExport.ValidDes.match(!!VNETExport.PDMSModule) gt 0) and !!VNETExport.hierprefix neq 'SITE' and !!VNETExport.hierprefix neq 'MANU' then
      do !loop indices !selected
         !pos = !!VNETAssmObj.memfullname.findfirst(!selected[!loop])
         !result = !this.getassembnames(!!VNETAssmObj.memdbref[!pos].dbref())
         !dtext.appendarray(!result)
      enddo
   endif
   !dtext.unique()
   !this.idlimem.dtext = !dtext

   !this.updatemembers()

   !this.resetpos(!this.members, !currentpos)

   !this.idlimemSort()
   !this.idlimemState()

endmethod

---------------------------------------------------------------------------
-- Method:           .addeleall
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Add all items to list
----------------------------------------------------------------------------

define method .addeleall()

  -- Initialise Variables
  -- Add picked elements into Export list....

   !this.idlimem.clear()

   !dtext = !!VNETExport.SiteMembers
   !dtext.unique()
   !this.idlimem.dtext = !dtext

   !this.updatemembers()
   !this.idlimemSort()
   !this.idlimemState()

endmethod

---------------------------------------------------------------------------
-- Method:           .remele
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Remove CE parent from list
----------------------------------------------------------------------------

define method .remele()
  !this.IDLIMEM.clearselection()
  !remove = 'Unset'

  if !!CE.type eq 'WORL' then
     !!alert.warning ('At WORLD level, you cannot remove this')
     return
  elseif !!CE.type eq 'SITE' then
     !remove = !!ce.name
     !this.IDLIMEM.select('DTEXT',!remove)
  elseif !!CE.type eq 'ISODEP' then
     !remove = !!ce.name
      !this.IDLIMEM.select('DTEXT',!remove)
  elseif !!VNETExport.hierprefix eq 'MANU' then
       !remove = !!ce.flnm
        !this.IDLIMEM.select('DTEXT',!remove)
        handle any
        endhandle
   elseif !!VNETExport.hierprefix eq 'ASMBLY' then
       if(!!ce.mem.size() gt 1 and !!ce.mem[1].type eq 'ASMBLY') then
         do !val values !!ce.mem
          !remove = !val.flnm
          !this.IDLIMEM.select('DTEXT',!remove)
          handle any
          endhandle
          if(!val.mem.size() gt 1 and !val.mem[1].type eq 'ASMBLY') then
            do !subval values !val.mem
            !remove = !subval.flnm
            !this.IDLIMEM.select('DTEXT',!remove)
            handle any
            endhandle
            enddo
          endif
         enddo
       else
        !remove = !!ce.flnm
        !this.IDLIMEM.select('DTEXT',!remove)
        handle any
          !!alert.message('Element not found in exportList')
        endhandle
       endif
        !remove = !!ce.flnm
        !this.IDLIMEM.select('DTEXT',!remove)
        handle any
        endhandle
   else
     if !!VNETExport.ValidDes.match(!!VNETExport.PDMSModule) gt 0 then
        !remove = name of site
         !this.IDLIMEM.select('DTEXT',!remove)
        handle any
        endhandle
     elseif !!VNETExport.ValidSpl.match(!!VNETExport.PDMSModule) gt 0 then
        !remove = name of isodep
         !this.IDLIMEM.select('DTEXT',!remove)
        handle any
        endhandle
     elseif !!VNETExport.hierprefix eq 'MANU' then
       !remove = !!ce.flnm
        !this.IDLIMEM.select('DTEXT',!remove)
        handle any
        endhandle
     endif
  endif
  !this.delentry()
endmethod

---------------------------------------------------------------------------
-- Method:           .delentry
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Remove items from list
----------------------------------------------------------------------------

define method .delentry()

  if !this.idlimem.val.unset() then
     return
  endif

 -- Store current selection
  !currentpos = !this.idlimem.val

 -- Get current list of items
  !dtext  = !this.idlimem.dtext
  !origdtext  = !this.idlimem.dtext

 -- Get the current selection
  !temp = !this.idlimem.selection()

 -- Remove the items from the list
  do !x indices !temp
     !remindx = !dtext.findfirst(!temp[!x])
     !dtext.Remove(!remindx)
     handle any
        return
     endhandle
  enddo

 -- Refresh the list
  !this.idlimem.dtext = !dtext

 -- Update the members list
  !this.updatemembers()
  !this.idlimemSort()

  if !origdtext.difference(!dtext).size() neq 0 then

     !this.resetpos(!this.idlimem, !currentpos)

    -- Update the status of the export list
     !this.idlimemState()

  else
     !!alert.message('Cannot remove item from list as its parent is still listed for export')
     !this.idlimem.val = !currentpos[1]
  endif

endmethod

---------------------------------------------------------------------------
-- Method:           .membersadd
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Add all items to list
----------------------------------------------------------------------------

define method .membersadd()

  !currentce = !!ce
  prompt dismiss
 -- Add parents of members in Design Explorer
  !this.MEMBERS.clearselection()
  !add = array()

  if !this.MEMBERSADD.tag eq 'Add Assembly of CE' then

     !asm = !!ce.asmown
     !add.append(!!ce.flnm)
     if !asm.empty() then

       !mem = !!ce.ownlst
       var !child collect all for ce

       do !loop values !child
          !!ce = $!loop
          !mem.append(!!ce)
       enddo

       do !loop indices !mem
          !asm = !mem[!loop].asmown
          skip if !asm.empty()
          !add.append(!asm[1].fullname)
       enddo

       if !add.empty() then
          prompt |Item is not part of an Assembly|
       endif
     else
       !add.append(!asm[1].fullname)
     endif

  else
     if !!VNETExport.ValidDes.match(!!VNETExport.PDMSModule) gt 0 then
		if !!VNETExport.hierprefix eq 'SITE' then
			!add.append(name of site)
			handle any
			   !splittyp = !!VNETExport.MarineTypes.split()
			   do !martypes values !splittyp
				  !add.append(name of $!martypes)
				  handle any
				  elsehandle none
					 break
				  endhandle
			   enddo
			endhandle
		else
           !add.append(!!ce.flnm)
		   --!splitManuTypes = !!VNETExport.ManuTypes.split()
		   --do !manuType values !splitManuTypes
			  --!add.append(name of $!manuType)
			  --handle any
			  --elsehandle none
				 --break
			  --endhandle
		   --enddo
		endif
     elseif !!VNETExport.ValidSpl.match(!!VNETExport.PDMSModule) gt 0 then
        !add.append(name of isodep)
         handle any
         endhandle
     endif
  endif

  if !add.empty().not() then
     do !additem values !add
        !this.MEMBERS.select('DTEXT',!additem)
        handle any
           prompt |$!additem has already been selected for Export|
--           !!Alert.Message('$!add has already been selected for Export')
        elsehandle none
          !this.addele()
        endhandle
     enddo
  endif

  !!ce = !currentce

endmethod

---------------------------------------------------------------------------
-- Method:           .idlimemState
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Set Selected items gadget state
----------------------------------------------------------------------------

define method .idlimemState()

   prompt dismiss
   if !this.IDLIMEM.dtext.unset() then
      !this.IDLIMEM.active = false

      !this.DELALL.active = false

      !this.DELENT.active = false

      !this.REM.active = false
   else
      !this.IDLIMEM.active = true

      !this.DELALL.active = true

      !this.REM.active = true

      !this.DELENT.active = !this.IDLIMEM.selection().empty().not()

      if not !this.IDLIMEM.val.unset() then
         !this.DELENT.active = true
      endif
      !this.idlidelPop.setactive('Remove Selection', !this.IDLIMEM.selection().empty().not() )
      !this.idlidelPop.setactive('Remove CE Parent', true)
   endif

   !this.membersState()

   !this.setheadings()

endmethod

---------------------------------------------------------------------------
-- Method:           .idlimemSort
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Sort items
----------------------------------------------------------------------------

define method .idlimemSort()

 -- Sort alphabetically the list of DBs
   !sortOrder = !this.IDLIMEM.dtext.sortedIndices()
   !dbDispList = ARRAY()

   do !i values !sortOrder
     !dbDispList.append(!this.idlimem.dtext[!i])
   enddo

   !this.idlimem.dText = !dbDispList

endmethod

---------------------------------------------------------------------------
-- Method:           .membersState
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Set Unselected items gadget states
----------------------------------------------------------------------------

define method .membersState()

   prompt dismiss
   if !this.MEMBERS.dtext.unset() then
      !this.MEMBERS.active = false
      !this.ADD.active = false
      !this.ADDALL.active = false
      !this.MEMBERSFLTR.active = false
   else
      !this.MEMBERS.active = true
      !this.MEMBERSFLTR.active = true
      !this.ADD.active = !this.MEMBERS.selection().empty().not()
      !this.ADDALL.active = !this.MEMBERS.dtext.empty().not()
   endif

endmethod

---------------------------------------------------------------------------
-- Method:           .membersfilter
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Find items by the filter
----------------------------------------------------------------------------

define method .membersfilter()

   !this.members.clearselection()

   !membersdtext = !this.members.dtext

   !found = ARRAY()

  -- get first character and if its not a wild card character and its not a / then add a / for site names
   !filterfirstch = !this.MEMBERSFLTR.val.substring(1,1)
   if !filterfirstch eq '?' or !filterfirstch eq '*' then
   elseif !filterfirstch neq '/' then
      !this.MEMBERSFLTR.val = '/' & !this.MEMBERSFLTR.val
   endif

   do !INDX indices !membersdtext
      if !membersdtext[!indx].matchwild(!this.MEMBERSFLTR.val) then
         !found.append(!membersdtext[!indx])
      endif
   enddo

   if !found.size() gt 0 then
      !this.members.select('DTEXT',!found)
   endif

   !this.membersState()

endmethod

---------------------------------------------------------------------------
-- Method:           .selectinv
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Invert selection
----------------------------------------------------------------------------

define method .selectinv (!rootGadget is STRING)

   !form = ('!!' & !rootGadget)

   !invertlist = $!<form>.dtext
   !selected = $!<form>.val
   do !loop values !selected
      !invertlist[!loop].delete()
   enddo
   !invertlist.compress()
   $!<form>.clearselection()
   $!<form>.select('DTEXT',!invertlist)

   if !rootGadget eq 'vnetxlist.members' then
      !this.membersState()
   else
      !this.idlimemState()
   endif

endmethod

---------------------------------------------------------------------------
-- Method:           .updatemembers
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Update the members list
----------------------------------------------------------------------------

define method .updatemembers()

   prompt dismiss
   !currentpos = !this.members.selection()

   !exportlist = !this.idlimem.dtext
   !difference = !!VNETExport.SiteMembers.difference(!exportlist)

   if !this.MEMPOP.selected('Sort Alphabetically A-Z') then
      !difference.sort()
   endif

   !this.members.dtext = !difference

   if !currentpos.unset().not() then
      do !loop values !currentpos
         !this.members.select('DTEXT',!loop)
         handle any
         endhandle
      enddo
   endif

endmethod

---------------------------------------------------------------------------
-- Method:           .deleleall
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Remove all items from the list
----------------------------------------------------------------------------

define method .deleleall()

   !this.idlimem.clear()
   !this.members.dtext = !!VNETExport.SiteMembers
   !this.updatemembers()
   !this.idlimemState()

endmethod

---------------------------------------------------------------------------
-- Method:           .getassembnames
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Get assemblies names
----------------------------------------------------------------------------

define method .getassembnames(!itemref is DBREF) is ARRAY

  !result = array()

   var !assemref collect all ASMBLY for $!itemref

   do !loop indices !assemref
      !pos = !!VNETAssmObj.memdbref.findfirst(!assemref[!loop])
      if !pos.unset().not() then
         !result.append(!!VNETAssmObj.memfullname[!pos])
      endif
   enddo

   return !result

endmethod
---------------------------------------------------------------------------
-- Method:           .setheadings
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Update the form list headings
----------------------------------------------------------------------------

define method .setheadings()

   if !this.IDLIMEM.dtext.size() gt 0 then
      !tempsel = '     (' & !this.IDLIMEM.dtext.size().string() & ')'
      !this.NUMSEL.val = !tempsel.substring(-1,-12)
   else
      !this.NUMSEL.val = ''
   endif

endmethod

---------------------------------------------------------------------------
-- Method:           .resetpos
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Reset position
----------------------------------------------------------------------------

define method .resetpos( !gadgetname is GADGET, !currentpos is ARRAY )

 -- Select the next item in the list
   !gadgetname.clearselection()
   if !gadgetname.dtext.size() gt 0 then
      if !currentpos[1] geq !gadgetname.dtext.size() then
         !gadgetname.val = !gadgetname.dtext.size()
      elseif !currentpos[1] eq 0 then
         !gadgetname.val = 1
      else
         !gadgetname.val = !currentpos[1]
      endif
   endif

endmethod

-- End of method definition for .resetpos()

------------------------------------------------------------------------
-- End of file VNETxlist.pmlfrm
