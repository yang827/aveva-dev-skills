--   Module:            Design
--   Replaces:
--
-- Arthor:           C. Pearson
-- Created:          Fri March 20
--
--
-- Description:
-- Set file paths for VNETExport form
--
--------------------------------------------------------------------------------
-- Method Name      Called From      Description
--
-- .vnetxsettings   This             Initialise settings
-- .checkfile       This             Check file is valid filename
-- .checkdir        This             Check folder is valid filename
-- .ok              This             Update other VNET forms
--------------------------------------------------------------------------------

-- Kill existing form definition
kill !!VNETxsettings

-- Define form
setup form !!VNETxsettings at xr 0 yr 0

   Import 'pmlfilebrowser'
   handle any
   endhandle

  !!VNETxsettings.formtitle = 'AVEVA NET Export - Settings'
  !!VNETxsettings.icontitle = ||
  !!VNETxsettings.callback  = |!this.initialise()|
  !!VNETxsettings.formrevision = |$Revision 1.0$ |

  -- define desired tag width value
  !tw = 15

  -- Body of form

  -- Main setup file....
    frame .FrmOutPaths |Output Folders| width 10

  -- The output folder path
       text .output tagWid $!tw |Design XML| at ymax call |!this.checkdir('output')| width 51 string
       button .outset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.output.val, '*', 'Design XML Output Directory', true, '!!VNETxsettings.output.val = !!VNETdirBrowser.path.val')|

  -- The Document Links output folder path
       text .outputlnk tagWid $!tw |Links XML| at xmin_output ymax call |!this.checkdir('outputlnk')| width 51 string
       button .outlnkset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.outputlnk.val, '*', 'Document Links XML Output Directory', false, '!!VNETxsettings.outputlnk.val = !!VNETdirBrowser.path.val')|

  -- The Spool output folder path
       text .outputspl tagWid $!tw |Spooler XML| at xmin_output ymax call |!this.checkdir('outputspl')| width 51 string
       button .outputsplset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.outputspl.val, '*', 'Spooler XML Output Directory', false, '!!VNETxsettings.outputspl.val = !!VNETdirBrowser.path.val')|

  -- The ASM output folder path
       text .outputasm tagWid $!tw |Assembly XML| at xmin_output ymax call |!this.checkdir('outputasm')| width 51 string
       button .outputasmset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.outputasm.val, '*', 'Assembly XML Output Directory', false, '!!VNETxsettings.outputasm.val = !!VNETdirBrowser.path.val')|

  -- The RVM output folder path
       text .outputasmrvm tagWid $!tw |Assembly RVM| at xmin_output ymax  call |!this.checkdir('outputasmrvm')| width 51 string
       button .outputasmrvmset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.outputasmrvm.val, '*', 'Assembly RVM Output Directory', false, '!!VNETxsettings.outputasmrvm.val = !!VNETdirBrowser.path.val')|

  -- The Manufacturing output folder path
       text .outputmanu tagWid $!tw |Manufacturing XML| at xmin_output ymax  call |!this.checkdir('outputmanu')| width 51 string
       button .outputmanuset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.outputmanu.val, '*', 'Manufacturing XML Output Directory', false, '!!VNETxsettings.outputmanu.val = !!VNETdirBrowser.path.val')|

  -- The log file folder path
       text .logfile tagWid $!tw |Logfile| at xmin_output ymax call |!this.checkdir('logfile')| width 51 string
       button .logset  |...|   at xmax ymin   call |call !!VNETdirBrowser(!!VNETxsettings.logfile.val, '*', 'Log File Directory', false, '!!VNETxsettings.logfile.val = !!VNETdirBrowser.path.val')|

    exit

  -- Main setup file....
    frame .FrmPaths |VNET Classifications and Naming Setup files| at x0 ymax width.FrmOutPaths

  -- Std. Classification setup file
       text .class tagWid $!tw |Class map file| at xmin_output ymax call |!this.checkfile('class')| width 40 string
       button .clset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PMLLIB%\vnet\settings', '*.pmlmac', 'Classifications setup file', false, '!!VNETxsettings.class.val = !!filebrowser.file.name()','OPEN')|

  -- User Classification setup file
       text .uclass tagWid $!tw |User map Routine| at xmin_output ymax call |!this.checkfile('uclass')| width 40 string
       button .uclset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PMLLIB%\vnet\settings', 'VNETUserClass$N$!!currentproject$N*', 'User Class mapping routine', false, '!!VNETxsettings.uclass.val = !!filebrowser.file.name()','OPEN')|

       button .ucldef |Default|    at xmax+1 ymin    call |!!VNETExport.ClassFileExists()|

  -- Original Names setup file
       text .origname tagWid $!tw |Original Name Routine| at xmin_output ymax call |!this.checkfile('origname')| width 40 string
       button .orignameset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PMLLIB%\vnet\settings', '*$N$!!currentproject$N*', 'Original Name mapping routine', false, '!!VNETxsettings.origname.val = !!filebrowser.file.name()','OPEN')|

       button .orignamedef |Default|    at xmax+1 ymin    call |!!VNETExport.OriginalNameExists()|

  -- Other Names  setup file
       text .othername tagWid $!tw |Other Names Routine| at xmin_output ymax call |!this.checkfile('othername')| width 40 string
       button .othernameset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PMLLIB%\vnet\settings', '*$N$!!currentproject$N*', 'Other Names mapping routine', false, '!!VNETxsettings.othername.val = !!filebrowser.file.name()','OPEN')|

       button .othernamedef |Default|    at xmax+1 ymin    call |!!VNETExport.OtherNameExists()|
    exit

    frame .tabs tabset anchor all at xmin ymax

       frame .FrmDESPaths |Design Setup files| dock fill at xmin ymin
     -- Include items setup file
          text .incitemname tagWid $!tw |Items to Include| at xmin_output ymax call |!this.checkfile('incitemname')| width 40 string
          button .incitemnameset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'DES-VNET-ITEMS', 'Items to Include', true, '!!VNETxsettings.incitemname.val = !!filebrowser.file.name()','OPEN')|

          button .incitemdef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.incitemname, 'DES-VNET-ITEMS')|

     -- Include attribs setup file
          text .incattrsname tagWid $!tw |Attributes to Export| at xmin_output ymax call |!this.checkfile('incattrsname')| width 40 string
          button .incattrsnameset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'DES-VNET-INCLUDE', 'Attributes to Export', true, '!!VNETxsettings.incattrsname.val = !!filebrowser.file.name()','OPEN')|

          button .incattrsdef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.incattrsname, 'DES-VNET-INCLUDE')|
       exit

       frame .FrmSPLPaths |Spooler Setup files| dock fill at xmin ymin
     -- Include items setup file
          text .incitemspl tagWid $!tw |Items to Include| at xmin_output ymax call |!this.checkfile('incitemspl')| width 40 string
          button .incitemsplset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'SPL-VNET-ITEMS', 'Spooler Items to Include', false, '!!VNETxsettings.incitemspl.val = !!filebrowser.file.name()','OPEN')|

          button .incitemspldef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.incitemspl, 'SPL-VNET-ITEMS')|

     -- Include attribs setup file
          text .incattrsspl tagWid $!tw |Attributes to Export| at xmin_output ymax call |!this.checkfile('incattrsspl')| width 40 string
          button .incattrssplset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'SPL-VNET-INCLUDE', 'Spooler Attributes to Export', false, '!!VNETxsettings.incattrsspl.val = !!filebrowser.file.name()','OPEN')|

          button .incattrsspldef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.incattrsspl, 'SPL-VNET-INCLUDE')|

     -- Include TOLERANCE setup file
          text .inctolerspl tagWid $!tw |Tolerance(s)| at xmin_output ymax call |!this.checkfile('inctolerspl')| width 40 string
          button .inctolersplset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'SPL-VNET-TOLERANCE', 'Spooler Tolerance(s)', false, '!!VNETxsettings.inctolerspl.val = !!filebrowser.file.name()','OPEN')|

          button .inctolerspldef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.inctolerspl, 'SPL-VNET-TOLERANCE')|
       exit

       frame .FrmENCPaths |CodePage Encoding Setup file| dock fill at xmin ymin
     -- Character Encoding  setup file
          text .charencname tagWid $!tw |Character Encoding| at xmin_output ymax call |!this.checkfile('charencname')| width 40 string
          button .charencnameset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'VNET-CHAR-ENCODE', 'Character Encoding', true, '!!VNETxsettings.charencname.val = !!filebrowser.file.name()','OPEN')|

          button .charencdef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.charencname, 'VNET-CHAR-ENCODE')|
       exit

       frame .FrmASMPaths |Assembly Setup file| dock fill at xmin ymin
     -- RVM Template setup file
          text .rvmtempname tagWid $!tw |RVM Template| at xmin_output ymax call |!this.checkfile('rvmtempname')
                                                                                 !this.checkrvmtemp()| width 40 string
          button .rvmtempnameset |...|    at xmax ymin    call |call !!VNETfilebrowser('%PDMSDFLTS%', 'DES-VNET-RVMTEMPLATE.xr', 'RVM Template file', false, '!!VNETxsettings.rvmtempname.val = !!filebrowser.file.name()','OPEN')
                 !this.checkrvmtemp()|

          button .rvmtempdef |Default|    at xmax+1 ymin    call |!!VNETDefaultsExist(!!VNETxsettings.rvmtempname, 'DES-VNET-RVMTEMPLATE.xr')
                                                                  !this.checkrvmtemp()|

          toggle .CreateAsmRVM 'Create Assembly Review (RVM) files' at xmin_output ymax call |!this.checkrvmtemp()|
          toggle .rvmtxt 'Create Assembly Review txt (RVT) files' at xmin_CreateAsmRVM ymax call |!this.checkrvmtemp()|
       exit
    exit

    frame .FrmOptions |Export Options| at x0 ymax width.FrmOutPaths
       toggle .IncludeUnNamedSite 'Include UnNamed Items in selection'
       toggle .IncludeUnsetValue 'Include Unset values' at xmin_IncludeUnNamedSite ymax
       toggle .IncludeNulrefValue 'Include Nulref (=0/0) values' at xmin_IncludeUnNamedSite ymax
       toggle .IncludeWorldPosValue 'Evaluate all Positions in WRT to /*' at xmax_incattrsdef-size ymin_IncludeUnNamedSite call |!this.IncludeZeroPosValue.active = !this.IncludeWorldPosValue.val.not()|
       toggle .IncludeZeroPosValue 'Include (E 0 N 0 U 0) Positions' at xmin_IncludeWorldPosValue ymax
       toggle .IncludeZeroValue 'Include (0) values' at xmin_IncludeWorldPosValue ymax

       line .horiz 'H-Line' at xmin_FrmOptions ymax Horiz wid 73

       toggle .IncludeSITES 'Export referenced Design Items' at xmin_IncludeUnNamedSite ymax
       toggle .IncludeCharClass 'Export Characteristic Classes XML' at xmin_IncludeZeroValue ymin_IncludeSITES
    exit

    frame .FrmWarn |Warning Messsages| at x0 ymax width.FrmOutPaths
       toggle .FullLog |Full Export Logging| at xmin_output ymax
--       toggle .AttrErr 'Attribute Errors' at xmin_IncludeWorldPosValue ymin
--       toggle .ConErr 'Connection Errors' at xmin_AttrErr ymax
       toggle .AttrErr 'Attribute Errors' at xmax_FullLog ymin
       toggle .ConErr 'Connection Errors' at xmax_AttrErr ymin
    exit

 -- Bottom Line
    button .OK     | OK |  call '!this.ok()' at x0 ymax_FrmWarn+0.5 ok
    button .CANCEL |Cancel| at xmax form-size ymin cancel

 -- Form Members

   -- Hierarchy Selection
    member .MacroFile is STRING

   -- Classification list
    member .ClassFile   is STRING

   -- Setting to keep VNETxlist in line with setting
    member .IncludeUnNamedSiteCH is BOOLEAN

    member .logfiled is STRING
    !this.logfiled = '%PDMSUSER%\VNET-Logs'
    member .outputd is STRING
    !this.outputd = '%PDMSUSER%\VNET-DesignXML'
    member .outputlnkd is STRING
    !this.outputlnkd = '%PDMSUSER%\VNET-LinksXML'
    member .outputspld is STRING
    !this.outputspld = '%PDMSUSER%\VNET-SpoolerXML'
    member .outputasmd is STRING
    !this.outputasmd = '%PDMSUSER%\VNET-AssemblyXML'
    member .outputasmrvmd is STRING
    !this.outputasmrvmd = '%PDMSUSER%\VNET-AssemblyRVM'
    member .outputmanud is STRING
    !this.outputmanud = '%PDMSUSER%\VNET-ManufacturingXML'

$* End of form definition
exit

---------------------------------------------------------------------------
-- Method:           .vnetxsettings
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Initialise of the form
----------------------------------------------------------------------------

 define method .vnetxsettings()

  -- Common defaults
   !this.logfile.val = !this.logfiled
   !this.checkdir('logfile')

  -- Classifiation defaults
   !this.uclass.val = 'Unset'
   !this.origname.val = 'Unset'
   !this.othername.val = 'Unset'

  -- Design defaults
   !this.output.val = !this.outputd
   !this.checkdir('output')
   !this.incitemname.val = 'Unset'
   !this.incattrsname.val = 'Unset'

  -- Design defaults
   !this.outputlnk.val = !this.outputlnkd
   !this.checkdir('logfile')

  -- Spooler defaults
   !this.outputspl.val = !this.outputspld
   !this.checkdir('outputspl')
   !this.incitemspl.val = 'Unset'
   !this.incattrsspl.val = 'Unset'
   !this.inctolerspl.val = 'Unset'

  -- Character encoding defaults
   !this.charencname.val = 'Unset'

   if (undefined(!!VNETdirbrowser)) then
      pml load form !!VNETdirbrowser
   endif


  -- Assembly defaults
   !this.outputasm.val = !this.outputasmd
   !this.checkdir('outputasm')

  -- Manufacturing defaults
   !this.outputmanu.val = !this.outputmanud
   !this.checkdir('outputmanu')

   !this.outputasmrvm.val = !this.outputasmrvmd
   !this.checkdir('outputasmrvm')
   !this.rvmtempname.val = 'Unset'
   !this.createAsmRVM.val = true
   !this.checkrvmtemp()

  -- Check to see if Class Definition File can be Found
   !Path = !!pml.getPathName('aveva-classify.pmlmac')
   handle none
     !this.class.val  = '$!path'
   elsehandle any
     !!Alert.warning('Default Class Mapping file not found. You must set it manually.')
     !this.class.val = 'Unset'
   endhandle

 endmethod

-- End of method definition for .vnetxsettings()

---------------------------------------------------------------------------
-- Method:           .initialise
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Initialise of the form
----------------------------------------------------------------------------

 define method .initialise()

   !this.IncludeUnNamedSiteCh = !this.IncludeUnNamedSite.val

   !this.FrmASMPaths.active = false

   !this.outputasm.active = false
   !this.outputasmset.active = false
   !this.outputasmrvm.active = false
   !this.outputasmrvmset.active = false

   if(!!VNETExport.marine) then
      !this.FrmASMPaths.active = true

      !this.outputasm.active = true
      !this.outputasmset.active = true
      !this.outputasmrvm.active = true
      !this.outputasmrvmset.active = true
   endif

 endmethod

-- End of method definition for .initialise()

---------------------------------------------------------------------------
-- Method:           .checkfile
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- If file is selected by browse button then display it in the form
----------------------------------------------------------------------------

 define method .checkfile(!flag is STRING)

   !gadget = '!!VNETxsettings.' + !flag + '.val'

   !file = $!gadget

   if (!file.lowcase().trim() eq 'unset') then
      return
   elseif (!file.lowcase().trim() eq '') then
     !!Alert.Warning('File is being set to Unset')
     !gadget = '!!VNETxsettings.' + !flag + '.val = ''Unset'''
     $!gadget
     return
   endif

 -- Check if file exists...
   !Exists = object FILE(!file)
   !test = !exists.exists()
   if (!test eq false) and (!file.lowcase() neq 'unset') then
     !!Alert.Warning('File $!Exists Does Not Exist. Setting to Unset')
     !gadget = '!!VNETxsettings.' + !flag + '.val = ''Unset'''
     $!gadget
   endif

 endmethod

-- End of method definition for .checkfile()

---------------------------------------------------------------------------
-- Method:           .checkdir
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- If file is selected by browse button then display it in the form
----------------------------------------------------------------------------

 define method .checkdir(!flag is STRING)

   !gadget = '!!VNETxsettings.' + !flag + '.val'
   !folder = $!gadget

   !directory = object FILE(!folder)
   if !directory.exists().not() then
      !folder = !directory.name()
      SYSCOM 'mkdir $!folder'
      if !directory.exists().not() then
         !gadget = '!!VNETxsettings.' + !flag + '.val = !this.' + !flag +'d'
         $!gadget
      endif
   endif

--   call !!VNETdirBrowserDir(!folder)

--   !gadget = '!!VNETxsettings.' + !flag + '.val = !!VNETdirBrowser.path.val'
--   $!gadget

 endmethod

-- End of method definition for .checkdir()

---------------------------------------------------------------------------
-- Method:           .checkrvmtemp
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- If file is selected by browse button then display it in the form
----------------------------------------------------------------------------

 define method .checkrvmtemp()

   !this.CreateAsmRVM.active = true
   !this.rvmtxt.active = true

   if !this.rvmtempname.val eq 'Unset' then
      !this.CreateAsmRVM.active = false
      !this.rvmtxt.active = false
   endif

   if !this.CreateAsmRVM.val.not() then
      !this.rvmtxt.active = false
   endif

 endmethod

-- End of method definition for .checkrvmtemp()


---------------------------------------------------------------------------
-- Method:           .ok
-- Arthor:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- OK the form and set the main VNETExport forms values
----------------------------------------------------------------------------

 define method .ok()

   -- If the Uclass field is unset then we only use the standard AVEVA supplied mapping file.
   -- If it IS set then we use the std. one first, then call the users one second.
    !Uclass = object FILE()
    !Output = object FILE()

    !file1 = !Uclass.file(!this.uclass.val).entry()
    if (!file1 eq 'Unset') then
      !file1 = !uclass.file(!this.class.val).entry()
    endif
    !!VNETExport.Uclass.val = !file1

   -- Set output file path to the selected on ion this form
    !!VNETExport.OutputFldr()

   --In case User has changed the original Class file, re-read into main form memory
    !!VNETExport.ClassRead()

   -- Read in Character Encoding
    !!VNETLoadXMLEncode()

    !charcode = !!VNETCharEncode()

   -- Character Encoding
    !!VNETExport.CharEnc.val = 'Character Encoding : ' & !charcode

    if !this.IncludeUnNamedSite.val neq !this.IncludeUnNamedSiteCH then
       if !!vnetxlist.shown() then
          !!vnetxlist.hide()
          !!vnetxlist.show('free')
       else
          if !!VNETExport.marine then
             !!VNETAssmObj.Update()
          endif
       endif
       !this.IncludeUnNamedSiteCH = !this.IncludeUnNamedSite.val
    endif

    if !this.IncludeUnNamedSite.val then
       !!vnetxlist.formtitle = 'AVEVA NET Export - Item Selection (Unnamed items Included)'
    else
       !!vnetxlist.formtitle = 'AVEVA NET Export - Item Selection (Unnamed items Excluded)'
    endif

 endmethod

-- End of method definition for .ok()

----------------------------------------------------------------------------

$* End of Code
