--     Keyword:         Export
--   Module:            Design
--   Replaces:
--
-- Author:           Ian Stanbrook
-- Created:          11 March 20004
--
--
-- Description:
-- Strips name of strange characters and replaces them with XML replacements
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETCharEncode() is string

  -- Get project setting
   var !characterSetting PROJ CHARSET
   var !multiByte PROJ MBCHAR

  -- Set up a default setting
   !encstring = string()
   !encstring = !!VNETCharEncObj.defencoding.part(2)

  -- Is the projetc multibyte
   if (!characterSetting.lowcase() eq 'unset' AND !multiByte.lowcase() eq 'unset') then
   else
      if !!VNETCharEncObj.charencoding.empty().not() then
         !pos = !!VNETCharEncObj.charencoding[1].findfirst(!multiByte.part(1).upcase())

         if !pos.unset().not() then
            !encstring = !!VNETCharEncObj.charencoding[2][!pos]
            handle ANY
               !encstring = !!VNETCharEncObj.defencoding.part(2)
            endhandle
         endif
      endif
   endif

  -- Return setting
   return !encstring

endfunction

-- End of function definition for .VNETCharEncode()

