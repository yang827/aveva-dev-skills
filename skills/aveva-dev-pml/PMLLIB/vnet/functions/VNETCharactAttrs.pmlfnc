--
-- File:                VNETCharactAttrs.pmlfnc
--   Type:              Function Definition
--   Group:             AVEVA NET
--     Keyword:         Export
--   Module:            Design and Spooler
--   Replaces:
--
-- Author:           Ian Stanbrook
-- Created:          11 August 20004
--
--
-- Description:
-- Turn VPD Attribues and descriptions into XML Characteristics
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETCharactAttrs( !AttrsDesc is array, !AttrsValu is array ) is array

   !chars = array()
   do !i indexes !AttrsDesc

      !chars.append('       <Characteristic>')

      !resultdesc = !!VNETStripXML(!AttrsDesc[$!i])
      !chars.append('         <Name>$!resultdesc</Name>')

      !resultval = !!VNETStripXML(!AttrsValu[$!i])

   -- Handle the length of string, if needed split into several lines
      if !resultval.length() le 210 then
         !chars.append('         <Value>$!resultval</Value>')
      else
         !lsplit=(!resultval.length() / 210)
         if !lsplit gt !lsplit.int() then
            !lsplit = (!lsplit.int() + 1)
         endif

         !chars.append('         <Value>' & !resultval.substring(1,210))
         do !n from 1 to (!lsplit - 1)
            !chars.append(!resultval.substring((1 + (!n * 210)),(210 + (!n * 210))))
         enddo
         !chars.append('         </Value>')
      endif

      !chars.append('       </Characteristic>')

   enddo

   return !chars

endfunction

-- End of function definition for .VNETCharactAttrs()

