--
--
-- Description:
-- VNET34SP1 - Replaces VNETExport method .IncludeExists(xx is gadget, xx is string)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETDefaultsExist(!formgadget is gadget, !defaultfile is STRING)

  -- Determine if Include Items file exists

   !filename = !!comGetOptFiles(!defaultfile)

   !formgadget.val = 'Unset'
   handle ANY
      !formgadget = 'Unset'
   endhandle

  -- if a user options file has been found, load the options
  -- if a system options file has been found, load the data

   if (defined(!filename[2])) then
      !formgadget.val = !filename[2].fullname().string()
      handle ANY
         !formgadget = !filename[2].fullname().string()
      endhandle

      !formgadget.settooltip(!filename[2].fullname().string())
      handle ANY
      endhandle
   elseif (defined(!filename[1])) then
      !formgadget.val = !filename[1].fullname().string()
      handle ANY
         !formgadget = !filename[1].fullname().string()
      endhandle

      !formgadget.settooltip(!filename[1].fullname().string())
      handle ANY
      endhandle
   endif

endfunction

-- End of function definition for .VNETDefaultsExist()

