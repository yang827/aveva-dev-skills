-- File:                VNETExAttrClass.pmlfnc
--   Type:              Function Definition
--   Group:             AVEVA NET
--     Keyword:         Export
--   Module:            Design
--   Replaces:
--
-- Author:           Ian Stanbrook
-- Created:          25 Feb 2010
--
--
-- Description:
-- Export Attributes that are listed to be found to a Characteristics Class file
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      String      Current project code
--    2   R      Boolean     Plant false - Marine true
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETExAttrClass(!proj is STRING, !Gateway is STRING, !Attribs is ARRAY, !Pseudos is ARRAY, !module is BOOLEAN)

   !systemtype = 'Plant'
   if !module then
      !systemtype = 'Marine'
   endif

 -- Setup output file for each site...
   !OutFile = !!VNETxsettings.output.val & '/00AVEVA' & !systemtype & '_' & !Gateway & '_' & !proj & '_Characteristics_null.xml'

   !CharOutFile = object file(!OutFile)
   !CharOutFile.open('OVERWRITE')
   handle any
      !!Alert.error('Error Creating AVEVA NET Characteristics XML Output file : $!OutFile')
      $p $!!ERROR.TEXT
      prompt dismiss
      return
   endhandle

   var !user user
   !time = !!VNETStripXML(!!VNETLogTime())

 -- Write out header lines
   !CharOutFile.WriteRecord(|<?xml version="1.0" encoding="UTF-8"?>|)
   !CharOutFile.WriteRecord(|<vl:VNETList xmlns:vl="http://www.aveva.com/VNET/List" xmlns="http://www.aveva.com/VNET/eiwm">|)
   !CharOutFile.WriteRecord(|<!-- Exported by $!user - $!time -->|)

 -- Write out Attributes
   do !i indices !Attribs

      !ElemAttrtmp = !Attribs[!i].replace('######','#')
      !CurAtt = !ElemAttrtmp.part(1,'#')
      !CurDes = !ElemAttrtmp.part(2,'#')
      !result = !!VNETStripXML(!CurDes)

      !CharOutFile.WriteRecord('       <!-- AVEVA $!systemtype Attribute $!CurAtt -->')

      !CharOutFile.WriteRecord('       <CharacteristicClass>')
      !CharOutFile.WriteRecord('         <ClassID>$!result</ClassID>')
      !CharOutFile.WriteRecord('         <ParentClassID>QUALITATIVE CHARACTERISTIC</ParentClassID>')
      !CharOutFile.WriteRecord('         <ClassName>$!result</ClassName>')
      !CharOutFile.WriteRecord('         <DataType>string</DataType>')
      !CharOutFile.WriteRecord('       </CharacteristicClass>')

   enddo

 -- Write out Pseudo Attributes
   do !i indices !Pseudos

      !ElemAttrtmp = !Pseudos[!i].replace('######','#')
      !CurAtt = !ElemAttrtmp.part(1,'#')
      !CurDes = !ElemAttrtmp.part(2,'#')
      !result = !!VNETStripXML(!CurDes)

      !CharOutFile.WriteRecord('       <!-- AVEVA $!systemtype Attribute $!CurAtt -->')

      !CharOutFile.WriteRecord('       <CharacteristicClass>')
      !CharOutFile.WriteRecord('         <ClassID>$!result</ClassID>')
      !CharOutFile.WriteRecord('         <ParentClassID>QUALITATIVE CHARACTERISTIC</ParentClassID>')
      !CharOutFile.WriteRecord('         <ClassName>$!result</ClassName>')
      !CharOutFile.WriteRecord('         <DataType>string</DataType>')
      !CharOutFile.WriteRecord('       </CharacteristicClass>')

   enddo

 -- Write out EOF lines
   !CharOutFile.WriteRecord(|</vl:VNETList>|)

 -- Close the file
   !CharOutFile.Close()
   !CharOutFile = object file('')

endfunction

-- End of function definition for .VNETExAttrClass()
-------------------------------------------------------------------------------
-- End of File
