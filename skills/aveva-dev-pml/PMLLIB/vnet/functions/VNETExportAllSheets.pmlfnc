--
-- Description:
-- Function to Export all of the Draft Drawing Sheets with Hitfiles for VNET
--
--------------------------------------------------------------------------------

define function !!VNETExportAllSheets()

-- Where am I
    !session = current session
    if !session.module() neq 'DRAFT' then
       return error 1 'Not in Draft module'
    endif

-- Get Current Element
  !name = !!ce.name

-- Navigate to Draft world
   /*

-- Get all of the Views and add them to the form member
   var !SHEETS collect all SHEETS

   !SHTRefs = array()

    do !loop indices !SHEETS

       $!SHEETS[$!loop]

       var !VIEWS member views
       skip if !VIEWS eq 'unset'

       !VIEWNAMES = !VIEWS.split()

       do !idx indices !VIEWNAMES
          $!VIEWNAMES[$!idx]

          var !MAINITEMS delete

          var !MAINITEMS vscan signif
          handle any
             skip
          endhandle
          if undefined(!MAINITEMS) then
             skip
          endif

          !SHTRefs.append(!SHEETS[!loop])

       enddo

    enddo

-- Plotting Default settings
   !FRAME = | |

   !BORDER = | |

   !CUTM = |CUTM OFF|

   !SIZE = |Default|
--   !SIZE = |1189 841| $* A0
--   !SIZE = |841 594| $* A1
--   !SIZE = |594 420| $* A2
--   !SIZE = |420 297| $* A3
--   !SIZE = |297 210| $* A4
--   !SIZE = |297 420| $* P3
--   !SIZE = |210 297| $* P4


-- Navigate to world
   /*

-- Loop around the views
   do !loopsheet indices !SHTRefs

      $!SHTRefs[$!loopsheet]

      !file = name

      !file = !file.replace('/','.')
      if !file.substring(1,1) eq |.| then
         !file = !file.substring(2)
      endif

      !plotfile = !file & '.plt'

      if (!SIZE EQ |Default|) THEN
         var !SIZE SIZE
      endif

      prompt at xr 0 yr 0 |Plotting /%PDMSUSER%/$!plotfile$n...|
      PLOT $!SHTRefs[$!loopsheet] /%PDMSUSER%/$!plotfile $!SIZE $!CUTM $!BORDER $!FRAME OVER
      handle any
         prompt dismiss
         return error 1 |$!!ERROR.TEXT|
      endhandle

      !a = object VNETWriteHit('%PDMSUSER%', '$!file','BATCH' )

      prompt dismiss

   enddo

-- Return to original Current Element
   $!name

endmethod

-- End of method definition for .VNETExportAllSheets()


