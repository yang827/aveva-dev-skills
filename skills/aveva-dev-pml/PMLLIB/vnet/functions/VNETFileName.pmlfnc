--     Keyword:         Export
--   Module:            Design
--   Replaces:
--
-- Author:           Ian Stanbrook
-- Created:          11 March 20004
--
--
-- Description:
-- Strips name of strange characters and replaces them with valid dos ones
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETFileName( !name is string ) is string

     !string = !name.replace('/','')
     !string = !string.replace('.','-')
     !string = !string.replace('\','')
     !string = !string.replace(':','')
     !string = !string.replace('*','')
     !string = !string.replace('?','')
     !string = !string.replace('"','')
     !string = !string.replace('<','')
     !string = !string.replace('>','')
     !string = !string.replace('|','')
     !string = !string.replace(|'|,||)
     !string = !string.replace('%','')
     !string = !string.replace('$$','')

   return !string

endfunction

-- End of function definition for .VNETFileName()

