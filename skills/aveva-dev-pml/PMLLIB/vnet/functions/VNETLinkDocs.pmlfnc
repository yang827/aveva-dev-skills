-- Created:         Mon March 24th
--
--
-- Description:
-- Writes out assembly RVM files
--
-------------------------------------------------------------------------

-- Define function
define function !!VNETLinkDocs(!currentitem is DBREF, !filename is STRING)

   !linktodocs = !currentitem.lnkdoc

   !CharEnc = !!VNETCharEncode()

  -- Create output data for each Items Links
   !output = array()

   !output.append(|<?xml version="1.0" encoding="| & !CharEnc & |"?>|)
   !output.append('<vl:VNETList xmlns:vl="http://www.aveva.com/VNET/List" xmlns="http://www.aveva.com/VNET/eiwm">')

   !output.append('  <Template>')
   !output.append('    <ID>VPD Document Links - ' & !currentitem.flnn & '</ID>')

   do !loop indices !linktodocs

      !lnk = !linktodocs[!loop]
      !name = !lnk.fullname
      !name2 = !lnk.flnn
      !desc = !lnk.desc
      !owner = !lnk.owner.flnn

      !url = string()
      if !lnk.url.match('dabref://') gt 0 then
         !lnkobj = object dbref(!lnk.url.after('dabref://'))
         handle any
            !lnktxt = !lnk.url.after('dabref://')
            !!VNETExport.LogfileMes.append('           ' & !name & ' - URL: Unknown Ref ( ' & !lnktxt &' )')
            !!VNETExport.LogfileMes.append('')
            $P      $!name - URL: Unknown Ref ( $!lnktxt )
            skip
         endhandle
         !url = !lnkobj.fullname
      else
         !url = !lnk.url
      endif
      !resulturl = !!VNETStripXML(!url)

      !class = string()
      !class = 'Unknown'
      do !loop2 indices !lnk.members
         skip if !lnk.members[!loop2].sitem.type neq 'LNCLAS'
         !class = !lnk.members[!loop2].sitem.flnn
         break
      enddo

      !output.append('    <Object>')
      !output.append('      <ID>Link: ' & !name2 & '</ID>')
      !output.append('      <Context>')
      !output.append('        <ID>PROJECTCONTEXT</ID>')
      !output.append('      </Context>')
      !output.append('      <ClassID>FILE</ClassID>')
      !output.append('      <Characteristic>')
      !output.append('        <Name>InfoType</Name>')
      !output.append('        <Value>text/aspx</Value>')
      !output.append('      </Characteristic>')
      !output.append('      <Characteristic>')
      !output.append('        <Name>InfoLocator</Name>')
      !output.append('        <Value>' & !resulturl & '</Value>')
      !output.append('      </Characteristic>')
      !output.append('    </Object>')
      !output.append('    <Object>')
      !output.append('      <ID>' & !name2 & '</ID>')
      !output.append('      <Context>')
      !output.append('        <ID>PROJECTCONTEXT</ID>')
      !output.append('      </Context>')

      if !desc.trim() neq '' then
         !output.append('      <Name>' & !desc & '</Name>')
      endif

      !output.append('      <ClassID>' & !class & '</ClassID>')
      !output.append('      <Association type="is fulfilled by">')
      !output.append('        <Object>')
      !output.append('          <ID>Link: ' & !name2 & '</ID>')
      !output.append('          <Context>')
      !output.append('            <ID>PROJECTCONTEXT</ID>')
      !output.append('          </Context>')
      !output.append('        </Object>')
      !output.append('      </Association>')
      !output.append('    </Object>')

   enddo

   !output.append('  </Template>')
   !output.append('</vl:VNETList>')

   !VNETLnkFileNM = !!VNETxsettings.outputlnk.val & '\Lnk_' & !filename & '_VPDLNK.xml'

   !VNETLnkFile = !!file(!VNETLnkFileNM)
   !VNETLnkFile.writefile('OVERWRITE',!output)
   handle any
      !!VNETExport.LogfileMes.append('           Error creating DocLinks file : ' & !VNETLnkFileNM)
      !!VNETExport.LogfileMes.append('                                        : $!!ERROR.TEXT')
   elsehandle none
   !itmtype = !currentitem.type
      !!VNETExport.LogfileMes.append('           Creating DocLinks file : $!VNETLnkFileNM')
      $p      Creating Links file for Items in $!itmtype $!currentitem.fullname
   endhandle

endfunction
-- End of function definition for !!VNETLinkDocs.pmlfnc()

------------------------------------------------------------------------
-- End of File
