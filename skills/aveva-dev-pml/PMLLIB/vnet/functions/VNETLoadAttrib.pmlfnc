-- Created:          11 March 20004
--
--
-- Description:
-- Load Attributes File
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETLoadAttrib( !filename is gadget ) is array

 -- Empty local return arrays
   !AttribsNam = object ARRAY()
   !AttribsTyp = object ARRAY()

   !PsuedosNam = object ARRAY()
   !PsuedosTyp = object ARRAY()

 -- Check file exists
   if (!filename.val eq 'Unset') then
      return
   else
     !Exists = object FILE(!filename.val)
     !test = !exists.exists()
     if (!test eq false) then
        !filename.val = 'Unset'
        return
     endif
   endif

-- Read file
   !Lines = !Exists.ReadFile()
   handle any
   endhandle

   if (undefined(!Lines)) then
      return
   endif

   if !Lines.empty() then
      return
   endif

 -- Find the "--Begin" indicator
   !StartIndx = !Lines.FindFirst('--Begin')
   If (!StartIndx eq 0) then
      return
   endif

 -- Remove the unwanted lines from the array
   !Rem = !Lines.DeleteTo(!StartIndx)
   !Lines.unique()
   !cmp = !Lines.compress()

 -- Loop through and sort attributes into different types Attri Pseudo

   !AttribArray = object ARRAY()
   !PsuedoArray = object ARRAY()

   Do !line values !Lines
      skip if (!line.trim() eq '')
      skip if (!line.trim().substring(1,2) eq '--')
      if (!line.upcase().substring(1,2) eq 'P:') or (!line.upcase().after('\').substring(1,2) eq 'P:') then
         !PsuedoArray.append(!line.before('>').upcase().replace('P:','')+'>'+!line.after('>'))
      else
         !DefaultVal = ''
         if !line.match('#') gt 0 then

           !hashpos = !line.match('#')
           !grtpos = !line.match('>')

           !DefaultVal = !line.substring(!hashpos).replace('#','')
           !diff = !grtpos - !hashpos
           if !diff gt 0 then
              !DefaultVal = !line.substring(!hashpos, !diff).replace('#','')
           endif

           !line = !line.replace('#'&!DefaultVal,'')

         endif

         !AttribArray.append(!line.before('>').upcase()+'>'+!line.after('>')+'#'+!DefaultVal)

      endif
   Enddo

-- Go through and get attribute and uda descriptions

   !AttribArray.unique()
   do !loop indices !AttribArray
      !attr = !AttribArray[!loop].before('>').split('\')

      if !attr.size() eq 1 then
         !attrib = !attr[1]
         !type = 'ALL'
      else
         !attrib = !attr[2]
         !type = !attr[1].upcase().Substring(1,4)
      endif

      if !attrib.Substring(1,1) eq ':' then
        -- It's a UDA
         !Code = 'RPTX'
      else
         !Code = 'DESTEXT'
      endif

      if !AttribArray[!loop].after('>').before('#').replace('>','').trim() eq '' then
         var !Desc attdef $!attrib $!Code
         handle any
           !Desc[1] = !attrib
         elsehandle none
            !Desc1 = !Desc[1].trim()
            if (!Desc1 eq '') then
               !Desc[1] = !attrib
            endif
         endhandle
      else
         !Desc[1] = !AttribArray[!loop].after('>').before('#').replace('>','').trim()
      endif

      !AttribsTyp.append(!type)
      !AttribsNam.append(!attrib & '######' & !Desc[1] & '######' & !AttribArray[!loop].after('#').trim())

   enddo

-- Go through and get Psuedo descriptions

   !PsuedoArray.unique()
   do !loop indices !PsuedoArray
      !attr = !PsuedoArray[!loop].before('>').split('\')

      if !attr.size() eq 1 then
         !attrib = !attr[1]
         !type = 'ALL'
      else
         !attrib = !attr[2]
         !type = !attr[1].upcase().Substring(1,4)
      endif

      if !PsuedoArray[!loop].after('>').before('#').replace('>','').trim() eq '' then
         var !Desc attdef $!attrib DESTEXT
         handle any
           !Desc[1] = !attrib
         elsehandle none
            !Desc1 = !Desc[1].trim()
            if (!Desc1 eq '') then
               !Desc[1] = !attrib
            endif
         endhandle
      else
         !Desc[1] = !PsuedoArray[!loop].after('>').before('#').replace('>','').trim()
      endif

     !PsuedosTyp.append(!type)
     !PsuedosNam.append(!attrib & '######' & !Desc[1] & '######' & !PsuedoArray[!loop].after('#').trim())

  enddo

  !results = object ARRAY()
  !results[1] = !AttribsNam
  !results[2] = !AttribsTyp
  !results[3] = !PsuedosNam
  !results[4] = !PsuedosTyp

  return !results

endfunction

-- End of function definition for .VNETLoadAttrib()

