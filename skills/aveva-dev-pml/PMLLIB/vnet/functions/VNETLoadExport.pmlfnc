define function !!VNETLoadExport()

!name = '9XMvbxuchzkp/mC4GaGT3cy/ZLTguovipJZcvsorjJXynSV1'
!hasLicense = !name.substring(48,' 1')

if (!hasLicense) then
	show !!VNETExport free
else
	!!Alert.warning('No valid license found for the AVEVA Net Gateway')
endif

endfunction
