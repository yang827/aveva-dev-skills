--
-- Description:
-- Load Items File
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETLoadItems( !filename is gadget ) is array

 -- Check file exists
   if (!filename.val eq 'Unset') then
      return
   else
     !Exists = object FILE(!filename.val)
     !test = !exists.exists()
     if (!test eq false) then
        !filename.val = 'Unset'
        return
     endif
   endif

-- Read file
   !Lines = !Exists.ReadFile()
   handle any
   endhandle

   if (undefined(!Lines)) then
      return
   endif

   if !Lines.empty() then
      return
   endif

 -- Find the "--Begin" indicator
   !StartIndx = !Lines.FindFirst('--Begin')
   If (!StartIndx eq 0) then
      !StartIndx = !Lines.FindFirst('--begin')
      If (!StartIndx eq 0) then
         !StartIndx = !Lines.FindFirst('--BEGIN')
         If (!StartIndx eq 0) then
            return
         endif
      endif
   endif

 -- Remove the unwanted lines from the array
   !Rem = !Lines.DeleteTo(!StartIndx)
   !Lines.unique()
   !cmp = !Lines.compress()

   !ItemsArray = object ARRAY()
   Do !line values !Lines
     skip if (!line.trim() eq '')
     skip if (!line.trim().substring(1,2) eq '--')
     !ItemsArray.append(!line)
   Enddo

  -- Finally set them to the main store .IncludeItem
   !ItemsArray.unique()

   if !ItemsArray.empty() then
      !filename.val = 'Unset'
   endif

   return !ItemsArray

endfunction

-- End of function definition for .VNETLoadItems()

