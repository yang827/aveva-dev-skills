--
--
-- Description:
-- Load Items File
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETLoadXMLEncode()

  !MultiByte = object ARRAY()
  !CodePage = object ARRAY()

  !DefaultEncode = 'DEFAULT         UTF-8               UNICODE'

  !CodeArray = object ARRAY()
  !CodeArray[1] = !MultiByte
  !CodeArray[2] = !CodePage

  -- Open Character Encoding Definition file and read in all contents...
  !InFile = !!VNETxsettings.charencname.val
  handle ANY
     !InFile = !!VNETxsettings.charencname
  endhandle

  !InputFile = object FILE(!InFile)
  if (!InputFile.exists()) then
    !Lines     = !InputFile.ReadFile()
  else
    !!VNETCharEncObj.DefEncoding = !DefaultEncode
    return
  endif

  -- Find the "--Begin" indicator
  !StartIndx = !Lines.FindFirst('--Begin')
  If (!StartIndx eq 0) then
    !!VNETCharEncObj.DefEncoding = !DefaultEncode
    return
  endif

  -- Remove the unwanted lines from the array
  !Rem = !Lines.DeleteTo(!StartIndx)
  !cmp = !Lines.Compress()

  Do !line values !Lines
    skip if !line.trim() eq ''
    skip if (!line.trim().substring(1,2) eq '--')
    if !line.part(1).upcase() eq 'DEFAULT' then
       !!VNETCharEncObj.DefEncoding = !line
       skip
    endif
    !MultiByte.append(!line.part(1).upcase())
    !CodePage.append(!line.part(2))
  Enddo

  !CodeArray[1] = !MultiByte
  !CodeArray[2] = !CodePage

  !!VNETCharEncObj.CharEncoding = !CodeArray

  return

endfunction

-- End of function definition for .VNETLoadXMLEncode()

