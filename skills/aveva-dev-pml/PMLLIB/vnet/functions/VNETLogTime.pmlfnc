--
-- Description:
-- Gets date and time to create unique logfile information
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETLogTime() is string

   !todaydate = object DateTime()
   !day = '0' + !todaydate.date().string()
   !month = '0' + !todaydate.month().string()
   !year = !todaydate.year().string()
   !hour = '0' + !todaydate.hour().string()
   !minute = '0' + !todaydate.minute().string()

   !logtime = !year + '-' + !month.substring(-2,2) + '-' + !day.substring(-2,2) + '_' + !hour.substring(-2,2) + '-' + !minute.substring(-2,2)

   return !logtime

endfunction

-- End of function definition for .VNETLogTime()

