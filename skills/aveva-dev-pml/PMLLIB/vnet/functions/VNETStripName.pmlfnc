--
-- Description:
-- Strips name of strange characters and doubles them up
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETStripName( !name is string ) is string

   !string = !name.replace(|'|, |''|)

   return !string

endfunction

-- End of function definition for .VNETStripName()

