--
--
-- Description:
-- Strips name of strange characters and replaces them with XML replacements
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!VNETStripXML( !name is string ) is string

   !string = !name.replace('&', '&amp;')
   !string = !string.replace('<', '&lt;')
   !string = !string.replace('>', '&gt;')
   !string = !string.replace('''','&apos;')
   !string = !string.replace('"', '&quot;')

   return !string

endfunction

-- End of function definition for .VNETStripXML()

