--
-- File:            VNETassemrvm.pmlfnc
--   Type:          Function Definition
--   Group:         VNET
--     Keyword:
--   Module:        Design
--   Replaces:
--
-- Author:           I.Stanbrook
-- Created:         Mon March 24th
--
--
-- Description:
-- Writes out assembly RVM files
--
-------------------------------------------------------------------------

-- Define function
define function !!VNETassemrvm(!assemdata is VNETASSEMBLY, !VNETTopItmFNM is STRING, !RVMTemplateData is ARRAY, !RVMTemplateFile is STRING)

   !VNETRVMFlder = !!file(!!VNETxsettings.outputasmrvm.val)

   !evar = !VNETRVMFlder.name().after(|%|).before(|%|)

  -- Did we get an evar
   if (!evar.unset() or !evar.empty()) then
      !filepath = !VNETRVMFlder.path()
      !fpath  = !filepath[1].string()
   else
      var !evarPath SPLIT EVAR $!evar
      !fpath = !evarPath[1].string() + !VNETRVMFlder.name().after('%').after('%')
   endif

   !VNETRVMBinName = !!file(!fpath & '\' & !assemdata.AsmblyFileName & '.rvm')
   if !VNETRVMBinName.exists() then
      !VNETRVMBinName.deletefile()
   endif

   !VNETRVMTxtName = !!file(!fpath & '\' & !assemdata.AsmblyFileName & '.rvt')
   if !VNETRVMTxtName.exists() then
      !VNETRVMTxtName.deletefile()
   endif

  -- Create a list of items
   !newitems = object ARRAY()
   !subassem = false
   do !membcnt indices !assemdata.members
      if !assemdata.members[!membcnt][2] eq 'ASMBLY' then
         !subassem = true
         skip
      endif
      !newitems.append('var !!CDCAXREF append |' & !assemdata.members[!membcnt][1] & '|')
   enddo

   if !newitems.empty().not() then

      !!VNETExport.NumberOfItems.val = 'Creating RVM with ' & !newitems.size() & ' items'
      refresh !!VNETExport.NumberOfItems

      !NewRVMxr = !RVMTemplateData

      do !loop indices !NewRVMxr
         if !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_ONAM*') then
            !OldFileName = !NewRVMxr[!loop].after('|').before('|')
            !NewRVMxr[!loop] = !NewRVMxr[!loop].replace(!OldFileName,!VNETRVMBinName.string())
         elseif !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_FTEXT*') then
            !NewRVMxr[!loop] = ''
         elseif !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_FBIN*') then
            !NewRVMxr[!loop] = ''
         endif
      enddo

      !NewRVMxr.appendarray(!newitems)

      !VNETRVMxr = !!file(!RVMTemplateFile)
      if !VNETRVMxr.exists() then
         !VNETRVMxr.deletefile()
      endif

      !VNETRVMxr.writefile('OVERWRITE',!NewRVMxr)
      handle any
         !!VNETExport.LogfileMes.append('Error creating template file for RVM Binary : ' & !RVMTemplateFile)
         !!VNETExport.LogfileMes.append('                                            : $!!ERROR.TEXT')
      elsehandle none
         !!VNETExport.LogfileMes.append('           Creating RVM file: $!VNETRVMBinName')

         $p      Creating RVM file for ASMBLY $!VNETTopItmFNM

         !!CDSFILE = !RVMTemplateFile
         !!CDXEXPMAIN.FBIN.val = true
         !!runSynonym('CALLXR IEXPMAIN RUN FROM')

         if !VNETRVMBinName.exists().not() then
            $p      Error creating RVM Binary file for ASMBLY $!VNETTopItmFNM
            !!VNETExport.LogfileMes.append('Error creating RVM Binary file : ' & !VNETRVMBinName)
         endif

         if !!VNETxsettings.rvmtxt.val and !!VNETxsettings.rvmtxt.active then
            do !loop indices !NewRVMxr
               if !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_ONAM*') then
                  !OldFileName = !NewRVMxr[!loop].after('|').before('|')
                  !NewRVMxr[!loop] = !NewRVMxr[!loop].replace(!OldFileName,!VNETRVMTxtName.string())
                  break
               endif
            enddo

            !VNETRVMxr.deletefile()

            !VNETRVMxr.writefile('OVERWRITE',!NewRVMxr)
            handle any
               !!VNETExport.LogfileMes.append('Error creating template file for RVM Text : ' & !RVMTemplateFile)
               !!VNETExport.LogfileMes.append('                                          : $!!ERROR.TEXT')
            elsehandle none
               !!VNETExport.LogfileMes.append('           Creating RVM text file: $!VNETRVMTxtName')

               $p      Creating RVM Text file for ASMBLY $!VNETTopItmFNM

               !!CDSFILE = !RVMTemplateFile
               !!CDXEXPMAIN.FTEXT.val = true
               !!runSynonym('CALLXR IEXPMAIN RUN FROM')

               if !VNETRVMBinName.exists().not() then
                  $p      Error creating RVM Text file for ASMBLY $!VNETTopItmFNM
                  !!VNETExport.LogfileMes.append('Error creating RVM Text file : ' & !VNETRVMTxtName)
               endif

            endhandle
         endif

         !VNETRVMxr.deletefile()

      endhandle
   endif

  -- Create bigger model
   if !subassem then

      !collection = object COLLECTION()
      !collection.type('ALL')
      !collection.filter(object EXPRESSION('TYPE neq |ASMBLY|'))
      !collection.scope(!assemdata.asmblyname.dbref())
      !result     = !collection.results()

      !resultsitem = ARRAY()
      do !loop values !result
         skip if !loop.sitem.unset() or !loop.sitem.badref()
		 handle any
		    skip
		 endhandle
         !resultsitem.append(!loop.sitem.fullname)
      enddo

      !newitems = object ARRAY()
      do !membcnt indices !resultsitem
         !newitems.append('var !!CDCAXREF append |' & !resultsitem[!membcnt] & '|')
      enddo

      !!VNETExport.NumberOfItems.val = 'Creating Complete RVM with ' & !newitems.size() & ' items'
      refresh !!VNETExport.NumberOfItems

      !VNETRVMBinName = !!file(!fpath & '\' & !assemdata.AsmblyFileName & '-Complete.rvm')
      if !VNETRVMBinName.exists() then
         !VNETRVMBinName.deletefile()
      endif

      !VNETRVMTxtName = !!file(!fpath & '\' & !assemdata.AsmblyFileName & '-Complete.rvt')
      if !VNETRVMTxtName.exists() then
         !VNETRVMTxtName.deletefile()
      endif

      !NewRVMxr = !RVMTemplateData
      do !loop indices !NewRVMxr
         if !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_ONAM*') then
            !OldFileName = !NewRVMxr[!loop].after('|').before('|')
            !NewRVMxr[!loop] = !NewRVMxr[!loop].replace(!OldFileName,!VNETRVMBinName.string())
         elseif !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_FTEXT*') then
            !NewRVMxr[!loop] = ''
         elseif !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_FBIN*') then
            !NewRVMxr[!loop] = ''
         endif
      enddo

      !NewRVMxr.appendarray(!newitems)

      !VNETRVMxr = !!file(!RVMTemplateFile)
      if !VNETRVMxr.exists() then
         !VNETRVMxr.deletefile()
      endif

      !VNETRVMxr.writefile('OVERWRITE',!NewRVMxr)
      handle any
         !!VNETExport.LogfileMes.append('Error creating complete Assembly RVM Binary template file : ' & !RVMTemplateFile)
         !!VNETExport.LogfileMes.append('                                                 : $!!ERROR.TEXT')
      elsehandle none
         !!VNETExport.LogfileMes.append('           Creating complete Assembly RVM file: $!VNETRVMBinName')

         $p      Creating complete Assembly RVM file for ASMBLY $!VNETTopItmFNM

         !!CDSFILE = !RVMTemplateFile
         !!CDXEXPMAIN.FBIN.val = true
         !!runSynonym('CALLXR IEXPMAIN RUN FROM')

         if !VNETRVMBinName.exists().not() then
            $p      Error creating RVM Binary file for ASMBLY $!VNETTopItmFNM
            !!VNETExport.LogfileMes.append('Error creating RVM Binary file : ' & !VNETRVMBinName)
         endif

         if !!VNETxsettings.rvmtxt.val and !!VNETxsettings.rvmtxt.active then
            do !loop indices !NewRVMxr
               if !NewRVMxr[!loop].upcase().matchwild('*CDXEXPMAIN_ONAM*') then
                  !OldFileName = !NewRVMxr[!loop].after('|').before('|')
                  !NewRVMxr[!loop] = !NewRVMxr[!loop].replace(!OldFileName,!VNETRVMTxtName.string())
                  break
               endif
            enddo

            !VNETRVMxr.deletefile()

            !VNETRVMxr.writefile('OVERWRITE',!NewRVMxr)
            handle any
               !!VNETExport.LogfileMes.append('Error creating complete Assembly RVM Text template file : ' & !RVMTemplateFile)
               !!VNETExport.LogfileMes.append('                                               : $!!ERROR.TEXT')
            elsehandle none
               !!VNETExport.LogfileMes.append('           Creating complete Assembly RVM text file: $!VNETRVMTxtName')

               $p      Creating complete Assembly RVM Text file for ASMBLY $!VNETTopItmFNM

               !!CDSFILE = !RVMTemplateFile
               !!CDXEXPMAIN.FTEXT.val = true
               !!runSynonym('CALLXR IEXPMAIN RUN FROM')

               if !VNETRVMBinName.exists().not() then
                  $p      Error creating RVM Text file for ASMBLY $!VNETTopItmFNM
                  !!VNETExport.LogfileMes.append('Error creating RVM Text file : ' & !VNETRVMTxtName)
               endif

            endhandle
         endif

         !VNETRVMxr.deletefile()

      endhandle

   endif

endfunction
-- End of function definition for !!VNETassemrvm.pmlfnc()

------------------------------------------------------------------------
-- End of File
