--
--
-- Description:
-- Function to set the FileBrowser up for display. Standard user
-- invocation of the form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Origin directory
--    2   R      STRING      Seed Filename
--    3   R      STRING      Form title string
--    4   R      BOOLEAN     True if file must exist
--    5   R      STRING      Callback assigned to OK button
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!VNETdirbrowser(!directory is STRING, !seedFile is STRING, !title is STRING, !existFlag is BOOLEAN, !callback is STRING)

  if (undefined(!!VNETdirbrowser)) then
    pml load form !!VNETdirbrowser
  endif

  !delimiter = '\'

  -- Assign form variables
  !!VNETdirbrowser.mode.val    = !title
  !!VNETdirbrowser.existFlag   = !existFlag

  -- Set the form callback
  !!VNETdirbrowser.okCall        = !callback

  -- Initialise the form lists
  call !!VNETdirBrowserDir(!directory)

  -- Display the form
  show !!VNETdirbrowser

endfunction
-- End of function definition for !!VNETdirbrowser
