--
--
-- Description:
-- Function to list the subdirectories present in the passed
-- directory name.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Directory name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!VNETdirBrowserDir(!dirString is STRING)

  -- Initialise variables
  !home = !!evar('HOME')

  !delimiter = '\'

  !dirPath = !dirString

  -- Check the path ending
  if (!dirPath.part(-1,!delimiter) eq |..|) then

    -- Remove the ending
    !dirPath = !dirPath.before(!delimiter + |..|)
    !directory = object FILE(!dirPath)
    !directory = !directory.directory()
    handle any
    endhandle

  else
    !directory = object FILE(!dirPath)
  endif

  !dtype = !directory.type()
  handle any
    !directory = !directory.directory()
  endhandle

  !dText = ARRAY()

  -- Get the first evar
  !evar = !directory.name().after(|%|).before(|%|)

  -- Did we get an evar
  if (!evar.unset() or !evar.empty()) then
    -- Create the DirectoryList of 1
    !dText.append(!directory.fullName() + !delimiter + '..')
    handle any
    endhandle
    !subDirArray = !directory.subDirs()
    handle any
    elsehandle none
       do !subDir values !subDirArray
         !dText.append(!subDir.fullName())
       enddo
    endhandle

  else
    -- Split the evar and construct a path for each
    var !evarPath SPLIT EVAR $!evar

    do !i indices !evarPath
      !tempDir = object FILE(!dirPath.replace('%' & !evar & '%',!evarPath[!i]))
      !dText.append(!tempDir.fullName() + !delimiter + '..')
      handle any
        skip
      endhandle
      !subDirArray = !tempDir.subDirs()
      handle any
      elsehandle none
         do !subDir values !subDirArray
           !dText.append(!subDir.fullName())
         enddo
      endhandle
    enddo
  endif

  -- Add the full directory list to the gadget
  !!VNETdirBrowser.subDir.dText = !dText

  -- Display the path in the correct gadget
  !!VNETdirBrowser.path.val     = !directory.name()
  !!VNETdirBrowser.directory    = !directory.name()

endfunction
-- End of function definition for !!VNETdirBrowserDir
