--
-- File:            filebrowser.pmlfnc
--   Type:          Function Definition
--   Group:         File Handling
--     Keyword:     FILE
--   Module:        common
--   Replaces:      XFILEMOTIF
--
-- Author:           E.conba
-- Created:         Wed Mar 19 10:15:27 GMT 1997
--
--
-- Description:
-- Function to set the FileBrowser up for display. Standard user
-- invocation of the form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Origin directory
--    2   R      STRING      Seed Filename
--    3   R      STRING      Form title string
--    4   R      BOOLEAN     True if file must exist
--    5   R      STRING      Callback assigned to OK button
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!VNETfileBrowser(!directory is STRING, !seedFile is STRING, !title is STRING, !existFlag is BOOLEAN, !callback is STRING, !formtype is STRING)

  if (undefined(!!fileBrowser)) then
    pml load form !!fileBrowser
  endif
import 'pmlfilebrowser'
handle any
endhandle
Using namespace 'Aveva.Pdms.Presentation'

!browser = object PMLFILEBROWSER(!formtype)

-- Strip any extension off the seedfile and feed into the browser extension
!extension = !seedFile.after('.')
if (!extension eq '') then
  !extension = 'all'
  !dotExtension = '.*'
else
  !dotExtension = '.' & !extension
endif

!extensionString = !extension & ' files (*' & !dotExtension & ')|*' & !dotExtension
-- Show Browser
!browser.show(!directory, !seedFile, !title, !existFlag ,!extensionString , 2)
-- Set selected file

!!fileBrowser.file = !!file(!browser.file())

!!fileBrowser.existFlag   = !existFlag

if (!!fileBrowser.file.string() neq '') then

  -- Run callback if it's a function
  $!callback
  handle any
    -- Run callback if its a PML1 style Macro
    var !unique unique
    !fileName = '%pdmswk%' & !unique & '.pmlmac'
    !tempFile = object FILE(!fileName)
    !lines[1] = !callback
    !tempFile.writefile('OVERWRITE', !lines)
    !!runMacro(!tempFile.Fullname(), '')
    !tempFile.deleteFile()
  endhandle
endif

endfunction
-- End of function definition for !!VNETfileBrowser
