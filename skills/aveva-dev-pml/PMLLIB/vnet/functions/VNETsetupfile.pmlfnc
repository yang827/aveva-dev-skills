--
-- Description:
-- Writes out setup file for the model export to VNET
--
-------------------------------------------------------------------------

-- Define function
define function !!VNETsetupfile(!flag is BOOLEAN)

 -- Initialise Variables
  if (!!filebrowser.file.set().not()) then
    !!Alert.error('No file name specified.')
    return
  endif

  !save = !flag

 -- Check file name and add VNET and .dat if required
  !filename = !!filebrowser.file.entry()

  !newfile = ''
  if !filename.substring(1,4) neq 'VNET' or !filename.substring(-1,-4) neq '.dat' then
     if !filename.substring(1,4) neq 'VNET' then
        !newfile = 'VNET' + !filename
        !change = true
     endif

     if !filename.substring(-1,-4) neq '.dat' then
        if !change then
           !newfile = !newfile + '.dat'
        else
           !newfile = !filename + '.dat'
        endif
     endif

     !path = !!filebrowser.file.pathname()
     !newfile = !path + '\' + !newfile
  endif

  if !newfile eq '' then
     !savefile = !!filebrowser.file
  else
     !savefile = !!file(!newfile)
  endif

  var !user user
  var !timedate clock
  !line = object ARRAY()

 -- Check, are we Saving or Reading in?
  if (!save) then
    -- We are saving out....

    !line.append('-- Setup file for PDMS Object export to VNET.')
    !line.append('-- Last modified by User: $!user on $!timedate')

   -- First SAVE out the "VNETXsettings" file names...
    !line.append('--')
    !line.append('-- PDMS-AVEVA NET Export Module')
    !line.append('--')
    !line.append('## Module - ' & !!VNETExport.PDMSModule)

   -- Now SAVE out the "VNETXsettings" file names...
    !line.append('--')
    !line.append('-- VNETXsettings Files')
    !line.append('--')

    !line.append('!!VNETXsettings.Output.val = ' & '|' & !!vnetxsettings.Output.val & '|')
    !line.append('!!VNETXsettings.Outputspl.val = ' & '|' & !!vnetxsettings.Outputspl.val & '|')

    !line.append('!!VNETXsettings.Class.val  = ' & '|' & !!vnetxsettings.Class.val & '|')
    !line.append('!!VNETXsettings.UClass.val = ' & '|' & !!vnetxsettings.UClass.val & '|')

    !line.append('!!VNETXsettings.origname.val = ' & '|' & !!VNETXsettings.origname.val & '|')
    !line.append('!!VNETXsettings.othername.val = ' & '|' & !!VNETXsettings.othername.val & '|')

    !line.append('!!VNETXsettings.incitemname.val = ' & '|' & !!VNETXsettings.incitemname.val & '|')
    !line.append('!!VNETXsettings.incattrsname.val = ' & '|' & !!VNETXsettings.incattrsname.val & '|')

    !line.append('!!VNETXsettings.incitemspl.val = ' & '|' & !!VNETXsettings.incitemspl.val & '|')
    !line.append('!!VNETXsettings.incattrsspl.val = ' & '|' & !!VNETXsettings.incattrsspl.val & '|')
    !line.append('!!VNETXsettings.inctolerspl.val = ' & '|' & !!VNETXsettings.inctolerspl.val & '|')

    !line.append('!!VNETXsettings.IncludeUnNamedSite.val = ' & !!VNETXsettings.IncludeUnNamedSite)
    !line.append('!!VNETXsettings.IncludeUnsetValue.val = ' & !!VNETXsettings.IncludeUnsetValue)
    !line.append('!!VNETXsettings.IncludeNulrefValue.val = ' & !!VNETXsettings.IncludeNulrefValue)

    !line.append('!!VNETXsettings.IncludeWorldPosValue.val = ' & !!VNETXsettings.IncludeWorldPosValue)

    !line.append('!!VNETXsettings.IncludeZeroPosValue.val = ' & !!VNETXsettings.IncludeZeroPosValue)
    !line.append('!!VNETXsettings.IncludeZeroValue.val = ' & !!VNETXsettings.IncludeZeroValue)

    -- Issue 147742 & 147743 : settings to be included while saving the settings
    !line.append('!!VNETXsettings.IncludeSITES.val =' & !!VNETXsettings.IncludeSITES)
    !line.append('!!VNETXsettings.IncludeCharClass.val =' & !!VNETXsettings.IncludeCharClass)

    !line.append('!!VNETXsettings.logfile.val = ' & '|' & !!VNETXsettings.logfile.val & '|')
    !line.append('!!VNETXsettings.FullLog.val = ' & !!VNETXsettings.FullLog)

    !line.append('!!VNETXsettings.AttrErr.val = ' & !!VNETXsettings.AttrErr)
    !line.append('!!VNETXsettings.ConErr.val = ' & !!VNETXsettings.ConErr)

   -- Now SAVE out Form settings...
    !line.append('--')
    !line.append('-- VNETExport form settings')
    !line.append('--')

    !line.append('!!VNETExport.plist.val   = ' & '|' & !!vnetexport.Plist.val & '|')
    !line.append('!!VNETExport.mdb.active  = ' & !!vnetexport.mdb.active)
    !line.append('!!VNETExport.list.active = ' & !!vnetexport.list.active)

   -- Now SAVE form members that are ARRAYs...
    !line.append('--')
    !line.append('-- VNETExport Current MDB and Selection')
    !line.append('--')

    !line.append('!!VNETExport.HierList.Clear()')
    do !entry VALUES !!VNETExport.HierList
       !line.append('!!VNETExport.HierList.Append(''$!entry'')')
    enddo

    !line.append('!!VNETExport.mdb.Clear()')
    !line.append('!MDBarray = object ARRAY()')
    do !entry VALUES !!VNETExport.mdb.DTEXT
      !line.append('!MDBarray.Append(''$!entry'')')
    enddo
    !line.append('!!VNETExport.mdb.dtext = !MDBarray')
    !line.append('!!VNETExport.oldMDB      = ' & '|' & !!vnetexport.oldMDB & '|')
    !line.append('!!VNETExport.mdb.select(|RTEXT|,|' & !!vnetexport.mdb.selection() & '|)')

   -- Now SAVE out the classes
    !line.append('--')
    !line.append('-- VNETExport Classes')
    !line.append('--')

    !line.append('!!VNETExport.uclass.val  = ' & '|' & !!vnetexport.Uclass.val & '|')
    !line.append('!!VNETExport.Classes.Clear()')
    do !entry VALUES !!VNETExport.Classes
      !line.append('!!VNETExport.Classes.Append(''$!entry'')')
    enddo

  -- Character Encoding
    !line.append('!!VNETCharEncObj.DEFEncoding = ' & '|' & !!VNETCharEncObj.DEFEncoding & '|')
    !line.append('!!VNETCharEncObj.CharEncoding.Clear()')
    !line.append('!!VNETCharEncObj.CharEncoding[1] = Array()')
    !line.append('!!VNETCharEncObj.CharEncoding[2] = Array()')
    do !entry VALUES !!VNETCharEncObj.CharEncoding[1]
      !line.append('!!VNETCharEncObj.CharEncoding[1].Append(''$!entry'')')
    enddo
    do !entry VALUES !!VNETCharEncObj.CharEncoding[2]
      !line.append('!!VNETCharEncObj.CharEncoding[2].Append(''$!entry'')')
    enddo

    !line.append('--')
    !line.append('-- VM-AVEVA NET Export Extras')
    !line.append('--')

    !line.append('-- VNETXsettings Files')
    !line.append('--')

    !line.append('!!VNETXsettings.Outputlnk.val = ' & '|' & !!vnetxsettings.Outputlnk.val & '|')
    !line.append('!!VNETXsettings.Outputasm.val = ' & '|' & !!vnetxsettings.Outputasm.val & '|')
    !line.append('!!VNETXsettings.Outputmanu.val = ' & '|' & !!vnetxsettings.Outputmanu.val & '|')
    !line.append('!!VNETXsettings.Outputasmrvm.val = ' & '|' & !!vnetxsettings.Outputasmrvm.val & '|')

    !line.append('!!VNETXsettings.rvmtempname.val = ' & '|' & !!VNETXsettings.rvmtempname.val & '|')

    !line.append('!!VNETXsettings.CreateAsmRVM.val = ' & !!VNETXsettings.CreateAsmRVM)
    !line.append('!!VNETXsettings.rvmtxt.val = ' & !!VNETXsettings.rvmtxt)


    !line.append('--')
    !line.append('-- VNETExport form settings')
    !line.append('--')

    if defined(!!VNETExport.designtype) then
       !line.append('!!VNETExport.designtype.val = ' & !!VNETExport.designtype.val )
       !line.append('--')
    endif

   -- Now write all lines out at once to file
    !line.append('-- End of Save File.')
    !savefile.WriteFile('OVERWRITE', !line)

  else

   -- What forms are shown then hide them
    !shownexport = !!VNETExport.shown()

    !shownxlist = !!VNETxlist.shown()
    !!VNETxlist.hide()

    !shownxsettings = !!VNETxsettings.shown()
    !!VNETxsettings.hide()

   -- Must be a READ in then...
    if !savefile.exists().not() then
       !!Alert.error('Settings file ' + !savefile.string() + ' Not found')
       return
    endif

   -- Load the file in and copy its contents for comaprision later
    !input = !savefile.ReadFile()
    !originput = !input

   -- Upgrade to latest version
    do !loop indices !input
       if (!input[!loop].match('VNETExport.plist.background') gt 0) then
          !input[!loop] = ''
       elseif (!input[!loop].substring(1, 38) eq '!!VNETExport.designtype.select(|RTEXT|') then
          if !input[!loop].match('Sites') gt 0 then
             !input[!loop] = |!!VNETExport.designtype.val = 1|
          else
             !input[!loop] = |!!VNETExport.designtype.val = 2|
          endif
       elseif (!input[!loop].substring(1, 24) eq '!!VNETExport.DEFEncoding') then
          !input[!loop] = !input[!loop].replace('!!VNETExport','!!VNETCharEncObj')
       elseif (!input[!loop].substring(1, 25) eq '!!VNETExport.CharEncoding') then
          !input[!loop] = !input[!loop].replace('!!VNETExport','!!VNETCharEncObj')
       endif
    enddo

   -- Save the file if different
    !diffs = !input.difference(!originput)
    if !diffs.unset().not() then
       $P Settings file has been updated
       !savefile.writefile('OVERWRITE', !input)
    endif

   -- Reload file to Load Settings
    !input = !savefile.ReadFile()
    do !command VALUES !input
      skip if (!command.substring(1, 2) eq '--')

      if (!command.substring(1, 2) eq '##') then
         !Module = !command.after('## Module - ').trim()
         if !Module neq !!VNETExport.PDMSModule then
            !!Alert.Error('Unable to load saved settings as they where saved whilst in PDMS Module $!Module . Switch Modules and reload settings')
            return
         endif
         skip
      endif

--      $P Command >>>>$!command
      $!command
      handle (2,759)
       -- This is to skip the char encoding
        if !command.match('charenc') eq 0 then
           !!Alert.error('Error: $!!Error.text')
           $P Command = $!Command
        else
           $P Unable to set Command = $!Command
        endif
      elsehandle any
        !!Alert.error('Error: $!!Error.text')
        $P Command = $!Command
      endhandle
    enddo

    if (not(unset(!!VNETExport.HierList.findfirst('/*')))) then
       !!VNETExport.HierList.clear()
       !!VNETExport.HierList[1] = '/*'
    else
--         !!VNETExport.HierList.unique().sort()

--         !originalsize = !!VNETExport.HierList.size()

--         var !siteref collect all SITE
--         var !sites eval name for all from !siteref

--         !intersect = !sites.intersect(!!VNETExport.HierList)

--         !!VNETExport.HierList.clear()
--         if !intersect.size() eq 0 then
--            !!VNETExport.HierList[1] = '/*'
--         else
--            !!VNETExport.HierList = !intersect
--         endif

--         if !originalsize neq !!VNETExport.HierList.size() then
--            !difference = !originalsize - !!VNETExport.HierList.size()

--            !!Alert.Warning(!difference & ' Sites where not added to the selection list as they no longer exist in the current MDB')
--         endif
    endif

    !!VNETExport.SetModuleHier()

    !!VNETxlist.initialise()

   -- Reshow forms and initialise
    if !shownxlist then
       !!VNETxlist.show()
    else
       !!VNETxlist.initialise()
    endif

   -- Reset hierarchy selection on main form
    !!VNETExport.SetHierList()

   -- Check file paths
    !!VNETxsettings.checkfile('class')
    !!VNETxsettings.checkfile('uclass')
    !!VNETxsettings.checkfile('origname')
    !!VNETxsettings.checkfile('othername')
    !!VNETxsettings.checkfile('incitemname')
    !!VNETxsettings.checkfile('incattrsname')
    !!VNETxsettings.checkfile('incitemspl')
    !!VNETxsettings.checkfile('incattrsspl')
    !!VNETxsettings.checkfile('inctolerspl')

   -- Reshow forms and initialise
    if !shownxsettings then
      !!VNETxsettings.show()
    endif

   -- Show file names on main
    !!VNETExport.Outputfldr()

    if undefined(!!VNETBatchMode) then
       !!Alert.Message('Settings loaded from file')
    else
       $P Settings loaded from file $!savefile
    endif

  endif

  prompt dismiss

endfunction
-- End of function definition for !!VNETsetupfile.pmlfnc()

------------------------------------------------------------------------
-- End of File
