define object VNETAssembly

 -- ASSEMBLY Item

 -- Name and Name-NoSlash
   member .AsmblyName is string
   member .AsmblyOName is string
   member .AsmblyNPName is string
   member .AsmblyFileName is string

 -- VNET Name
   member .AsmblyVName is string

 -- Attributes - VNET Characteristics
   member .AsmblyChars is array

 -- VNET Classification
   member .AsmblyClass is string

 -- PDMS Hierarchy - VNET Hierarchy
   member .AsmblyHier is array
   member .AsmblyHierName is array
   member .AsmblyHierOName is array
   member .AsmblyHierNPName is array
   member .AsmblyHierClass is array

   member .AsmblyHierFileName is array

 -- ASSEMBLY members
   member .Members is array

 -- ASSEMBLY Document Links
   member .LinksToDocs is array

endobject

-- End of object definition for VNETAssembly()

