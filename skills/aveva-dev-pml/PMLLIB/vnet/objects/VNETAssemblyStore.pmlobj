--
-- Description:
-- Setup character encoding Storage object and load with values from file

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Update()                         -
--
--------------------------------------------------------------------------------

define object VNETAssemblyStore

 -- These members are only used if Assemblies is selected as the hierarchy
 -- List of all Assemblies DBRefs in MDB
   member .memdbref is ARRAY

 -- List of all Assemblies Names form ASNAME attribute
   member .memasslocname is ARRAY

 -- List of all Assemblies fullnames ownership
   member .memfullname is ARRAY

 -- List of all Assemblies names
   member .memname is ARRAY

endobject

-- End of object definition for VNETAssemblyStore()

--------------------------------------------------------------------------------
-- Method:           .Update()
-- Arthor:           I.Stanbrook
-- Created:          Thur 19 June
--
--
-- Description:
-- Iniialise the setting of the object member the same as the PDMS gateway
-- VNETExport form does
--------------------------------------------------------------------------------

define method .Update()

  -- Get assemblies which have ASMBLY world names set
   var !assemref collect all ASMBLY with ( fullname of ASWL eq name of ASWL )

  -- Get the assemblies local name
   var !assemlocname eval ASNAME for all from !assemref

  -- Get the assemblies fullname
   var !assemfullnm eval fullname for all from !assemref

  -- Get the assemblies name
   var !assemnm eval name for all from !assemref

   if !!VNETxsettings.IncludeUnNamedSite.val.not() then
      !removeitems = array()
      do !indx indices !assemfullnm
         if !assemfullnm[!indx].matchwild('*ASMBLY*of*') then
            !removeitems.append(!indx)
         endif
      enddo

      if !removeitems.empty().not() then
         !removeitems.invert()
         do !indx values !removeitems
            !assemref.remove(!indx)
            !assemlocname.remove(!indx)
            !assemfullnm.remove(!indx)
            !assemnm.remove(!indx)
         enddo
      endif
   endif

   !this.memdbref = !assemref
   !this.memasslocname = !assemlocname
   !this.memfullname = !assemfullnm
   !this.memname = !assemnm

endmethod

-- End of method definition for .Update()

