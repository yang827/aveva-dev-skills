--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETDMExportISO()                -
--

define object VNETDMExportISO

  -- User Mapping Data
   member .OrigName is BOOLEAN

endobject

-- End of object definition for VNETDMExportISO()

--------------------------------------------------------------------------------

define method .VNETDMExportISO()

  -- Check project is set (Pre 11.5)
   if undefined(!!currentproject) then
      var !!currentproject project code
   endif

  -- Determine if OriginalName file exists
   !filename = 'VNETxmlOrigName' & !!currentproject & '.pmlobj'
   !filename = !filename.lowcase()
   !macro = !!pml.getPathName(!filename)
   handle any
      !this.OrigName = false
   elsehandle none
      !this.OrigName = true
   endhandle

endmethod

-- End of method definition for .VNETDMExportISO()

-------------------------------------------------------------------------------

-- End of File
