--
-- Description:
-- Setup character encoding Storage object and load with values from file

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETEncodingStore()              -                   Deslash the original name
--
--------------------------------------------------------------------------------

define object VNETEncodingStore

  -- Character Encoding
   member .CharEncoding is ARRAY
   member .DefEncoding is STRING

endobject

-- End of object definition for VNETEncodingStore()

--------------------------------------------------------------------------------
-- Method:           .VNETEncodingStore()
-- Author:           I.Stanbrook
-- Created:          Thur 19 June
--
--
-- Description:      Deslash the original name
-- Iniialise the setting of the object member the same as the PDMS gateway
-- VNETExport form does
--------------------------------------------------------------------------------

define method .VNETEncodingStore()

  -- Check project is set (Pre 11.5)
   if undefined(!!currentproject) then
      var !!currentproject project code
   endif

  -- Set default file pathname by calling in the respective form
  -- ONLY if it hasn't been called before (Dont want to reset user input!)
   if undefined (!!VNETXsettings) then
      pml load object VNETISOBatchxsettings
      !!VNETXsettings = object VNETISOBatchxsettings()
   endif

endmethod

-- End of method definition for .VNETEncodingStore()
