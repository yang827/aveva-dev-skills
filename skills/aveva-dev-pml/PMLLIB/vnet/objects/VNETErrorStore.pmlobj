--
--
-- Description:
-- Storage item for AVEVA NET Export Errors

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Reset()                          -
--  SetErrorFlag(STRING)             -
--
--------------------------------------------------------------------------------

define object VNETErrorStore

 -- These members are only used if Assemblies is selected as the hierarchy
 -- List of all Assemblies DBRefs in MDB
   member .SiteErrors is BOOLEAN

 -- List of all Assemblies Names form ASNAME attribute
   member .ExErrors is BOOLEAN

 -- List of all Assemblies ownership
   member .ExErrorTxt is ARRAY

 -- Original Name Error
   member .OrigNameError is BOOLEAN

endobject

-- End of object definition for VNETErrorStore()

--------------------------------------------------------------------------------
-- Method:           .Reset()
-- Author:           I.Stanbrook
-- Created:          Thur 29 March
--
--
-- Description:
-- Iniialise the setting of the object members
--------------------------------------------------------------------------------

define method .Reset()

   !this.SiteErrors = false
   !this.ExErrors = false
   !this.ExErrorTxt.clear()
   !this.OrigNameError = false

endmethod

-- End of method definition for .Reset()

--------------------------------------------------------------------------------
-- Method:           .SetErrorFlag(!errormessage is STRING)
-- Author:           I.Stanbrook
-- Created:          Thur 19 June
--
--
-- Description:
-- Iniialise the setting of the object member the same as the PDMS gateway
-- VNETExport form does
--------------------------------------------------------------------------------

define method .SetErrorFlag(!errormessage is STRING)

   !this.SiteErrors = true
   !this.ExErrors = true

   if !errormessage.trim() neq '' then
      !this.ExErrorTxt.append(!errormessage)
   endif

endmethod

-- End of method definition for .SetErrorFlag(!errormessage is STRING)

-------------------------------------------------------------------------------
