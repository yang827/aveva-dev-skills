--
--
-- Description:
-- Get required attributes for output for the CE
--

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETGetAttributes(string,string,array,array,array,array) object
--
--------------------------------------------------------------------------------

define object VNETGetAttributes

   member .CEAttName is array
   member .CEAttDesc is array
   member .CEAttValue is array
   member .CEAttDefVal is array

   member .CEErrors is array

endobject

-- End of object definition for VNETGetAttributes()

--------------------------------------------------------------------------------
-- Method:           .VNETGetAttributes(!fullname is STRING,!type is STRING, , !IncludedAttribs is array, !IncludedAttribsTyp is array, !IncludedPsuedos is array, !IncludedPsuedosTyp is array )
-- Author:           I.Stanbrook
-- Created:          Thur 19 June
--
--
-- Description:
-- Derive attributes for current element
--------------------------------------------------------------------------------

define method .VNETGetAttributes( !fullname is string, !type is string, !IncludedAttribs is array, !IncludedAttribsTyp is array, !IncludedPsuedos is array, !IncludedPsuedosTyp is array ) is object

   !navigateitem = false

   !this.CEAttName.clear()
   !this.CEAttDesc.clear()
   !this.CEAttValue.clear()
   !this.CEAttDefVal.clear()

   !this.CEErrors.clear()

-- Check for funny chars in names
   !outname = !!VNETStripName(!fullname)

-- Check that the current item is what you are at. Spooler output is not and so has to change to the object
   if !!CE.fullname neq !fullname then
      !navigateitem = true
      !CE = !!CE
      $!fullname
      handle any
         return
      endhandle
   endif

-- Create empty container
   !DataAll = array()

-- If the array is equal to 1 or more and the one is not empty then we have attributes

   if !IncludedAttribs.empty().not() then

    -- Output ALL attributes for current element
      !AttList = !!CE.attributes()

      do !loop indices !AttList
         !AttList[!loop] = !AttList[!loop].upcase()
      enddo

      !RemoveItem = !AttList.findfirst('MEMBERS')

      if !removeitem.unset().not() then
         !AttList[!RemoveItem].delete()
      endif

   -- Get all attributes for all items and the current type
      !AllAttPos = !IncludedAttribsTyp.find('ALL')

      !TypAttPos = !IncludedAttribsTyp.find(!type)

      !Shorttype = !type.substring(1,4)
      !TypShrtAttPos = !IncludedAttribsTyp.find(!Shorttype)

   -- Load the attributes into an array and sort them unique
      !ElemAttr = array()
      do !loop values !AllAttPos
         !ElemAttr.append(!IncludedAttribs[!loop])
      enddo

      do !loop values !TypAttPos
         !ElemAttr.append(!IncludedAttribs[!loop])
      enddo

      do !loop values !TypShrtAttPos
         !ElemAttr.append(!IncludedAttribs[!loop])
      enddo

   -- Check if any attributes are defined for outputing
      if !ElemAttr.empty().not() then

      -- Sort uniquness
         !ElemAttr.unique()

      -- Split so that we have the attribute and descriptions seperate
         !CurAtt = array()
         !CurDes = array()
         !CurDef = array()

         do !loop indices !ElemAttr
            !ElemAttrtmp = !ElemAttr[!loop].replace('######','#')
            !CurAtt.append(!ElemAttrtmp.part(1,'#'))
            !CurDes.append(!ElemAttrtmp.part(2,'#'))
            !CurDef.append(!ElemAttrtmp.part(3,'#'))
         enddo

      -- Find the intersection between the list of attributes of the item and the list defined for the item
         !XAttrs = !CurAtt.intersect(!Attlist)

         do !AttName values !XAttrs
            var !AttValue $!AttName
            handle any
      -- Cope with case where ref set, but inaccessible
               var !AttValue 'unset'
               $P        GETATTRIBUTES >> $!AttName data inaccessible for $!outname
               if !!VNETxsettings.AttrErr.val.not() then
                  !this.CEErrors.append('               GETATTRIBUTES >> $!AttName data inaccessible for $!outname')
               endif
            endhandle

         -- Check if name is a real name
            if !AttName.upcase() eq 'NAME' and !AttValue.substring(1,1) eq '=' then
               skip if !!CE.name eq !AttValue
            endif

            !DataAll.append( !AttName & '######' & !CurDes[!CurAtt.findfirst(!AttName)] & '######' & !AttValue & '######' & !CurDef[!CurAtt.findfirst(!AttName)].trim())
         enddo
      endif
   endif

   if !IncludedPsuedos.empty().not() then

   -- Get all pseudoattributes for all items and the current type

      !AllPsAttPos = !IncludedPsuedosTyp.find('ALL')

      !TypPsAttPos = !IncludedPsuedosTyp.find(!type)

      !Shorttype = !type.substring(1,4)
      !TypPsShrtAttPos = !IncludedPsuedosTyp.find(!Shorttype)

   -- Load the attributes into an array and sort them unique
      !ElemPsAttr = array()
      do !loop values !AllPsAttPos
         !ElemPsAttr.append(!IncludedPsuedos[!loop])
      enddo

      do !loop values !TypPsAttPos
         !ElemPsAttr.append(!IncludedPsuedos[!loop])
      enddo

      do !loop values !TypPsShrtAttPos
         !ElemPsAttr.append(!IncludedPsuedos[!loop])
      enddo

   -- Check if any Pseudo attributes are defined for outputing
      if !ElemPsAttr.empty().not() then
         !ElemPsAttr.unique()

     -- Split so that we have the attribute and descriptions seperate
         !CurPsAtt = array()
         !CurPsDes = array()
         !CurPsDef = array()

         do !loop indices !ElemPsAttr
            !ElemAttrtmp = !ElemPsAttr[!loop].replace('######','#')
            !CurPsAtt.append(!ElemAttrtmp.part(1,'#'))
            !CurPsDes.append(!ElemAttrtmp.part(2,'#'))
            !CurPsDef.append(!ElemAttrtmp.part(3,'#'))
         enddo

     -- Get values for Pseudo attributes

         do !AttName values !CurPsAtt

            var !PsuedoAttValue $!AttName
            handle (2,201) $* Attribute not on this item type
               if !!VNETxsettings.AttrErr.val.not() then
                  !this.CEErrors.append('               GETATTRIBUTES >> $!AttName data inaccessible for $!outname')
               endif
               skip
            elsehandle any
             -- cope with case where ref set, but inaccessible
               var !PsuedoAttValue 'unset'
            endhandle

            !DataAll.append( !AttName & '######' & !CurPsDes[!CurPsAtt.findfirst(!AttName)] & '######' & !PsuedoAttValue & '######' & !CurPsDef[!CurPsAtt.findfirst(!AttName)].trim())

         enddo
      endif

   endif

   !DataAll.unique()

   if !DataAll.empty() then
      if !navigateitem then
         $!CE
      endif
      return
   endif

   do !loop indices !DataAll
      !ElemAttrtmp = !DataAll[!loop].replace('######','#')
      !this.CEAttName.append(!ElemAttrtmp.part(1,'#'))
      !this.CEAttDesc.append(!ElemAttrtmp.part(2,'#'))
      !this.CEAttValue.append(!ElemAttrtmp.part(3,'#'))
      !this.CEAttDefVal.append(!ElemAttrtmp.part(4,'#'))
   enddo

   !RemoveItems = object ARRAY()

   if !!VNETxsettings.IncludeUnsetValue.val.not() then
      do !loop indices !this.CEAttValue
         if !this.CEAttValue[!loop].upcase() eq 'UNSET' and !this.CEAttDefVal[!loop] eq '' then
            !RemoveItems.append(!loop)
         elseif !this.CEAttValue[!loop].upcase() eq 'UNSET' and !this.CEAttDefVal[!loop] neq '' then
            !this.CEAttValue[!loop] = !this.CEAttDefVal[!loop]
         endif
      enddo
   endif

   if !!VNETxsettings.IncludeNulrefValue.val.not() then
      do !loop indices !this.CEAttValue
         if !this.CEAttValue[!loop] eq '=0/0' and !this.CEAttDefVal[!loop] eq '' then
            !RemoveItems.append(!loop)
         elseif !this.CEAttValue[!loop] eq '=0/0' and !this.CEAttDefVal[!loop] neq '' then
            !this.CEAttValue[!loop] = !this.CEAttDefVal[!loop]
         endif
      enddo
   endif

   if !!VNETxsettings.IncludeZeroValue.val.not() then
      do !loop indices !this.CEAttValue
         if (!this.CEAttValue[!loop] eq '0' or !this.CEAttValue[!loop] eq '0mm' or !this.CEAttValue[!loop] eq '0in') and !this.CEAttDefVal[!loop] eq '' then
            !RemoveItems.append(!loop)
         elseif (!this.CEAttValue[!loop] eq '0' or !this.CEAttValue[!loop] eq '0mm' or !this.CEAttValue[!loop] eq '0in') and !this.CEAttDefVal[!loop] neq '' then
            !this.CEAttValue[!loop] = !this.CEAttDefVal[!loop]
         endif
      enddo
   endif

   if !!VNETxsettings.IncludeWorldPosValue.val then
      do !loop indices !this.CEAttName
         if !this.CEAttName[!loop].lowcase() eq 'position' then
            var !wrtpos pos wrt /*
            !this.CEAttValue[!loop] = !wrtpos
         endif
      enddo
   else
      if !!VNETxsettings.IncludeZeroPosValue.val.not() then
         do !loop indices !this.CEAttValue
            if (!this.CEAttValue[!loop] eq 'E 0 N 0 U 0' or !this.CEAttValue[!loop] eq 'E 0mm N 0mm U 0mm' or !this.CEAttValue[!loop] eq 'E 0in N 0in U 0in') and !this.CEAttDefVal[!loop] eq '' then
               !RemoveItems.append(!loop)
            elseif (!this.CEAttValue[!loop] eq 'E 0 N 0 U 0' or !this.CEAttValue[!loop] eq 'E 0mm N 0mm U 0mm' or !this.CEAttValue[!loop] eq 'E 0in N 0in U 0in') and !this.CEAttDefVal[!loop] neq '' then
               !this.CEAttValue[!loop] = !this.CEAttDefVal[!loop]
            endif
         enddo
      endif
   endif

   do !loop indices !this.CEAttValue
      if !this.CEAttValue[!loop].trim() eq '' and !this.CEAttDefVal[!loop] neq '' then
         !this.CEAttValue[!loop] = !this.CEAttDefVal[!loop]
      endif
   enddo

   if !RemoveItems.empty().not() then
      !RemoveItems.sortunique()

      do !loop values !RemoveItems
         !this.CEAttDesc[!loop].delete()
         !this.CEAttValue[!loop].delete()
      enddo
   endif

   !this.CEAttDesc.compress()
   !this.CEAttValue.compress()

   if !navigateitem then
      $!CE
   endif

endmethod

-- End of method definition for .VNETGetattributes()
-------------------------------------------------------------------------------
-- End of File
