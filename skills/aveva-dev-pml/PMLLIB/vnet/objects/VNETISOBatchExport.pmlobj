--
--
-- Description:
-- Setup enviroment to enable batch plotting of ISOs with the names defined in the
-- PDMS Export gateway xml files
-- This replaces the Gateway form VNETExport for batch use

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  CharEncExists()                  -
--  OriginalNameExists()             -
--  VNETISOBatchExport()             -
--
--------------------------------------------------------------------------------

define object VNETISOBatchExport

  -- Allows the PDMS name to be modified as per the required output names
  -- OrigName Setting File exists
    member .OrigName is BOOLEAN

endobject

-- End of object definition for VNETISOBatchExport()

--------------------------------------------------------------------------------
-- Method:           .VNETISOBatchExport()
-- Author:           I.Stanbrook
-- Created:          Thur 19 June
--
--
-- Description:
-- Iniialise the setting of the object member the same as the PDMS gateway
-- VNETExport form does
--------------------------------------------------------------------------------

define method .VNETISOBatchExport()

  -- Check project is set (Pre 11.5)
   if undefined(!!currentproject) then
      var !!currentproject project code
   endif

  -- Set default file pathname by calling in the respective form
  -- ONLY if it hasn't been called before (Dont want to reset user input!)
   if undefined (!!VNETXsettings) then
      pml load object VNETISOBatchxsettings
      !!VNETXsettings = object VNETISOBatchxsettings()

     -- Check for a OriginalName settings file for the current project
      !this.OriginalNameExists()

     -- Read in Character Encoding file
      !this.CharEncExists()

   endif

   if undefined (!!VNETCharEncObj) then

      pml load object VNETEncodingStore
      !!VNETCharEncObj = object VNETEncodingStore()

     -- Get Encoding
      !!VNETLoadXMLEncode()

   endif

endmethod

-- End of method definition for .VNETISOBatchExport()

---------------------------------------------------------------------------
-- Method:           .OriginalNameExists
-- Author:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Check if a project Original Names pmlobj file exists
----------------------------------------------------------------------------

define method .OriginalNameExists()

-- Determine if OriginalName file exists
   !filename = 'VNETxmlOrigName' & !!currentproject & '.pmlobj'
   !filenamelc = !filename.lowcase()
   !macro = !!pml.getPathName(!filenamelc)
   handle any
      !this.OrigName = false
      !!VNETxsettings.OrigName = 'Unset'
   elsehandle none
      !this.OrigName = true
      !!VNETxsettings.OrigName = !macro
   endhandle

endmethod
-- End of method definition for .OriginalNameExists()

---------------------------------------------------------------------------
-- Method:           .CharEncExists
-- Author:           I.Stanbrook
-- Created:          Fri March 28
--
--
-- Description:
-- Check if a project Character Encoding file exists
----------------------------------------------------------------------------

define method .CharEncExists()

  -- Determine if Character Encoding file exists

   !filename = !!comGetOptFiles('VNET-CHAR-ENCODE')

   !!VNETxsettings.charencname = 'Unset'

  -- if a user options file has been found, load the options
  -- if a system options file has been found, load the data

   if (defined(!filename[2])) then
      !!VNETxsettings.charencname = !filename[2].fullname().string()
   elseif (defined(!filename[1])) then
      !!VNETxsettings.charencname = !filename[1].fullname().string()
   endif

endmethod
----------------------------------------------------------------------------
