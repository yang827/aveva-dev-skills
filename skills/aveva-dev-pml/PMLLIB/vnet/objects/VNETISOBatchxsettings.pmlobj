-- File:                VNETISOBatchxsettings.pmlobj
--   Type:              Function Definition
--   Group:             AVEVA NET
--     Keyword:         Export
--   Module:            Isodraft
--   Replaces:
--
-- Author:           I. Stanbrook
-- Created:          ??
--
--
-- Description:
-- Setup enviroment to enable batch plotting of ISOs with the names defined in the
-- PDMS Export gateway xml files
-- This replaces the Gateway form VNETxsettings for batch use

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETISOBatchxsettings(dbref,string) -
--
--------------------------------------------------------------------------------

define object VNETISOBatchxsettings

  -- Original Names setup file
    member .origname is STRING

  -- Character Encoding
    member .charencname is STRING

  endobject

-- End of object definition for VNETISOBatchxsettings()

--------------------------------------------------------------------------------
-- Method:           .VNETISOBatchxsettings(!name is STRING,!type is String)
-- Author:           I.Stanbrook
-- Created:          Thur 19 June
--
--
-- Description:
-- Iniialise the setting of the object member the same as the PDMS gateway
-- VNETxsettings form does
--------------------------------------------------------------------------------

define method .VNETISOBatchxsettings(!object is dbref, !name is string)

    !this.origname = 'Unset'
    !this.charencname = 'Unset'

endmethod

-- End of method definition for .VNETISOBatchxsettings()

--------------------------------------------------------------------------------

-- End of File
