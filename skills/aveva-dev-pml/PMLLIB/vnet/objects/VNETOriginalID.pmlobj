--
--
-- Description:
-- Output VantagePD data into XML format
-- Data output from user specified hierarchy position or list of hierarchy elements
-- Output hierarchy list stored in VNETExport member ".HierList"

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  OriginalName(dbref,string)       string
--  VNETOriginalID(dbref,string)     -
--
--------------------------------------------------------------------------------

define object VNETOriginalID

  -- Used as a temporary store to store results
  member .result is string

endobject

-- End of object definition for VNETOriginalID()

--------------------------------------------------------------------------------
-- Method:           .OriginalID(!name is STRING,!type is String)
-- Author:           A.Jenyon
-- Created:          Thur 19 June
--
--
-- Description:
-- Derive original external identifier from PDMS name
-- At minimum strip-off initial / and deal with illegal XML characters
--------------------------------------------------------------------------------

define method .VNETOriginalID(!object is dbref, !name is string)

   if ( !name.substring(1,1) eq '/' ) then
      !answer = !name.substring(2)
   elseif ( !name eq !object.name ) then
      !answer = !object.fullname
   else
      !answer = !name
   endif

-- Now see if the user has any better idea ...
   if !!VNETExport.OrigName then
      !answer = !this.OriginalName(!object, !answer)
   endif

   if !answer eq '' then
      if ( !name.substring(1,1) eq '/' ) then
         !answer = !name.substring(2)
      elseif ( !name eq !object.name ) then
         !answer = !object.fullname
      else
         !answer = !name
      endif
   endif

   !this.result = !!VNETStripXML(!answer)

endmethod

-- End of method definition for .OriginalID()

--------------------------------------------------------------------------------
-- Method:           .OriginalName(!object is DBREF,!name is String)
-- Author:           A.Jenyon
-- Created:          Thur 19 June
--
--
-- Description:
-- Derive original external identifier from PDMS name (e.g. to match P&ID name)

--------------------------------------------------------------------------------

define method .OriginalName(!object is dbref, !name is string ) is string

  -- Object to get Originalname for items for this project name found
   !orignameobject = !!file(!!vnetxsettings.origname.val).entry().before('.pmlobj')
   handle (2,759)(2,751)
    -- Error caused because running in ISO batchmode
    -- So get name for Batch element instead

      if undefined (!!VNETXsettings) then
         pml load object VNETISOBatchExport
         !dummysettings = object VNETISOBatchExport()
      endif

      !orignameobject = !!file(!!vnetxsettings.origname).entry().before('.pmlobj')

   endhandle

   !OrigName = object $!orignameobject(!object, !name)
   handle any
      return !name
   endhandle

   if (!OrigName.result eq !name) then
      return !name
   else
      return !OrigName.result
   endif

endmethod

-- End of method definition for .OriginalName()

