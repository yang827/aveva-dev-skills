--
--
-- Description:
-- Output PDMS Draft Drawings with Hit files

--------------------------------------------------------------------------------
-- Method Name      Return     Description
--
-- .VNETWriteHit    -          Filter out items in views, then create output file
-- .ScanMain        ARRAY      Filter out items in views, then create output file
-- .ScanSubs        ARRAY      Filter out items in views, then create output file
-- .ToDPos          -          Get the 2D position of the item on the drawing view
-- .ItemExclude     -          Get the Mapping file annd read it in (DRA-VNET-EXCLUDE)
--------------------------------------------------------------------------------

define object VNETSpool

 -- ISOREG Item
 -- Name and Name no slash
   member .IsoRegOName is string
   member .IsoRegNPName is string
 -- VNET Name
   member .IsoRegVName is string
 -- VNET Characteristics
   member .IsoRegChars is array
 -- VNET Classification
   member .IsoRegClass is string

 -- SPLDRG Item
 --Name and Name no slash
   member .SplDrgOName is string
   member .SplDrgNPName is string
 -- VNET Name
   member .SplDrgVName is string
 -- VNET Characteristics
   member .SplDrgChars is array
 -- VNET Classification
   member .SplDrgClass is string

 -- SPLDRG Associated Pipes
   member .AssocPipes is array

 -- SPLDRG members
   member .Splfld is array

   -- Note Splfld array will contain arrays for each SPLDRG Member and they are in the following Structure

      -- Splfld[1].spool[2] =
      -- Splfld[1].spool[3] = Re-named piping components
      -- Splfld[1].spool[4] = Correct name of piping components in [3]
      -- Splfld[1].spool[5] = Associated Pipes
      -- Splfld[1].spool[7] = VNET Characteristics
      -- Splfld[1].spool[8] = VNET Classification
      -- Splfld[1].spool[9] = PDMS Type (For Debug)

endobject

-- End of object definition for VNETSpool()

