--
--
-- Description:
-- Output PDMS Draft Drawings with Hit files

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  GetHitData(Array,String)         ARRAY
--  GetLabels()                      ARRAY
--  ItemExclude()                    -
--  ScanMain()                       ARRAY
--  ScanSubs(String)                 ARRAY
--  ToDPos(String)                   ARRAY
--  VNETWriteHit(string,string,string) -
--
--------------------------------------------------------------------------------

define object VNETWriteHit

  -- Element type
  member .elemtype is string

  -- Hitfile Contents
  member .hitfileoutput is array

  -- Items Array to vscan
  member .VNETviews is array

  -- User Mapping Data
  member .ExcludedItems is array
  member .ExcludedUnItems is array

  -- Drawing Size
  member .DwgSize is array

  member .ViwCen is string

endobject

-- End of object definition for VNETWriteHit()

--------------------------------------------------------------------------------

define method .VNETWriteHit(!directory is string, !file is string, !batchjob is string)

-- Determine the mapping file
   !this.ItemExclude()

-- switch off echoing of navigation through db
   trace off

-- Remember the current element
   !name = !!ce.name

-- Navigate to the selected plot element if called from PDMS DRAFT Plot CE menu option
   if !batchjob neq 'BATCH' then
      !plotitem = !!CDRPLOTIT.TYPE.selection()
      $!plotitem
   endif

-- What am I at
   !this.elemtype = !!ce.fulltype
   $P Processing $!!CE.fullname : $!!CE.type

-- Empty out arrays
   !this.VNETviews.empty()
   !this.hitfileoutput.empty()

-- Depending on type load array with the view refs
   if !this.elemtype eq 'SHEET' then
      var !VIEWS member views
      if !VIEWS eq 'unset' then
         $P >>> No Views found
         golabel /NoViews
      endif
      !this.VNETviews = !VIEWS.split()
   elseif !this.elemtype eq 'VIEW' then
      !this.VNETviews.append(fullname)
      var !viwxypos xypos
      !this.ViwCen = !viwxypos
   endif

   -- Is this an Imperial drawing
   -- First run macro to check for imperial units....
   !!runSynonym('CALLDRG UIMPCHECK')

   if (!!CDLFINCH eq '1') or (!!CDLINCH eq '1') then

   -- Store the current sheets units if imperial drawing
      var !UNITS units

   -- Set the units to mm with 2 decimal point precision
      MM DIST
      PREC VAR 2 DP

   endif

   !this.DwgSize = size

   !MNamedTags = ARRAY()
   !MUnNamedTags = ARRAY()

   !NamedTags = ARRAY()
   !UnNamedTags = ARRAY()

   -- Select Views by looping
   do !loopview indices !this.VNETviews

    -- Navigate to View
      $!this.VNETviews[$!loopview]

    -- Get all main items
      !found = !this.ScanMain()
      if !found.empty() then
         skip
      endif
      !hitdata = !this.GetHitData(!found,'MAIN')

      !MNamedTags = !hitdata[1]
      !MUnNamedTags = !hitdata[2]

    -- Navigate to View
      $!this.VNETviews[$!loopview]

    -- Get all branch item
      !found = !this.ScanSubs('STRU')
      if !found.empty().not() then
         !hitdata = !this.GetHitData(!found,'')
         !NamedTags.appendarray(!hitdata[1])
         !UnNamedTags.appendarray(!hitdata[2])
      endif

    -- Navigate to View
      $!this.VNETviews[$!loopview]

    -- Get all branch item
      !found = !this.ScanSubs('FRMW')
      if !found.empty().not() then
         !hitdata = !this.GetHitData(!found,'')
         !NamedTags.appendarray(!hitdata[1])
         !UnNamedTags.appendarray(!hitdata[2])
      endif

    -- Navigate to View
      $!this.VNETviews[$!loopview]

    -- Get all branch item
      !found = !this.ScanSubs('BRANCH')
      if !found.empty().not() then
         !hitdata = !this.GetHitData(!found,'')
         !NamedTags.appendarray(!hitdata[1])
         !UnNamedTags.appendarray(!hitdata[2])
      endif

    -- Navigate to View
      $!this.VNETviews[$!loopview]

    -- Get all EQUIP item
      !found = !this.ScanSubs('EQUIP')
      if !found.empty().not() then
         !hitdata = !this.GetHitData(!found,'')
         !NamedTags.appendarray(!hitdata[1])
         !UnNamedTags.appendarray(!hitdata[2])
      endif

   -- Append All Items found

      !NamedTags.appendarray(!MNamedTags)
      !UnNamedTags.appendarray(!MUnNamedTags)

    -- Get all Labels
      !hitdata = !this.GetLabels()

      !NamedTags.appendarray(!hitdata[1])
      !UnNamedTags.appendarray(!hitdata[2])

   enddo

   !NamedTags.unique()
   !UnNamedTags.unique()

   !this.hitfileoutput.appendarray(!UnNamedTags)
   !this.hitfileoutput.appendarray(!NamedTags)

-- Reset the current sheets units if imperial drawing
   if (!!CDLFINCH eq '1') or (!!CDLINCH eq '1') then
      $!UNITS
   endif

   !hitfilenm = !!file(!directory & '/' & !file & '.hit')
   !hitfilenm.writefile('OVERWRITE',!this.hitfileoutput)
   !hitfilenm.close()

label /NoViews

-- Return to original Current Element
   $!name

   !taggeditems = !this.hitfileoutput.size()
   $P Processed $!!CE.fullname : $!taggeditems Items Tagged in Hit File

endmethod

-- End of method definition for .VNETWriteHit()

-----------------------------------------------------------------------------------------
-- Method:           .ScanMain() is ARRAY
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Scan View of main items
--------------------------------------------------------------------------------

define method .ScanMain() is ARRAY

   !ScanMain = array()
   !BranchOwn = ARRAY()

-- Scan all of the major items in the current view
   var !mainitems vscan signif
   if undefined(!mainitems) then
      $P >>>>>> $!!CE.fullname : No Significant Items found
      return !ScanMain
   endif

   do !loop indices !mainitems
      skip if !mainitems[!loop].part(1).upcase() neq 'BRAN'
      !c = !mainitems[!loop].part(2).dbref()
      var !r ref of owner of $!c
      var !t type of owner of $!c
      !BranchOwn.append(!t + ' ' + !r)
   enddo
   !BranchOwn.sortunique()

   !mainitems.appendarray(!BranchOwn)

   do !loop indices !mainitems
      skip if not !this.ExcludedItems.findfirst(!mainitems[!loop].part(1).upcase()).unset()
      !ScanMain.append(!mainitems[!loop].after(' '))
   enddo

-- Return
   return !ScanMain

endmethod

-- End of method definition .ScanMain() is ARRAY

-----------------------------------------------------------------------------------------
-- Method:           .ScanSubs(!scantype is String) is ARRAY
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Scan View of Sub items
--------------------------------------------------------------------------------

define method .ScanSubs(!scantype is String) is ARRAY

   !ScanSubs = ARRAY()

   var !selecteditems vscan for $!scantype members

   if undefined(!selecteditems) then
      $P >>>>>> $!!CE.fullname : No $!scantype Sub Items found
      return !ScanSubs
   endif

   do !loop indices !selecteditems

      skip if not !this.ExcludedItems.findfirst(!selecteditems[!loop].part(1).upcase()).unset()

      skip if !scantype eq 'EQUIP' and (!selecteditems[!loop].part(1).upcase() neq 'NOZZ' or !selecteditems[!loop].part(1).upcase() neq 'SUBE')

      !ScanSubs.append(!selecteditems[!loop].after(' '))
   enddo

-- Return
   return !ScanSubs

endmethod

-- End of method definition .ScanSubs(!scantype is String) is ARRAY

-----------------------------------------------------------------------------------------
-- Method:           .GetHitData(!itemid is Array, !selectedmode is String) is ARRAY
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Get data for items passed to it
--------------------------------------------------------------------------------

define method .GetHitData(!itemid is Array, !selectedmode is String) is ARRAY

   !HitData = ARRAY()
   !HitData[1] = ARRAY()
   !HitData[2] = ARRAY()

   !NamedSrt = array()

   var !itmtype eval type for all from !itemid
   var !itmname eval name for all from !itemid
   var !fulname eval fullname for all from !itemid

   do !loop indices !itemid

      skip if not (!this.ExcludedUnItems.findfirst(!itmtype[!loop].part(1).upcase()).unset()) and (!itmname[!loop] eq !itemid[!loop])

      !position = array()
      !position = !this.ToDPos(!itemid[!loop])

      skip if !position.empty()

      if !itmname[!loop] eq !fulname[!loop] then
         !HitData[1].append(|     | & !position[1] &  |       | & !position[2] & | | & !itemid[!loop] & | '| & !fulname[!loop] & |'|)
         !NamedSrt.append(!fulname[!loop])
      else
         !HitData[2].append(|     | & !position[1] &  |       | & !position[2] & | | & !itemid[!loop] & | '| & !fulname[!loop] & |'|)
      endif
   enddo

   return !HitData

endmethod

-- End of method definition .GetHitData(!itemid is Array) is ARRAY

-----------------------------------------------------------------------------------------
-- Method:           .ToDPos(!itemid is String) is ARRAY
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Get the 2D position of the item on the drawing view
--------------------------------------------------------------------------------

define method .ToDPos(!itemid is String) is ARRAY

   !ToDPos = ARRAY()

   var !postwod shpos of $!itemid
   handle any
      return !ToDPos
   endhandle

   !ToDPos[1] = !postwod.part(2).real().string('D2')
   !ToDPos[2] = !postwod.part(4).real().string('D2')

   if !this.elemtype eq 'VIEW' then
      !xp = !ToDPos[1].real() - (!this.ViwCen.part(2).real() - (!this.DwgSize[1] / 2))
      !ToDPos[1] = !xp.string('D2')
      !yp = !ToDPos[2].real() - (!this.ViwCen.part(4).real() - (!this.DwgSize[2] / 2))
      !ToDPos[2] = !yp.string('D2')
   endif

   if not (!ToDPos[1].real().between(0,!this.DwgSize[1]) and !ToDPos[2].real().between(0,!this.DwgSize[2])) then
      !ToDPos.clear()
   else
      -- Remove mm unit labels
      !ToDPos[1] = !ToDPos[1].replace('mm', '')
      !ToDPos[2] = !ToDPos[2].replace('mm', '')
   endif

-- Return
   return !ToDPos

endmethod

-- End of method definition .ToDPos(!itemid is String) is ARRAY
-----------------------------------------------------------------------------------------
-- Method:           .GetLabels() is ARRAY
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Get the 2D position of the item on the drawing view
--------------------------------------------------------------------------------

define method .GetLabels() is ARRAY

   !GetLabels = ARRAY()
   !GetLabels[1] = ARRAY()
   !GetLabels[2] = ARRAY()

   !labtype = ''

   if !this.ExcludedItems.findfirst('SLAB').unset() then
      !labtype = 'SLAB'
   endif
   if !this.ExcludedItems.findfirst('GLAB').unset() then
      !labtype = !labtype & ' GLAB'
   endif

   !labtype = !labtype.trim()

   if !labtype eq '' then
      return !GetLabels
   endif

   !Alllabel = !!CollectAllFor(!labtype,'',VIEW )
   if !Alllabel.empty() then
      $P >>>>>> $!!CE.fullname : No $!labtype Labels found
      return !GetLabels
   endif

   var !label collect all ( $!labtype ) for VIEW

   var !itemid eval ref of ddna for all from !label
   var !fulname eval name of ddna for all from !label
   var !itmname eval fullname of ddna for all from !label

   !labelxy = array()

   do !loop values !Alllabel

      if !loop.oset then
         !loop.oset = false
         handle any
         endhandle

         !labelxy.append(!loop.xyposition)

         !loop.oset = true
         handle any
         endhandle
      else
         !labelxy.append(!loop.xyposition)
      endif

   enddo

   do !loop indices !label

      skip if !itmname[!loop] eq 'unset'
      skip if !fulname[!loop] eq !itemid[!loop]

      if !itmname[!loop] eq !fulname[!loop] then
         !GetLabels[1].append(|     | & !labelxy[!loop].east.real().string('D2').replace('mm', '') &  |       | & !labelxy[!loop].north.real().string('D2').replace('mm', '') & | | & !itemid[!loop] & | '| & !fulname[!loop] & |'|)
      else
         !GetLabels[2].append(|     | & !labelxy[!loop].east.real().string('D2').replace('mm', '') &  |       | & !labelxy[!loop].north.real().string('D2').replace('mm', '') & | | & !itemid[!loop] & | '| & !itmname[!loop] & |'|)
      endif

   enddo

-- Return
   return !GetLabels

endmethod

-- End of method definition .GetLabels(!itemid is String) is ARRAY

-----------------------------------------------------------------------------------------
-- Method:           .ItemExclude()
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Find out the mapping file to use
--------------------------------------------------------------------------------

define method .ItemExclude()

   !this.ExcludedItems.clear()
   !this.ExcludedUnItems.clear()

   !mapfile = !!comGetOptFiles('DRA-VNET-EXCLUDE')

   -- if a user options file has been found, load the options
   -- if a system options file has been found, load the data
   if (defined(!mapfile[2])) then

    -- load options file
      !InputFile = object FILE(!mapfile[2].fullName())
      !Lines     = !InputFile.ReadFile()
   elseif (defined(!mapfile[1])) then

    -- load options file
      !InputFile = object FILE(!mapfile[1].fullName())
      !Lines     = !InputFile.ReadFile()
   endif

   if (undefined(!Lines)) then
      return
   endif

   if !Lines.empty() then
      return
   endif

   !MapArray = object ARRAY()

  -- Find the "--Begin" indicator
   !StartIndx = !Lines.FindFirst('--Begin')
   If (!StartIndx eq 0) then
     return
   endif

  -- Remove the unwanted lines from the array
   !Rem = !Lines.DeleteTo(!StartIndx)
   !cmp = !Lines.Compress()

   !ExItem = object ARRAY()
   !ExUnItem = object ARRAY()

   Do !line values !Lines
      skip if (!line.trim() eq '')
      if (!line.upcase().substring(1,2) eq 'U:') then
         !ExUnItem.append(!line.upcase().replace('U:',''))
      else
         !ExItem.append(!line.upcase())
      endif
   Enddo

  -- Finally set them to the main store .Classes
   !this.ExcludedItems = !ExItem.unique()
   !this.ExcludedUnItems = !ExUnItem.unique()

endmethod

-- End of method definition for .ItemExclude()

