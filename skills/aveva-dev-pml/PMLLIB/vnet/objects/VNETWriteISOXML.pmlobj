-- Description:
-- Output PDMS Draft Drawings with Hit files

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETWriteISOXML(string,string,string) -
--
--------------------------------------------------------------------------------

define object VNETWriteISOXML

 -- User Mapping Data
  member .result is string

endobject

-- End of object definition for VNETWriteISOXML()

--------------------------------------------------------------------------------

define method .VNETWriteISOXML(!vnetFile is string, !plotfilename is string, !currentitem is string)

   !VNETtype = 'PIPE'

   !tempname = '/' & !currentitem
   !currentDBRef = !tempname.dbref()
   handle (2,109)
      var !detailitem Detaillist
      !items = !detailitem.occurs('ADD')
      if !items eq 0 then
         $p Error getting dbref for : $!tempname
         return
      endif

      $p System ISO containing $!items items

      !VNETtype = 'SYSTEMISO'

   endhandle

      !detailspl = 'ISODEP ISOREG SPLDRG SPOOL FIELD'
      if (!detailspl.match(!!ce.type) neq 0) then
         !VNETtype = 'SPOOL'
         var !pcmp collect all with type eq 'FIELD' or type eq 'SPOOL' for $!currentDBRef.fullname
      endif

      if !VNETtype neq 'SYSTEMISO' then
    -- convert any invalid XML chars found in the name
         !OrigID = object VNETOriginalID(!currentDBRef, !currentDBRef.fullname)
         !ItemID = !OrigID.result
      else
         !ItemID = !currentitem
      endif

    -- Character Encoding
      !CharEnc = !!VNETCharEncode()

      !output = array()

      !output.append(|<?xml version="1.0" encoding="| & !CharEnc & |"?>|)

      !output.append('<vl:VNETList xmlns:vl="http://www.aveva.com/VNET/List" xmlns="http://www.aveva.com/VNET/eiwm">')
      !output.append('  <Template>')

      if !VNETtype eq 'PIPE' then
         !output.append('    <ID>VPD ISO Association for ' & !currentitem & '</ID>')
      elseif !VNETtype eq 'SPOOL' then
         !output.append('    <ID>VPD ISOSPL Association for ' & !currentitem & '</ID>')
      else
         !output.append('    <ID>VPD System ISO Association for ' & !currentitem & '</ID>')
      endif

   -- System Isos have the main file name as the ItemID so ignore it

      if !VNETtype neq 'SYSTEMISO' then

         !output.append('    <Object>')
         !output.append('       <ID>' & !ItemID & '</ID>')
         !output.append('       <Context>')
         !output.append('         <ID>PROJECTCONTEXT</ID>')
         !output.append('       </Context>')
         !output.append('       <Association type="is referenced in">')
         !output.append('         <Object>')
         !output.append('           <ID>' & !plotfilename & '</ID>')
         !output.append('             <Context>')
         !output.append('               <ID>VPD</ID>')
         !output.append('                 <Context>')
         !output.append('                   <ID>PROJECTCONTEXT</ID>')
         !output.append('                 </Context>')
         !output.append('             </Context>')
         !output.append('         </Object>')
         !output.append('       </Association>')
         !output.append('    </Object>')

      endif

      if !VNETtype eq 'SPOOL' then

         if !pcmp.empty().not() then

            !spoolpipes = ARRAY()
            do !pcmpvals indices !pcmp
               !splitem = !pcmp[!pcmpvals].dbref()
               !pcmps = !splitem.splmem
               do !i indices !pcmps
                  skip if !pcmps[!i].badref()
                  !spoolpipes.append(!pcmps[!i].owner.owner)
               enddo
            enddo

            !spoolpipes.sortunique()

            if !spoolpipes.empty().not() then
               do !loop indices !spoolpipes
                  !output.append('    <Object>')

              -- get VNET name for associated PIPEs
                  !OrigID = object VNETOriginalID(!spoolpipes[!loop], !spoolpipes[!loop].fullname)
                  !ItemID = !OrigID.result

                  !output.append('       <ID>' & !ItemID & '</ID>')
                  !output.append('       <Context>')
                  !output.append('          <ID>PROJECTCONTEXT</ID>')
                  !output.append('       </Context>')
                  !output.append('       <Association type="is referenced in">')
                  !output.append('         <Object>')
                  !output.append('           <ID>' & !plotfilename & '</ID>')
                  !output.append('             <Context>')
                  !output.append('               <ID>VPD</ID>')
                  !output.append('                 <Context>')
                  !output.append('                   <ID>PROJECTCONTEXT</ID>')
                  !output.append('                 </Context>')
                  !output.append('             </Context>')
                  !output.append('         </Object>')
                  !output.append('       </Association>')
                  !output.append('    </Object>')
               enddo
            endif

         endif

      elseif !VNETtype eq 'SYSTEMISO' then

         var !detailitem Detaillist
         !detailitems = !detailitem.split()
         !posremove = !detailitems.findfirst('REMOVE')
         !detailitems.removefrom(!posremove)

         !pos = !detailitems.find('ADD')
         do !loop values !pos
            !detailitems.deletefrom(!loop,1)
         enddo
         !detailitems.compress().unique()
         var !detailrefs eval refno for all from !detailitems

         do !loop indices !detailrefs
            !output.append('    <Object>')

              -- get VNET name for associated PIPEs
            !OrigID = object VNETOriginalID($!detailrefs[$!loop], fullname of $!detailrefs[$!loop])
            !ItemID = !OrigID.result

            !output.append('       <ID>' & !ItemID & '</ID>')
            !output.append('       <Context>')
            !output.append('          <ID>PROJECTCONTEXT</ID>')
            !output.append('       </Context>')
            !output.append('       <Association type="is referenced in">')
            !output.append('         <Object>')
            !output.append('           <ID>' & !plotfilename & '</ID>')
            !output.append('             <Context>')
            !output.append('               <ID>VPD</ID>')
            !output.append('                 <Context>')
            !output.append('                   <ID>PROJECTCONTEXT</ID>')
            !output.append('                 </Context>')
            !output.append('             </Context>')
            !output.append('         </Object>')
            !output.append('       </Association>')
            !output.append('    </Object>')
         enddo

      endif

      !output.append('  </Template>')
      !output.append('</vl:VNETList>')

      !VNETOutputFile = object file(!vnetFile)
      !VNETOutputFile.writefile('OVERWRITE',!output)
      !VNETOutputFile.close()

endmethod

-- End of method definition for .VNETWriteISOXML()

-------------------------------------------------------------------------------

-- End of File
