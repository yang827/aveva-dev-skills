-------------------------------------------------------------------------------

-- Method:      .IncludeTol()
-- Author:      Ian Stanbrook
-- Created:     Fri December 05
--
--
-- Description:
-- Find out the mapping file to use

--------------------------------------------------------------------------------

define method .IncludeTol(!action is string)

   if !action eq 'LOAD' then

-- Set up original settings
      !this.tolbore = ''
      !this.tolskey = ''
      !this.toloff = ''
      !this.tolang = ''
      !this.toltub = ''

      var !origbore TOLERANCE CATALOGUE BORE
      var !origskey TOLERANCE CATALOGUE SKEY
      var !origoff TOLERANCE OFFSET
      var !origang TOLERANCE ANGLE
      var !origtub TOLERANCE TUBE

      !this.tolbore = !origbore
      !this.tolskey = !origskey
      !this.toloff = !origoff
      !this.tolang = !origang
      !this.toltub = !origtub

-- Load user settings

      !this.settolbore = ''
      !this.settolskey = ''
      !this.settoloff = ''
      !this.settolang = ''
      !this.settoltub = ''

      !IncludedTol = !!VNETLoadItems(!!VNETxsettings.inctolerspl)
      handle any
         return
      endhandle

      do !loop indices !IncludedTol
         if !IncludedTol[!loop].part(1) eq 'BORE' then
            !this.settolbore = !IncludedTol[!loop]
         elseif !IncludedTol[!loop].part(1) eq 'SKEY' then
            !this.settolskey = !IncludedTol[!loop]
         elseif !IncludedTol[!loop].part(1) eq 'OFFSET' then
            !this.settoloff = !IncludedTol[!loop]
         elseif !IncludedTol[!loop].part(1) eq 'ANGLE' then
            !this.settolang = !IncludedTol[!loop]
         elseif !IncludedTol[!loop].part(1) eq 'TUBE' then
            !this.settoltub = !IncludedTol[!loop]
         endif
      enddo

   elseif !action eq 'SET' then

      if !this.settolbore neq '' then
         !tmptolbore = !this.settolbore

         TOLERANCE CATALOGUE $!tmptolbore
         handle any
            !this.logfile('','Error setting Tolerence Bore with value from Tolerences file: ' & !!VNETxsettings.inctolerspl.val)
         endhandle
      endif

      if !this.settolskey neq '' then
         !tmptolskey = !this.settolskey.after('SKEY').trim()
         !tmptolskey = !tmptolskey.replace(| |,|' '|)
         TOLERANCE CATALOGUE SKEY '$!tmptolskey'
         handle any
            !this.logfile('','Error setting Tolerence SKEY with value from Tolerences file: ' & !!VNETxsettings.inctolerspl.val)
         endhandle
      endif

      if !this.settoloff neq '' then
         !tmptoloff = !this.settoloff
         TOLERANCE $!tmptoloff
         handle any
            !this.logfile('','Error setting Tolerence Offset with value from Tolerences file: ' & !!VNETxsettings.inctolerspl.val)
         endhandle
      endif

      if !this.settolang neq '' then
         !tmptolang = !this.settolang
         TOLERANCE $!tmptolang
         handle any
            !this.logfile('','Error setting Tolerence Angle with value from Tolerences file: ' & !!VNETxsettings.inctolerspl.val)
         endhandle
      endif

      if !this.settoltub neq '' then
         !tmptoltub = !this.settoltub
         TOLERANCE $!tmptoltub
         handle any
            !this.logfile('','Error setting Tolerence Tube with value from Tolerences file: ' & !!VNETxsettings.inctolerspl.val)
         endhandle
      endif

   elseif !action eq 'RESET' then

      !tolbore = !this.tolbore
      TOLERANCE CATALOGUE BORE $!tolbore
      handle any
      endhandle

      !tolskey = !this.tolskey
      TOLERANCE CATALOGUE SKEY $!tolskey
      handle any
      endhandle

      !toloff = !this.toloff
      TOLERANCE OFFSET $!toloff
      handle any
      endhandle

      !tolang = !this.tolang
      TOLERANCE ANGLE $!tolang
      handle any
      endhandle

      !toltub = !this.toltub
      TOLERANCE ANGLE $!toltub
      handle any
      endhandle

   endif

endmethod

-- End of method definition for .IncludeTol()

-------------------------------------------------------------------------------

-- Method:           .logfile()
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Output the data to the relevent log file or files depending on the settings

--------------------------------------------------------------------------------

define method .logfile(!whichfile is string, !message is string)

   if !whichfile eq '' or (!whichfile eq 'StdLog') then
      if !message eq 'ARRAY' then
         do !loop indices !this.LogfileMes
            !this.NormalLog.WriteRecord(!this.LogfileMes[!loop])
         enddo
      else
         !this.NormalLog.WriteRecord(!message)
      endif
   endif

   if !this.FullLog.unset().not() and (!whichfile neq 'StdLog') then
      if !message eq 'ARRAY' then
         do !loop indices !this.LogfileMes
            !this.FullLog.WriteRecord(!this.LogfileMes[!loop])
         enddo
      else
         !this.FullLog.WriteRecord(!message)
         handle any
         endhandle
      endif
   endif

   !this.LogfileMes.clear()

endmethod

-- End of method definition for .logfile(!whichfile is string, !message is string)

-------------------------------------------------------------------------------

-- Method:           .logfilehead(!logtype is string, !Filename is file)
-- Author:           Ian Stanbrook
-- Created:          Fri December 05
--
--
-- Description:
-- Output the data to the relevent log file or files depending on the settings

--------------------------------------------------------------------------------

define method .logfilehead(!logtype is string, !Filename is file)

     var !time clock

     -- Write Logfile entries
     !this.logfile('$!logtype','')
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')
     !this.logfile('$!logtype','')

     !this.logfile('FullLog','')
     !this.logfile('$!logtype','XML Encoding : ' & !this.CharEnc )
     !this.logfile('$!logtype','')

     !this.logfile('$!logtype','Export Started: $!time')
     !this.logfile('$!logtype','')
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')
     !this.logfile('$!logtype','')
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')
     !this.logfile('$!logtype','Original Name Routine  : ' + !!VNETxsettings.origname.val)
     !this.logfile('$!logtype','User Class Map Routine : ' + !!VNETxsettings.uclass.val)
     !this.logfile('$!logtype','Other Names Routine    : ' + !!VNETxsettings.OtherName.val)
     !this.logfile('$!logtype','Items to Include       : ' + !!VNETxsettings.incitemspl.val.string())
     !this.logfile('$!logtype','Attributes to Export   : ' + !!VNETxsettings.incattrsspl.val.string())
     !this.logfile('$!logtype','Tolerances to Include  : ' + !!VNETxsettings.inctolerspl.val.string())
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')
     !this.logfile('$!logtype','')
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')
     !this.logfile('$!logtype','Include Settings:')

     !this.logfile('$!logtype','UnNamed Sites         : ' + !!VNETxsettings.IncludeUnNamedSite.val.string())
     !this.logfile('$!logtype','Unset values          : ' + !!VNETxsettings.IncludeUnsetValue.val.string())
     !this.logfile('$!logtype','Nulref values         : ' + !!VNETxsettings.IncludeNulrefValue.val.string())
     !this.logfile('$!logtype','0 values              : ' + !!VNETxsettings.IncludeZeroValue.val.string())
     !this.logfile('$!logtype','Positions WRT to World: ' + !!VNETxsettings.IncludeWorldPosValue.val.string())
     !this.logfile('$!logtype','E 0 N 0 U 0 Positions : ' + !!VNETxsettings.IncludeZeroPosValue.val.string())
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')

     !this.logfile('$!logtype','')
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')
     !this.logfile('$!logtype','Contents of : ' + !!VNETxsettings.incitemspl.val.string())
     !this.logfile('$!logtype','--------------------------------------------------------------------------------')

     do !loop indices !this.IncludeItem
        !this.logfile('$!logtype','$!loop) ' + !this.IncludeItem[!loop])
     enddo

     !this.logfile('$!logtype','--------------------------------------------------------------------------------')

endmethod

-- End of method definition for .logfilehead(!logtype is string, !Filename is file)

