-- Created:         Tue 03 Aug 2006
--
--
-- Description:
-- Asembly View Data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETLog()                        -                   Construct
--  add(STRING)                      -                   Add a message to the log
--  addarray(ARRAY)                  -                   Add a message to the log
--  clear()                          -                   Clear this object
--  footer()                         -                   Adds a footer to the file contents
--  header()                         -                   Adds a header to the file contents
--  initialise(FILE)                 -                   Initialise the object
--  read(FILE)                       -                   Read a passed log file
--  stop()                           -                   Stops the log file recording
--
------------------------------------------------------------------------
------------------------------------------------------------------------
define object VNETLOG

  member .folder    is FILE

  member .file      is FILE

  member .alphaLog  is FILE

  member .dateTime  is DATETIME

  member .contents  is ARRAY

endobject
-- End of object definition for VNETLOG

------------------------------------------------------------------------
--
-- Method:        .VNETLog()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .VNETLog()

  -- Initialise variables
  !this.dateTime = object DATETIME()

endmethod
-- End of object definition for .VNETLog()

------------------------------------------------------------------------
--
-- Method:      .add(STRING)
--
-- Description: Add a message to the log
--
-- Method Type: Construct
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .add(!message is STRING)

  !this.contents.append(!message)

endmethod
-- End of object definition for .add(STRING)

------------------------------------------------------------------------
--
-- Method:      .addarray(ARRAY)
--
-- Description: Add a message to the log
--
-- Method Type: Construct
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .addarray(!message is ARRAY)

  !this.contents.appendarray(!message)

endmethod
-- End of object definition for .addarray(ARRAY)

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear this object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.contents.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .footer()
--
-- Description:   Adds a footer to the file contents
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .footer()

  -- Initialise variables
  !date = object DATETIME()

  -- Build footer
  !this.contents.append(' ')
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')
  !this.contents.append('Export complete ' & !date.string())
  !this.contents.append(' ')

endmethod
-- End of object definition for .footer()

------------------------------------------------------------------------
--
-- Method:        .header()
--
-- Description:   Adds a header to the file contents
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .header()

  -- Initialise variables
  !project = CURRENT PROJECT

  -- Get project data
  !projectName = !project.name()
  if (!projectName.unset()) then
    !projectName = ' '
  endif

  -- Header
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')
  !this.contents.append('                        VNET Assembly XML Export')
  !this.contents.append(' ')
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')
  !this.contents.append('Project: ' & !project.code() & ' ' & !projectName)
  !this.contents.append('Export Started: ' & !this.dateTime.string())
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')

     !this.contents.append('_________________________________________________________________________')
     !this.contents.append('Original Name Routine   : ' + !!VNETxsettings.origname.val)
     !this.contents.append('User Class Map Routine  : ' + !!VNETxsettings.uclass.val)
     !this.contents.append('Other Names Routine     : ' + !!VNETxsettings.OtherName.val)
     !this.contents.append('Attributes to Export    : ' + !!VNETxsettings.incattrsname.val.string())
     !this.contents.append('_________________________________________________________________________')
     !this.contents.append(' ')
     !this.contents.append('_________________________________________________________________________')
     !this.contents.append('Include Settings:')
     !this.contents.append('UnNamed Top Level Items : ' + !!VNETxsettings.IncludeUnNamedSite.val.string())
     !this.contents.append('Unset values            : ' + !!VNETxsettings.IncludeUnsetValue.val.string())
     !this.contents.append('Nulref values           : ' + !!VNETxsettings.IncludeNulrefValue.val.string())
     !this.contents.append('0 values                : ' + !!VNETxsettings.IncludeZeroValue.val.string())
     !this.contents.append('E 0 N 0 U 0 Positions   : ' + !!VNETxsettings.IncludeZeroPosValue.val.string())
     !this.contents.append('_________________________________________________________________________')




endmethod
-- End of object definition for .header()

------------------------------------------------------------------------
--
-- Method:        .initialise(FILE)
--
-- Description:   Initialise the object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        The directory where the log file will be written
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!logfile is FILE)

  -- Initialise variables
  !this.dateTime = object DATETIME()
  !this.clear()

  -- Check that the directory exists
  if (!logfile.exists().not()) then

    -- Create the folder
    !folderPath = !logfile.directory()
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- Store directory
  !this.folder = !logfile.directory()

  -- Build the log file object
  !this.file = !logfile

  -- Add header
  !this.header()

endmethod
-- End of object definition for .intialise(FILE)

------------------------------------------------------------------------
--
-- Method:        .read(FILE)
--
-- Description:   Read a passed log file
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Log file object
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .read(!file is FILE)

  !this.file     = !file

  !this.folder   = !this.file.directory()

  !this.contents = !this.file.readFile()

endmethod
-- End of object definition for .read(FILE)

------------------------------------------------------------------------
--
-- Method:        .stop()
--
-- Description:   Stops the log file recording
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stop()

  -- Add footer
  !this.footer()

  -- Write the log
  !this.file.writefile('OVERWRITE',!this.contents)

endmethod
-- End of object definition for .stop()
