--   Group:         Application Switching
--     Keyword:     APP
--   Module:        design
--   Replaces:
--
-- Author:           Ian Stanbrook
-- Created:         Thu Jan 29 15:56:21 2004
--
--
-- Description:     Object for VNET application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appVNetDRA()                     -                   Constructor method
--  initialise()                     -                   initialisation for AVEVA Net export application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPVNETDRA
	member .hasLicense is BOOLEAN
endobject
-- End of object definition for APPVNETDRA

------------------------------------------------------------------------
--
-- Method:      .appVNetDRA()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appVNetDRA()

  !name = '9XMvbxuchzkp/mC4GaGT3cy/ZLTguovipJZcvsorjJXynSV1'
  !this.hasLicense = !name.substring(48,' 1')

  !!appVNetDRA = !this

endmethod
-- End of method definition for .appVNetDRA()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
   !this.utilsMenu()
endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
    !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()

  -- add option to menu in General app
  !menu = object APPMENU('MBUTILS')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'AVEVA NET Export...', 'show !!vnetExport free', 'DraftVNETExport')
  !!appMenuCntrl.addMenu(!menu, 'ALL')

endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  frame .AvevaNetToolbar toolbar 'AVEVA Net Toolbar'
	button .exportButton 'Export' tooltip 'Export' pixmap width 16  height 16 callback |show !!vnetExport free|
  exit
  !!appTbarCntrl.addToolbar('AvevaNetToolbar', 'ALL')

endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation for AVEVA Net export application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

-- Only enable the toolbar button and menu item if a valid license has been found
--!!appDraMain.exportButton.addPixmap(!!pml.getPathName('PublishtoAVEVANet.png'))

if (!this.hasLicense.not()) then
	!!appDraMain.exportButton.active = false
	!!appDraMain.mbutils.setFieldProperty('DraftVNETExport', 'ACTIVE', false)

endif

endmethod
-- End of method definition for .initialise()
