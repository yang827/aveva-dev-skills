--
-- Author:           C. Pearson
-- Created:          Fri March 28
--
--
-- Description:
-- Users filter for specifying the VNET classifcation for an item
--
-- The standard export macros select the basic, high level element groups, i.e. PIPE, EQUI etc. from
-- the complete db. If set, this function is then called for each.  Hence the user may now put
-- any selection/filter method they wish in here before finally returning the resultant VNET
-- Classification.
-- e.g. if part 1 of name = 'V' then return 'Vessel' as Class
-- or.  if attrib-a = x and spre = y then class is 'Flow Indicator'.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETUserClass(STRING,STRING,STRING) -
--

--------------------------------------------------------------------------------
-- Method Name                      Called From             Description
-- VNETUserClass     VNETWriteXML
--------------------------------------------------------------------------------

define object VNETUserClass

  -- Used as a temporary store for the original name
  member .result is string

endobject

-- End of object definition for VNETUserClass

--------------------------------------------------------------------------------

define method .VNETUserClass(!type is STRING, !name is STRING, !Class is STRING)

  -- Variables defined are....
  --  !type = PDMS Type of the current element e.g. SITE or GASK
  --  !name = PDMS name including "/".
  --  !Class = AVEVA default class result


 -- Set up the result to be the default class for the item
   !this.result = !Class

   if (!type eq 'EQUI') then

      !FirstChar = !name.substring(2,1)
      if (!FirstChar eq 'E') then
         !this.result = 'Heat Transfer'
      elseif (!FirstChar eq 'V') then
         !this.result = 'Vessel'
      elseif (!FirstChar eq 'P') then
         !this.result = 'Pump'
      elseif (!FirstChar eq 'D') then
         !this.result = 'Drum'
      elseif (!FirstChar eq 'C') then
         !this.result = 'Columns and Towers'
      endif

   endif

endmethod

-- End of method definition for .!!VNETUserClass()

---------------------------------------------------------------------------------

