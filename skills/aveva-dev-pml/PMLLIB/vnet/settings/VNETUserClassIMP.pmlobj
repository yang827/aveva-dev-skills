-- File:                VNETUserClassIMP()
--   Type:              Function Definition
--   Group:             AVEVA NET
--     Keyword:         Export
--   Module:            Design
--   Replaces:
--
-- Author:           C. Pearson
-- Created:          Fri March 28
--
--
-- Description:
-- Users filter for specifying the VNET classifcation for an item
--
-- The standard export macros select the basic, high level element groups, i.e. PSAM, EQUI etc. from
-- the complete db. If set, this function is then called for each.  Hence the user may now put
-- any selection/filter method they wish in here before finally returning the resultant VNET
-- Classification.
-- e.g. if part 1 of name = 'V' then return 'Vessel' as Class
-- or.  if attrib-a = x and spre = y then class is 'Flow Indicator'.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETUserClassIMP(STRING,STRING,STRING) -
--

--------------------------------------------------------------------------------
-- Method Name                      Called From             Description
-- VNETUserClass(ProjectName)     VNETWriteXML
--------------------------------------------------------------------------------

define object VNETUserClassIMP

  -- Used as a temporary store for the original name
  member .result is string

endobject

-- End of object definition for VNETUserClassIMP

--------------------------------------------------------------------------------

define method .VNETUserClassIMP(!type is STRING, !name is STRING, !Class is STRING)

  -- Variables defined are....
  --  !type = PDMS Type of the current element e.g. SITE or GASK
  --  !name = PDMS name including "/".
  --  !Class = AVEVA default class result

-- Set up the result to be the default class for the item
   !this.result = !Class


--
--
-- This Project uses 3 storage areas for the tag / class information
--
-- VNETExport.UserClassStore1 for Equipment Classes PDMS Item type EQUI
--
-- VNETExport.UserClassStore2 for Instrumentation ClassesPDMS Item type INST
--
-- VNETExport.UserClassStore3 for Instrumentation Valves Classes PDMS Item type VALV
--
--


-- Array of equipment tags and there class in the format
-- Tag+Class

   if !!VNETExport.UserClassStore1.empty() then

      !equitagdata = array()
      !equitagdata.append('C+Columns and Towers')
      !equitagdata.append('E+Heat Transfer')
      !equitagdata.append('D+Drum')
      !equitagdata.append('P+Pump')
      !equitagdata.append('VENTILATION+HVAC')


-- Some instruments are build as EQUIs

      !equitagdata.append('LG+LEVEL GAUGE')
      !equitagdata.append('LT+LEVEL TRANSMITTER')
      !equitagdata.append('LS+LEVEL SWITCH')
      !equitagdata.append('LV+HAND VALVE')
      !equitagdata.append('LZ+HAND VALVE')

      !!VNETExport.UserClassStore1.clear()
      !!VNETExport.UserClassStore1[1] = array()
      !!VNETExport.UserClassStore1[2] = array()

   -- Seperate out the tags from the array descriptions and load into one of the user storage areas

      do !indx indices !equitagdata
         !!VNETExport.UserClassStore1[1].append(!equitagdata[!indx].part(1,'+').trim())
         !!VNETExport.UserClassStore1[2].append(!equitagdata[!indx].part(2,'+').trim())
      enddo

   endif

-- Array of instrument tags and there class in the format
-- Tag+Class

   if !!VNETExport.UserClassStore2.empty() then

      !insttagdata = array()
      !insttagdata.append('FE+FLOW ELEMENT')
      !insttagdata.append('FG+FLOW GAUGE')
      !insttagdata.append('FT+FLOW TRANSMITTER')
      !insttagdata.append('FI+FLOW INDICATOR')
      !insttagdata.append('FC+FLOW CONTROLLER')
      !insttagdata.append('FIC+FLOW INDICATOR CONTROLLER')
      !insttagdata.append('FV+FLOW CONTROL VALVE')
      !insttagdata.append('FCV+FLOW CONTROL VALVE')
      !insttagdata.append('LI+LEVEL INDICATOR')
      !insttagdata.append('LA+LEVEL ALARM')
      !insttagdata.append('LAH+LEVEL ALARM HIGH')
      !insttagdata.append('LSH+LEVEL SWITCH HIGH')
      !insttagdata.append('LT+LEVEL TRANSMITTER')
      !insttagdata.append('LG+LEVEL GAUGE')
      !insttagdata.append('LC+LEVEL CONTROLLER')
      !insttagdata.append('LIC+LEVEL INDICATOR CONTROLLER')
      !insttagdata.append('LCV+LEVEL CONTROL VALVE')
      !insttagdata.append('LV+LEVEL CONTROL VALVE')
      !insttagdata.append('PT+PRESSURE TRANSMITTER')
      !insttagdata.append('PI+PRESSURE INDICATOR')
      !insttagdata.append('PIC+PRESSURE INDICATOR CONTROLLER')
      !insttagdata.append('PG+PRESSURE GAUGE')
      !insttagdata.append('PV+PRESSURE CONTROL VALVE')
      !insttagdata.append('PCV+PRESSURE CONTROL VALVE')
      !insttagdata.append('TE+TEMPERATURE ELEMENT')
      !insttagdata.append('TG+TEMPERATURE GAUGE')
      !insttagdata.append('TI+TEMPERATURE INDICATOR')
      !insttagdata.append('TT+TEMPERATURE TRANSMITTER')
      !insttagdata.append('RV+RELIEF VALVE')
      !insttagdata.append('PSV+PRESSURE RELIEF VALVE')
      !insttagdata.append('RO+FLOW ELEMENT')
      !insttagdata.append('TW+TEMPERATURE ELEMENT')
      !insttagdata.append('XV+CONTROL VALVE')
      !insttagdata.append('TM+TEMPERATURE MONITOR')
      !insttagdata.append('HV+HAND VALVE')
      !insttagdata.append('QE+QUANTITY ELEMENT')
      !insttagdata.append('QT+QUANTITY TRANSMITTER')
      !insttagdata.append('LS+LEVEL SWITCH')
      !insttagdata.append('PZ+HAND VALVE')
      !insttagdata.append('LZ+HAND VALVE')

      !!VNETExport.UserClassStore2.clear()
      !!VNETExport.UserClassStore2[1] = array()
      !!VNETExport.UserClassStore2[2] = array()

   -- Seperate out the tags from the array descriptions and load into one of the user storage areas
      do !indx indices !insttagdata
         !!VNETExport.UserClassStore2[1].append(!insttagdata[!indx].part(1,'+').trim())
         !!VNETExport.UserClassStore2[2].append(!insttagdata[!indx].part(2,'+').trim())
      enddo

   endif

-- Array of valve tags and there class in the format
-- Tag+Class

   if !!VNETExport.UserClassStore3.empty() then

      !valvtagdata = array()
      !valvtagdata.append('MOV+SHUTDOWN VALVE')

      !!VNETExport.UserClassStore3.clear()
      !!VNETExport.UserClassStore3[1] = array()
      !!VNETExport.UserClassStore3[2] = array()

-- Make the Valve list same as instruments list

      !!VNETExport.UserClassStore3[1] = !!VNETExport.UserClassStore2[1]
      !!VNETExport.UserClassStore3[2] = !!VNETExport.UserClassStore2[2]

   -- Seperate out the tags from the array descriptions and load into one of the user storage areas
      do !indx indices !valvtagdata
         !!VNETExport.UserClassStore3[1].append(!valvtagdata[!indx].part(1,'+').trim())
         !!VNETExport.UserClassStore3[2].append(!valvtagdata[!indx].part(2,'+').trim())
      enddo

   endif

-- Main code to look and classify items depending on the name

   if (!type eq 'EQUI') then

   -- Split the items name at any dashes and remove the prefixing VPD slash
      !splitname = !name.after('/').split('-')

   -- Find the tag in the list of tags and get its position
   -- Searches through the split parts of the name for the tag letters
   -- If it finds any then it breaks out

      !pos = real()
      do !indx indices !splitname
         !pos = !!VNETExport.UserClassStore1[1].findfirst(!splitname[!indx])
         if not !pos.unset() then
            break
         endif
      enddo

   -- Check to see if anything was found
   -- Try to be more clever
   -- Convert all REALS to hashes then split them on hashes an try the search again

      if !pos.unset() then
         if (!splitname.size() eq 1) then
            !length = !splitname[1].length()
            do !loop from 1 to !length
               !test = !splitname[1].substring(!loop,1).real()
               handle any
               elsehandle none
                  !splitname[1] = !splitname[1].replace(!splitname[1].substring(!loop,1),'#',1,1)
               endhandle
            enddo

            !newname = !splitname[1].split('#')
            do !indx indices !newname
               !pos = !!VNETExport.UserClassStore1[1].findfirst(!newname[!indx])
               if not !pos.unset() then
                  break
               endif
            enddo

         endif
      endif

   -- Check to see if anything was found
   -- If yes then output just the description form the array of tags and descriptions

      if !pos.unset().not() then
         !this.result = !!VNETExport.UserClassStore1[2][!pos]
      endif

   elseif (!type eq 'INST') then

   -- Split the items name at any dashes and remove the prefixing VPD slash
      !splitname = !name.after('/').split('-')

   -- Find the tag in the list of tags and get its position
   -- Searches through the split parts of the name for the tag letters
   -- If it finds any then it breaks out

      !pos = real()
      do !indx indices !splitname
         !pos = !!VNETExport.UserClassStore2[1].findfirst(!splitname[!indx])
         if not !pos.unset() then
            break
         endif
      enddo

   -- Check to see if anything was found
   -- Try to be more clever
   -- Convert all REALS to hashes then split them on hashes an try the search again

      if !pos.unset() then
         if (!splitname.size() eq 1) then
            !length = !splitname[1].length()

            do !loop from 1 to !length
               !test = !splitname[1].substring(!loop,1).real()
               handle any
               elsehandle none
                  !splitname[1] = !splitname[1].replace(!splitname[1].substring(!loop,1),'#',1,1)
               endhandle
            enddo

            !newname = !splitname[1].split('#')
            do !indx indices !newname
               !pos = !!VNETExport.UserClassStore2[1].findfirst(!newname[!indx])
               if not !pos.unset() then
                  break
               endif
            enddo

         endif
      endif

   -- Check to see if anything was found
   -- If yes then output just the description form the array of tags and descriptions

      if !pos.unset().not() then
         !this.result = !!VNETExport.UserClassStore2[2][!pos]
      endif

   elseif (!type eq 'VALV') then

   -- Split the items name at any dashes and remove the prefixing VPD slash
      !splitname = !name.after('/').split('-')

   -- Find the tag in the list of tags and get its position
   -- Searches through the split parts of the name for the tag letters
   -- If it finds any then it breaks out

      !pos = real()
      do !indx indices !splitname
         !pos = !!VNETExport.UserClassStore3[1].findfirst(!splitname[!indx])
         if not !pos.unset() then
            break
         endif
      enddo

   -- Check to see if anything was found
   -- Try to be more clever
   -- Convert all REALS to hashes then split them on hashes an try the search again

      if !pos.unset() then

         if (!splitname.size() eq 1) then
            !length = !splitname[1].length()

            do !loop from 1 to !length
               !test = !splitname[1].substring(!loop,1).real()
               handle any
               elsehandle none
                  !splitname[1] = !splitname[1].replace(!splitname[1].substring(!loop,1),'#',1,1)
               endhandle
            enddo

            !newname = !splitname[1].split('#')
            do !indx indices !newname
               !pos = !!VNETExport.UserClassStore3[1].findfirst(!newname[!indx])
               if not !pos.unset() then
                  break
               endif
            enddo

         endif
      endif

   -- Check to see if anything was found
   -- If yes then output just the description form the array of tags and descriptions

      if !pos.unset().not() then
         !this.result = !!VNETExport.UserClassStore3[2][!pos]
      endif

   elseif (!type eq 'PIPE') then

      if (!name.match('CABLE') gt 0) then

         !this.result = 'CABLETRAY'

      elseif (!name.match('HVAC') gt 0) then

         !this.result = 'HVAC'

      endif

   elseif (!type eq 'BRAN' and !!CE.owner.type eq 'HVAC') then

     !this.result = 'HVACSEGMENT'

   elseif (!type eq 'BRAN' and (!!CE.owner.name.match('CABLE') gt 0)) then

     !this.result = 'CABLETRAYSECTION'

   elseif (!type eq 'BRAN' and (!!CE.owner.name.match('HVAC') gt 0)) then

     !this.result = 'HVACSECTION'

   elseif (!!CE.owner.type eq 'BRAN' and !!CE.owner.owner.type eq 'HVAC') then

     !this.result = 'HVACCOMPONENT'

   endif

endmethod

-- End of method definition for .VNETUserClassIMP()

-------------------------------------------------------------------------------

-- End of File
