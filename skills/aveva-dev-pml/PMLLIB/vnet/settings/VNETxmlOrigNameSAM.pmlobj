-- Created:          9th March 2004
--
--
-- Description:
-- Derive original external identifier from PDMS name (e.g. to match P&ID name)

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  VNETxmlOrigNameSAM(dbref,string) -
--
--------------------------------------------------------------------------------

define object VNETxmlOrigNameSAM

  -- Used as a temporary store for the original name
  member .result is string

endobject

-- End of object definition for VNETxmlOrigNameSAM

--------------------------------------------------------------------------------

define method .VNETxmlOrigNameSAM( !object is dbref, !name is string )

   if (!object.type EQ 'PIPE') then

      if (!name.match('-') gt 0) then

         !splitname = !name.split('-')

         if ((!splitname.size() eq 3) or (!splitname.size() eq 4)) then
            !this.result = !splitname[2] & '-' & !splitname[3]
         else
            !this.result = !name
         endif

      elseif (!name.match('/') gt 0) then

         !splitname = !name.split('/')
         if (!splitname.size() eq 4) then
            !this.result = !splitname[1] & '-' & !splitname[2] & '/' & !splitname[3]
         else
            !this.result = !name
         endif

      else
         !this.result = !name
      endif

   else
      !this.result = !name
   endif

endmethod

-- End of method definition for .VNETxmlOrigNameSAM()

-------------------------------------------------------------------------------

