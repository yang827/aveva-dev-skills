-- Fixture for tools/pml-graph/tests: a form whose gadget callback drives a method.

setup form !!graphSampleForm
  title |Graph Sample|
  init |!this.loadValue()|
  cancelcall |!this.close()|

  frame .body |Sample|
    text   .input  |Value| call |!this.applyValue()| width 20
    button .apply  |Apply| call |!this.applyValue()|
    button .reset  |Reset| call |call !!graphSampleRound(!this.input.val)|
  exit

  member .storedValue is REAL

  define method .loadValue()
    !this.storedValue = !!graphSampleAdd(1, 2)
    !this.input.val = STRING(!this.storedValue)
  endmethod

  define method .applyValue()
    !this.storedValue = !!graphSampleAdd(!this.input.val, 0)
  endmethod

endform
