-- Fixture for tools/pml-graph/tests: an object with a member and two methods,
-- including an overloaded method name (the graph must keep both).

define object GraphSampleObject

  member .value    is REAL
  member .label    is STRING

endobject

define method .GraphSampleObject(!seed is REAL)
  !this.value = !seed
  !this.label = 'seed'
endmethod

define method .describe()
  return !this.label
endmethod

define method .describe(!prefix is STRING)
  return !prefix & !this.label
endmethod
