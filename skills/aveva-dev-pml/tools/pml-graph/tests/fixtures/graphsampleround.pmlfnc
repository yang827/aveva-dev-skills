-- Fixture for tools/pml-graph/tests: the callee, plus a CDB path and an interop import.

import 'GridControl'

define function !!graphSampleRound(!value is REAL) is REAL

  !clamped = !value
  if (!clamped GT 100) then
    !clamped = 100
  endif
  !path = /GRAPH/FIXTURE-AREA
  return !clamped

endfunction
